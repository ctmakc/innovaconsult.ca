---
// Closing band (one per page, last): the line, one real button that opens the contact dialog
// (falls back to /contact without JS) and the email. Flare is used once here: the button.
import { SITE } from '../data/site';
interface Props {
  title?: string;
  lede?: string;
}
const { title = 'Start a conversation.', lede = 'Tell us what you are working on. Every message is read by a person, and we reply by email.' } = Astro.props;
---

<section class="cta shell" aria-labelledby="cta-h">
  <div class="cta-f frame">
    <h2 id="cta-h" class="cta-h" data-rise>{title}</h2>
    <div class="cta-r">
      <p class="cta-p">{lede}</p>
      <div class="cta-acts">
        <a class="btn btn--flare cta-btn" href="/contact" data-open-contact>Write to us <span class="ar" aria-hidden="true">→</span></a>
        <a class="cta-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: calc(var(--sec) * 0.62);
  }
  .cta-f {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 28px;
    align-items: end;
    padding: clamp(36px, 4.4vw, 72px) var(--in);
    background: var(--reel);
    box-shadow: inset 0 0 0 1px var(--rule-film);
  }
  .cta-h {
    grid-column: 1 / span 7;
    font-size: clamp(44px, 6.4vw, 104px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-wrap: balance;
  }
  .cta-r {
    grid-column: 8 / span 5;
    padding-bottom: 0.4em;
  }
  .cta-p {
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.45;
    color: var(--ash);
    max-width: 36ch;
  }
  .cta-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 24px;
  }
  .cta-btn {
    min-height: 54px;
    padding: 0 26px;
    font-size: 17px;
  }
  .cta-mail {
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--ash);
    padding-block: 10px 2px;
  }
  .cta-mail:hover {
    border-color: var(--print);
  }
  @media (max-width: 900px) {
    .cta-h,
    .cta-r {
      grid-column: 1 / -1;
    }
    .cta-btn {
      flex: 1 1 auto;
    }
  }
</style>
