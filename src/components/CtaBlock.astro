---
// Closing band (round 4): ONE full-bleed atmospheric band per page, always the last thing in <main>,
// right above the footer. Edge to edge (no gutter, no frame, no border): the photo fills the width,
// the line sits bottom-left at 48–104px, ONE flare button opens the contact dialog (falls back to
// /contact without JS), the email follows as plain text. Default photo: Rideau Canal at night (Ottawa);
// pages whose own hero already uses that photo pass photo="festival". The CC credit is printed on the band.
// Pages never add a second closing CTA box above it; a page with nothing to close passes footerCta={false}.
// Round 5: the photo band closes HOME only (variant="band"). Every other page ends with variant="line":
// the page's own closing sentence at H3 size and one text action beside it, no photo, no box.
import { SITE } from '../data/site';
interface Props {
  title?: string;
  lede?: string;
  photo?: 'ottawa' | 'festival';
  link?: { href: string; label: string };
  variant?: 'band' | 'line';
}
const {
  title = 'Start a conversation.',
  lede = 'Tell us what you are working on. Every message is read by a person, and we reply by email.',
  photo = 'ottawa',
  link,
  variant = 'line'
} = Astro.props;

const PH = {
  ottawa: {
    src: '/img/rideau-night.webp',
    srcset: '/img/rideau-night-1200.webp 1200w, /img/rideau-night.webp 2400w',
    w: 2400,
    h: 1600,
    pos: '62% 46%',
    credit: 'Rideau Canal, Ottawa. Photo: Dylandamic0, CC BY-SA 3.0, via Wikimedia Commons'
  },
  festival: {
    src: '/img/uafest-venue.webp',
    srcset: '/img/uafest-venue-800.webp 800w, /img/uafest-venue.webp 1280w',
    w: 1280,
    h: 851,
    pos: '50% 40%',
    credit: 'UAFest, Carleton Place'
  }
}[photo];
---

{variant === 'line' ? (
<section class="cl shell" aria-labelledby="cta-h">
  <div class="inset cl-g">
    <h2 id="cta-h" class="cl-h">{title}</h2>
    <div class="cl-r">
      <p class="cl-p">{lede}</p>
      <p class="cl-a">
        <a class="btn btn--flare" href="/contact" data-open-contact>Write to us <span class="ar" aria-hidden="true">→</span></a>
        <span class="cl-mail">or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{link && (<><span aria-hidden="true"> · </span><a href={link.href}>{link.label}</a></>)}</span>
      </p>
    </div>
  </div>
</section>
) : (
<section class="cta" aria-labelledby="cta-h">
  <div class="cta-ph">
    <div class="cta-z" data-dolly-bg>
      <img src={PH.src} srcset={PH.srcset} sizes="100vw" alt="" width={PH.w} height={PH.h} loading="lazy" decoding="async" style={`object-position:${PH.pos}`} />
    </div>
    <p class="cta-cr">{PH.credit}</p>
  </div>
  <div class="cta-c shell">
    <div class="inset cta-g">
      <h2 id="cta-h" class="cta-h">{title}</h2>
      <div class="cta-r">
        <p class="cta-p">{lede}</p>
        <a class="btn btn--flare cta-btn" href="/contact" data-open-contact>Write to us <span class="ar" aria-hidden="true">→</span></a>
        <p class="cta-mail">
          or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          {
            link && (
              <>
                <span aria-hidden="true"> · </span>
                <a href={link.href}>{link.label}</a>
              </>
            )
          }
        </p>
      </div>
    </div>
  </div>
</section>
)}

<style>
  /* ── line variant (inner pages) ── */
  .cl {
    margin-top: calc(var(--sec) * 0.5);
    padding-bottom: clamp(56px, 6vw, 96px);
  }
  .cl-g {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--col-gap);
    align-items: end;
    padding-top: clamp(32px, 3.4vw, 48px);
    border-top: 1px solid var(--rule-film);
  }
  .cl-h {
    font-size: clamp(32px, 3.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 16ch;
    text-wrap: balance;
  }
  .cl-p {
    max-width: 44ch;
    font-size: var(--fs-copy);
    line-height: 1.5;
    color: var(--copy);
  }
  .cl-a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin-top: 20px;
  }
  .cl-mail {
    font-size: 17px;
    color: var(--copy);
  }
  .cl-mail a {
    color: var(--print);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .cl-mail a:hover {
    color: var(--flare-hi);
  }
  @media (max-width: 900px) {
    .cl-g {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
  }

  .cta {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(480px, 64svh, 680px);
    margin-top: calc(var(--sec) * 0.7);
    padding-block: clamp(40px, 4.4vw, 72px) clamp(44px, 4.4vw, 72px);
    background: var(--reel);
    overflow: hidden;
  }
  .cta-ph {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .cta-z {
    position: absolute;
    inset: 0;
  }
  .cta-ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the film fades into the photo at the top edge, so the band reads as a scene, never as a box */
  .cta-z::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--film) 0%, rgb(13 12 11 / 0) 22%),
      linear-gradient(90deg, rgb(13 12 11 / 0.72) 0%, rgb(13 12 11 / 0.3) 52%, rgb(13 12 11 / 0) 80%),
      linear-gradient(0deg, rgb(13 12 11 / 0.9) 0%, rgb(13 12 11 / 0.25) 48%, rgb(13 12 11 / 0) 70%);
  }
  .cta-c {
    width: 100%;
  }
  .cta-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 0;
    align-items: end;
  }
  .cta-h {
    grid-column: 1 / span 8;
    font-size: clamp(44px, 5.8vw, 96px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.92;
    max-width: 15ch;
    text-wrap: balance;
  }
  .cta-r {
    grid-column: 1 / span 6;
  }
  .cta-p {
    margin-top: clamp(18px, 1.8vw, 28px);
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.45;
    max-width: 36ch;
    color: var(--print);
  }
  .cta-btn {
    margin-top: clamp(22px, 2.2vw, 32px);
    min-height: 64px;
    padding: 0 32px;
    font-size: 19px;
    font-weight: 600;
  }
  .cta-mail {
    margin-top: 16px;
    font-size: 17px;
    color: var(--print);
  }
  .cta-mail a {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .cta-mail a:hover {
    color: var(--flare-hi);
  }
  .cta-cr {
    position: absolute;
    z-index: 2;
    right: var(--gut);
    bottom: 12px;
    max-width: 46ch;
    font-size: 14px;
    line-height: 1.3;
    text-align: right;
    color: rgb(238 234 226 / 0.82);
    text-shadow: 0 1px 2px rgb(13 12 11 / 0.9);
  }
  @media (max-width: 1100px) {
    .cta-h,
    .cta-r {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 900px) {
    .cta {
      display: block;
      min-height: 0;
      padding: 0 0 64px;
    }
    .cta-ph {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 4 / 3.4;
    }
    .cta-ph::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, var(--film) 0%, rgb(13 12 11 / 0) 24%, rgb(13 12 11 / 0) 50%, var(--reel) 100%);
    }
    .cta-z::after {
      display: none;
    }
    .cta-c {
      position: relative;
      z-index: 1;
      margin-top: -16vw;
    }
    .cta-btn {
      display: flex;
      width: 100%;
      justify-content: center;
    }
    .cta-cr {
      top: 30%;
      bottom: auto;
      right: 10px;
      max-width: calc(100% - 20px);
      padding: 3px 8px;
      border-radius: 4px;
      background: rgb(13 12 11 / 0.6);
      font-size: 14px;
    }
  }
</style>
