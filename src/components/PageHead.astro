---
import RiseHeading from './RiseHeading.astro';
interface Props {
  crumb: string;
  /** When given, the crumb text links to this path. */
  crumbHref?: string;
  title: string;
  lede?: string;
}
const { crumb, crumbHref, title, lede } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="ph">
  <div class="wrap grid12">
    <div class="ph-l">
      <p class="kicker ph-crumb">
        <a href="/" class="ulink">INNOVA</a><span aria-hidden="true">/</span>{crumbHref ? <a href={crumbHref} class="ulink">{crumb}</a> : crumb}
      </p>
      <RiseHeading text={title} class="d-page" delay={60} />
    </div>
    {
      (lede || hasAside) && (
        <div class="ph-r">
          {lede && <p class="lede">{lede}</p>}
          {hasAside && (
            <div class="ph-aside">
              <slot name="aside" />
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .ph {
    padding-block: clamp(48px, 5vw, 88px) clamp(48px, 5vw, 80px);
    border-bottom: 1px solid var(--rule);
  }
  .ph .grid12 {
    align-items: start;
    row-gap: 28px;
  }
  .ph-l {
    grid-column: 1 / span 7;
    min-width: 0;
  }
  .ph-l :global(.d-page) {
    max-width: 15ch;
  }
  /* The first lede line sits level with the H1 cap line (crumb height + its margin). */
  .ph-r {
    grid-column: 9 / span 4;
    padding-top: 46px;
    animation: phf 800ms var(--ease-out) 380ms both;
  }
  .ph-aside {
    margin-top: 28px;
  }
  .ph-crumb a {
    color: var(--frost);
  }
  .ph-crumb span {
    color: var(--rule-strong);
  }
  @keyframes phf {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph-r {
      animation: none;
    }
  }
  @media (max-width: 980px) {
    .ph-l,
    .ph-r {
      grid-column: 1 / -1;
    }
    .ph-r {
      padding-top: 0;
    }
  }
</style>
