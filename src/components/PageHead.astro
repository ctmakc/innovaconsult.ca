---
// Inner-page head (v2). Crumb line, a big title, a lede, optional aside (slot "aside")
// and optional media (slot "media": a MediaFrame or Screen shown full width under the head).
// Props are the v1 props, so every existing page keeps working.
interface Props {
  crumb: string;
  crumbHref?: string;
  title: string;
  lede?: string;
}
const { crumb, crumbHref, title, lede } = Astro.props;
const hasAside = Astro.slots.has('aside');
const hasMedia = Astro.slots.has('media');
---

<section class="ph">
  <div class="shell">
    <div class="inset ph-g">
      <p class="t-label ph-crumb">
        <a href="/">INNOVA</a><span aria-hidden="true">/</span>{crumbHref ? <a href={crumbHref}>{crumb}</a> : <span>{crumb}</span>}
      </p>
      <h1 class="t-display ph-t">{title}</h1>
      {
        (lede || hasAside) && (
          <div class="ph-r">
            {lede && <p class="t-lede">{lede}</p>}
            {hasAside && (
              <div class="ph-aside">
                <slot name="aside" />
              </div>
            )}
          </div>
        )
      }
    </div>
    {hasMedia && <div class="ph-media"><slot name="media" /></div>}
  </div>
</section>

<style>
  .ph {
    padding-block: clamp(40px, 6vw, 104px) clamp(56px, 6vw, 104px);
  }
  .ph-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 28px;
    align-items: end;
  }
  .ph-crumb {
    grid-column: 1 / -1;
    display: flex;
    gap: 10px;
    color: var(--ash);
  }
  .ph-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .ph-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ph-t {
    grid-column: 1 / span 8;
    font-size: clamp(48px, 7.6vw, 128px);
    max-width: 14ch;
    animation: ph-rise 1s var(--e-out) 0.05s both;
  }
  .ph-r {
    grid-column: 9 / span 4;
    animation: ph-in 0.8s var(--e-out) 0.3s both;
  }
  .ph-r .t-lede {
    color: var(--print);
  }
  .ph-aside {
    margin-top: 24px;
  }
  .ph-media {
    margin-top: clamp(40px, 5vw, 80px);
  }
  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes ph-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 900px) {
    .ph-t,
    .ph-r {
      grid-column: 1 / -1;
    }
  }
</style>
