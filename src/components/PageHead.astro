---
import RiseHeading from './RiseHeading.astro';
interface Props {
  crumb: string;
  title: string;
  lede?: string;
}
const { crumb, title, lede } = Astro.props;
---

<section class="ph">
  <div class="wrap grid12">
    <div class="ph-l">
      <p class="kicker ph-crumb"><a href="/" class="ulink">INNOVA</a><span aria-hidden="true">/</span>{crumb}</p>
      <RiseHeading text={title} class="d-xl" delay={60} />
    </div>
    {
      lede && (
        <div class="ph-r">
          <p class="lede">{lede}</p>
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .ph {
    padding-block: clamp(48px, 5vw, 88px) clamp(48px, 5vw, 80px);
    border-bottom: 1px solid var(--rule);
  }
  .ph .grid12 {
    align-items: end;
    row-gap: 28px;
  }
  .ph-l {
    grid-column: 1 / span 7;
  }
  .ph-l :global(.d-xl) {
    max-width: 16ch;
  }
  .ph-r {
    grid-column: 9 / span 4;
    animation: phf 800ms var(--ease-out) 380ms both;
  }
  .ph-crumb a {
    color: var(--frost);
  }
  .ph-crumb span {
    color: var(--rule-strong);
  }
  @keyframes phf {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ph-r {
      animation: none;
    }
  }
  @media (max-width: 980px) {
    .ph-l,
    .ph-r {
      grid-column: 1 / -1;
    }
  }
</style>
