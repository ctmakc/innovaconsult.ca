---
// HOME HERO (round 3) — one full-bleed real photograph, one statement.
// The UAFest Unity Ride aerial fills the frame; nothing floats on top of it except the giant
// statement, the lede and two buttons. The proof row at the bottom is text only: the three live
// products with one hard number each, so the photo is tied to the software that runs the festival.
// The H1 is in its final place at first paint (no mask, no JS); only the photo drifts (Ken Burns).
// Facts are copied from src/data/projects.ts — nothing new.
import FitText from '../FitText.astro';
import Button from '../Button.astro';
import { visibleProjects, projectHref, type Project } from '../../data/projects';
import { SITE } from '../../data/site';

const P = Object.fromEntries(visibleProjects.map((p) => [p.slug, p])) as Record<string, Project>;

const PROOF: { p: Project; num: string; line: string }[] = [
  { p: P.uafest, num: '199 participant cabinets.', line: 'The 13 September 2026 festival ran on it.' },
  { p: P.foundwall, num: 'Web platform live.', line: 'iOS and Android apps in public beta.' },
  { p: P.babakokum, num: 'On the App Store.', line: 'Since 24 September 2026, and playable on the web.' }
];
---

<section class="hr-sec shell" aria-labelledby="h1" data-hero>
  <div class="hr frame">
    <div class="hr-world" aria-hidden="true">
      <picture>
        <source media="(max-width: 700px)" srcset="/img/uafest-unity-ride-m.webp" />
        <img
          src="/img/uafest-unity-ride.webp"
          srcset="/img/uafest-unity-ride-800.webp 800w, /img/uafest-unity-ride-1200.webp 1200w, /img/uafest-unity-ride.webp 1920w"
          sizes="100vw"
          alt=""
          width="1920"
          height="960"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <p class="hr-top t-label">
      <span>{SITE.city}, {SITE.country}</span>
      <span class="hr-top-r tnum">Federal corporation {SITE.corporationNumber}</span>
    </p>

    <div class="hr-copy">
      <FitText as="h1" id="h1" class="hr-h" text="INNOVA: Applied AI & software, Ottawa" lines={['Applied AI', '& software']} />
      <p class="hr-lede">We build software and applied AI with companies, researchers and public organizations. Three products are live today.</p>
      <div class="hr-ctas">
        <Button openContact variant="flare">Start a conversation</Button>
        <Button href="/projects" variant="ghost">See the work</Button>
      </div>
    </div>

    <p class="hr-credit">UAFest Unity Ride, Carleton Place. The festival runs on our operations platform.</p>

    <ol class="hr-proof" aria-label="Live now">
      {
        PROOF.map(({ p, num, line }) => (
          <li>
            <a class="hr-tab" href={projectHref(p)}>
              <span class="hr-tn">
                <i class="hr-dot" aria-hidden="true" />
                {p.short}
                <span class="sr-only">, live:</span>
                <span class="ar" aria-hidden="true">→</span>
              </span>
              <span class="hr-tf">
                <b>{num}</b> {line}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hr {
    --pad: clamp(18px, 2.4vw, 40px);
    --proof: clamp(112px, 12.5vh, 132px);
    height: calc(100svh - var(--hdr) - var(--gut));
    min-height: 640px;
    max-height: 1040px;
    background: var(--reel);
  }
  .hr-world,
  .hr-world picture,
  .hr-world img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hr-world {
    z-index: 0;
    overflow: hidden;
  }
  .hr-world img {
    object-fit: cover;
    object-position: 50% 60%;
  }
  /* scrims: left for the statement, bottom for the proof row, top for the record line */
  .hr::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(13 12 11 / 0.82) 0%, rgb(13 12 11 / 0.55) 34%, rgb(13 12 11 / 0) 62%),
      linear-gradient(0deg, rgb(13 12 11 / 0.95) 0%, rgb(13 12 11 / 0.78) calc(var(--proof) * 0.9), rgb(13 12 11 / 0) calc(var(--proof) + 260px)),
      linear-gradient(180deg, rgb(13 12 11 / 0.72) 0%, rgb(13 12 11 / 0.3) 70px, rgb(13 12 11 / 0) 130px);
  }

  .hr-top {
    position: absolute;
    z-index: 3;
    top: clamp(16px, 2vw, 26px);
    left: var(--pad);
    right: var(--pad);
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .hr-copy {
    position: absolute;
    z-index: 3;
    left: var(--pad);
    bottom: calc(var(--proof) + clamp(26px, 4vh, 48px));
    width: min(54%, 820px);
  }
  .hr-h {
    margin-left: -0.04em;
  }
  .hr-lede {
    margin-top: clamp(18px, 2.4vh, 28px);
    max-width: 34ch;
    font-size: clamp(19px, 1.45vw, 23px);
    line-height: 1.4;
  }
  .hr-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(20px, 2.8vh, 30px);
  }
  .hr-credit {
    position: absolute;
    z-index: 3;
    right: var(--pad);
    bottom: calc(var(--proof) + 14px);
    max-width: 30ch;
    font-size: 14px;
    line-height: 1.35;
    text-align: right;
    color: var(--print);
    text-shadow: 0 1px 2px rgb(13 12 11 / 0.9), 0 0 14px rgb(13 12 11 / 0.7);
  }

  /* ── proof row: text only, the three live products ── */
  .hr-proof {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--proof);
    margin: 0;
    padding: 0 var(--pad);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--col-gap);
  }
  .hr-tab {
    display: grid;
    align-content: start;
    padding-top: clamp(18px, 2.2vh, 24px);
    gap: 6px;
    height: 100%;
    text-decoration: none;
    color: var(--ash);
    border-top: 1px solid rgb(238 234 226 / 0.22);
    transition: border-color var(--t-micro) var(--e-out);
  }
  .hr-tab:hover {
    border-color: var(--print);
  }
  .hr-tn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: clamp(20px, 1.5vw, 24px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--print);
  }
  .hr-tn .ar {
    font-weight: 400;
    transition: transform 0.3s var(--e-out);
  }
  .hr-tab:hover .ar {
    transform: translateX(6px);
  }
  .hr-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--flare);
    box-shadow: 0 0 0 4px rgb(255 91 34 / 0.22);
  }
  .hr-tf {
    font-size: 16px;
    line-height: 1.4;
  }
  .hr-tf b {
    font-weight: 600;
    color: var(--print);
  }

  /* the photo is there at first paint; it only drifts */
  @media (prefers-reduced-motion: no-preference) {
    .hr-world img {
      animation: hr-kb 14s var(--e-out) both;
    }
  }
  @keyframes hr-kb {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1.01);
    }
  }

  @media (max-width: 1100px) {
    .hr-copy {
      width: min(64%, 820px);
    }
    .hr-credit {
      display: none;
    }
  }

  /* ── phones and tablets: the photo on top, the statement over its lower edge, proof below ── */
  @media (max-width: 900px) {
    .hr {
      height: auto;
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
      background: var(--film);
    }
    .hr::after {
      display: none;
    }
    .hr-world {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 4 / 4.4;
    }
    .hr-world::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgb(13 12 11 / 0.6) 0%, rgb(13 12 11 / 0) 18%, rgb(13 12 11 / 0) 46%, rgb(13 12 11 / 0.9) 84%, var(--film) 100%);
    }
    .hr-world img {
      object-position: 50% 50%;
    }
    .hr-top {
      top: 14px;
      left: 16px;
      right: 16px;
      font-size: 13px;
      white-space: nowrap;
    }
    .hr-copy {
      position: relative;
      left: auto;
      bottom: auto;
      width: auto;
      margin-top: -30vw;
      padding: 0 16px;
    }
    .hr-lede {
      font-size: 18px;
    }
    .hr-ctas :global(.btn) {
      flex: 1 1 auto;
    }
    .hr-proof {
      position: relative;
      height: auto;
      grid-template-columns: 1fr;
      padding: 28px 16px 4px;
    }
    .hr-tab {
      padding-block: 16px;
    }
  }
</style>
