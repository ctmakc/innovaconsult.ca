---
// Home: "What a funded project with INNOVA looks like" (round 5) — one compact screen for IRAP /
// Invest Ottawa readers. The four parts (as on /innovation) are filled with the concrete OpenField
// instance, set as one table at body size, with the R&D links beside it. Every OpenField line restates
// src/data/projects.ts or /innovation (prototype on demo and simulated data; field validation planned
// for the 2027 season with Ontario dealers and growers running robots from more than one manufacturer).
// The picture is the technician's "Needs a person" screen at its natural size (3x capture).
import StatusTag from '../StatusTag.astro';
import { HOME_MEDIA } from './media';
import { visibleProjects, projectHref } from '../../data/projects';

const of = visibleProjects.find((p) => p.slug === 'openfield')!;
const shot = HOME_MEDIA.openfieldEntry;

const PARTS = [
  {
    k: 'Question',
    t: 'Can one logbook record what farm robots from different manufacturers did, where they failed and what the grower must report?'
  },
  {
    k: 'Baseline and target',
    t: 'Today dealers who service robots from many brands keep no common record. Target: field validation in the 2027 season with Ontario dealers and growers running robots from more than one manufacturer.'
  },
  { k: 'Milestones', t: 'A working prototype on demo and simulated data, done. Field validation in the 2027 growing season, planned.' },
  { k: 'Results', t: 'Reported against the target after the 2027 season, including the experiments that fail.' }
];
---

<section class="fp shell" id="funded" aria-labelledby="fp-h">
  <div class="inset">
    <div class="fp-hd">
      <h2 id="fp-h" class="t-h2 fp-h" data-rise>What a funded project with INNOVA looks like</h2>
      <p class="fp-lede">Four parts, written before the work starts and reported against when it ends. The example is <a href={projectHref(of)}>{of.short}</a>, our logbook for ag-robot fleets.</p>
    </div>

    <div class="fp-g">
      <table class="fp-t">
        <caption class="sr-only">The four parts of a funded project, with OpenField as the example</caption>
        <tbody>
          {
            PARTS.map((p) => (
              <tr>
                <th scope="row">{p.k}</th>
                <td>{p.t}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="fp-side">
        <a class="fp-shot" href={projectHref(of)} aria-label={`${of.short}: open the project`}>
          <img
            src={shot.src}
            srcset={shot.srcset}
            sizes="(max-width: 900px) 86vw, 400px"
            alt={shot.alt}
            width={shot.w}
            height={shot.h}
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="fp-cap"><StatusTag status={of.status} /> <span>Technician entry screen, demo data</span></p>
        <p class="fp-links">
          <a class="lnk" href="/innovation#funded">How we run R&amp;D <span class="ar" aria-hidden="true">→</span></a>
          <a class="lnk" href="/partnerships">Partnership models <span class="ar" aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .fp {
    padding-top: var(--sec);
  }
  .fp-hd {
    max-width: 980px;
  }
  .fp-h {
    max-width: 16ch;
  }
  .fp-lede {
    margin-top: 20px;
    max-width: 52ch;
    font-size: var(--fs-copy);
    line-height: 1.5;
    color: var(--copy);
  }
  .fp-lede a {
    color: var(--print);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .fp-g {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
    column-gap: clamp(32px, 5vw, 96px);
    align-items: start;
    margin-top: clamp(36px, 4vw, 56px);
  }
  .fp-t {
    width: 100%;
    border-collapse: collapse;
  }
  .fp-t tr {
    border-top: 1px solid var(--rule-film);
  }
  .fp-t tr:last-child {
    border-bottom: 1px solid var(--rule-film);
  }
  .fp-t th,
  .fp-t td {
    padding: clamp(18px, 1.8vw, 26px) 0;
    vertical-align: top;
    text-align: left;
  }
  .fp-t th {
    width: 32%;
    padding-right: 24px;
    font-size: clamp(20px, 1.6vw, 24px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--print);
  }
  .fp-t td {
    font-size: var(--fs-copy);
    line-height: 1.5;
    color: var(--copy);
    max-width: 52ch;
  }
  .fp-shot {
    display: block;
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow-screen);
    background: var(--bone-2);
    transition: transform 0.55s var(--e-out);
  }
  .fp-shot:hover {
    transform: translateY(-6px);
  }
  .fp-shot img {
    width: 100%;
  }
  .fp-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 14px;
    font-size: 15px;
    color: var(--ash);
  }
  .fp-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 24px;
    font-size: 17px;
  }

  @media (max-width: 900px) {
    .fp-g {
      grid-template-columns: 1fr;
      row-gap: 36px;
    }
    .fp-t th,
    .fp-t td {
      display: block;
      width: auto;
      padding: 0;
    }
    .fp-t th {
      padding-top: 18px;
      font-size: 20px;
    }
    .fp-t td {
      padding: 6px 0 18px;
    }
    .fp-side {
      max-width: 420px;
    }
  }
</style>
