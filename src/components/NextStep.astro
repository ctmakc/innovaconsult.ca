---
interface Props {
  title: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const { title, primary, secondary } = Astro.props;
---

<section class="section ns">
  <div class="wrap ns-in">
    <p class="d-l ns-t">{title}</p>
    <div class="ns-a">
      <a class="btn btn-primary" href={primary.href}>{primary.label} <span class="arr" aria-hidden="true">→</span></a>
      {secondary && <a class="arrow-link" href={secondary.href}><span>{secondary.label}</span><span aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>

<style>
  .ns-in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px;
    align-items: end;
  }
  .ns-t {
    max-width: 20ch;
  }
  .ns-a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    justify-content: flex-end;
  }
  @media (max-width: 860px) {
    .ns-in {
      grid-template-columns: 1fr;
    }
    .ns-a {
      justify-content: flex-start;
    }
  }
</style>
