---
// Five modules (round 3): ONE sticky product stage on a dark plate. Desktop: the module names
// scroll on the left (300px column); the stage on the right (~1050px) swaps to the module being
// read, and a close-up of the one number that matters (cut from the 2x master) sits on its corner.
// Phones: each module shows only its close-up, which reads at phone width.
// Factor lists, patterns, levels, phases, the technology and the data/AI note live in two
// collapsed <details>; the product boundary is a two-line callout at the end.
import { MODULES, QA, RISK, TECHNOLOGY } from './data';
import { CROPS, type Crop } from '../../data/crops';

/* Per module: the stage image (full screen or a readable panel) and its close-up. */
const STAGE: { img: { src: string; srcset: string; w: number; h: number }; loupe?: Crop; lw?: string; crop: Crop }[] = MODULES.map((m, i) => {
  const full = (sh: typeof m.shot) => ({
    src: sh.src2000 ?? sh.src,
    srcset: `${sh.src800} 800w, ${sh.src} 1600w${sh.src2000 ? `, ${sh.src2000} 2000w` : ''}`,
    w: sh.w,
    h: sh.h
  });
  switch (i) {
    case 0:
      return { img: full(m.shot), loupe: CROPS.wosOverview234, lw: '30%', crop: CROPS.wosOverview234 };
    case 1:
      return { img: full(m.shot), loupe: CROPS.wosMap88, lw: '40%', crop: CROPS.wosMap88 };
    case 2:
      return { img: full(m.shot), loupe: CROPS.wosDesigner60, lw: '46%', crop: CROPS.wosDesigner60 };
    case 3:
      return { img: { src: CROPS.wosImpl.src, srcset: CROPS.wosImpl.srcset, w: CROPS.wosImpl.w, h: CROPS.wosImpl.h }, crop: CROPS.wosImpl };
    default:
      return { img: full(m.shot), loupe: CROPS.wosImpactKpi, lw: '46%', crop: CROPS.wosImpactKpi };
  }
});
const score = MODULES.find((m) => m.formula)!;
const design = MODULES.find((m) => m.patterns)!;
const impl = MODULES.find((m) => m.phases)!;
---

<section class="mods" aria-labelledby="mods-h">
  <div class="shell">
    <div class="inset mods-hd">
      <h2 id="mods-h" class="t-display" data-rise>Five modules.</h2>
      <p class="t-lede mods-lede">Each module hands its output to the next. Risk controls run through all five.</p>
    </div>

    <div class="ms">
      <ol class="ms-chs">
        {
          MODULES.map((m, i) => (
            <li class:list={['ch', { on: i === 0 }]} id={`module-${i + 1}`} data-ch={i}>
              <span class="ch-n tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ch-h">{m.name}</h3>
              <p class="ch-l">{m.line}</p>
              <figure class="ch-shot">
                <img
                  class="scr-img scr-dark"
                  src={STAGE[i].crop.src}
                  srcset={STAGE[i].crop.srcset}
                  sizes="92vw"
                  width={STAGE[i].crop.w}
                  height={STAGE[i].crop.h}
                  alt={STAGE[i].crop.alt}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{m.shot.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ol>

      <div class="ms-stage" aria-hidden="true">
        <div class="ms-sticky">
          <div class="plate">
            <div class="stack">
              {
                STAGE.map((s, i) => (
                  <div class:list={['stk', { on: i === 0 }]} data-shot={i}>
                    <img
                      class="scr-img scr-dark"
                      src={s.img.src}
                      srcset={s.img.srcset}
                      sizes="(max-width: 1440px) 74vw, 1080px"
                      width={s.img.w}
                      height={s.img.h}
                      alt=""
                      loading={i === 0 ? undefined : 'lazy'}
                      decoding="async"
                    />
                    {s.loupe && (
                      <img
                        class="loupe scr-img scr-dark"
                        src={s.loupe.src}
                        srcset={s.loupe.srcset}
                        sizes="480px"
                        width={s.loupe.w}
                        height={s.loupe.h}
                        alt=""
                        loading={i === 0 ? undefined : 'lazy'}
                        decoding="async"
                        style={`--lw:${s.lw}`}
                      />
                    )}
                  </div>
                ))
              }
            </div>
          </div>
          <div class="caps">
            {MODULES.map((m, i) => <p class:list={{ on: i === 0 }} data-cap={i}>{m.shot.caption}</p>)}
          </div>
        </div>
      </div>
    </div>

    <div class="inset">
      <div class="more">
        <details class="dt">
          <summary>
            <span class="dt-h">How the score works</span>
            <span class="dt-s">Factors, patterns, control levels, delivery phases and the technology</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <div class="dt-b">
            <div class="dt-c dt-wide">
              <h4>Priority score</h4>
              <p class="fx tnum">Priority = {score.formula!.join(' ')}</p>
            </div>
            {
              score.groups!.map((g) => (
                <div class="dt-c">
                  <h4>
                    {g.label} <span class="tnum">({g.items.length})</span>
                  </h4>
                  <p>{g.items.join(', ')}.</p>
                </div>
              ))
            }
            <div class="dt-c">
              <h4>Six patterns</h4>
              <p>{design.patterns!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five levels of human control</h4>
              <p>{design.levels!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five delivery phases</h4>
              <p>{impl.phases!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Risk and governance, in every module</h4>
              <p>{RISK.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Technology</h4>
              <p>{TECHNOLOGY.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Data and AI</h4>
              <p>
                The demo runs on fictional data. Scoring, design and ROI are calculated without AI. Optional AI discovery sends the description you paste to an external AI model hosted outside Canada; when it is off or slow, a rules engine drafts the process model instead.
              </p>
            </div>
          </div>
        </details>

        <details class="dt">
          <summary>
            <span class="dt-h">Six questions it answers</span>
            <span class="dt-s">From the company’s own process data</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <dl class="dt-b dt-qa">
            {
              QA.map((x) => (
                <div class="dt-c">
                  <dt>{x.q}</dt>
                  <dd>
                    {x.a} <a class="lnk" href={`#module-${x.m}`}>Module {x.m} <span class="ar" aria-hidden="true">↑</span></a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </details>
      </div>

      <p class="end" id="end">
        <span class="end-h">Workflow OS decides what to automate and how.</span>
        The automations run in the client’s existing platforms or in INNOVA products such as <a href="/projects/aicrmius">AICRMIUS</a>, so the plan stays independent of any single vendor, including us.
        <a class="lnk end-k" href="/ai-transformation">Our AI transformation method <span class="ar" aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
</section>

<script>
  // The module crossing the middle of the screen picks the screen and caption. Instant swap.
  const chs = document.querySelectorAll<HTMLElement>('[data-ch]');
  const groups = ['[data-shot]', '[data-cap]'].map((q) => document.querySelectorAll<HTMLElement>(q));
  const set = (i: number) => {
    groups.forEach((g) => g.forEach((el, j) => el.classList.toggle('on', j === i)));
    chs.forEach((c, j) => c.classList.toggle('on', j === i));
  };
  let raf = 0;
  let cur = -1;
  const pick = () => {
    raf = 0;
    const mid = window.innerHeight * 0.55;
    let i = 0;
    chs.forEach((c, j) => {
      if (c.getBoundingClientRect().top < mid) i = j;
    });
    if (i !== cur) set((cur = i));
  };
  if (chs.length) {
    window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(pick)), { passive: true });
    window.addEventListener('resize', () => (raf ||= requestAnimationFrame(pick)));
    pick();
  }
</script>

<style>
  .mods {
    padding-block: calc(var(--sec) * 0.8) calc(var(--sec) * 0.4);
  }
  .mods-hd {
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .mods-lede {
    margin-top: 18px;
    max-width: 40ch;
    color: var(--ash);
  }

  .ms {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    column-gap: clamp(20px, 2.4vw, 40px);
  }
  .ms-chs {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--in);
  }
  .ch {
    min-height: 62vh;
    padding: 4px 0 40px;
    color: var(--ash);
    transition: color var(--t-micro) var(--e-out);
  }
  .ch:last-child {
    min-height: 0;
  }
  .ch-n {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ash);
  }
  .ch.on {
    color: var(--print);
  }
  .ch.on .ch-n {
    color: var(--flare);
  }
  .ch-h {
    margin-top: 8px;
    font-size: clamp(26px, 2.2vw, 36px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .ch-l {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.5;
    max-width: 30ch;
  }
  .ch-shot {
    display: none;
  }

  .ms-stage {
    min-width: 0;
  }
  .ms-sticky {
    position: sticky;
    top: calc(var(--hdr) + 20px);
  }
  .plate {
    padding: clamp(14px, 1.6vw, 24px) clamp(14px, 1.6vw, 24px) clamp(40px, 4vw, 64px);
    border-radius: var(--r);
    background: radial-gradient(120% 100% at 20% 0%, var(--reel-2) 0%, var(--reel) 60%);
    box-shadow: inset 0 0 0 1px var(--rule-film);
  }
  .stack {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .stk {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .stk.on {
    visibility: visible;
  }
  .stk > img:first-child {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
  }
  .loupe {
    position: absolute;
    right: -2.4%;
    bottom: -8%;
    width: var(--lw, 40%);
    box-shadow:
      0 40px 80px -24px rgb(0 0 0 / 0.85),
      0 0 0 1px rgb(238 234 226 / 0.28);
  }
  @media (prefers-reduced-motion: no-preference) {
    .stk.on .loupe {
      animation: loupe 0.42s var(--e-out) both;
    }
  }
  @keyframes loupe {
    from {
      transform: translate(10px, 14px) scale(0.94);
    }
    to {
      transform: none;
    }
  }
  .caps {
    position: relative;
    margin-top: 16px;
    min-height: 3em;
  }
  .caps p {
    position: absolute;
    inset: 0 auto auto 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ash);
    visibility: hidden;
  }
  .caps p.on {
    visibility: visible;
  }

  /* collapsed detail */
  .more {
    display: grid;
    margin-top: clamp(48px, 5vw, 88px);
  }
  .dt {
    border-top: 1px solid var(--rule-film);
  }
  .dt:last-child {
    border-bottom: 1px solid var(--rule-film);
  }
  .dt summary {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 44px;
    align-items: center;
    gap: 8px var(--col-gap);
    min-height: 72px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  .dt summary::-webkit-details-marker {
    display: none;
  }
  .dt-h {
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.022em;
  }
  .dt-s {
    color: var(--ash);
    font-size: 17px;
  }
  .dt-i {
    justify-self: end;
    position: relative;
    width: 18px;
    height: 18px;
  }
  .dt-i::before,
  .dt-i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--e-out);
  }
  .dt-i::after {
    transform: rotate(90deg);
  }
  .dt[open] .dt-i::after {
    transform: rotate(0);
  }
  .dt-b {
    margin: 0;
    padding: 8px 0 40px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px var(--col-gap);
  }
  .dt-c h4,
  .dt-c dt {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .dt-c p,
  .dt-c dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
  }
  .dt-wide {
    grid-column: 1 / -1;
  }
  .fx {
    font-size: clamp(20px, 1.6vw, 26px) !important;
    color: var(--print) !important;
    font-weight: 500;
  }

  /* boundary: a two-line callout */
  .end {
    margin-top: clamp(48px, 5vw, 80px);
    max-width: 62ch;
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.45;
    color: var(--ash);
  }
  .end-h {
    color: var(--print);
    font-weight: 500;
  }
  .end a:not(.lnk) {
    color: var(--print);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .end-k {
    display: inline-flex;
    margin-left: 6px;
    color: var(--print);
    font-size: 18px;
  }

  @media (max-width: 900px) {
    .ms {
      display: block;
    }
    .ms-chs {
      padding: 0 var(--in);
    }
    .ms-stage {
      display: none;
    }
    .ch,
    .ch.on {
      min-height: 0;
      color: var(--print);
      padding: 0 0 44px;
    }
    .ch .ch-n {
      color: var(--flare);
    }
    .ch-shot {
      display: block;
      margin: 18px 0 0;
    }
    .ch-shot img {
      width: 100%;
    }
    .ch-shot figcaption {
      margin-top: 10px;
      font-size: 15px;
      color: var(--ash);
    }
    .dt summary {
      grid-template-columns: 1fr 44px;
    }
    .dt-s {
      grid-column: 1;
      grid-row: 2;
      font-size: 16px;
    }
    .dt-i {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .dt-b {
      grid-template-columns: 1fr;
    }
    .end-k {
      display: flex;
      margin: 14px 0 0;
    }
  }
</style>
