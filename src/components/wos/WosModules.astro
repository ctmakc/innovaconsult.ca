---
// Five modules on bone, one sentence each. Desktop: the module names scroll on the left while one
// big sticky screen on the right swaps to the module being read (instant swap, never blank).
// Phones: each module carries its own screen inline. The factor lists, patterns, levels and the six
// questions sit in two collapsed <details> blocks below, for the reader who wants them.
import { MODULES, QA, RISK, type Shot } from './data';

const zoomStyle = (s: Shot) => (s.zoom ? `--zs:${s.zoom.s};--zx:${s.zoom.ox};--zy:${s.zoom.oy}` : undefined);
const score = MODULES.find((m) => m.formula)!;
const design = MODULES.find((m) => m.patterns)!;
const impl = MODULES.find((m) => m.phases)!;
---

<section class="mods tone-bone" aria-labelledby="mods-h">
  <div class="shell">
    <div class="inset">
      <div class="mods-hd">
        <h2 id="mods-h" class="t-display" data-rise>Five modules.</h2>
        <p class="t-lede mods-lede">Each module hands its output to the next. Risk controls run through all five.</p>
      </div>

      <div class="ms">
        <ol class="ms-chs">
          {
            MODULES.map((m, i) => (
              <li class="ch" id={`module-${i + 1}`} data-ch={i}>
                <p class="ch-k t-label tnum">
                  {i + 1} · {m.stations.join(' · ')}
                </p>
                <h3 class="ch-h">{m.name}</h3>
                <p class="ch-l">{m.line}</p>
                <figure class="ch-shot">
                  <div class:list={['ch-img', { 'is-zoom': !!m.shot.zoom }]} style={zoomStyle(m.shot)}>
                    <img
                      class="scr-img"
                      src={m.shot.src800}
                      srcset={`${m.shot.src800} 800w, ${m.shot.src} 1600w`}
                      sizes="92vw"
                      width={m.shot.w}
                      height={m.shot.h}
                      alt={m.shot.alt}
                      loading={i === 0 ? undefined : 'lazy'}
                      decoding="async"
                    />
                  </div>
                  <figcaption>{m.shot.caption}</figcaption>
                </figure>
              </li>
            ))
          }
        </ol>

        <div class="ms-stage" aria-hidden="true">
          <div class="ms-sticky">
            <div class="stack">
              {
                MODULES.map((m, i) => (
                  <div class:list={['stk', { on: i === 0, 'is-zoom': !!m.shot.zoom }]} data-shot={i} style={zoomStyle(m.shot)}>
                    <img
                      class="scr-img"
                      src={m.shot.src}
                      srcset={`${m.shot.src800} 800w, ${m.shot.src} 1600w`}
                      sizes="(max-width: 1440px) 62vw, 900px"
                      width={m.shot.w}
                      height={m.shot.h}
                      alt=""
                      decoding="async"
                    />
                  </div>
                ))
              }
            </div>
            <div class="caps">
              {MODULES.map((m, i) => <p class:list={{ on: i === 0 }} data-cap={i}>{m.shot.caption}</p>)}
            </div>
          </div>
        </div>
      </div>

      <div class="more">
        <details class="dt">
          <summary>
            <span class="dt-h">How the score works</span>
            <span class="dt-s">Factors, patterns, control levels and delivery phases</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <div class="dt-b">
            <div class="dt-c dt-wide">
              <h4>Priority score</h4>
              <p class="fx tnum">Priority = {score.formula!.join(' ')}</p>
            </div>
            {
              score.groups!.map((g) => (
                <div class="dt-c">
                  <h4>
                    {g.label} <span class="tnum">({g.items.length})</span>
                  </h4>
                  <p>{g.items.join(', ')}.</p>
                </div>
              ))
            }
            <div class="dt-c">
              <h4>Six patterns</h4>
              <p>{design.patterns!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five levels of human control</h4>
              <p>{design.levels!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five delivery phases</h4>
              <p>{impl.phases!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Risk and governance, in every module</h4>
              <p>{RISK.join(', ')}.</p>
            </div>
          </div>
        </details>

        <details class="dt">
          <summary>
            <span class="dt-h">Six questions it answers</span>
            <span class="dt-s">From the company’s own process data</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <dl class="dt-b dt-qa">
            {
              QA.map((x) => (
                <div class="dt-c">
                  <dt>{x.q}</dt>
                  <dd>
                    {x.a} <a class="lnk" href={`#module-${x.m}`}>Module {x.m} <span class="ar" aria-hidden="true">↑</span></a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </details>
      </div>
    </div>
  </div>
</section>

<script>
  // The module crossing the middle of the screen picks the screen and caption. Instant swap.
  const chs = document.querySelectorAll<HTMLElement>('[data-ch]');
  const groups = ['[data-shot]', '[data-cap]'].map((q) => document.querySelectorAll<HTMLElement>(q));
  const set = (i: number) => {
    groups.forEach((g) => g.forEach((el, j) => el.classList.toggle('on', j === i)));
    chs.forEach((c, j) => c.classList.toggle('on', j === i));
  };
  let raf = 0;
  let cur = -1;
  const pick = () => {
    raf = 0;
    const mid = window.innerHeight * 0.55;
    let i = 0;
    chs.forEach((c, j) => {
      if (c.getBoundingClientRect().top < mid) i = j;
    });
    if (i !== cur) set((cur = i));
  };
  if (chs.length) {
    window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(pick)), { passive: true });
    window.addEventListener('resize', () => (raf ||= requestAnimationFrame(pick)));
    pick();
  }
</script>

<style>
  .mods {
    padding-block: calc(var(--sec) * 0.8);
  }
  .mods-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 18px;
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 64px);
  }
  .mods-hd .t-display {
    grid-column: 1 / span 7;
  }
  .mods-lede {
    grid-column: 9 / span 4;
    color: var(--ink-soft);
  }

  .ms {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
  }
  .ms-chs {
    grid-column: 1 / span 4;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ch {
    min-height: 46vh;
    padding: 22px 0 40px;
    border-top: 1px solid var(--rule-ink);
    color: var(--ink-soft);
    transition: color var(--t-micro) var(--e-out);
  }
  .ch:last-child {
    min-height: 0;
  }
  .ch.on {
    color: var(--ink);
    border-top: 2px solid var(--ink);
    padding-top: 21px;
  }
  .ch.on .ch-k {
    color: var(--flare-ink);
  }
  .ch-h {
    margin-top: 10px;
    font-size: clamp(26px, 2.3vw, 38px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .ch-l {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.5;
    max-width: 38ch;
  }
  .ch-shot {
    display: none;
  }

  .ms-stage {
    grid-column: 5 / -1;
    padding-left: clamp(0px, 2vw, 32px);
  }
  .ms-sticky {
    position: sticky;
    top: calc(var(--hdr) + 28px);
  }
  .stack {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .stk {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--r);
    visibility: hidden;
    box-shadow: var(--shadow-screen-bone);
  }
  .stk.on {
    visibility: visible;
  }
  .stk img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    box-shadow: none;
  }
  .is-zoom img {
    transform: scale(var(--zs));
    transform-origin: var(--zx) var(--zy);
  }
  .caps {
    position: relative;
    margin-top: 14px;
    min-height: 3em;
  }
  .caps p {
    position: absolute;
    inset: 0 auto auto 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-soft);
    visibility: hidden;
  }
  .caps p.on {
    visibility: visible;
  }

  /* collapsed detail */
  .more {
    display: grid;
    gap: 12px;
    margin-top: clamp(40px, 4.4vw, 72px);
  }
  .dt {
    border-top: 1px solid var(--rule-ink);
  }
  .dt summary {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 44px;
    align-items: center;
    gap: 8px var(--col-gap);
    min-height: 64px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }
  .dt summary::-webkit-details-marker {
    display: none;
  }
  .dt-h {
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.022em;
  }
  .dt-s {
    color: var(--ink-soft);
    font-size: 16px;
  }
  .dt-i {
    justify-self: end;
    position: relative;
    width: 18px;
    height: 18px;
  }
  .dt-i::before,
  .dt-i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--e-out);
  }
  .dt-i::after {
    transform: rotate(90deg);
  }
  .dt[open] .dt-i::after {
    transform: rotate(0);
  }
  .dt-b {
    margin: 0;
    padding: 8px 0 36px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px var(--col-gap);
  }
  .dt-c h4,
  .dt-c dt {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .dt-c p,
  .dt-c dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .dt-wide {
    grid-column: 1 / -1;
  }
  .fx {
    font-size: clamp(20px, 1.6vw, 26px) !important;
    color: var(--ink) !important;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .mods-hd .t-display,
    .mods-lede {
      grid-column: 1 / -1;
    }
    .ms {
      display: block;
    }
    .ms-stage {
      display: none;
    }
    .ch,
    .ch.on {
      min-height: 0;
      color: var(--ink);
      border-top: 1px solid var(--rule-ink);
      padding: 20px 0 32px;
    }
    .ch-shot {
      display: block;
      margin: 18px 0 0;
    }
    .ch-img {
      overflow: hidden;
      border-radius: var(--r);
      aspect-ratio: 16 / 10;
      box-shadow: var(--shadow-screen-bone);
    }
    .ch-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 0 0;
      box-shadow: none;
    }
    .ch-shot figcaption {
      margin-top: 10px;
      font-size: 15px;
      color: var(--ink-soft);
    }
    .dt summary {
      grid-template-columns: 1fr 44px;
    }
    .dt-s {
      grid-column: 1;
      grid-row: 2;
    }
    .dt-i {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .dt-b {
      grid-template-columns: 1fr;
    }
  }
</style>
