---
// Five modules (round 5): ONE dark stage. A five-step rail on the left (Discover · Score · Design ·
// Deliver · Impact) and ONE framed 2x crop of the Workflow OS UI v2 on the right (about 8 of 12
// columns); a step swaps the screen instantly. Each crop is one region cut on panel boundaries
// (src/data/wos3.ts), shown at 1 to 1.15x its natural CSS size, so UI text reads at 13 px or more.
// No coloured plates, no numerals, no app buttons in the crops. Phones: each step shows the app's
// own 390 px layout of the same panel under its text, full width. Factor lists, patterns, levels,
// phases, the technology and the data/AI note live in two collapsed <details>.
import { MODULES, QA, RISK, TECHNOLOGY } from './data';
import { WOS3 } from '../../data/wos3';

const STEPS = [
  { k: 'Discover', d: WOS3.discovery, m: WOS3.m_discovery },
  { k: 'Score', d: WOS3.score, m: WOS3.m_score },
  { k: 'Design', d: WOS3.route, m: WOS3.m_route },
  { k: 'Deliver', d: WOS3.plan, m: WOS3.m_plan },
  { k: 'Impact', d: WOS3.impact, m: WOS3.m_impact }
].map((x, i) => ({ ...x, mod: MODULES[i] }));
const score = MODULES.find((m) => m.formula)!;
const design = MODULES.find((m) => m.patterns)!;
const impl = MODULES.find((m) => m.phases)!;
---

<section class="mods" aria-labelledby="mods-h">
  <div class="shell">
    <div class="inset mods-hd">
      <h2 id="mods-h" class="t-display" data-rise>Five modules.</h2>
      <p class="t-lede mods-lede">Each module hands its output to the next. Risk controls run through all five.</p>
      <p class="mods-note">Screens from the working prototype. The company in them is fictional and every number is illustrative.</p>
    </div>

    <div class="stg inset" data-stg>
      <ol class="stg-rail">
        {
          STEPS.map((x, i) => (
            <li class:list={['stg-step', { on: i === 0 }]} id={`module-${i + 1}`} data-step={i}>
              <button type="button" class="stg-b" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="stg-frame">
                <span class="stg-k">{x.k}</span>
                <span class="stg-n">{x.mod.name}</span>
                <span class="stg-l">{x.mod.line}</span>
              </button>
              <figure class="stg-m">
                <img
                  src={x.m.src}
                  srcset={x.m.srcset}
                  sizes="100vw"
                  alt={x.m.alt}
                  width={x.m.w}
                  height={x.m.h}
                  loading="lazy"
                  decoding="async"
                  style={`background-image:url(${x.m.lqip})`}
                />
              </figure>
            </li>
          ))
        }
      </ol>
      <figure class="stg-f" id="stg-frame">
        <div class="stg-box" role="region" aria-label="Workflow OS screen">
          {
            STEPS.map((x, i) => (
              <img
                class:list={['stg-img', { on: i === 0 }]}
                data-img={i}
                src={x.d.src}
                srcset={x.d.srcset}
                sizes={`(max-width: 900px) 1px, ${Math.round(x.d.w * 1.15)}px`}
                alt={x.d.alt}
                width={x.d.w}
                height={x.d.h}
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority="low"
                decoding="async"
                style={`--w:${x.d.w}px;background-image:url(${x.d.lqip})`}
              />
            ))
          }
        </div>
        <figcaption class="stg-cap">Demo data: Northstar Professional Services is a fictional 30-person firm, and every number is illustrative.</figcaption>
      </figure>
    </div>

    <div class="inset">
      <div class="more">
        <details class="dt">
          <summary>
            <span class="dt-h">How the score works</span>
            <span class="dt-s">Factors, patterns, control levels, delivery phases and the technology</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <div class="dt-b">
            <div class="dt-c dt-wide">
              <h4>Priority score</h4>
              <p class="fx tnum">Priority = {score.formula!.join(' ')}</p>
            </div>
            {
              score.groups!.map((g) => (
                <div class="dt-c">
                  <h4>
                    {g.label} <span class="tnum">({g.items.length})</span>
                  </h4>
                  <p>{g.items.join(', ')}.</p>
                </div>
              ))
            }
            <div class="dt-c">
              <h4>Six patterns</h4>
              <p>{design.patterns!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five levels of human control</h4>
              <p>{design.levels!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five delivery phases</h4>
              <p>{impl.phases!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Risk and governance, in every module</h4>
              <p>{RISK.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Technology</h4>
              <p>{TECHNOLOGY.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Data and AI</h4>
              <p>
                The demo runs on fictional data. Scoring, design and ROI are calculated without AI. Optional AI discovery sends the description you paste to an external AI model hosted outside Canada; when it is off or slow, a rules engine drafts the process model instead.
              </p>
            </div>
          </div>
        </details>

        <details class="dt">
          <summary>
            <span class="dt-h">Six questions it answers</span>
            <span class="dt-s">From the company’s own process data</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <dl class="dt-b dt-qa">
            {
              QA.map((x) => (
                <div class="dt-c">
                  <dt>{x.q}</dt>
                  <dd>
                    {x.a} <a class="lnk" href={`#module-${x.m}`}>Module {x.m} <span class="ar" aria-hidden="true">↑</span></a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </details>
      </div>


      <aside class="end" id="end" aria-label="Where Workflow OS ends">
        <p><strong>Workflow OS decides what to automate and how.</strong> The automations run in the client’s existing platforms or in INNOVA products such as <a href="/projects/aicrmius">AICRMIUS</a>, so the plan stays independent of any single vendor, including us.</p>
        <a class="lnk end-k" href="/ai-transformation">Our AI transformation method <span class="ar" aria-hidden="true">→</span></a>
      </aside>
    </div>
  </div>
</section>

<script>
  // A step picks the screen. Instant swap (visibility), so the frame is never blank.
  const stg = document.querySelector<HTMLElement>('[data-stg]');
  if (stg) {
    const steps = [...stg.querySelectorAll<HTMLElement>('[data-step]')];
    const imgs = [...stg.querySelectorAll<HTMLElement>('[data-img]')];
    const pick = (i: number) => {
      steps.forEach((s, j) => {
        s.classList.toggle('on', j === i);
        s.querySelector('button')?.setAttribute('aria-pressed', j === i ? 'true' : 'false');
      });
      imgs.forEach((m, j) => m.classList.toggle('on', j === i));
    };
    steps.forEach((s, i) => {
      const b = s.querySelector('button');
      b?.addEventListener('click', () => pick(i));
      b?.addEventListener('mouseenter', () => window.matchMedia('(hover: hover) and (min-width: 901px)').matches && pick(i));
    });
    // links to #module-n (the six questions) open that step
    const fromHash = () => {
      const m = /^#module-(\d)$/.exec(location.hash);
      if (m) pick(Number(m[1]) - 1);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  .mods {
    padding-block: calc(var(--sec) * 0.8) calc(var(--sec) * 0.5);
  }
  .mods-hd {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .mods-lede {
    margin-top: 18px;
    max-width: 40ch;
    color: var(--print);
  }
  .mods-note {
    margin-top: 12px;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
  }

  /* ── the stage ─────────────────────────────────────────────── */
  .stg {
    display: grid;
    grid-template-columns: minmax(280px, 4fr) minmax(0, 8fr);
    column-gap: clamp(28px, 3vw, 56px);
    align-items: start;
    padding-right: 0;
  }
  .stg-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .stg-b {
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 16px 0 16px 20px;
    border: 0;
    border-left: 2px solid var(--rule-film);
    background: none;
    color: var(--ash);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      color var(--t-micro) var(--e-out),
      border-color var(--t-micro) var(--e-out);
  }
  .stg-k {
    font-size: clamp(24px, 2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .stg-n {
    font-size: 15px;
    font-weight: 500;
  }
  .stg-l {
    display: none;
    margin-top: 6px;
    font-size: 17px;
    line-height: 1.45;
    color: var(--copy);
    max-width: 40ch;
  }
  .stg-step.on .stg-b,
  .stg-b:hover {
    color: var(--print);
  }
  .stg-step.on .stg-b {
    border-left-color: var(--print);
  }
  .stg-step.on .stg-l {
    display: block;
  }
  .stg-m {
    display: none;
    margin: 0;
  }
  .stg-f {
    position: sticky;
    top: calc(var(--hdr) + 24px);
    margin: 0;
  }
  .stg-box {
    position: relative;
    aspect-ratio: 16 / 8.4;
    border-radius: var(--r) 0 0 var(--r);
    background: var(--ui-dark);
    box-shadow: 0 0 0 1px var(--rule-film);
  }
  .stg-img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(calc(100% - 48px), calc(var(--w) * 1.15));
    height: auto;
    max-height: calc(100% - 48px);
    object-fit: contain;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    visibility: hidden;
  }
  .stg-img.on {
    visibility: visible;
  }
  .stg-cap {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ash);
    max-width: 64ch;
  }

  /* phones and tablets: every step shows its own screen, full width, under its text */
  @media (max-width: 900px) {
    .stg {
      display: block;
      padding-right: var(--in);
    }
    .stg-rail {
      gap: clamp(40px, 8vw, 56px);
    }
    .stg-b {
      padding: 0;
      border: 0;
      color: var(--print);
      cursor: default;
      pointer-events: none;
    }
    .stg-l {
      display: block;
    }
    .stg-m {
      display: block;
      margin: 18px calc(var(--in) * -1 - var(--gut)) 0;
      background: var(--ui-dark);
    }
    .stg-m img {
      width: 100%;
      background-size: 100% 100%;
    }
    .stg-f {
      position: static;
      margin-top: 24px;
    }
    .stg-box {
      display: none;
    }
  }

  /* collapsed detail */
  .more {
    display: grid;
    margin-top: clamp(48px, 5vw, 88px);
  }
  .dt {
    border-top: 1px solid var(--rule-film);
  }
  .dt:last-child {
    border-bottom: 1px solid var(--rule-film);
  }
  .dt summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    align-items: center;
    gap: 4px var(--col-gap);
    min-height: 72px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  .dt summary::-webkit-details-marker {
    display: none;
  }
  .dt-h {
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.022em;
  }
  .dt-s {
    grid-column: 1;
    grid-row: 2;
    color: var(--copy);
    font-size: 17px;
  }
  .dt-i {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: end;
    position: relative;
    width: 18px;
    height: 18px;
  }
  .dt-i::before,
  .dt-i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--e-out);
  }
  .dt-i::after {
    transform: rotate(90deg);
  }
  .dt[open] .dt-i::after {
    transform: rotate(0);
  }
  .dt-b {
    margin: 0;
    padding: 8px 0 40px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px var(--col-gap);
  }
  .dt-c h4,
  .dt-c dt {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .dt-c p,
  .dt-c dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
  }
  .dt-wide {
    grid-column: 1 / -1;
  }
  .fx {
    font-size: clamp(20px, 1.6vw, 26px) !important;
    color: var(--print) !important;
    font-weight: 500;
  }

  /* boundary: a two-line callout */
  .end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: clamp(40px, 4vw, 64px);
    padding: clamp(20px, 2.2vw, 32px);
    border-radius: var(--r);
    background: var(--reel);
  }
  .end p {
    max-width: 96ch;
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.5;
    color: var(--ash);
  }
  .end strong {
    color: var(--print);
    font-weight: 500;
  }
  .end p a {
    color: var(--print);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .end-k {
    color: var(--print);
    font-size: 18px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .dt summary {
      grid-template-columns: 1fr 44px;
    }
    .dt-s {
      grid-column: 1;
      grid-row: 2;
      font-size: 16px;
    }
    .dt-i {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .dt-b {
      grid-template-columns: 1fr;
    }
  }
</style>
