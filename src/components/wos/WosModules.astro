---
// Five modules on bone. Desktop: chapters scroll on the left while a sticky screen on the right
// swaps to the module being read (with a 5-tick index and the screen's caption).
// Phones: each chapter carries its own screen inline; the sticky stage is hidden.
import SectionHead from '../SectionHead.astro';
import { MODULES, type Shot } from './data';

const zoomStyle = (s: Shot) => (s.zoom ? `--zs:${s.zoom.s};--zx:${s.zoom.ox};--zy:${s.zoom.oy}` : undefined);
---

<section class="mods tone-bone" aria-labelledby="mods-h">
  <div class="shell">
    <div class="inset">
      <SectionHead id="mods-h" title="Five modules." lede="Each module hands its output to the next. Risk controls run through all five." />

      <div class="ms">
        <div class="ms-chs">
          {
            MODULES.map((m, i) => (
              <article class="ch" id={`module-${i + 1}`} data-ch={i} aria-labelledby={`module-${i + 1}-h`}>
                <p class="ch-k t-label">
                  <span class="tnum">Module {i + 1} of 5</span>
                  <span class="ch-st">{m.stations.join(' · ')}</span>
                </p>
                <h3 class="t-h3 ch-h" id={`module-${i + 1}-h`}>
                  {m.name}
                </h3>
                <p class="ch-l">{m.line}</p>

                <figure class="ch-shot">
                  <div class:list={['ch-img', { 'is-zoom': !!m.shot.zoom }]} style={zoomStyle(m.shot)}>
                    <img
                      class="scr-img"
                      src={m.shot.src800}
                      srcset={`${m.shot.src800} 800w, ${m.shot.src} 1600w`}
                      sizes="92vw"
                      width={m.shot.w}
                      height={m.shot.h}
                      alt={m.shot.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption>{m.shot.caption}</figcaption>
                </figure>

                {m.formula && (
                  <div class="fx">
                    <p class="fx-k t-label">Priority score</p>
                    <p class="fx-f">
                      <span class="fx-eq">Priority =</span>
                      {m.formula.map((t) => (
                        <span class="fx-t tnum">{t} </span>
                      ))}
                    </p>
                  </div>
                )}

                {m.groups && (
                  <div class="grp">
                    {m.groups.map((g) => (
                      <div class:list={['grp-c', { 'is-risk': g.label === 'Risk penalty' }]}>
                        <h4 class="grp-h">
                          {g.label} <span class="tnum">{g.items.length}</span>
                        </h4>
                        <ul>
                          {g.items.map((x) => (
                            <li>{x}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}

                {m.patterns && (
                  <div class="blk">
                    <h4 class="blk-h">Six patterns</h4>
                    <ul class="pat">
                      {m.patterns.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {m.levels && (
                  <div class="blk">
                    <h4 class="blk-h">Five levels of human control</h4>
                    <ol class="lvl">
                      {m.levels.map((x, k) => (
                        <li>
                          <span class="lvl-m" aria-hidden="true">
                            {[0, 1, 2, 3].map((j) => (
                              <i class:list={{ on: j < k }} />
                            ))}
                          </span>
                          <span>{x}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="lvl-note">The bar shows how much of the decision stays with a person.</p>
                  </div>
                )}

                {m.phases && (
                  <div class="blk">
                    <h4 class="blk-h">Five delivery phases</h4>
                    <ol class="ph">
                      {m.phases.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ol>
                  </div>
                )}

                {m.fields && (
                  <div class="blk">
                    <h4 class="blk-h">{m.phases ? 'Every task carries' : m.name === 'Process discovery' ? 'What it captures' : 'What it tracks'}</h4>
                    <ul class="fld" aria-label={`${m.name}: fields`}>
                      {m.fields.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))
          }
        </div>

        <div class="ms-stage" aria-hidden="true">
          <div class="ms-sticky">
            <div class="stack">
              {
                MODULES.map((m, i) => (
                  <div class:list={['stk', { on: i === 0, 'is-zoom': !!m.shot.zoom }]} data-shot={i} style={zoomStyle(m.shot)}>
                    <img
                      class="scr-img"
                      src={m.shot.src}
                      srcset={`${m.shot.src800} 800w, ${m.shot.src} 1600w`}
                      sizes="(max-width: 1440px) 60vw, 900px"
                      width={m.shot.w}
                      height={m.shot.h}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))
              }
            </div>
            <div class="ms-foot">
              <ol class="ticks">
                {
                  MODULES.map((m, i) => (
                    <li class:list={{ on: i === 0 }} data-tick={i}>
                      <a href={`#module-${i + 1}`} tabindex="-1">
                        <span class="tnum">{i + 1}</span>
                        <span class="tk-n">{m.name}</span>
                      </a>
                    </li>
                  ))
                }
              </ol>
              <div class="caps">
                {MODULES.map((m, i) => <p class:list={{ on: i === 0 }} data-cap={i}>{m.shot.caption}</p>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The chapter crossing the middle of the screen picks the screen, tick and caption.
  const chs = document.querySelectorAll<HTMLElement>('[data-ch]');
  const groups = ['[data-shot]', '[data-tick]', '[data-cap]'].map((q) => document.querySelectorAll<HTMLElement>(q));
  const set = (i: number) => groups.forEach((g) => g.forEach((el, j) => el.classList.toggle('on', j === i)));
  // Active = the last chapter whose top has passed the middle of the screen (first one by default).
  let raf = 0;
  let cur = -1;
  const pick = () => {
    raf = 0;
    const mid = window.innerHeight * 0.5;
    let i = 0;
    chs.forEach((c, j) => {
      if (c.getBoundingClientRect().top < mid) i = j;
    });
    if (i !== cur) set((cur = i));
  };
  if (chs.length) {
    window.addEventListener('scroll', () => (raf ||= requestAnimationFrame(pick)), { passive: true });
    window.addEventListener('resize', () => (raf ||= requestAnimationFrame(pick)));
    pick();
  }
</script>

<style>
  .mods {
    padding-block: var(--sec);
  }
  .ms {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: start;
  }
  .ms-chs {
    grid-column: 1 / span 5;
  }
  .ms-stage {
    grid-column: 6 / span 7;
    padding-left: clamp(0px, 2.4vw, 40px);
    align-self: stretch;
    margin-right: calc(var(--in) * -1);
  }
  .ms-sticky {
    position: sticky;
    top: calc(var(--hdr) + 40px);
  }

  /* chapters */
  .ch {
    min-height: 74vh;
    padding-block: clamp(40px, 6vh, 72px);
    scroll-margin-top: calc(var(--hdr) + 24px);
    border-top: 1px solid var(--rule-ink);
  }
  .ch:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .ch:last-child {
    min-height: 0;
    padding-bottom: 0;
  }
  .ch-k {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    color: var(--ink-soft);
  }
  .ch-st {
    color: var(--ink);
  }
  .ch-h {
    margin-top: 16px;
  }
  .ch-l {
    margin-top: 20px;
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.45;
    max-width: 42ch;
  }

  /* inline screen: phones only */
  .ch-shot {
    display: none;
    margin: 28px 0 0;
  }
  .ch-img {
    aspect-ratio: 16 / 10;
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow-screen-bone);
  }
  .ch-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    box-shadow: none;
    border-radius: 0;
  }
  .is-zoom img {
    transform: scale(var(--zs));
    transform-origin: var(--zx) var(--zy);
  }
  .ch-shot figcaption {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* formula: the priority score set in display type */
  .fx {
    margin-top: 36px;
    padding: 26px 28px 30px;
    background: var(--ink);
    color: var(--print);
    border-radius: var(--r);
  }
  .fx-k {
    color: var(--ash);
  }
  .fx-f {
    display: grid;
    margin-top: 14px;
    font-size: clamp(28px, 2.5vw, 42px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .fx-eq {
    color: var(--ash);
  }
  .fx-t:last-child {
    color: var(--flare-hi);
  }

  /* factor groups */
  .grp {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px var(--col-gap);
  }
  .grp-h,
  .blk-h {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
  }
  .grp-h .tnum {
    color: var(--ink-soft);
    font-weight: 500;
  }
  .grp ul,
  .pat,
  .fld {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: 18px;
    line-height: 1.4;
  }
  .grp-c.is-risk ul {
    color: var(--ink-soft);
  }
  .grp-c.is-risk li::before {
    content: '− ';
  }
  .blk {
    margin-top: 34px;
  }
  .pat {
    font-size: clamp(19px, 1.45vw, 23px);
    font-weight: 500;
    letter-spacing: -0.015em;
    gap: 6px;
  }
  .fld {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 6px;
  }

  /* levels of human control: a 4-step meter, empty = fully automated, full = human only */
  .lvl {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 18px;
    line-height: 1.3;
  }
  .lvl li {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 16px;
    align-items: center;
  }
  .lvl-m {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
  }
  .lvl-m i {
    height: 10px;
    border-radius: 2px;
    border: 1.5px solid var(--ink);
  }
  .lvl-m i.on {
    background: var(--ink);
  }
  .lvl-note {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-soft);
  }

  /* delivery phases: big words in a row */
  .ph {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    font-size: clamp(24px, 2.1vw, 34px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .ph li:not(:last-child)::after {
    content: '→';
    margin-inline: 0.32em;
    color: var(--ink-soft);
    font-weight: 400;
  }

  /* sticky stage */
  .stack {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .stk {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow-screen-bone);
    opacity: 0;
    transform: translateY(24px) scale(0.975);
    transition:
      opacity 0.55s var(--e-out),
      transform 0.8s var(--e-out);
  }
  .stk.on {
    opacity: 1;
    transform: none;
  }
  .stk img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    box-shadow: none;
    border-radius: 0;
  }
  .stk.is-zoom img {
    transition: transform 1.2s var(--e-out);
  }
  .stk.is-zoom:not(.on) img {
    transform: scale(1);
  }
  .ms-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px var(--col-gap);
    margin-top: 22px;
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .ticks a {
    display: flex;
    gap: 12px;
    padding: 2px 0;
    font-size: 15px;
    line-height: 1.35;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.35s var(--e-out);
  }
  .ticks .tnum {
    width: 12px;
  }
  .ticks li.on a {
    color: var(--ink);
    font-weight: 600;
  }
  .ticks a:hover {
    color: var(--ink);
  }
  .caps {
    display: grid;
  }
  .caps p {
    grid-area: 1 / 1;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-soft);
    opacity: 0;
    transition: opacity 0.4s var(--e-out);
  }
  .caps p.on {
    opacity: 1;
  }

  @media (max-width: 1100px) {
    .ms-chs {
      grid-column: 1 / span 6;
    }
    .ms-stage {
      grid-column: 7 / span 6;
    }
    .ms-foot {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .ms {
      display: block;
    }
    .ms-stage {
      display: none;
    }
    .ch-shot {
      display: block;
    }
    .ch {
      min-height: 0;
      padding-block: 48px;
    }
    .ch:first-child {
      padding-top: 8px;
    }
    .fx {
      padding: 22px 20px 24px;
    }
  }
  @media (max-width: 520px) {
    .grp {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }
    .grp ul,
    .fld {
      font-size: 17px;
    }
    .fld {
      column-gap: 16px;
    }
  }
</style>
