---
// Five modules (round 4): ONE signature section, a sticky deck. Each module is a card in its own
// material with a real Workflow OS UI v2 crop on it at (or above) its natural size, so the UI text
// reads at 12-14 css px. On desktop the cards stick and stack; the card underneath recedes as the
// next one slides over it (transform + overlay only). Tablets and phones get the app's own 390px
// layout of the same panel as a 2x crop. Factor lists, patterns, levels, phases, the technology and
// the data/AI note live in two collapsed <details>; the product boundary is a two-line callout.
import { MODULES, QA, RISK, TECHNOLOGY } from './data';

const MAT = ['var(--m-evergreen)', 'var(--m-navy)', 'var(--m-loam)', 'var(--m-evergreen)', 'var(--m-navy)'];
const score = MODULES.find((m) => m.formula)!;
const design = MODULES.find((m) => m.patterns)!;
const impl = MODULES.find((m) => m.phases)!;
---

<section class="mods" aria-labelledby="mods-h">
  <div class="shell">
    <div class="inset mods-hd">
      <h2 id="mods-h" class="t-display" data-rise>Five modules.</h2>
      <p class="t-lede mods-lede">Each module hands its output to the next. Risk controls run through all five.</p>
      <p class="mods-note">Screens from the working prototype. The company in them is fictional and every number is illustrative.</p>
    </div>

    <ol class="deck" data-deck>
      {
        MODULES.map((m, i) => (
          <li class="card" id={`module-${i + 1}`} style={`--i:${i};--mat:${MAT[i]}`} data-card>
            <div class="card-hd">
              <h3 class="card-h">
                <span class="card-n tnum" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {m.name}
              </h3>
              <p class="card-l">{m.line}</p>
            </div>
            <figure class="card-scr">
              <picture>
                {m.shot.m && <source media="(max-width: 999px)" srcset={`${m.shot.m.src} 764w`} sizes="(max-width: 760px) 92vw, 420px" width={m.shot.m.w} height={m.shot.m.h} />}
                <img
                  class="scr-dark"
                  src={m.shot.src2x}
                  srcset={`${m.shot.src} ${m.shot.w}w, ${m.shot.src2x} ${m.shot.w * 2}w`}
                  sizes={`(min-width: 1400px) ${Math.round(m.shot.w * 1.25)}px, ${m.shot.w}px`}
                  width={m.shot.w}
                  height={m.shot.h}
                  alt={m.shot.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </figure>
          </li>
        ))
      }
    </ol>

    <div class="inset">
      <div class="more">
        <details class="dt">
          <summary>
            <span class="dt-h">How the score works</span>
            <span class="dt-s">Factors, patterns, control levels, delivery phases and the technology</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <div class="dt-b">
            <div class="dt-c dt-wide">
              <h4>Priority score</h4>
              <p class="fx tnum">Priority = {score.formula!.join(' ')}</p>
            </div>
            {
              score.groups!.map((g) => (
                <div class="dt-c">
                  <h4>
                    {g.label} <span class="tnum">({g.items.length})</span>
                  </h4>
                  <p>{g.items.join(', ')}.</p>
                </div>
              ))
            }
            <div class="dt-c">
              <h4>Six patterns</h4>
              <p>{design.patterns!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five levels of human control</h4>
              <p>{design.levels!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Five delivery phases</h4>
              <p>{impl.phases!.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Risk and governance, in every module</h4>
              <p>{RISK.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Technology</h4>
              <p>{TECHNOLOGY.join(', ')}.</p>
            </div>
            <div class="dt-c">
              <h4>Data and AI</h4>
              <p>
                The demo runs on fictional data. Scoring, design and ROI are calculated without AI. Optional AI discovery sends the description you paste to an external AI model hosted outside Canada; when it is off or slow, a rules engine drafts the process model instead.
              </p>
            </div>
          </div>
        </details>

        <details class="dt">
          <summary>
            <span class="dt-h">Six questions it answers</span>
            <span class="dt-s">From the company’s own process data</span>
            <span class="dt-i" aria-hidden="true"></span>
          </summary>
          <dl class="dt-b dt-qa">
            {
              QA.map((x) => (
                <div class="dt-c">
                  <dt>{x.q}</dt>
                  <dd>
                    {x.a} <a class="lnk" href={`#module-${x.m}`}>Module {x.m} <span class="ar" aria-hidden="true">↑</span></a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </details>
      </div>


      <aside class="end" id="end" aria-label="Where Workflow OS ends">
        <p><strong>Workflow OS decides what to automate and how.</strong> The automations run in the client’s existing platforms or in INNOVA products such as <a href="/projects/aicrmius">AICRMIUS</a>, so the plan stays independent of any single vendor, including us.</p>
        <a class="lnk end-k" href="/ai-transformation">Our AI transformation method <span class="ar" aria-hidden="true">→</span></a>
      </aside>
    </div>
  </div>
</section>

<script>
  // The card underneath recedes while the next one slides over it: --p 0→1 drives scale + overlay.
  // Runs only where the deck is sticky (same media query as the CSS) and motion is allowed.
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  const mq = window.matchMedia('(min-width: 1000px) and (min-height: 700px) and (prefers-reduced-motion: no-preference)');
  if (deck) {
    const cards = Array.from(deck.querySelectorAll<HTMLElement>('[data-card]'));
    const scrs = Array.from(deck.querySelectorAll<HTMLElement>('.card-scr'));
    let raf = 0;
    const tick = () => {
      raf = 0;
      if (!mq.matches) {
        cards.forEach((c) => c.style.removeProperty('--p'));
        scrs.forEach((f) => {
          f.classList.remove('is-cut');
          f.style.removeProperty('max-width');
        });
        return;
      }
      const vh = window.innerHeight;
      // Fit each screen to the card height: as wide as the card allows, never below its natural
      // size (the UI text stays >= 11.5 css px); a crop that still does not fit is cut and faded.
      scrs.forEach((f) => {
        const img = f.querySelector('img');
        const card = f.parentElement;
        if (!img || !card) return;
        const w = Number(img.getAttribute('width')) || 0;
        const h = Number(img.getAttribute('height')) || 1;
        const cs = getComputedStyle(card);
        const hd = card.firstElementChild as HTMLElement | null;
        const avail = card.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom) - (hd ? hd.offsetHeight : 0) - parseFloat(cs.rowGap || '0');
        const full = card.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        const fit = Math.max(w, Math.min(full, (avail * w) / h, w * 1.25));
        f.style.maxWidth = `${Math.floor(fit)}px`;
        f.classList.toggle('is-cut', (fit * h) / w > avail + 1);
      });
      for (let i = 0; i < cards.length - 1; i++) {
        const next = cards[i + 1];
        const stick = parseFloat(getComputedStyle(next).top) || 0;
        const t = next.getBoundingClientRect().top;
        const p = Math.min(1, Math.max(0, (vh - t) / (vh - stick)));
        cards[i].style.setProperty('--p', p.toFixed(3));
      }
    };
    const req = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', req);
    deck.querySelectorAll('img').forEach((im) => im.addEventListener('load', req));
    mq.addEventListener('change', req);
    tick();
  }
</script>

<style>
  .mods {
    padding-block: calc(var(--sec) * 0.8) calc(var(--sec) * 0.5);
  }
  .mods-hd {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .mods-lede {
    margin-top: 18px;
    max-width: 40ch;
    color: var(--print);
  }
  .mods-note {
    margin-top: 12px;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
  }

  /* ── the deck ─────────────────────────────────────────────── */
  .deck {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(18px, 2vw, 28px);
    border-radius: var(--r);
    background: var(--mat);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
    color: var(--print);
  }
  .card-h {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(26px, 2.5vw, 40px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .card-n {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--flare-hi); /* 4.6:1 on evergreen, the darkest pairing */
  }
  .card-l {
    margin-top: 10px;
    max-width: 74ch;
    font-size: 18px;
    line-height: 1.5;
    color: var(--print);
  }
  .card-scr {
    position: relative;
    margin: 0;
    min-height: 0;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--ui-dark);
    box-shadow: 0 0 0 1px var(--rule-film);
  }
  .card-scr img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1000px) and (min-height: 700px) {
    .deck {
      gap: 0;
      padding-bottom: 8vh;
    }
    .card {
      position: sticky;
      top: calc(var(--hdr) + 12px + var(--i) * 12px);
      height: min(calc(100svh - var(--hdr) - 24px - 48px), 860px);
      transform-origin: 50% 0;
    }
    .card + .card {
      margin-top: 22vh;
    }
    /* nothing slides over the last card, so it hugs its (short) impact crop instead of leaving an empty band */
    .card:last-child {
      height: auto;
    }
    /* the screen keeps its natural height; a crop taller than the card is cut and faded (.is-cut) */
    .card-scr {
      flex: 0 1 auto;
      width: 100%;
    }
    .card-scr.is-cut {
      mask-image: linear-gradient(to bottom, black calc(100% - 44px), transparent);
    }
    @media (prefers-reduced-motion: no-preference) {
      .card {
        transform: scale(calc(1 - var(--p, 0) * 0.05));
      }
      .card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--film);
        opacity: calc(var(--p, 0) * 0.6);
        pointer-events: none;
      }
    }
  }

  /* tablets: the text beside the phone-layout crop */
  @media (min-width: 761px) and (max-width: 999px) {
    .card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
      align-items: start;
      gap: 28px;
    }
  }
  @media (max-width: 760px) {
    .card {
      gap: 16px;
      padding: 18px 14px 0;
      overflow: hidden;
    }
    /* the phone crop bleeds to the card edges so its UI text keeps ~0.96 of its size */
    .card-scr {
      margin-inline: -14px;
      border-radius: 0;
      box-shadow: none;
    }
    .card-h {
      font-size: 28px;
    }
    .card-l {
      font-size: 17px;
    }
  }

  /* collapsed detail */
  .more {
    display: grid;
    margin-top: clamp(48px, 5vw, 88px);
  }
  .dt {
    border-top: 1px solid var(--rule-film);
  }
  .dt:last-child {
    border-bottom: 1px solid var(--rule-film);
  }
  .dt summary {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 44px;
    align-items: center;
    gap: 8px var(--col-gap);
    min-height: 72px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  .dt summary::-webkit-details-marker {
    display: none;
  }
  .dt-h {
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.022em;
  }
  .dt-s {
    color: var(--ash);
    font-size: 17px;
  }
  .dt-i {
    justify-self: end;
    position: relative;
    width: 18px;
    height: 18px;
  }
  .dt-i::before,
  .dt-i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--e-out);
  }
  .dt-i::after {
    transform: rotate(90deg);
  }
  .dt[open] .dt-i::after {
    transform: rotate(0);
  }
  .dt-b {
    margin: 0;
    padding: 8px 0 40px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px var(--col-gap);
  }
  .dt-c h4,
  .dt-c dt {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .dt-c p,
  .dt-c dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
  }
  .dt-wide {
    grid-column: 1 / -1;
  }
  .fx {
    font-size: clamp(20px, 1.6vw, 26px) !important;
    color: var(--print) !important;
    font-weight: 500;
  }

  /* boundary: a two-line callout */
  .end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: clamp(40px, 4vw, 64px);
    padding: clamp(20px, 2.2vw, 32px);
    border-radius: var(--r);
    background: var(--reel);
  }
  .end p {
    max-width: 96ch;
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.5;
    color: var(--ash);
  }
  .end strong {
    color: var(--print);
    font-weight: 500;
  }
  .end p a {
    color: var(--print);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .end-k {
    color: var(--print);
    font-size: 18px;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .dt summary {
      grid-template-columns: 1fr 44px;
    }
    .dt-s {
      grid-column: 1;
      grid-row: 2;
      font-size: 16px;
    }
    .dt-i {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .dt-b {
      grid-template-columns: 1fr;
    }
  }
</style>
