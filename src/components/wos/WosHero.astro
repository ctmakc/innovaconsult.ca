---
// /workflow-os hero: a bone frame (the product's light exhibit wall), the giant fitted name in ink,
// and the real product screens rising out of the bottom edge. The screens carry .mf-scr + data-depth,
// so the shared depth dolly (motion.ts, [data-dolly]) moves them at different depths on scroll.
import FitText from '../FitText.astro';
import Button from '../Button.astro';
import StatusTag from '../StatusTag.astro';
import { SHOTS } from './data';
---

<section class="wh shell" aria-labelledby="wos-h1" data-hero>
  <div class="wh-f frame" data-dolly>
    <p class="wh-top t-label">
      <span class="wh-crumb"><a href="/">INNOVA</a><span aria-hidden="true">/</span><span>Workflow OS</span></span>
      <StatusTag status="prototype" label="Working prototype" />
    </p>

    <FitText as="h1" id="wos-h1" class="wh-h" text="INNOVA AI Workflow OS" lines={['Workflow OS']} mobileLines={['Workflow', 'OS']} />

    <div class="wh-body">
      <div class="wh-copy">
        <p class="wh-lede">From business processes to measurable AI automation.</p>
        <p class="wh-fit">Invite-only demo online since 1 October 2026. Built for firms of 20 to 200 people.</p>
        <Button href="/contact?topic=workflow-os" class="wh-cta">Request a demo invite</Button>
        <p class="wh-sub">You receive a personal link to the working prototype, preloaded with Northstar Professional Services, a fictional 30-person firm. All data shown is illustrative. The walkthrough takes about two minutes.</p>
      </div>

      <div class="wh-stage">
        <div class="mf-scr wh-s1" data-depth="0.7">
          <img
            class="scr-img"
            src={SHOTS.overview.src}
            srcset={`${SHOTS.overview.src800} 800w, ${SHOTS.overview.src} 1600w, ${SHOTS.overview.src2000} 2000w`}
            sizes="(max-width: 900px) 92vw, 62vw"
            width={SHOTS.overview.w}
            height={SHOTS.overview.h}
            alt={SHOTS.overview.alt}
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .wh-f {
    --pad: clamp(18px, 2.6vw, 40px);
    height: calc(100svh - var(--hdr) - var(--gut));
    min-height: 640px;
    max-height: 1040px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    padding: clamp(18px, 2.4vw, 34px) var(--pad) 0;
    background: var(--bone);
    color: var(--ink);
  }
  .wh-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
  }
  .wh-crumb {
    display: inline-flex;
    gap: 10px;
    color: var(--ink-soft);
  }
  .wh-crumb a {
    color: var(--ink);
    text-decoration: none;
  }
  .wh-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .wh-h {
    margin: clamp(14px, 2vw, 30px) 0 0;
    margin-left: -0.04em;
  }
  .wh-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    min-height: 0;
    padding-top: clamp(24px, 2.8vw, 44px);
  }
  .wh-copy {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .wh-lede {
    font-size: clamp(24px, 2.2vw, 36px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 15ch;
  }
  .wh-fit {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .wh-copy :global(.wh-cta) {
    margin-top: 26px;
  }
  .wh-sub {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 38ch;
  }

  /* the screens rise out of the frame's bottom edge (the frame crops them) */
  .wh-stage {
    grid-column: 5 / -1;
    position: relative;
    min-height: 0;
    margin-right: calc(var(--pad) * -1);
  }
  .wh-s1 {
    position: absolute;
    left: 2%;
    top: 0;
    width: 94%;
    z-index: 1;
  }
  .wh-s2 {
    position: absolute;
    right: 3%;
    top: 46%;
    width: 42%;
    z-index: 2;
  }
  .wh-stage .scr-img {
    width: 100%;
    box-shadow: var(--shadow-screen-bone);
  }
  .wh-s2 .scr-img {
    box-shadow:
      0 50px 90px -30px color-mix(in srgb, var(--ink) 70%, transparent),
      0 0 0 1px color-mix(in srgb, var(--ink) 18%, transparent);
  }

  /* entrance: CSS only, done by about 1 s */
  @media (prefers-reduced-motion: no-preference) {
    .wh-f {
      animation: wh-gate 0.95s var(--e-gate) both;
    }
    .wh-s1 > img {
      animation: wh-up 1.05s var(--e-out) 0.1s both;
    }
    .wh-top,
    .wh-copy {
      animation: wh-in 0.7s var(--e-out) 0.4s both;
    }
  }
  @keyframes wh-gate {
    from {
      clip-path: inset(5% 3% 5% 3% round 6px);
    }
    to {
      clip-path: inset(0 0 0 0 round 6px);
    }
  }
  @keyframes wh-rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }
  @keyframes wh-up {
    from {
      transform: translateY(90px);
    }
    to {
      transform: none;
    }
  }
  @keyframes wh-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1100px) {
    .wh-copy {
      grid-column: 1 / span 5;
    }
    .wh-stage {
      grid-column: 6 / span 7;
    }
  }
  @media (max-width: 900px) {
    .wh-f {
      height: auto;
      min-height: 0;
      max-height: none;
      grid-template-rows: auto auto auto;
    }
    .wh-body {
      display: flex;
      flex-direction: column;
      padding-top: 22px;
    }
    .wh-lede {
      max-width: 18ch;
    }
    .wh-stage {
      margin-top: 36px;
      margin-left: calc(var(--pad) * -1);
      aspect-ratio: 4 / 3;
    }
    .wh-s1 {
      left: var(--pad);
      top: 0;
      width: 112%;
    }
    .wh-s2 {
      left: auto;
      right: var(--pad);
      top: 40%;
      width: 58%;
    }
  }
</style>
