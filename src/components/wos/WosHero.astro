---
// /workflow-os hero: a bone frame (the product's light exhibit wall), the giant fitted name in ink,
// and the process landscape (the only Overview screen on the site) rising out of the bottom edge at
// its natural size, so the UI text stays readable; the frame crops whatever does not fit. The screens carry .mf-scr + data-depth,
// so the shared depth dolly (motion.ts, [data-dolly]) moves them at different depths on scroll.
import FitText from '../FitText.astro';
import Button from '../Button.astro';
import StatusTag from '../StatusTag.astro';
import { SHOTS } from './data';
const L = SHOTS.landscape;
---

<section class="wh shell" aria-labelledby="wos-h1" data-hero>
  <div class="wh-f frame" data-dolly>
    <p class="wh-top t-label">
      <span class="wh-crumb"><a href="/">INNOVA</a><span aria-hidden="true">/</span><span>Workflow OS</span></span>
      <StatusTag status="prototype" label="Working prototype" />
    </p>

    <FitText as="h1" id="wos-h1" class="wh-h" text="INNOVA AI Workflow OS" lines={['Workflow OS']} mobileLines={['Workflow', 'OS']} />

    <div class="wh-body">
      <div class="wh-copy">
        <p class="wh-lede">From business processes to measurable AI automation.</p>
        <p class="wh-fit">Invite-only demo online since 1 October 2026. Built for firms of 20 to 200 people.</p>
        <Button href="/contact?topic=workflow-os" class="wh-cta">Request a demo invite</Button>
        <p class="wh-sub">You receive a personal link to the working prototype, preloaded with Northstar Professional Services, a fictional 30-person firm. All data shown is illustrative. The walkthrough takes about two minutes.</p>
      </div>

      <div class="wh-stage">
        <div class="mf-scr wh-s1" data-depth="0.5">
          <picture>
            <source media="(max-width: 760px)" srcset={`${L.m!.src} 764w`} sizes="94vw" width={L.m!.w} height={L.m!.h} />
            <img
              class="scr-img scr-dark"
              src={L.src2x}
              srcset={`${L.src} 1112w, ${L.src2x} 2224w`}
              sizes="(min-width: 1800px) 62vw, 1112px"
              width={L.w}
              height={L.h}
              alt={L.alt}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .wh-f {
    --pad: clamp(18px, 2.6vw, 40px);
    height: calc(100svh - var(--hdr) - var(--gut));
    min-height: 640px;
    max-height: 1040px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    padding: clamp(18px, 2.4vw, 34px) var(--pad) 0;
    background: var(--bone);
    color: var(--ink);
  }
  .wh-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
  }
  .wh-crumb {
    display: inline-flex;
    gap: 10px;
    color: var(--ink-soft);
  }
  .wh-crumb a {
    color: var(--ink);
    text-decoration: none;
  }
  .wh-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .wh-h {
    margin: clamp(14px, 2vw, 30px) 0 0;
    margin-left: -0.04em;
  }
  .wh-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    min-height: 0;
    padding-top: clamp(24px, 2.8vw, 44px);
  }
  .wh-copy {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .wh-lede {
    font-size: clamp(24px, 2.2vw, 36px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 15ch;
  }
  .wh-fit {
    margin-top: 18px;
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .wh-copy :global(.wh-cta) {
    margin-top: 26px;
  }
  .wh-sub {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 38ch;
  }

  /* the screens rise out of the frame's bottom edge (the frame crops them) */
  .wh-stage {
    grid-column: 5 / -1;
    position: relative;
    min-height: 0;
    margin-right: calc(var(--pad) * -1);
  }
  /* natural size (1112 css px, 2x file): the frame crops the right and bottom edges, never the type */
  .wh-s1 {
    position: absolute;
    left: 2%;
    top: 0;
    width: max(98%, 1112px);
    z-index: 1;
  }
  .wh-stage .scr-img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-screen-bone);
  }

  /* entrance: CSS only, done by about 1 s; the copy is final at first paint (no fade) */
  @media (prefers-reduced-motion: no-preference) {
    .wh-f {
      animation: wh-gate 0.95s var(--e-gate) both;
    }
    .wh-s1 img {
      animation: wh-up 1.05s var(--e-out) 0.1s both;
    }
  }
  @keyframes wh-gate {
    from {
      clip-path: inset(5% 3% 5% 3% round 6px);
    }
    to {
      clip-path: inset(0 0 0 0 round 6px);
    }
  }
  @keyframes wh-up {
    from {
      transform: translateY(90px);
    }
    to {
      transform: none;
    }
  }
  @media (max-width: 1100px) {
    .wh-copy {
      grid-column: 1 / span 5;
    }
    .wh-stage {
      grid-column: 6 / span 7;
    }
  }
  @media (max-width: 900px) {
    .wh-f {
      height: auto;
      min-height: 0;
      max-height: none;
      grid-template-rows: auto auto auto;
    }
    .wh-body {
      display: flex;
      flex-direction: column;
      padding-top: 22px;
    }
    .wh-lede {
      max-width: 18ch;
    }
    .wh-stage {
      margin: 32px calc(var(--pad) * -1) 0;
      max-height: 460px;
      overflow: hidden;
      /* the depth dolly shifts the screen a few px; the gap it opens reads as screen, never as a bone strip */
      background: var(--ui-dark);
    }
    .wh-s1 {
      position: relative;
      left: 0;
      width: 1112px;
    }
    .wh-stage .scr-img {
      border-radius: 0;
    }
  }
  @media (max-width: 760px) {
    .wh-s1 {
      width: 100%;
    }
  }
</style>
