---
// Signature element: every visible project drawn as a trail along the stage line,
// ending at its real stage. Status and stage come from one table (STATUS_STAGE).
import { STAGES } from '../data/stages';
import { visibleProjects, STATUS_STAGE, STATUS_LABEL, DOMAINS } from '../data/projects';

const rows = [...visibleProjects]
  .map((p) => ({ ...p, stage: STATUS_STAGE[p.status] }))
  .sort((a, b) => b.stage - a.stage);
const domainLabel = (k: string) => DOMAINS.find((d) => d.key === k)?.label ?? k;
---

<figure class="pb" aria-labelledby="pb-cap">
  <figcaption id="pb-cap" class="pb-cap">
    <span class="mono">Portfolio · stage by stage</span>
    <span class="pb-cap-note">Each line ends where the project really is today.</span>
  </figcaption>

  <div class="pb-head" aria-hidden="true">
    <span class="pb-lab"></span>
    <ol class="pb-stages">
      {
        STAGES.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="pb-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="pb-sl">{s.label}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="pb-axis" aria-hidden="true">
    <span class="pb-lab"></span>
    <span class="pb-axis-line">
      <span class="pb-axis-draw"></span>
      {STAGES.map((_, i) => <i style={`--i:${i}`}></i>)}
    </span>
  </div>

  <ul class="pb-rows">
    {
      rows.map((p, r) => (
        <li>
          <a
            class="pb-row"
            href={`/projects/${p.slug}`}
            style={`--s:${p.stage};--r:${r}`}
            aria-label={`${p.short}: ${STATUS_LABEL[p.status]}, stage ${STAGES[p.stage].label}`}
          >
            <span class="pb-lab">
              <span class="pb-name">{p.short}</span>
              <span class="pb-dom">{domainLabel(p.domain)}</span>
            </span>
            <span class="pb-track" aria-hidden="true">
              <span class="pb-trail" />
              <span class="mark pb-mark" data-s={p.status} />
              <span class="pb-st">{STATUS_LABEL[p.status]}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="pb-key" aria-hidden="true">
    {STAGES.map((st, i) => <span><b>{String(i + 1).padStart(2, '0')}</b> {st.label}</span>)}
  </p>

  <ul class="pb-legend" aria-label="Status legend">
    <li><span class="mark" data-s="live" aria-hidden="true"></span>Live · Built</li>
    <li><span class="mark" data-s="prototype" aria-hidden="true"></span>In development · Prototype</li>
    <li><span class="mark" data-s="research" aria-hidden="true"></span>R&amp;D</li>
    <li><span class="mark" data-s="exploring" aria-hidden="true"></span>Exploring</li>
  </ul>
</figure>

<style>
  .pb {
    --lab: 168px;
    --cell: calc(100% / 6);
    margin: 0;
    padding: 22px 24px 20px;
    background: var(--plate);
    border: 1px solid var(--rule);
    position: relative;
  }
  .pb-cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .pb-cap .mono {
    color: var(--frost);
  }
  .pb-cap-note {
    color: var(--lichen);
    font-size: 0.86rem;
  }

  .pb-head,
  .pb-axis,
  .pb-row {
    display: grid;
    grid-template-columns: var(--lab) minmax(0, 1fr);
    align-items: center;
  }
  .pb-stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .pb-stages li {
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
    animation: pb-fade 600ms var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 120ms);
  }
  .pb-n {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--signal);
  }
  .pb-sl {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--lichen);
  }

  .pb-axis {
    height: 26px;
  }
  .pb-axis-line {
    position: relative;
    height: 100%;
  }
  .pb-axis-draw {
    position: absolute;
    top: 50%;
    left: calc(var(--cell) / 2);
    right: calc(var(--cell) / 2);
    height: 2px;
    margin-top: -1px;
    background: var(--signal);
    transform-origin: left center;
    animation: pb-draw var(--t-draw) var(--ease-in-out) both;
    animation-delay: 600ms;
  }
  .pb-axis-line i {
    position: absolute;
    top: 50%;
    left: calc(var(--cell) * var(--i) + var(--cell) / 2);
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--plate);
    border: 2px solid var(--signal);
    animation: pb-pop 420ms var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 200ms);
  }

  .pb-rows {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  .pb-row {
    min-height: 44px;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--rule);
    transition: background-color var(--t-micro) var(--ease-out);
  }
  .pb-row:hover,
  .pb-row:focus-visible {
    background: var(--plate-hi);
  }
  .pb-lab {
    display: grid;
    padding: 7px 12px 7px 0;
    min-width: 0;
  }
  .pb-name {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pb-dom {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--lichen);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pb-track {
    position: relative;
    height: 44px;
  }
  .pb-track::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--cell) / 2);
    right: calc(var(--cell) / 2);
    border-top: 1px dashed var(--rule-strong);
  }
  .pb-trail {
    position: absolute;
    top: 50%;
    left: calc(var(--cell) / 2);
    width: calc(var(--cell) * var(--s));
    height: 2px;
    margin-top: -1px;
    background: var(--signal-dim);
    transform-origin: left center;
    animation: pb-draw calc(380ms + var(--s) * 110ms) var(--ease-out) both;
    animation-delay: calc(1500ms + var(--r) * 90ms);
  }
  .pb-mark {
    --sz: 14px;
    position: absolute;
    top: 50%;
    left: calc(var(--cell) * var(--s) + var(--cell) / 2);
    margin: -7px 0 0 -7px;
    animation: pb-pop 360ms var(--ease-out) both;
    animation-delay: calc(1500ms + var(--r) * 90ms + 380ms + var(--s) * 110ms);
  }
  .pb-mark[data-s='partner-opportunity'] {
    margin: -7px 0 0 -7px;
  }
  .pb-st {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: calc(var(--cell) * var(--s) + var(--cell) / 2 + 14px);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--frost);
    white-space: nowrap;
    background: var(--plate);
    padding: 1px 4px;
    opacity: 0;
    transition:
      opacity var(--t-micro) var(--ease-out),
      background-color var(--t-micro) var(--ease-out);
  }
  .pb-row:hover .pb-st,
  .pb-row:focus-visible .pb-st {
    opacity: 1;
    background: var(--plate-hi);
  }
  /* Status labels near the right edge flip to the left of the marker. */
  .pb-row[style*='--s:4'] .pb-st,
  .pb-row[style*='--s:5'] .pb-st {
    left: auto;
    right: calc(var(--cell) * (5 - var(--s)) + var(--cell) / 2 + 14px);
  }

  .pb-legend {
    list-style: none;
    margin: 16px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--lichen);
  }
  .pb-legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pb-legend .mark {
    --sz: 11px;
  }

  @keyframes pb-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes pb-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes pb-fade {
    from {
      opacity: 0;
      translate: 0 6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pb *,
    .pb *::before {
      animation: none !important;
    }
  }

  @media (max-width: 720px) {
    .pb {
      --lab: 0px;
      padding: 18px 16px 16px;
    }
    .pb-head,
    .pb-axis,
    .pb-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .pb-head .pb-lab,
    .pb-axis .pb-lab {
      display: none;
    }
    .pb-sl {
      font-size: 0.56rem;
      letter-spacing: 0.02em;
    }
    .pb-row {
      padding-top: 8px;
    }
    .pb-lab {
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 10px;
      padding: 0;
    }
    .pb-track {
      height: 30px;
    }
  }
  .pb-key {
    display: none;
  }
  @media (max-width: 420px) {
    .pb-sl {
      display: none;
    }
    .pb-key {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      margin: 14px 0 0;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--lichen);
    }
    .pb-key b {
      color: var(--signal);
      font-weight: 400;
    }
  }
</style>
