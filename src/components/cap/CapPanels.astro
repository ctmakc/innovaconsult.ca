---
// /capabilities head picture: four tall panels, one per capability, each a world with a real screen.
// Desktop: the hovered or focused panel widens. Phones: a horizontal snap row (the page itself never scrolls sideways).
import CapArt from './CapArt.astro';
import type { CapKey } from './media';
interface Props {
  items: { k: CapKey; href: string; name: string; line: string; span: string }[];
}
const { items } = Astro.props;
---

<ul class="cpn" aria-label="The four capabilities">
  {
    items.map((it) => (
      <li class="cpn-i">
        <CapArt k={it.k} href={it.href} name={it.name} line={it.line} span={it.span} go="Read more" headingLevel="p" class="cpn-a" />
      </li>
    ))
  }
</ul>

<style>
  .cpn {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(8px, 0.9vw, 14px);
    height: clamp(460px, calc(100svh - 410px), 760px);
  }
  .cpn-i {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 0.7s var(--e-out);
  }
  .cpn-i:hover,
  .cpn-i:focus-within {
    flex-grow: 1.55;
  }
  .cpn-i :global(.cpn-a) {
    height: 100%;
  }
  .cpn-i :global(.ca-n) {
    font-size: clamp(26px, 2.3vw, 38px);
  }
  .cpn-i :global(.ca-scr--phone) {
    width: clamp(104px, 9vw, 132px);
    margin-left: calc(clamp(104px, 9vw, 132px) / -2);
    top: 9%;
  }
  .cpn-i:hover :global(.ca-scr img),
  .cpn-i:focus-within :global(.ca-scr img) {
    transform: translateY(-28px);
  }
  /* desktop: the line opens with the panel */
  @media (min-width: 901px) {
    .cpn-i :global(.ca-l) {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.6s var(--e-out),
        opacity 0.4s var(--e-out);
    }
    .cpn-i :global(.ca-l > span) {
      overflow: hidden;
    }
    .cpn-i:hover :global(.ca-l),
    .cpn-i:focus-within :global(.ca-l) {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cpn-i {
      animation: cpn-in 0.9s var(--e-out) both;
    }
    .cpn-i:nth-child(2) {
      animation-delay: 0.08s;
    }
    .cpn-i:nth-child(3) {
      animation-delay: 0.16s;
    }
    .cpn-i:nth-child(4) {
      animation-delay: 0.24s;
    }
  }
  @keyframes cpn-in {
    from {
      clip-path: inset(100% 0 0 0 round 6px);
    }
    to {
      clip-path: inset(0 0 0 0 round 6px);
    }
  }
  @media (max-width: 900px) {
    .cpn {
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      scroll-padding-inline: var(--gut);
    }
    .cpn::-webkit-scrollbar {
      display: none;
    }
    .cpn-i {
      flex: 0 0 min(78vw, 360px);
      height: min(118vw, 520px);
      scroll-snap-align: start;
    }
    .cpn-i:hover,
    .cpn-i:focus-within {
      flex-grow: 0;
    }
  }
</style>
