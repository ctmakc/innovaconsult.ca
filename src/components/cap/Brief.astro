---
// "In brief": the page's self-contained summary (for people and answer engines) set as one large
// paragraph that lights up word by word on scroll (motion.ts [data-light]). Static and fully lit without motion.
interface Props {
  text: string;
  id?: string;
  label?: string;
  /** Optional block under the label (left column), e.g. a status line. */
  class?: string;
}
const { text, id = 'brief-h', label = 'In brief', class: cls } = Astro.props;
const words = text.split(' ');
---

<section class:list={['brief shell', cls]} aria-labelledby={id}>
  <div class="inset brief-g">
    <h2 class="t-label t-mute brief-l" id={id}>{label}</h2>
    <p class="brief-t" data-light>
      {words.map((w) => <><span class="lw">{w}</span>{' '}</>)}
    </p>
    {Astro.slots.has('default') && <div class="brief-s"><slot /></div>}
  </div>
</section>

<style>
  .brief {
    padding-block: clamp(24px, 3vw, 48px) var(--sec);
  }
  .brief-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 20px;
    align-items: start;
  }
  .brief-l {
    grid-column: 1 / span 3;
    padding-top: 0.6em;
  }
  .brief-t {
    grid-column: 4 / span 9;
    font-size: clamp(26px, 2.75vw, 46px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.14;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .brief-s {
    grid-column: 4 / span 9;
    margin-top: 16px;
  }
  .light-ready .lw {
    color: rgb(238 234 226 / 0.44); /* ≥3:1 for large text before it lights up */
    transition: color 0.4s var(--e-out);
  }
  .light-ready .lw.lit {
    color: var(--print);
  }
  @media (max-width: 900px) {
    .brief-l,
    .brief-t,
    .brief-s {
      grid-column: 1 / -1;
    }
    .brief-l {
      padding-top: 0;
    }
  }
</style>
