---
// HOME HERO (round 4) — ONE visual: a full-bleed dark product film.
// 10.6 s loop (25 fps) recorded from the redesigned Workflow OS (process landscape treemap builds,
// the cursor settles on Client Onboarding, then its 88 score waterfall), graded to sit under the
// giant statement. Integrator pass: in the waterfall half everything outside the chart (cut-off
// sentences, the non-clickable app buttons) is painted out with the film's own empty plate, the
// click flash is a short dip to black, and the phone cut shows the whole chart below the Pause control. The product sits right of ~40% of the frame; the left is film-black, so the type
// never fights the screen. First paint = the poster (frame 0 of the loop, so the hand-off to the
// video is invisible). The video loads after window load, never with reduced motion or Save-Data,
// pauses off-screen, and carries a visible Pause control (WCAG 2.2.2).
// Bottom strip = federal proof (corporation, NCAGE, D-U-N-S, city) from src/data/site.ts.
import FitText from './FitText.astro';
import Button from './Button.astro';
import { SITE } from '../data/site';

const verify = `https://ised-isde.canada.ca/cc/lgcy/fdrlCrpDtls.html?corpId=${SITE.corporationNumber.replace('-', '')}`;
const x = Buffer.from(verify).toString('base64');
---

<section class="hf-sec shell" aria-labelledby="h1" data-hero>
  <div class="hf frame">
    <div class="hf-film" aria-hidden="true">
      <picture>
        <source media="(max-width: 900px)" srcset="/media/hero-film-poster-m.webp" width="720" height="792" />
        <img
          class="hf-poster"
          src="/media/hero-film-poster-1920.webp"
          srcset="/media/hero-film-poster-1280.webp 1280w, /media/hero-film-poster-1920.webp 1920w"
          sizes="100vw"
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <video
        class="hf-vid"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        tabindex="-1"
        data-src-d="/media/hero-film-1920.mp4"
        data-src-m="/media/hero-film-m.mp4"></video>
    </div>

    <div class="hf-copy">
      <FitText as="h1" id="h1" class="hf-h" text="INNOVA: Applied AI & software, Ottawa" lines={['Applied AI', '& software']} />
      <p class="hf-lede">We build software and applied AI with companies, researchers and public organizations. Three products are live today.</p>
      <div class="hf-ctas">
        <Button openContact variant="flare">Start a conversation</Button>
        <Button href="/projects" variant="ghost">See the work</Button>
      </div>
      <p class="hf-note">On screen: INNOVA AI Workflow OS scoring a fictional demo company. Illustrative data.</p>
    </div>

    <div class="hf-cap">
      <p>On screen: INNOVA AI Workflow OS, our automation planning tool, scoring a fictional demo company. Illustrative data.</p>
      <button type="button" class="hf-pp" data-film-toggle hidden>
        <span class="hf-pp-i" aria-hidden="true"></span><span class="hf-pp-t">Pause film</span>
      </button>
    </div>

    <div class="hf-ids tnum">
    <dl class="hf-dl" aria-label="Corporate record">
      <div>
        <dt>Federal corporation</dt>
        <dd>{SITE.corporationNumber}</dd>
      </div>
      <div>
        <dt><abbr title="NATO Commercial and Government Entity code, assigned by DND">NCAGE</abbr> code</dt>
        <dd>{SITE.ncage}</dd>
      </div>
      <div>
        <dt>D-U-N-S number</dt>
        <dd>{SITE.duns}</dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{SITE.city}, {SITE.country}</dd>
      </div>
    </dl>
    <p class="hf-v">
      <span class="lnk" role="link" tabindex="0" data-x={x}>Verify on Corporations Canada <span aria-hidden="true">↗</span></span>
    </p>
    </div>
  </div>
</section>

<script>
  // Hero film: poster first, video after load. Off with reduced motion or Save-Data.
  const v = document.querySelector<HTMLVideoElement>('.hf-vid');
  const btn = document.querySelector<HTMLButtonElement>('[data-film-toggle]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const lean = !!conn && (conn.saveData === true || /(^|-)2g$/.test(conn.effectiveType || ''));
  if (v && btn && !reduce.matches && !lean) {
    let userPaused = false;
    let visible = true;
    const label = btn.querySelector<HTMLElement>('.hf-pp-t');
    const sync = () => {
      const paused = v.paused;
      btn.classList.toggle('is-paused', paused);
      if (label) label.textContent = paused ? 'Play film' : 'Pause film';
    };
    const play = () => {
      if (userPaused || !visible || document.hidden) return;
      v.play().catch(() => {});
    };
    const start = () => {
      v.src = window.matchMedia('(max-width: 900px)').matches ? v.dataset.srcM! : v.dataset.srcD!;
      v.addEventListener('playing', () => {
        v.classList.add('on');
        btn.hidden = false;
        sync();
      });
      v.addEventListener('pause', sync);
      play();
    };
    btn.addEventListener('click', () => {
      if (v.paused) {
        userPaused = false;
        play();
      } else {
        userPaused = true;
        v.pause();
      }
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) play();
      else if (!v.paused) v.pause();
    }).observe(v);
    document.addEventListener('visibilitychange', () => (document.hidden ? v.pause() : play()));
    reduce.addEventListener?.('change', () => reduce.matches && (v.pause(), (userPaused = true)));
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>

<style>
  .hf {
    --pad: clamp(18px, 2.4vw, 40px);
    --ids: clamp(104px, 12vh, 124px);
    height: calc(100svh - var(--hdr) - var(--gut));
    min-height: 640px;
    max-height: 1040px;
    background: var(--film);
  }
  .hf-film,
  .hf-film picture,
  .hf-poster,
  .hf-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hf-film {
    z-index: 0;
    overflow: hidden;
    background: var(--film);
  }
  .hf-poster,
  .hf-vid {
    object-fit: cover;
    /* the product lives in the right 60% of the frame: trim the black left side first */
    object-position: 100% 50%;
  }
  .hf-vid {
    opacity: 0;
  }
  .hf-vid.on {
    opacity: 1;
  }
  /* grade: the film is already dark on the left; deepen it under the statement and the record strip */
  .hf::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(13 12 11 / 0.6) 0%, rgb(13 12 11 / 0.35) 44%, rgb(13 12 11 / 0) 62%),
      /* the record strip sits on solid film: the product's lower text rows (score line, totals) must never ghost behind the IDs */
      linear-gradient(0deg, var(--film) 0%, var(--film) calc(var(--ids) + 28px), rgb(13 12 11 / 0.72) calc(var(--ids) + 110px), rgb(13 12 11 / 0) calc(var(--ids) + 300px)),
      linear-gradient(180deg, rgb(13 12 11 / 0.5) 0%, rgb(13 12 11 / 0) 90px);
  }

  .hf-copy {
    position: absolute;
    z-index: 3;
    left: var(--pad);
    bottom: calc(var(--ids) + clamp(28px, 4.6vh, 56px));
    width: min(42%, 680px);
    container-type: inline-size;
  }
  .hf-h {
    margin-left: -0.04em;
  }
  /* First paint = final size (no 12vw overflow, no clipped line before site.ts fits it).
     Ratios measured in Host Grotesk 600 caps at -0.035em; fitAll() then refines in place. */
  .hf-h :global(.fit-d .ln:nth-child(1) .fit) {
    font-size: calc(var(--k1, 19.95) * 1cqi);
  }
  .hf-h :global(.fit-d .ln:nth-child(2) .fit) {
    font-size: calc(var(--k2, 16) * 1cqi);
  }
  .hf-lede {
    margin-top: clamp(18px, 2.4vh, 28px);
    max-width: 34ch;
    font-size: clamp(19px, 1.45vw, 23px);
    line-height: 1.4;
    color: var(--print);
  }
  .hf-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(20px, 2.8vh, 30px);
  }

  .hf-cap {
    position: absolute;
    z-index: 3;
    right: var(--pad);
    bottom: calc(var(--ids) + 12px);
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 50ch;
    padding: 6px 6px 6px 16px;
    border-radius: var(--r);
    background: rgb(13 12 11 / 0.86);
  }
  .hf-cap p {
    font-size: 14px;
    line-height: 1.35;
    text-align: right;
    color: var(--print);
  }
  .hf-note {
    display: none;
  }
  .hf-pp {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgb(238 234 226 / 0.35);
    border-radius: 999px;
    background: rgb(13 12 11 / 0.55);
    color: var(--print);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color var(--t-micro) var(--e-out);
  }
  .hf-pp[hidden] {
    display: none;
  }
  .hf-pp:hover {
    border-color: var(--print);
  }
  /* pause = two bars; play = triangle */
  .hf-pp-i {
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentColor;
  }
  .hf-pp.is-paused .hf-pp-i {
    width: 0;
    height: 0;
    border-inline: 0;
    border-left: 10px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }

  /* ── federal proof strip ── */
  .hf-ids {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--ids);
    margin: 0;
    padding: 0 var(--pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--col-gap);
  }
  .hf-dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--col-gap);
  }
  .hf-dl > div {
    display: grid;
    align-content: start;
    gap: 6px;
    padding-top: clamp(18px, 2.2vh, 24px);
    border-top: 1px solid rgb(238 234 226 / 0.22);
  }
  .hf-ids dt {
    font-size: 15px;
    line-height: 1.3;
    color: var(--ash);
  }
  .hf-ids abbr {
    text-decoration: none;
  }
  .hf-ids dd {
    margin: 0;
    font-size: clamp(22px, 1.75vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--print);
    white-space: nowrap;
  }
  .hf-v {
    align-self: center;
  }
  .hf-v .lnk {
    font-size: 16px;
    white-space: nowrap;
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    /* tablet band: the frame is narrower than the film, so the chart reaches under the statement;
       keep the statement inside the solid part of the grade */
    .hf-copy {
      width: min(50%, 680px);
    }
    .hf::after {
      background:
        linear-gradient(90deg, rgb(13 12 11 / 0.94) 0%, rgb(13 12 11 / 0.9) 52%, rgb(13 12 11 / 0) 76%),
        linear-gradient(0deg, var(--film) 0%, var(--film) calc(var(--ids) + 28px), rgb(13 12 11 / 0) calc(var(--ids) + 260px));
    }
    .hf-cap p {
      display: none;
    }
    .hf-cap {
      padding: 0;
      background: none;
    }
    .hf-note {
      display: block;
      margin-top: 18px;
      font-size: 14px;
      line-height: 1.4;
      color: var(--ash);
    }
    .hf-ids {
      grid-template-columns: 1fr;
    }
    .hf-v {
      display: none;
    }
  }

  /* ── phones and tablets: the film on top, the statement over its lower edge, the record below ── */
  @media (max-width: 900px) {
    .hf {
      height: auto;
      min-height: 0;
      max-height: none;
      display: flex;
      flex-direction: column;
    }
    .hf::after {
      display: none;
    }
    .hf-film {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 720 / 792;
    }
    .hf-film::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgb(13 12 11 / 0) 0%, rgb(13 12 11 / 0) 46%, rgb(13 12 11 / 0.9) 66%, var(--film) 82%);
    }
    .hf-poster,
    .hf-vid {
      object-position: 50% 0;
    }
    .hf-copy {
      position: relative;
      left: auto;
      bottom: auto;
      width: auto;
      margin-top: -34vw;
      padding: 0 16px;
    }
    .hf-lede {
      font-size: 18px;
    }
    .hf-ctas :global(.btn) {
      flex: 1 1 auto;
    }
    .hf-cap {
      position: absolute;
      top: 10px;
      right: 10px;
      bottom: auto;
    }
    .hf-pp {
      min-height: 44px;
      padding: 0 12px;
      background: rgb(13 12 11 / 0.78);
    }
    .hf-ids {
      position: relative;
      height: auto;
      padding: 28px 16px 8px;
    }
    .hf-dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hf-dl > div {
      padding-block: 14px;
    }
    .hf-v {
      display: block;
      padding-top: 10px;
    }
    .hf-ids dd {
      font-size: 21px;
    }
  }
</style>
