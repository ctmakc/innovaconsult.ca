---
// A frame for projects without public screenshots: the product's own working words set
// large on its material, caption at the bottom (same caption rhythm as MediaFrame).
// Words and label come from presets.ts and restate src/data/projects.ts; nothing new.
interface Props {
  words: string[];
  label?: string;
  material?: 'evergreen' | 'loam' | 'navy' | 'reel' | 'bone';
  size?: 'full' | 'half';
  aspect?: string;
  href?: string;
  /** Rise the words from masks on first view (index tiles). */
  rise?: boolean;
  /** Light the words one after another in a slow loop: the cycle in action (motion only). */
  cycle?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { words, label, material = 'reel', size = 'half', aspect, href, rise = true, cycle = false, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'div';
const AR = { full: '16 / 8.6', half: '5 / 4.6' } as const;
---

<Tag {...rest} href={href} class:list={['tf frame', `tf--${size}`, `tm-${material}`, { 'tf--cycle': cycle }, cls]} style={`--ar:${aspect ?? AR[size]};--n:${words.length}`}>
  <div class="tf-top">
    {label && <p class="t-label tf-l">{label}</p>}
    <p class="tf-w">
      {
        words.map((w, i) => (
          <span class="tf-ln" data-mask={rise ? '' : undefined}>
            <span style={`--i:${i}` + (rise ? `;transition-delay:${i * 70}ms` : '')}>{w}</span>
          </span>
        ))
      }
    </p>
  </div>
  {Astro.slots.has('default') && <div class="tf-cap"><slot /></div>}
</Tag>

<style>
  .tf {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(32px, 4vw, 64px);
    aspect-ratio: var(--ar);
    padding: clamp(24px, 3vw, 48px) clamp(20px, 2.6vw, 44px) clamp(20px, 2.6vw, 40px);
    color: var(--print);
    text-decoration: none;
  }
  .tm-reel {
    background: radial-gradient(120% 90% at 80% 10%, var(--reel-2) 0%, var(--reel) 50%, var(--film) 100%);
  }
  .tm-loam {
    background: radial-gradient(120% 100% at 80% 10%, color-mix(in srgb, var(--m-loam) 80%, var(--print) 8%) 0%, var(--m-loam) 55%, var(--film) 100%);
  }
  .tm-navy {
    background: radial-gradient(120% 100% at 80% 10%, color-mix(in srgb, var(--m-navy) 75%, var(--print) 10%) 0%, var(--m-navy) 55%, color-mix(in srgb, var(--m-navy) 60%, var(--film)) 100%);
  }
  .tm-evergreen {
    background: radial-gradient(120% 100% at 80% 10%, color-mix(in srgb, var(--m-evergreen) 70%, var(--print) 10%) 0%, var(--m-evergreen) 55%, color-mix(in srgb, var(--m-evergreen) 70%, var(--film)) 100%);
  }
  .tm-bone {
    background: var(--bone-2);
  }
  .tf-l {
    color: var(--ash);
    margin-bottom: clamp(16px, 2vw, 28px);
  }
  .tf-w {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.96;
    transition: color 0.45s var(--e-out);
  }
  .tf--full .tf-w {
    font-size: clamp(48px, 7vw, 120px);
    max-width: 11em;
  }
  .tf--half .tf-w {
    font-size: clamp(36px, 3.7vw, 62px);
  }
  .tf-ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.04em;
  }
  .tf-ln > span {
    display: block;
  }
  a.tf:hover .tf-w {
    color: var(--flare-hi);
  }
  .tf-cap {
    max-width: 46rem;
  }
  /* Full width: words on the left, caption bottom-right, so the frame stays short. */
  @media (min-width: 901px) {
    .tf--full {
      display: grid;
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: clamp(24px, 3vw, 56px);
      align-items: end;
    }
    .tf--full .tf-top {
      align-self: start;
    }
    .tf--full .tf-w {
      font-size: clamp(48px, 5.6vw, 96px);
    }
  }
  /* The cycle in action: one word lit at a time, slowly. */
  @media (prefers-reduced-motion: no-preference) {
    .tf--cycle .tf-ln > span {
      color: rgb(238 234 226 / 0.44); /* ≥3:1 for large text when dim */
      animation: tf-hl calc(var(--n) * 1.5s) linear calc(var(--i) * 1.5s + 0.6s) infinite;
    }
    .tf--cycle[style*='--n:5'] .tf-ln > span {
      animation-name: tf-hl5;
    }
    .tf--cycle[style*='--n:3'] .tf-ln > span {
      animation-name: tf-hl3;
    }
  }
  @keyframes tf-hl {
    0%,
    45% {
      color: var(--print);
    }
    55%,
    100% {
      color: rgb(238 234 226 / 0.44);
    }
  }
  @keyframes tf-hl5 {
    0%,
    18% {
      color: var(--print);
    }
    24%,
    100% {
      color: rgb(238 234 226 / 0.44);
    }
  }
  @keyframes tf-hl3 {
    0%,
    30% {
      color: var(--print);
    }
    38%,
    100% {
      color: rgb(238 234 226 / 0.44);
    }
  }
  @media (max-width: 900px) {
    .tf {
      aspect-ratio: auto;
      min-height: 0;
      gap: 40px;
      padding: 28px 20px 26px;
    }
    .tf--full .tf-w,
    .tf--half .tf-w {
      font-size: clamp(40px, 11vw, 56px);
    }
  }
</style>
