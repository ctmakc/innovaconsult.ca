---
// One-row footer: legal line, email, Privacy and the MMIX credit (required). The header carries the nav.
import { SITE } from '../data/site';
interface Props {
  /** Photo credits for third-party photos used on this page (CC licences need attribution). */
  credits?: string[];
}
const { credits = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="ftr shell">
  <div class="ftr-row inset">
    <a class="ftr-brand" href="/" aria-label="INNOVA home"><img src="/innova-mark.webp" alt="" width="24" height="24" loading="lazy" />INNOVA</a>
    <p class="ftr-legal tnum">© {year} {SITE.legalName} · Federal corporation {SITE.corporationNumber} · {SITE.city}, {SITE.region}</p>
    <p class="ftr-links">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href="/privacy">Privacy</a>
    </p>
    <p class="mmix">
      Development &amp; promotion —
      <a href="https://mmix.ua/en/zakazat-korporativnyj-sajt/" class="mmix-plate">
        <img src="/mmix-logo.png" alt="MMIX — Marketing Mix" width="37" height="36" loading="lazy" />
      </a>
    </p>
  </div>
  {credits.length > 0 && <p class="ftr-credits inset">{credits.join(' · ')}</p>}
</footer>

<style>
  .ftr {
    padding-block: clamp(40px, 4vw, 64px) 28px;
    color: var(--ash);
    font-size: 15px;
  }
  .ftr-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 32px;
    padding-top: 22px;
    border-top: 1px solid var(--rule-film);
  }
  .ftr-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    color: var(--print);
    text-decoration: none;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.02em;
  }
  .ftr-brand img {
    width: 24px;
    height: 24px;
  }
  .ftr-legal {
    flex: 1 1 auto;
  }
  .ftr-links {
    display: flex;
    gap: 24px;
  }
  .ftr-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--print);
    text-decoration: none;
  }
  .ftr-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .mmix {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .mmix-plate {
    display: inline-flex;
    padding: 5px 9px;
    background: var(--print);
    border-radius: var(--r);
  }
  .mmix-plate img {
    width: 30px;
    height: auto;
  }
  .ftr-credits {
    margin-top: 14px;
    font-size: 14px;
    max-width: 110ch;
  }
  @media (max-width: 900px) {
    .ftr-legal {
      flex-basis: 100%;
      order: 3;
    }
    .ftr-links {
      order: 2;
    }
    .mmix {
      order: 4;
    }
  }
</style>
