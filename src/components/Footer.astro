---
import { SITE } from '../data/site';
import { STAGES } from '../data/stages';
interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
const year = new Date().getFullYear();
// NCAGE and D-U-N-S come from site.ts; render the lines only once they are present.
const rec = SITE as typeof SITE & { ncage?: string; duns?: string };
// Station x-positions (viewBox units) under the centre of each letter of INNOVA; the last sits under the final A.
const STATIONS = [69, 228, 405, 581, 743, 909];
---

<footer class:list={["ftr", { "ftr--nocta": !showCta }]}>
  <div class="wrap">
    {showCta && <div class="ftr-cta">
      <p class="d-l">Have a problem worth solving or technology worth building around?</p>
      <a href="/contact" class="btn btn-primary">Start a conversation <span class="arr" aria-hidden="true">→</span></a>
    </div>}

    <div class="ftr-cols">
      <div>
        <p class="ftr-h">Work</p>
        <ul>
          <li><a class="ulink" href="/projects">Projects</a></li>
          <li><a class="ulink" href="/workflow-os">AI Workflow OS</a></li>
          <li><a class="ulink" href="/partnerships">Partnerships</a></li>
        </ul>
      </div>
      <div>
        <p class="ftr-h">Capabilities</p>
        <ul>
          <li><a class="ulink" href="/innovation">Innovation &amp; R&amp;D</a></li>
          <li><a class="ulink" href="/software">Software &amp; Products</a></li>
          <li><a class="ulink" href="/ai-transformation">AI Transformation</a></li>
        </ul>
      </div>
      <div>
        <p class="ftr-h">Company</p>
        <ul>
          <li><a class="ulink" href="/about">About</a></li>
          <li><a class="ulink" href="/contact">Contact</a></li>
          <li><a class="ulink" href="/privacy">Privacy</a></li>
          <li><a class="ulink" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </div>
      <div class="ftr-record">
        <p class="ftr-h">Corporate record</p>
        <p>
          {SITE.legalName}<br />
          Federal corporation {SITE.corporationNumber}<br />
          {rec.ncage && <><abbr title="NATO Commercial and Government Entity code">NCAGE</abbr> {rec.ncage}<br /></>}
          {rec.duns && <>D-U-N-S {rec.duns}<br /></>}
          {SITE.city}, {SITE.region}, {SITE.country}
        </p>
      </div>
    </div>

    <div class="ftr-word" aria-hidden="true">
      <svg class="ftr-big" viewBox="0 0 1000 176" preserveAspectRatio="xMidYMax meet">
        <text x="0" y="168" textLength="1000" lengthAdjust="spacingAndGlyphs">INNOVA</text>
      </svg>
      <!-- Phones: a taller cut of the same wordmark (narrowest width axis, larger size, same letter centres)
           that runs edge to edge, so it still reads as the footer's signature at 390px. -->
      <svg class="ftr-big ftr-big--m" viewBox="0 0 1000 224" preserveAspectRatio="xMidYMax meet">
        <text x="0" y="216" textLength="1000" lengthAdjust="spacingAndGlyphs">INNOVA</text>
      </svg>
      <span class="ftr-line">
        {STAGES.map((_, i) => <i style={`left:${STATIONS[i] / 10}%`}></i>)}
      </span>
    </div>

    <div class="ftr-meta">
      <p class="mono">© {year} {SITE.legalName}</p>
      <p class="mmix">
        Development &amp; promotion —
        <a href="https://mmix.ua/en/zakazat-korporativnyj-sajt/" class="mmix-badge">
          <img src="/mmix-logo.png" alt="MMIX — Marketing Mix" width="37" height="36" loading="lazy" />
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--rule);
    padding-top: clamp(56px, 5vw, 88px);
    overflow: hidden;
  }
  .ftr--nocta {
    padding-top: 0;
  }
  .ftr--nocta .ftr-cols {
    border-top: 0;
  }
  .ftr-cta {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 32px;
    align-items: end;
    padding-bottom: clamp(56px, 6vw, 96px);
  }
  .ftr-cta .d-l {
    max-width: 22ch;
  }
  .ftr-cta .btn {
    justify-self: end;
  }
  .ftr-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    padding-block: 40px;
    border-top: 1px solid var(--rule);
  }
  .ftr-h {
    font-family: var(--font-text);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--lichen);
    margin: 0 0 8px;
  }
  .ftr ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .ftr ul li {
    line-height: 1.3;
  }
  .ftr ul a {
    display: inline-block;
    padding-block: 10px;
    text-decoration: none;
    color: var(--frost);
    background-position: 0 calc(100% - 8px);
  }
  .ftr ul a:hover {
    background-size: 100% 1px;
  }
  .ftr-record abbr {
    text-decoration: none;
  }
  .ftr-record p:last-child {
    margin: 0;
    padding-top: 10px;
    color: var(--lichen);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .ftr-word {
    position: relative;
    margin-top: 24px;
    display: block;
    margin-bottom: clamp(18px, 2.4vw, 32px);
  }
  .ftr-big {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ftr-big--m {
    display: none;
  }
  .ftr-big text {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 125%;
    font-size: 232px;
    fill: var(--plate-hi);
  }
  /* The stage line is the wordmark's baseline (y 168 of 176), so the letters stand on it. */
  .ftr-line {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(168 / 176 * 100%);
    height: 2px;
    margin-top: -1px;
    background: var(--signal);
    z-index: 1;
  }
  .ftr-line i {
    position: absolute;
    top: 50%;
    width: clamp(9px, 0.9vw, 13px);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--ground);
    border: 2px solid var(--signal);
  }
  .ftr-line i:last-child {
    background: var(--signal);
  }
  .ftr-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 22px 28px;
    border-top: 1px solid var(--rule);
    position: relative;
    background: var(--ground);
  }
  .ftr-meta p {
    margin: 0;
    color: var(--lichen);
  }
  .mmix {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
  }
  .mmix-badge {
    display: inline-flex;
    padding: 5px 8px;
    background: rgb(255 255 255 / 0.9);
  }
  @media (max-width: 860px) {
    .ftr-cta {
      grid-template-columns: 1fr;
    }
    .ftr-cta .btn {
      justify-self: start;
    }
    .ftr-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .ftr-word {
      margin-inline: calc(-1 * var(--gutter));
    }
    .ftr-big {
      display: none;
    }
    .ftr-big--m {
      display: block;
    }
    .ftr-big--m text {
      font-stretch: 100%;
      font-weight: 700;
      font-size: 290px;
    }
    .ftr-line {
      top: calc(216 / 224 * 100%);
    }
    .ftr-record {
      grid-column: 1 / -1;
    }
    .ftr-record p:last-child {
      white-space: nowrap;
    }
  }
</style>
