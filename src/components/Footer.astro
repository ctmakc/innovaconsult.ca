---
import { SITE } from '../data/site';
interface Props {
  /** Photo credits for third-party photos used on this page (CC licences need attribution). */
  credits?: string[];
}
const { credits = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ftr-g g12">
    <div class="ftr-a">
      <a class="ftr-brand" href="/"><img src="/innova-mark.webp" alt="" width="28" height="28" loading="lazy" />INNOVA</a>
      <p>{SITE.legalName} Applied innovation &amp; technology, {SITE.city}, {SITE.region}, {SITE.country}.</p>
    </div>
    <nav class="ftr-n" aria-label="Footer">
      <a href="/projects">Projects</a>
      <a href="/capabilities">Capabilities</a>
      <a href="/innovation">Innovation &amp; R&amp;D</a>
      <a href="/software">Software &amp; products</a>
      <a href="/ai-transformation">AI transformation</a>
      <a href="/workflow-os">Workflow OS</a>
      <a href="/partnerships">Partnerships</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
    </nav>
    <p class="ftr-r tnum">
      Federal corporation {SITE.corporationNumber}<br />
      <abbr title="NATO Commercial and Government Entity code">NCAGE</abbr> {SITE.ncage} · D-U-N-S {SITE.duns}<br />
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </div>
  <div class="ftr-meta">
    <p>© {year} {SITE.legalName}</p>
    {credits.length > 0 && <p class="ftr-credits">{credits.join(' · ')}</p>}
    <p class="mmix">
      Development &amp; promotion —
      <a href="https://mmix.ua/en/zakazat-korporativnyj-sajt/" class="mmix-plate">
        <img src="/mmix-logo.png" alt="MMIX — Marketing Mix" width="37" height="36" loading="lazy" />
      </a>
    </p>
  </div>
</footer>

<style>
  .ftr {
    padding: clamp(48px, 5vw, 80px) var(--gut) 28px;
    color: var(--ash);
    font-size: 16px;
  }
  .ftr-g {
    row-gap: 32px;
    padding-inline: var(--in);
  }
  .ftr-a {
    grid-column: 1 / span 4;
  }
  .ftr-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--print);
    text-decoration: none;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.02em;
    min-height: 44px;
  }
  .ftr-brand img {
    width: 28px;
    height: 28px;
  }
  .ftr-a p {
    margin-top: 12px;
    max-width: 32ch;
  }
  .ftr-n {
    grid-column: 5 / span 5;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    column-gap: 24px;
  }
  .ftr-n a {
    color: var(--print);
    text-decoration: none;
    padding-block: 7px;
    width: fit-content;
  }
  .ftr-n a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ftr-r {
    grid-column: 10 / span 3;
    line-height: 1.7;
  }
  .ftr-r abbr {
    text-decoration: none;
  }
  .ftr-r a {
    color: var(--print);
  }
  .ftr-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 28px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding: 20px var(--in) 0;
    border-top: 1px solid var(--rule-film);
    font-size: 15px;
  }
  .ftr-credits {
    flex: 1 1 360px;
    max-width: 78ch;
    font-size: 14px;
  }
  .mmix {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .mmix-plate {
    display: inline-flex;
    padding: 5px 9px;
    background: var(--print);
    border-radius: var(--r);
  }
  .mmix-plate img {
    width: 30px;
    height: auto;
  }
  @media (max-width: 900px) {
    .ftr-a,
    .ftr-n,
    .ftr-r {
      grid-column: 1 / -1;
    }
  }
</style>
