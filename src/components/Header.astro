---
// v2 header: a solid 72px film bar. Brand left, five links centred, Contact (flare) right.
// Below 1100px the links fold into a full-screen menu with big type.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const current = (href: string) => (path === href ? 'page' : isActive(href) ? 'true' : undefined);

const NAV = [
  { href: '/projects', label: 'Projects' },
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/workflow-os', label: 'Workflow OS' },
  { href: '/partnerships', label: 'Partnerships' },
  { href: '/about', label: 'About' }
];
const CAP_SUB = [
  { href: '/innovation', label: 'Innovation & R&D' },
  { href: '/software', label: 'Software & products' },
  { href: '/ai-transformation', label: 'AI transformation' }
];
const capOn = CAP_SUB.some((c) => isActive(c.href));
---

<header class="hdr" data-hdr>
  <a href="/" class="hdr-brand">
    <img src="/innova-mark.webp" width="28" height="28" alt="" />
    <span>INNOVA</span>
    <span class="sr-only">, home page</span>
  </a>

  <nav class="hdr-nav" aria-label="Main">
    {
      NAV.map((n) => (
        <a href={n.href} class:list={{ on: isActive(n.href) || (n.href === '/capabilities' && capOn) }} aria-current={current(n.href)}>
          {n.label}
        </a>
      ))
    }
  </nav>

  <div class="hdr-r">
    <a href="/contact" class="btn btn--flare btn--sm hdr-cta" data-open-contact aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
    <button class="hdr-menu" type="button" aria-expanded="false" aria-controls="m-menu" data-menu-btn>
      <span data-menu-label>Menu</span>
    </button>
  </div>
</header>

<div class="m-menu" id="m-menu" hidden data-menu>
  <nav aria-label="Main mobile">
    <ul>
      {
        NAV.map((n) => (
          <li>
            <a href={n.href} aria-current={current(n.href)}>{n.label}</a>
            {n.href === '/capabilities' && (
              <ul class="m-sub">
                {CAP_SUB.map((c) => (
                  <li>
                    <a href={c.href} aria-current={current(c.href)}>{c.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
      <li><a href="/contact" aria-current={current('/contact')}>Contact</a></li>
    </ul>
  </nav>
  <p class="m-meta">INNOVA CONSULT LTD. · Ottawa, Ontario, Canada</p>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const outside = () => [document.querySelector('main'), document.querySelector('footer')].filter(Boolean) as HTMLElement[];
  const links = () => Array.from(menu?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
  const isOpen = () => btn?.getAttribute('aria-expanded') === 'true';

  const close = (returnFocus: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'false');
    if (label) label.textContent = 'Menu';
    menu.hidden = true;
    document.documentElement.classList.remove('menu-open');
    outside().forEach((el) => (el.inert = false));
    if (returnFocus) btn.focus();
  };
  const open = () => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'true');
    if (label) label.textContent = 'Close';
    menu.hidden = false;
    document.documentElement.classList.add('menu-open');
    outside().forEach((el) => (el.inert = true));
    links()[0]?.focus();
  };
  btn?.addEventListener('click', () => (isOpen() ? close(true) : open()));
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) close(false);
  });
  document.addEventListener('keydown', (e) => {
    if (!btn || !isOpen()) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      close(true);
      return;
    }
    if (e.key !== 'Tab') return;
    const all = links();
    const last = all[all.length - 1];
    const active = document.activeElement;
    if (!e.shiftKey && active === last) {
      e.preventDefault();
      btn.focus();
    } else if (e.shiftKey && active === btn) {
      e.preventDefault();
      last?.focus();
    } else if (active !== btn && !menu?.contains(active)) {
      e.preventDefault();
      btn.focus();
    }
  });
  window.matchMedia('(min-width: 1101px)').addEventListener('change', (e) => {
    if (e.matches && isOpen()) close(false);
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--hdr);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--gut);
    background: var(--film);
  }
  .hdr-brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.02em;
  }
  .hdr-brand img {
    width: 28px;
    height: 28px;
  }
  .hdr-nav {
    display: flex;
    gap: clamp(8px, 1.2vw, 20px);
  }
  .hdr-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    font-size: 16px;
    text-decoration: none;
    color: var(--ash);
    transition: color var(--t-micro) var(--e-out);
    position: relative;
  }
  .hdr-nav a:hover,
  .hdr-nav a.on {
    color: var(--print);
  }
  .hdr-nav a.on::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    height: 1.5px;
    background: var(--print);
  }
  .hdr-r {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hdr-menu {
    display: none;
    align-items: center;
    min-height: 42px;
    min-width: 72px;
    justify-content: center;
    padding: 0 14px;
    background: none;
    border: 1px solid var(--rule-film);
    border-radius: var(--r);
    color: var(--print);
    font: 500 15px var(--font);
    cursor: pointer;
  }
  .hdr-menu:hover {
    border-color: var(--print);
  }

  .m-menu {
    position: fixed;
    inset: var(--hdr) 0 0 0;
    z-index: 49;
    background: var(--film);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px var(--gut) 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .m-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .m-menu > nav > ul > li > a {
    display: block;
    padding: 8px 0;
    font-size: clamp(34px, 9vw, 52px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-decoration: none;
  }
  .m-sub {
    padding: 0 0 10px 2px !important;
  }
  .m-sub a {
    display: block;
    padding: 8px 0;
    font-size: 19px;
    color: var(--ash);
    text-decoration: none;
  }
  .m-menu a[aria-current] {
    color: var(--flare);
  }
  .m-meta {
    margin-top: 32px;
    font-size: 15px;
    color: var(--ash);
  }
  @media (max-width: 1100px) {
    .hdr {
      grid-template-columns: 1fr auto;
    }
    .hdr-nav {
      display: none;
    }
    .hdr-menu {
      display: inline-flex;
    }
  }
  @media (min-width: 1101px) {
    .m-menu {
      display: none !important;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
