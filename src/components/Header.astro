---
const { active = '' } = Astro.props;
const links = [
  { label: 'Capabilities', href: '/#capabilities', key: 'capabilities' },
  { label: 'AI Transformation', href: '/ai-transformation', key: 'ai' },
  { label: 'Workflow OS', href: '/workflow-os', key: 'workflow' },
  { label: 'Projects', href: '/#projects', key: 'projects' },
  { label: 'R&D', href: '/#innovation', key: 'innovation' },
  { label: 'Partnerships', href: '/#partnerships', key: 'partnerships' }
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="INNOVA home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="brand-copy">
        <strong>INNOVA</strong>
        <small>Applied Innovation & Technology</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a class:list={[active === link.key && 'active']} href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a class="button button-ghost header-cta" href="/#contact">Work with INNOVA</a>

    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="button button-primary" href="/#contact">Work with INNOVA</a>
      </nav>
    </details>
  </div>
</header>
