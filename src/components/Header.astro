---
import { NAV } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const capActive = ['/capabilities', '/ai-transformation', '/software', '/innovation'].some((h) => isActive(h));
---

<header class="hdr" data-hdr>
  <div class="wrap hdr-in">
    <a href="/" class="brand" aria-label="INNOVA — home">
      <img src="/innova-mark.png" width="34" height="34" alt="" />
      <span class="brand-word">INNOVA</span>
      <span class="brand-desc mono">Applied Innovation<br />&amp; Technology</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) =>
            item.children ? (
              <li class="has-sub">
                <a href={item.href} class:list={['nav-a', { on: capActive }]} aria-haspopup="true">
                  {item.label}
                  <span class="caret" aria-hidden="true">
                    ↓
                  </span>
                </a>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class:list={{ on: isActive(c.href) && c.href !== '/capabilities' }}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={['nav-a', { on: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <a href="/contact" class="btn btn-primary hdr-cta">Start a conversation</a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="m-menu" data-menu-btn>
      <span class="menu-label">Menu</span>
      <span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="m-menu" id="m-menu" hidden data-menu>
    <div class="wrap">
      <ul class="m-list">
        <li><a href="/projects">Projects</a></li>
        <li><a href="/capabilities">Capabilities</a></li>
        <li class="m-sub"><a href="/ai-transformation">AI Transformation</a></li>
        <li class="m-sub"><a href="/software">Software &amp; Products</a></li>
        <li class="m-sub"><a href="/innovation">Innovation &amp; R&amp;D</a></li>
        <li><a href="/workflow-os">Workflow OS</a></li>
        <li><a href="/partnerships">Partnerships</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <p class="mono m-meta">Ottawa, Ontario, Canada</p>
    </div>
  </div>
</header>

<script>
  const hdr = document.querySelector('[data-hdr]');
  const onScroll = () => hdr?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const close = () => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
    document.documentElement.classList.remove('menu-open');
  };
  btn?.addEventListener('click', () => {
    if (!menu) return;
    const open = btn.getAttribute('aria-expanded') === 'true';
    if (open) return close();
    btn.setAttribute('aria-expanded', 'true');
    menu.hidden = false;
    document.documentElement.classList.add('menu-open');
    menu.querySelector('a')?.focus();
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(8 22 26 / 0.94);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-micro) var(--ease-out);
  }
  .hdr.scrolled {
    border-bottom-color: var(--rule);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
  }
  .brand-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.16em;
    font-size: 1.12rem;
  }
  .brand-desc {
    font-size: 0.62rem;
    color: var(--lichen);
    padding-left: 12px;
    border-left: 1px solid var(--rule-strong);
    line-height: 1.35;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .nav-a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--lichen);
    transition: color var(--t-micro) var(--ease-out);
  }
  .nav-a:hover,
  .nav-a.on {
    color: var(--frost);
  }
  .nav-a.on {
    box-shadow: inset 0 -2px 0 var(--signal);
  }
  .caret {
    font-size: 0.7em;
    opacity: 0.7;
  }
  .has-sub {
    position: relative;
  }
  .sub {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    display: block !important;
    padding: 8px 0 !important;
    background: var(--plate);
    border: 1px solid var(--rule);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--t-micro) var(--ease-out),
      transform var(--t-micro) var(--ease-out),
      visibility 0s linear var(--t-micro);
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .sub a {
    display: block;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--lichen);
    font-size: 0.95rem;
  }
  .sub a:hover,
  .sub a.on {
    color: var(--frost);
    background: var(--plate-hi);
  }
  .hdr-cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.92rem;
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 4px 0 12px;
    background: none;
    border: 0;
    color: var(--frost);
    font: 600 0.95rem var(--font-text);
    cursor: pointer;
  }
  .menu-bars {
    display: grid;
    gap: 6px;
    width: 22px;
  }
  .menu-bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--t-micro) var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] .menu-bars i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-bars i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  .m-menu {
    position: fixed;
    inset: 76px 0 0 0;
    background: var(--ground);
    border-top: 1px solid var(--rule);
    overflow-y: auto;
    padding-block: 28px 48px;
  }
  .m-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .m-list a {
    display: block;
    padding: 10px 0;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 480;
    font-size: clamp(1.7rem, 7vw, 2.4rem);
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .m-list .m-sub a {
    font-size: 1.15rem;
    font-family: var(--font-text);
    color: var(--lichen);
    padding-left: 20px;
  }
  .m-meta {
    color: var(--lichen);
    margin-top: 28px;
  }

  @media (max-width: 1180px) {
    .brand-desc {
      display: none;
    }
  }
  @media (max-width: 1020px) {
    .nav,
    .hdr-cta {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (min-width: 1021px) {
    .m-menu {
      display: none !important;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
