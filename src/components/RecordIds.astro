---
// Corporate record as one verification line: corporation number, NCAGE, D-U-N-S and the
// Corporations Canada verify link (owner law: external links carry no href; data-x).
import { SITE } from '../data/site';
const verify = `https://ised-isde.canada.ca/cc/lgcy/fdrlCrpDtls.html?corpId=${SITE.corporationNumber.replace('-', '')}`;
const x = Buffer.from(verify).toString('base64');
---

<p class="rid tnum">
  <span>Federal corporation <b>{SITE.corporationNumber}</b></span>
  <span><abbr title="NATO Commercial and Government Entity code, assigned by DND">NCAGE</abbr> <b>{SITE.ncage}</b></span>
  <span>D-U-N-S <b>{SITE.duns}</b></span>
  <span class="lnk rid-v" role="link" tabindex="0" data-x={x}>Verify on Corporations Canada <span aria-hidden="true">↗</span></span>
</p>

<style>
  .rid {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 28px;
    font-size: 17px;
  }
  .rid b {
    font-weight: 600;
    white-space: nowrap;
  }
  .rid abbr {
    text-decoration: none;
  }
</style>
