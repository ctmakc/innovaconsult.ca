---
// Mini stage track for a ruled row: highlights the span of the stage line a thing covers,
// or (with `at`) a single marker on its current stage.
import { STAGES, type Span } from '../data/stages';
import type { ProjectStatus } from '../data/projects';

interface Props {
  span?: Span;
  at?: number;
  status?: ProjectStatus;
  caption?: boolean;
}
const { span, at, status, caption = true } = Astro.props;
const from = span ? span[0] : 0;
const to = span ? span[1] : (at ?? 0);
const label =
  at !== undefined
    ? `Stage: ${STAGES[at].label}`
    : `Covers ${STAGES[from].label} to ${STAGES[to].label}`;
---

<div class="trk" role="img" aria-label={label} data-draw style={`--from:${from};--to:${to};`}>
  <div class="trk-line">
    <span class="trk-span" class:list={[{ 'is-marker': at !== undefined }]}></span>
    {STAGES.map((_, i) => <i class:list={['trk-tick', { on: i >= from && i <= to }]} style={`--i:${i}`}></i>)}
    {at !== undefined && <span class="mark trk-mark" data-s={status} style={`--i:${at}`}></span>}
  </div>
  {
    caption && (
      <p class="trk-cap mono" aria-hidden="true">
        {at !== undefined ? STAGES[at].label : from === to ? STAGES[from].label : `${STAGES[from].label} → ${STAGES[to].label}`}
      </p>
    )
  }
</div>

<style>
  .trk {
    --cell: calc(100% / 6);
    width: 100%;
    max-width: 280px;
    padding-top: 9px;
  }
  .trk-line {
    position: relative;
    height: 14px;
  }
  .trk-line::before {
    content: '';
    position: absolute;
    left: calc(var(--cell) / 2);
    right: calc(var(--cell) / 2);
    top: 6.5px;
    height: 1px;
    background: var(--rule-strong);
  }
  .trk-span {
    position: absolute;
    top: 5.5px;
    height: 3px;
    left: calc(var(--cell) * var(--from) + var(--cell) / 2);
    width: calc(var(--cell) * (var(--to) - var(--from)));
    min-width: 3px;
    background: var(--signal);
    transform-origin: left center;
    transition: transform 900ms var(--ease-out);
  }
  .trk-span.is-marker {
    left: calc(var(--cell) / 2);
    width: calc(var(--cell) * var(--to));
    background: var(--signal-dim);
  }
  .trk-tick {
    position: absolute;
    top: 3px;
    left: calc(var(--cell) * var(--i) + var(--cell) / 2 - 3.5px);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ground);
    border: 1px solid var(--rule-strong);
  }
  .trk-tick.on {
    border-color: var(--signal);
  }
  .trk-mark {
    --sz: 13px;
    position: absolute;
    top: 0.5px;
    left: calc(var(--cell) * var(--i) + var(--cell) / 2 - 6.5px);
  }
  .trk-cap {
    margin: 10px 0 0;
    color: var(--lichen);
    font-size: 0.7rem;
  }
  @media (max-width: 860px) {
    .trk {
      max-width: 340px;
    }
  }
</style>
