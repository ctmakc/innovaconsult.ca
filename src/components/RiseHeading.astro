---
// Headline whose words rise out of a mask on load (hero choreography, CSS only).
// Screen readers get the plain text once; the animated word spans are hidden from them.
interface Props {
  text: string;
  as?: 'h1' | 'h2';
  class?: string;
  delay?: number;
}
const { text, as: Tag = 'h1', class: cls = 'd-hero', delay = 120 } = Astro.props;
const words = text.split(' ');
---

<Tag class:list={[cls, 'rise']} style={`--d0:${delay}ms`}>
  <span class="sr-only">{text}</span>
  {
    words.map((w, i) => (
      <>
        <span class="rw" aria-hidden="true">
          <span style={`--wi:${i}`}>{w}</span>
        </span>{i < words.length - 1 ? ' ' : ''}
      </>
    ))
  }
</Tag>

<style>
  .rise .rw {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .rise .rw > span {
    display: inline-block;
    overflow-wrap: anywhere;
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--d0) + var(--wi) * 55ms);
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise .rw > span {
      animation: none;
    }
  }
</style>
