---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapHead from '../components/cap/CapHead.astro';
import MediaFrame from '../components/MediaFrame.astro';
import StatusTag from '../components/StatusTag.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Brief from '../components/cap/Brief.astro';
import Thumbs from '../components/cap/Thumbs.astro';
import CapNext from '../components/cap/CapNext.astro';
import { SHOT } from '../components/cap/media';
import { visibleProjects } from '../data/projects';

const kinds = [
  ['Custom platforms', 'Back offices and operations systems shaped around how your team works.'],
  ['Internal tools', 'Registers, dashboards and approval flows that replace spreadsheets and email chains.'],
  ['SaaS products', 'Multi-tenant products with roles, permissions and audit from day one.'],
  ['AI-enabled products', 'Applications where AI drafts, classifies or acts inside a controlled workflow.'],
  ['Mobile apps', 'iOS and Android apps from one codebase, taken through TestFlight, Google Play testing and App Store release.'],
  ['Integrations', 'Microsoft 365, SharePoint, Power Automate and Azure; CRMs, accounting, payments, email and public data sources.'],
  ['Prototypes', 'A working version in weeks, for users, investors or a funding application.'],
  ['Modernization', 'Moving legacy systems to maintainable, secure, documented software.']
];

const flow = [
  ['Define', 'What the software must change'],
  ['Prototype', 'A version people can click'],
  ['Validate', 'Tested with real users and data'],
  ['Build', 'Engineered for daily use'],
  ['Integrate', 'Joined to the systems you run'],
  ['Operate', 'Monitored, fixed and improved']
];

const order = ['uafest', 'foundwall', 'babakokum', 'aicrmius'];
const proof = order.map((s) => visibleProjects.find((p) => p.slug === s)).filter((p) => p !== undefined);
---

<BaseLayout
  title="Custom Software Development in Ottawa | INNOVA"
  description="INNOVA builds custom platforms, internal tools, SaaS, AI-enabled products and iOS/Android apps in Ottawa: a clickable prototype first, then build and run."
  path="/software"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'Software & Products', path: '/software' }
  ]}
>
  <CapHead
    crumb="Software & Products"
    title="Custom software, designed around outcomes."
    lede="We define what the software must change, prove it with a prototype, then build, integrate and keep it running."
  >
    <MediaFrame
      slot="media"
      size="full"
      scrim="left"
      material="loam"
      aspectM="4 / 3.9"
      screens={[
        { ...SHOT.uafestApps, l: '36%', t: '7%', width: '43%', lm: '4%', tm: '6%', wm: '74%' },
        { ...SHOT.foundwallHome, l: '57%', t: '39%', width: '40%', lm: '34%', tm: '40%', wm: '62%', depth: 1.25 },
        { ...SHOT.foundwallPhone, kind: 'phone', l: '84%', t: '7%', width: '10.5%', lm: '74%', tm: '8%', wm: '22%', depth: 1.7 }
      ]}
    >
      <div class="sw-cap">
        <p class="sw-live"><StatusTag status="live" label="In use today" /></p>
        <p class="t-h3 two-tone">UAFest and FoundWall<span class="d">Festival operations platform · Lost &amp; found network</span></p>
        <p class="sw-f">The 13 September 2026 festival ran on UAFest. FoundWall’s web platform is live, with iOS and Android apps in public beta.</p>
      </div>
    </MediaFrame>
  </CapHead>

  <Brief
    text="INNOVA designs and builds custom software in Ottawa: operations platforms, internal tools, SaaS, AI-enabled products and iOS and Android apps, in TypeScript, Python and Postgres. Every build starts with a working prototype. Live examples: the UAFest festival operations platform and FoundWall, a Canada-first lost-and-found network."
  />

  <!-- How a build runs: six verbs, one row -->
  <section class="flow shell" aria-labelledby="flow-h">
    <div class="inset">
      <h2 id="flow-h" class="t-label t-mute flow-k">How a build runs</h2>
      <ol class="flow-g">
        {
          flow.map(([t, d], i) => (
            <li data-mask>
              <span class="flow-w">
                <span class="flow-n tnum">{i + 1}</span>
                <span class="flow-t">{t}</span>
                <span class="flow-d">{d}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- What we build: eight kinds, on bone -->
  <section class="kinds tone-bone" aria-labelledby="kinds-h">
    <div class="shell">
      <div class="inset">
        <SectionHead id="kinds-h" title="What we build." lede="TypeScript, Python, Postgres and native mobile, with security, permissions and audit designed in." size="h2" />
        <ul class="kinds-g">
          {
            kinds.map(([t, d]) => (
              <li>
                <h3 class="t-h4">{t}</h3>
                <p>{d}</p>
              </li>
            ))
          }
        </ul>
        <p class="kinds-note">AI models run under your own licence and tenant. We configure what you already own before adding a new vendor.</p>
      </div>
    </div>
  </section>

  <!-- Prototype first + the work that proves it -->
  <section class="pt shell" aria-labelledby="pt-h">
    <div class="inset pt-g">
      <div class="pt-l">
        <h2 id="pt-h" class="t-display pt-h" data-rise>Prototype first.</h2>
        <p class="t-lede pt-lede">INNOVA can turn a research concept or an operational problem into a working prototype before anyone commits to a full build.</p>
        <p class="pt-p t-mute">For funded projects this means the first milestone is something a reviewer can click, and every later milestone is measured against it.</p>
        <Button href="/contact?topic=product" variant="flare" class="pt-cta">Start with a prototype</Button>
      </div>
      <div class="pt-r">
        <Thumbs projects={proof} label="Our work" cols={2} />
        <a class="lnk pt-all" href="/projects">All projects <span class="ar" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CapNext current="software" />
</BaseLayout>

<style>
  /* head frame caption */
  .sw-live {
    margin-bottom: 14px;
  }
  .sw-cap .t-h3 {
    font-size: clamp(30px, 3vw, 52px);
  }
  .sw-cap .two-tone .d {
    font-size: clamp(17px, 1.3vw, 21px);
    letter-spacing: 0;
    line-height: 1.35;
    margin-top: 8px;
  }
  .sw-f {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ash);
    max-width: 44ch;
  }

  /* how a build runs */
  .flow {
    padding-bottom: var(--sec);
  }
  .flow-k {
    margin-bottom: clamp(20px, 2vw, 32px);
  }
  .flow-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 36px var(--col-gap);
  }
  .flow-g li {
    overflow: hidden;
  }
  .flow-w {
    display: grid;
    gap: 8px;
  }
  .flow-n {
    font-size: 15px;
    font-weight: 500;
    color: var(--ash);
  }
  .flow-t {
    font-size: clamp(30px, 2.9vw, 50px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .flow-d {
    font-size: 16px;
    line-height: 1.4;
    color: var(--ash);
    max-width: 18ch;
  }

  /* kinds */
  .kinds {
    padding-block: var(--sec);
  }
  .kinds-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(36px, 4vw, 64px) var(--col-gap);
  }
  .kinds-g h3 {
    margin-bottom: 12px;
  }
  .kinds-g p {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 30ch;
  }
  .kinds-note {
    margin-top: clamp(48px, 5vw, 80px);
    max-width: 52ch;
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.42;
    color: var(--ink);
  }

  /* prototype first */
  .pt {
    padding-top: var(--sec);
  }
  .pt-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 56px;
    align-items: start;
  }
  .pt-l {
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(var(--hdr) + 40px);
  }
  .pt-h {
    font-size: clamp(52px, 6.4vw, 108px);
  }
  .pt-lede {
    margin-top: 28px;
  }
  .pt-p {
    margin-top: 18px;
    max-width: 44ch;
  }
  .pt-l :global(.pt-cta) {
    margin-top: 32px;
  }
  .pt-r {
    grid-column: 7 / span 6;
  }
  .pt-r :global(.th-n) {
    font-size: 21px;
  }
  .pt-all {
    margin-top: 28px;
  }

  @media (max-width: 1100px) {
    .flow-g {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .kinds-g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .pt-l,
    .pt-r {
      grid-column: 1 / -1;
      position: static;
    }
  }
  @media (max-width: 560px) {
    .flow-g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px var(--col-gap);
    }
    .kinds-g {
      grid-template-columns: 1fr;
    }
  }
</style>
