---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import StatusChip from '../components/StatusChip.astro';
import { visibleProjects } from '../data/projects';

const kinds = [
  ['Custom platforms', 'Back offices and operations systems shaped around how your team works.'],
  ['Internal tools', 'Registers, dashboards and approval flows that replace spreadsheets and email chains.'],
  ['SaaS products', 'Multi-tenant products with roles, permissions and audit from day one.'],
  ['AI-enabled products', 'Applications where AI drafts, classifies or acts inside a controlled workflow.'],
  ['Mobile apps', 'iOS and Android apps from one codebase, taken through TestFlight, Google Play testing and store review.'],
  ['Integrations', 'Microsoft 365, SharePoint, Power Automate and Azure; CRMs, accounting, payments, email and public data sources.'],
  ['Prototypes', 'A working version in weeks, for users, investors or a funding application.'],
  ['Modernization', 'Moving legacy systems to maintainable, secure, documented software.']
];
const flow = [
  ['Define', 'What the software must change'],
  ['Prototype', 'A version people can click'],
  ['Validate', 'Tested with real users and data'],
  ['Build', 'Engineered for daily use'],
  ['Integrate', 'Joined to the systems you run'],
  ['Operate', 'Monitored, fixed and improved']
];
const order = ['uafest', 'foundwall', 'aicrmius', 'babakokum'];
const proof = order.map((s) => visibleProjects.find((p) => p.slug === s)).filter((p) => p !== undefined);

---

<BaseLayout
  title="Custom Software Development in Ottawa | INNOVA"
  description="INNOVA builds custom platforms, internal tools, SaaS, AI-enabled products and iOS/Android apps in Ottawa: a clickable prototype first, then build and run."
  path="/software"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'Software & Products', path: '/software' }
  ]}
  footerCta={false}
>
  <PageHead
    crumb="Software & Products"
    title="Custom software, designed around outcomes."
    lede="We define what the software must change, prove it with a prototype, then build, integrate and keep it running."
  />

  <section class="brief" aria-labelledby="brief-h">
    <div class="wrap grid12">
      <p class="brief-l" id="brief-h">In brief</p>
      <p class="brief-t">
        INNOVA designs and builds custom software in Ottawa: operations platforms, internal tools, SaaS, AI-enabled products and iOS and Android
        apps, in TypeScript, Python and Postgres. Every build starts with a working prototype. Live examples: the UAFest festival operations
        platform and FoundWall, a Canada-first lost-and-found network.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="flow-h">
    <div class="wrap">
      <h2 class="sr-only" id="flow-h">How a build runs</h2>
      <ol class="ln" data-draw>
        <span class="ln-base" aria-hidden="true"></span>
        <span class="ln-rail" aria-hidden="true"></span>
        {
          flow.map(([t, d], i) => (
            <li class="ln-st" style={`--i:${i}`}>
              <span class="ln-ring" aria-hidden="true" />
              <span class="ln-n">{i + 1}</span>
              <span class="ln-h">{t}</span>
              <span class="ln-d">{d}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l"><h2 class="d-l">What we build.</h2></div>
        <p class="body sh-r">TypeScript, Python, Postgres and native mobile, with security, permissions and audit designed in.</p>
      </div>
      <div class="kinds">
        {
          kinds.map(([t, d]) => (
            <div>
              <h3 class="d-m">{t}</h3>
              <p class="body">{d}</p>
            </div>
          ))
        }
      </div>
      <p class="kinds-note">AI models run under your own licence and tenant. We configure what you already own before adding a new vendor.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid12">
      <div class="pt-l">
        <h2 class="d-l">Prototype first.</h2>
        <p class="lede pt-p">
          INNOVA can turn a research concept or an operational problem into a working prototype before anyone commits to a full build.
        </p>
        <p class="body">
          For funded projects this means the first milestone is something a reviewer can click, and every later milestone is measured against it.
        </p>
        <a href="/contact?topic=product" class="btn btn-primary pt-cta">Start with a prototype <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="pt-r">
        <h3 class="pt-h">Our work</h3>
        <ul class="pt-list">
          {
            proof.map((p) => (
              <li>
                <a href={p.internal ?? `/projects/${p.slug}`} class="ulink">
                  {p.name}
                </a>
                <StatusChip status={p.status} />
              </li>
            ))
          }
        </ul>
        <a class="arrow-link pt-all" href="/projects"><span>All projects</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .brief {
    padding-block: clamp(36px, 4vw, 60px);
    border-bottom: 1px solid var(--rule);
  }
  .brief-l {
    grid-column: 1 / span 3;
    margin: 0;
    padding-top: 5px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--lichen);
  }
  .brief-t {
    grid-column: 4 / span 7;
    margin: 0;
    max-width: 64ch;
    color: var(--frost);
    font-size: clamp(1.02rem, 0.96rem + 0.25vw, 1.15rem);
    line-height: 1.6;
  }

  /* The line: 2px signal rail through 10px rings, last station filled. Vertical at ≤860 (covers phones and small tablets). */
  .ln {
    --n: 6;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
  }
  .ln-base,
  .ln-rail {
    position: absolute;
    top: 4px;
    left: 5px;
    right: calc(100% / var(--n) - 5px);
    height: 2px;
  }
  .ln-base {
    background: var(--rule-strong);
  }
  .ln-rail {
    background: var(--signal);
    transform-origin: left center;
  }
  .ln-st {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 30px clamp(12px, 1.6vw, 24px) 0 0;
  }
  .ln-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--signal);
    background: var(--ground);
  }
  .ln-st:last-child .ln-ring {
    background: var(--signal);
  }
  .ln-n {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--lichen);
  }
  .ln-h {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 470;
    font-size: clamp(1.2rem, 0.9rem + 1.1vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .ln-d {
    margin-top: 10px;
    color: var(--lichen);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ln-rail {
      transition: transform var(--t-draw) var(--ease-in-out);
    }
    .ln-ring {
      transition:
        border-color 300ms var(--ease-out),
        background-color 300ms var(--ease-out);
      transition-delay: calc(var(--i) * 180ms + 180ms);
    }
    :global(.js) .ln:not(.is-in) .ln-rail {
      transform: scaleX(0);
    }
    :global(.js) .ln:not(.is-in) .ln-ring {
      border-color: var(--rule-strong);
      background: var(--ground);
    }
  }
  @media (max-width: 860px) {
    .ln {
      grid-template-columns: 1fr;
    }
    /* Vertical: one segment per gap, ring centre to ring centre, so the line never floats free. */
    .ln-base,
    .ln-rail {
      display: none;
    }
    .ln-st {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      column-gap: 0;
      padding: 0 0 24px 22px;
    }
    .ln-st:last-child {
      padding-bottom: 0;
    }
    .ln-st:not(:last-child)::before,
    .ln-st:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 8px;
      top: 12px;
      bottom: -12px;
      width: 2px;
    }
    .ln-st:not(:last-child)::before {
      background: var(--rule-strong);
    }
    .ln-st:not(:last-child)::after {
      background: var(--signal);
      transform-origin: center top;
    }
    .ln-ring {
      left: 4px;
      top: 7px;
      z-index: 1;
    }
    .ln-n {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
      padding-top: 5px;
    }
    .ln-h {
      grid-column: 2;
      font-size: 22px;
      font-weight: 470;
    }
    .ln-d {
      grid-column: 2;
      margin-top: 4px;
    }
  }
  @media (max-width: 860px) and (prefers-reduced-motion: no-preference) {
    .ln-st::after {
      transition: transform 420ms var(--ease-in-out);
      transition-delay: calc(var(--i) * 180ms);
    }
    :global(.js) .ln:not(.is-in) .ln-st::after {
      transform: scaleY(0);
    }
  }

  .kinds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 clamp(20px, 2.4vw, 40px);
  }
  .kinds > div {
    padding: 24px 0 30px;
    border-top: 1px solid var(--rule);
  }
  .kinds h3 {
    margin-bottom: 10px;
  }
  .kinds {
    border-bottom: 1px solid var(--rule);
  }
  .kinds-note {
    margin: 26px 0 0;
    max-width: 70ch;
    color: var(--frost);
    font-size: clamp(1.02rem, 0.96rem + 0.25vw, 1.15rem);
  }
  .pt-l {
    grid-column: 1 / span 6;
  }
  .pt-p {
    margin: 22px 0 18px;
  }
  .pt-cta {
    margin-top: 30px;
  }
  .pt-r {
    grid-column: 8 / span 5;
  }
  .pt-h {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--lichen);
  }
  .pt-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .pt-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    font-size: 1.05rem;
  }
  .pt-all {
    margin-top: 22px;
  }
  @media (max-width: 980px) {
    .brief-l,
    .brief-t {
      grid-column: 1 / -1;
    }
    .brief-l {
      margin-bottom: 12px;
      padding-top: 0;
    }
    .kinds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pt-l,
    .pt-r {
      grid-column: 1 / -1;
    }
    .pt-r {
      margin-top: 48px;
    }
  }
  @media (max-width: 640px) {
    .kinds {
      grid-template-columns: 1fr;
    }
  }
</style>
