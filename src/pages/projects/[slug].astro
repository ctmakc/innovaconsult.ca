---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import StatusTag from '../../components/StatusTag.astro';
import Screen from '../../components/Screen.astro';
import Button from '../../components/Button.astro';
import SectionHead from '../../components/SectionHead.astro';
import TypeFrame from '../../components/projects/TypeFrame.astro';
import ProjectTile from '../../components/projects/ProjectTile.astro';
import { PRESETS } from '../../components/projects/presets';
import { visibleProjects, STATUS_LABEL, DOMAINS, projectHref, type Project, type ProofImage } from '../../data/projects';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  // Projects with their own product page elsewhere (Workflow OS) get no detail page here.
  return visibleProjects.filter((p) => !p.internal).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const path = `/projects/${p.slug}`;
const pr = PRESETS[p.slug] ?? { fact: p.summary, material: 'reel' as const };
const lead = p.images?.[0];
const isPhone = (im: ProofImage) => im.h > im.w;

/* Gallery: every real screenshot of the project, readable, with its data caption. */
const gallery = [...(p.images ?? []), ...(pr.extra ?? [])];
const hasVisual = gallery.length > 0 || p.slug === 'aicrmius';

/* Related: same domain first, then same capability, then the next projects in the list. */
const others = visibleProjects.filter((x) => x.slug !== p.slug);
const related: Project[] = [];
for (const x of others) if (related.length < 2 && x.domain === p.domain) related.push(x);
for (const x of others)
  if (related.length < 2 && !related.includes(x) && p.capability && x.capability?.href === p.capability.href) related.push(x);
{
  const idx = visibleProjects.findIndex((x) => x.slug === p.slug);
  for (let k = 1; related.length < 2 && k < visibleProjects.length; k++) {
    const x = visibleProjects[(idx + k) % visibleProjects.length];
    if (!related.includes(x)) related.push(x);
  }
}

const domain = DOMAINS.find((d) => d.key === p.domain)?.label ?? p.domain;
const problemWords = p.problem.split(' ');

const isProject = p.domain === 'dual-use';
const ld = isProject
  ? {
      '@context': 'https://schema.org',
      '@type': 'Project',
      '@id': `${SITE.url}${path}#project`,
      name: p.name,
      description: p.seoDescription ?? p.summary,
      url: `${SITE.url}${path}`,
      parentOrganization: { '@id': `${SITE.url}/#org` }
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}${path}#app`,
      name: p.name,
      description: p.seoDescription ?? p.summary,
      url: p.url ?? `${SITE.url}${path}`,
      mainEntityOfPage: `${SITE.url}${path}`,
      applicationCategory: p.slug === 'babakokum' ? 'GameApplication' : 'BusinessApplication',
      operatingSystem: ['foundwall', 'babakokum'].includes(p.slug) ? 'Web, iOS, Android' : 'Web',
      creativeWorkStatus: STATUS_LABEL[p.status],
      creator: { '@id': `${SITE.url}/#org` },
      ...(lead ? { screenshot: `${SITE.url}${lead.src}` } : {})
    };

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Projects', path: '/projects' },
  { name: p.name, path }
];

const CYCLE = [
  { k: 'Propose', d: 'An agent drafts a change to a record.' },
  { k: 'Validate', d: 'The proposed value is checked against the field’s rules.' },
  { k: 'Approve', d: 'A person accepts or rejects it.' },
  { k: 'Apply', d: 'The change is written, with its audit entry.' },
  { k: 'Undo', d: 'One click reverses it.' }
];
---

<BaseLayout
  title={`${p.seoTitle ?? p.name} | INNOVA`}
  description={p.seoDescription ?? p.summary}
  path={path}
  jsonLd={[ld]}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    {
      pr.world && (
        <link
          rel="preload"
          as="image"
          href={pr.world.src}
          imagesrcset={pr.world.src800 ? `${pr.world.src800} 800w, ${pr.world.src} ${pr.world.w}w` : undefined}
          imagesizes={pr.world.src800 ? '100vw' : undefined}
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  <!-- ═══ HERO: the project in its world, name on the frame ═══ -->
  <section class="pj-top shell" aria-labelledby="pj-h">
    <p class="inset t-label pj-crumb">
      <a href="/">INNOVA</a><span aria-hidden="true">/</span><a href="/projects">Projects</a><span aria-hidden="true">/</span><span>{p.short}</span>
    </p>
    {
      pr.words ? (
        <TypeFrame class="pj-hf" words={pr.words} label={pr.wordsLabel} material={pr.material} size="full" aspect="16 / 6.2" rise={false} cycle={p.slug !== 'dual-use'}>
          <StatusTag status={p.status} label={pr.statusLabel} class="pj-tag" />
          <h1 id="pj-h" class="pj-h">{p.name}</h1>
          {p.tagline && <p class="pj-tl">{p.tagline}</p>}
        </TypeFrame>
      ) : (
        <MediaFrame class="pj-hf" size="full" aspect="16 / 8" aspectM={pr.aspectM} world={pr.world} material={pr.material} screens={pr.full} credit={pr.credit} scrim="left">
          <StatusTag status={p.status} label={pr.statusLabel} class="pj-tag" />
          <h1 id="pj-h" class="pj-h">{p.name}</h1>
          {p.tagline && <p class="pj-tl">{p.tagline}</p>}
        </MediaFrame>
      )
    }
  </section>

  <!-- ═══ SUMMARY + RECORD ═══ -->
  <section class="pj-in shell" aria-label="Summary">
    <div class="inset pj-in-g">
      <p class="pj-sum">{p.summary}</p>
      <dl class="pj-facts">
        <div>
          <dt>Field</dt>
          <dd>{domain}</dd>
        </div>
        {
          p.url && (
            <div>
              <dt>Live at</dt>
              <dd>
                <a class="lnk" href={p.url} target="_blank" rel="noopener">
                  {p.urlLabel}
                  <span class="ar" aria-hidden="true">↗</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </dd>
            </div>
          )
        }
        {
          p.capability && (
            <div>
              <dt>Capability</dt>
              <dd>
                <a class="lnk" href={p.capability.href}>
                  {p.capability.label} <span class="ar" aria-hidden="true">→</span>
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <!-- ═══ THE PROBLEM: one paragraph that lights up ═══ -->
  <section class="pj-pb shell" aria-labelledby="pb-h">
    <div class="inset">
      <h2 id="pb-h" class="t-label t-mute pj-k">The problem</h2>
      <p class="pj-pbt" data-light>
        {problemWords.map((w) => <><span class="lw">{w}</span>{' '}</>)}
      </p>
    </div>
  </section>

  <!-- ═══ WHAT WE BUILT: on bone, text beside the real screens ═══ -->
  <section class:list={['pj-sol tone-bone', { 'pj-sol--vis': hasVisual }]} aria-labelledby="sol-h">
    <div class="shell">
      <div class="inset pj-sol-g">
        <div class="pj-sol-l">
          <h2 id="sol-h" class="t-label t-mute pj-k">What we built</h2>
          <p class="pj-solt" data-rise>{p.solution}</p>
          {
            hasVisual && (
              <div class="tech tech--s">
                <h3 class="t-label t-mute">Built with</h3>
                <ul>
                  {p.technology.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            )
          }
        </div>
        <div class="pj-sol-r">
          {
            p.slug === 'aicrmius' && (
              <ol class="cyc" aria-label="The cycle every agent change goes through in the working build">
                {CYCLE.map((c, i) => (
                  <li>
                    <span class="cyc-n tnum">{i + 1}</span>
                    <b class="cyc-k">{c.k}</b>
                    <span class="cyc-d">{c.d}</span>
                  </li>
                ))}
              </ol>
            )
          }
          {
            gallery.length > 0 && (
              <div class="gal">
                {gallery.map((im, i) => (
                  <Screen
                    img={im}
                    kind={isPhone(im) ? 'phone' : 'desktop'}
                    class:list={['gal-i', { 'gal-ph': isPhone(im) }]}
                    sizes={isPhone(im) ? '(max-width: 900px) 70vw, 300px' : '(max-width: 900px) 100vw, 56vw'}
                    data-rise={i > 0 ? '' : undefined}
                  />
                ))}
              </div>
            )
          }
          {
            !hasVisual && (
              <div class="tech">
                <h3 class="t-label t-mute pj-k">Built with</h3>
                <ul>
                  {p.technology.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHERE IT STANDS ═══ -->
  <section class="pj-st shell pad-lg" aria-labelledby="st-h">
    <div class="inset pj-st-g">
      <div class="pj-st-l">
        <h2 id="st-h" class="t-label t-mute pj-k">Where it stands</h2>
        <StatusTag status={p.status} label={pr.statusLabel} class="pj-st-tag" />
        <p class="pj-out" data-rise>{p.outcome}</p>
      </div>
      <div class="pj-st-r">
        {
          (p.role || p.client) && (
            <div class="pj-blk">
              <h3 class="t-label t-mute">INNOVA’s role</h3>
              {p.role && <p>{p.role}</p>}
              {p.client && <p class="pj-client">{p.client}</p>}
            </div>
          )
        }
        {
          p.lookingFor && (
            <div class="pj-blk pj-ask">
              <h3 class="t-label t-mute">Looking for</h3>
              <p>{p.lookingFor}</p>
              <Button openContact variant="flare" size="sm">Write to INNOVA</Button>
            </div>
          )
        }
        {
          !p.role && !p.client && !p.lookingFor && p.capability && (
            <div class="pj-blk">
              <h3 class="t-label t-mute">Part of</h3>
              <a class="lnk" href={p.capability.href}>
                {p.capability.label} <span class="ar" aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ═══ RELATED ═══ -->
  <section class="pj-rel shell" aria-labelledby="rel-h">
    <div class="inset">
      <SectionHead id="rel-h" title="Related work" size="h2" link={{ href: '/projects', label: 'All projects' }} />
    </div>
    <div class="rel-g">
      {related.map((r) => <ProjectTile project={r} size="half" />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  .pj-top {
    padding-top: clamp(20px, 2.4vw, 36px);
  }
  .pj-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(16px, 1.8vw, 24px);
    color: var(--ash);
  }
  .pj-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .pj-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  :global(.pj-hf .pj-tag) {
    margin-bottom: 16px;
  }
  .pj-h {
    font-size: clamp(40px, 4.6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }
  .pj-tl {
    margin-top: 10px;
    font-size: clamp(22px, 1.9vw, 30px);
    letter-spacing: -0.022em;
    line-height: 1.12;
    color: var(--ash);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pj-hf {
      animation: pj-gate 0.95s var(--e-gate) both;
    }
    .pj-hf :global(.mf-world img) {
      animation: pj-settle 1.8s var(--e-out) both;
    }
    .pj-h,
    .pj-tl,
    .pj-hf :global(.pj-tag) {
      animation: pj-up 0.9s var(--e-out) 0.28s both;
    }
    .pj-tl {
      animation-delay: 0.38s;
    }
  }
  @keyframes pj-gate {
    from {
      clip-path: inset(5% 3% 5% 3% round 6px);
    }
    to {
      clip-path: inset(0 0 0 0 round 6px);
    }
  }
  @keyframes pj-settle {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes pj-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── summary + record ── */
  .pj-in {
    padding-block: clamp(48px, 6vw, 104px) 0;
  }
  .pj-in-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 40px;
    align-items: start;
  }
  .pj-sum {
    grid-column: 1 / span 7;
    font-size: clamp(21px, 1.8vw, 28px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .pj-facts {
    grid-column: 9 / span 4;
    margin: 0;
    display: grid;
    gap: 18px;
    padding-top: 6px;
  }
  .pj-facts dt {
    font-size: 15px;
    color: var(--ash);
  }
  .pj-facts dd {
    margin: 4px 0 0;
    font-size: 19px;
    font-weight: 500;
  }
  .pj-facts dd :global(.tag) {
    font-size: 19px;
  }

  /* ── problem ── */
  .pj-pb {
    padding-block: calc(var(--sec) * 0.8) var(--sec);
  }
  .pj-k {
    margin-bottom: 24px;
  }
  .pj-pbt {
    font-size: clamp(28px, 3.1vw, 52px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    max-width: 26ch;
  }
  .light-ready .lw {
    color: rgb(238 234 226 / 0.44); /* ≥3:1 for large text even before it lights up */
    transition: color 0.4s var(--e-out);
  }
  .light-ready .lw.lit {
    color: var(--print);
  }

  /* ── what we built (bone) ── */
  .pj-sol {
    padding-block: var(--sec);
  }
  .pj-sol-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: start;
  }
  .pj-sol-l {
    grid-column: 1 / span 5;
  }
  .pj-sol--vis .pj-sol-l {
    position: sticky;
    top: calc(var(--hdr) + 40px);
  }
  .pj-sol-r {
    grid-column: 7 / span 6;
  }
  .pj-solt {
    font-size: clamp(22px, 1.9vw, 30px);
    line-height: 1.32;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .gal {
    display: grid;
    gap: clamp(40px, 4vw, 64px);
  }
  .gal :global(.gal-ph) {
    max-width: 300px;
  }
  /* Softer plate shadow on bone so it never reads as a tinted box behind the caption. */
  .gal :global(.scr-img) {
    box-shadow:
      0 0 0 1px var(--rule-ink),
      0 28px 44px -34px rgb(20 19 16 / 0.45);
  }
  .cyc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    counter-reset: c;
  }
  .cyc li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 6px 16px;
    align-items: baseline;
    padding: clamp(20px, 2vw, 30px) clamp(20px, 2.2vw, 34px);
    background: var(--print);
    border-radius: var(--r);
    box-shadow: 0 24px 50px -40px rgb(20 19 16 / 0.5);
  }
  .cyc li:last-child {
    background: var(--ink);
    color: var(--print);
  }
  .cyc-n {
    grid-row: 1 / span 2;
    font-size: 15px;
    font-weight: 600;
    color: var(--flare-ink);
  }
  .cyc li:last-child .cyc-n {
    color: var(--flare);
  }
  .cyc-k {
    font-size: clamp(30px, 3vw, 50px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .cyc-d {
    grid-column: 2;
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .cyc li:last-child .cyc-d {
    color: var(--ash);
  }
  .tech ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tech li {
    padding: 12px 0 14px;
    font-size: clamp(20px, 1.7vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    border-top: 1px solid var(--rule-ink);
  }
  .tech--s {
    margin-top: clamp(36px, 3.4vw, 56px);
  }
  .tech--s h3 {
    margin-bottom: 12px;
  }
  .tech--s li {
    padding: 9px 0 10px;
    font-size: 17px;
    letter-spacing: 0;
  }

  /* ── where it stands ── */
  .pj-st-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: start;
  }
  .pj-st-l {
    grid-column: 1 / span 7;
  }
  :global(.pj-st-tag) {
    font-size: 17px !important;
  }
  .pj-out {
    margin-top: 22px;
    font-size: clamp(28px, 2.9vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: pretty;
  }
  .pj-st-r {
    grid-column: 9 / span 4;
    display: grid;
    gap: 36px;
    padding-top: 6px;
  }
  .pj-blk h3 {
    margin-bottom: 10px;
  }
  .pj-blk p {
    font-size: 18px;
    line-height: 1.5;
  }
  .pj-client {
    margin-top: 10px;
    color: var(--ash);
  }
  .pj-ask :global(.btn) {
    margin-top: 18px;
  }

  /* ── related ── */
  .pj-rel {
    padding-bottom: var(--sec);
  }
  .rel-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }

  @media (max-width: 900px) {
    .pj-sum,
    .pj-facts,
    .pj-st-l,
    .pj-st-r {
      grid-column: 1 / -1;
    }
    .pj-facts {
      gap: 18px;
    }
    /* Phones: solution, then the screens, then the stack list. */
    .pj-sol-g {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .pj-sol-l {
      display: contents;
    }
    .pj-sol-r {
      order: 3;
      margin-top: 40px;
    }
    .tech--s {
      order: 4;
      margin-top: 48px;
    }
    .cyc li {
      grid-template-columns: 32px minmax(0, 1fr);
    }
    .rel-g {
      grid-template-columns: 1fr;
    }
  }
</style>
