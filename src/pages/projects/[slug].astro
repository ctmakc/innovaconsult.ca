---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import StatusTag from '../../components/StatusTag.astro';
import Button from '../../components/Button.astro';
import SectionHead from '../../components/SectionHead.astro';
import TypeFrame from '../../components/projects/TypeFrame.astro';
import ProjectTile from '../../components/projects/ProjectTile.astro';
import { PRESETS } from '../../components/projects/presets';
import { hires } from '../../components/projects/shots';
import { visibleProjects, STATUS_LABEL, DOMAINS, projectHref, type Project, type ProofImage } from '../../data/projects';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  // Projects with their own product page elsewhere (Workflow OS) get no detail page here.
  return visibleProjects.filter((p) => !p.internal).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const path = `/projects/${p.slug}`;
const pr = PRESETS[p.slug] ?? { fact: p.summary, material: 'reel' as const };
const lead = p.images?.[0];
const isPhone = (im: ProofImage) => im.h > im.w;

/* Gallery: every real screenshot of the project, readable, with its data caption. */
const gallery = [...(p.images ?? []), ...(pr.extra ?? [])];
const galDesk = gallery.filter((im) => !isPhone(im));
const galPhone = gallery.filter(isPhone);

/* Related: same domain first, then same capability, then the next projects in the list. */
const others = visibleProjects.filter((x) => x.slug !== p.slug);
const related: Project[] = [];
for (const x of others) if (related.length < 2 && x.domain === p.domain) related.push(x);
for (const x of others)
  if (related.length < 2 && !related.includes(x) && p.capability && x.capability?.href === p.capability.href) related.push(x);
{
  const idx = visibleProjects.findIndex((x) => x.slug === p.slug);
  for (let k = 1; related.length < 2 && k < visibleProjects.length; k++) {
    const x = visibleProjects[(idx + k) % visibleProjects.length];
    if (!related.includes(x)) related.push(x);
  }
}

const domain = DOMAINS.find((d) => d.key === p.domain)?.label ?? p.domain;
const problemWords = p.problem.split(' ');

const isProject = p.domain === 'dual-use';
const ld = isProject
  ? {
      '@context': 'https://schema.org',
      '@type': 'Project',
      '@id': `${SITE.url}${path}#project`,
      name: p.name,
      description: p.seoDescription ?? p.summary,
      url: `${SITE.url}${path}`,
      parentOrganization: { '@id': `${SITE.url}/#org` }
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}${path}#app`,
      name: p.name,
      description: p.seoDescription ?? p.summary,
      url: p.url ?? `${SITE.url}${path}`,
      mainEntityOfPage: `${SITE.url}${path}`,
      applicationCategory: p.slug === 'babakokum' ? 'GameApplication' : 'BusinessApplication',
      operatingSystem: ['foundwall', 'babakokum'].includes(p.slug) ? 'Web, iOS, Android' : 'Web',
      creativeWorkStatus: STATUS_LABEL[p.status],
      creator: { '@id': `${SITE.url}/#org` },
      ...(lead ? { screenshot: `${SITE.url}${lead.src}` } : {})
    };

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Projects', path: '/projects' },
  { name: p.name, path }
];

const CYCLE = [
  { k: 'Propose', d: 'An agent drafts a change to a record.' },
  { k: 'Validate', d: 'The proposed value is checked against the field’s rules.' },
  { k: 'Approve', d: 'A person accepts or rejects it.' },
  { k: 'Apply', d: 'The change is written, with its audit entry.' },
  { k: 'Undo', d: 'One click reverses it.' }
];
---

<BaseLayout
  title={`${p.seoTitle ?? p.name} | INNOVA`}
  description={p.seoDescription ?? p.summary}
  path={path}
  jsonLd={[ld]}
  cta={{ title: `Talk to us about ${p.name}.` }}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    {
      pr.world && (
        <link
          rel="preload"
          as="image"
          href={pr.world.src}
          imagesrcset={pr.world.src800 ? `${pr.world.src800} 800w, ${pr.world.src} ${pr.world.w}w` : undefined}
          imagesizes={pr.world.src800 ? '100vw' : undefined}
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  <!-- ═══ HERO: the project in its world, name on the frame ═══ -->
  <section class="pj-top shell" aria-labelledby="pj-h">
    <p class="inset t-label pj-crumb">
      <a href="/">INNOVA</a><span aria-hidden="true">/</span><a href="/projects">Projects</a><span aria-hidden="true">/</span><span>{p.short}</span>
    </p>
    {
      pr.words ? (
        <TypeFrame class="pj-hf" words={pr.words} label={pr.wordsLabel} material={pr.material} size="full" aspect="16 / 6.2" rise={false} cycle={p.slug !== 'dual-use'}>
          <StatusTag status={p.status} label={pr.statusLabel} class="pj-tag" />
          <h1 id="pj-h" class="pj-h">{p.name}</h1>
          {p.tagline && <p class="pj-tl">{p.tagline}</p>}
        </TypeFrame>
      ) : (
        <MediaFrame class="pj-hf" size="full" aspect="16 / 8" aspectM={pr.aspectM} world={pr.world} material={pr.material} screens={pr.full} credit={pr.credit} scrim="left">
          <StatusTag status={p.status} label={pr.statusLabel} class="pj-tag" />
          <h1 id="pj-h" class="pj-h">{p.name}</h1>
          {p.tagline && <p class="pj-tl">{p.tagline}</p>}
        </MediaFrame>
      )
    }
  </section>

  <!-- ═══ SUMMARY + RECORD ═══ -->
  <section class="pj-in shell" aria-label="Summary">
    <div class="inset pj-in-g">
      <p class="pj-sum">{p.summary}</p>
      <dl class="pj-facts">
        <div>
          <dt>Field</dt>
          <dd>{domain}</dd>
        </div>
        {
          p.url && (
            <div>
              <dt>Live at</dt>
              <dd>
                <a class="lnk" href={p.url} target="_blank" rel="noopener">
                  {p.urlLabel}
                  <span class="ar" aria-hidden="true">↗</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </dd>
            </div>
          )
        }
        {
          p.capability && (
            <div>
              <dt>Capability</dt>
              <dd>
                <a class="lnk" href={p.capability.href}>
                  {p.capability.label} <span class="ar" aria-hidden="true">→</span>
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <!-- ═══ THE PROBLEM: one paragraph that lights up ═══ -->
  <section class="pj-pb shell" aria-labelledby="pb-h">
    <div class="inset">
      <h2 id="pb-h" class="t-label t-mute pj-k">The problem</h2>
      <p class="pj-pbt" data-light>
        {problemWords.map((w) => <><span class="lw">{w}</span>{' '}</>)}
      </p>
    </div>
  </section>

  <!-- ═══ WHAT WE BUILT (bone, round 4): the statement across the page, the stack as one line,
       then the real screens at reading size (desktop screens ≥ 10 of 12 columns, 2x files) ═══ -->
  <section class="pj-sol tone-bone" aria-labelledby="sol-h">
    <div class="shell">
      <div class="inset">
        <h2 id="sol-h" class="t-label pj-k pj-k--bone">What we built</h2>
        <p class="pj-solt" data-rise>{p.solution}</p>
        <div class="tech">
          <h3 class="tech-h">Built with</h3>
          <ul>
            {p.technology.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        {
          p.slug === 'aicrmius' && (
            <ol class="cyc" aria-label="The cycle every agent change goes through in the working build">
              {CYCLE.map((c, i) => (
                <li>
                  <span class="cyc-n tnum">{i + 1}</span>
                  <b class="cyc-k">{c.k}</b>
                  <span class="cyc-d">{c.d}</span>
                </li>
              ))}
            </ol>
          )
        }
        {
          galDesk.length > 0 && (
            <div class="gal">
              {galDesk.map((im, i) => (
                <figure class:list={['gal-i', { 'gal-i--r': i % 2 === 1 }]}>
                  <img class="scr-img" src={im.src} srcset={hires(im)} sizes="(max-width: 900px) 100vw, 86vw" alt={im.alt} width={im.w} height={im.h} loading="lazy" decoding="async" />
                  {im.caption && <figcaption>{im.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )
        }
        {
          galPhone.length > 0 && (
            <div class="gal-ph">
              {galPhone.map((im) => (
                <figure class="gal-p">
                  <img class="scr-img" src={im.src} srcset={hires(im)} sizes="(max-width: 900px) 78vw, 340px" alt={im.alt} width={im.w} height={im.h} loading="lazy" decoding="async" />
                  {im.caption && <figcaption>{im.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ═══ WHERE IT STANDS ═══ -->
  <section class="pj-st shell pad-lg" aria-labelledby="st-h">
    <div class="inset pj-st-g">
      <div class="pj-st-l">
        <h2 id="st-h" class="t-label t-mute pj-k">Where it stands</h2>
        <StatusTag status={p.status} label={pr.statusLabel} class="pj-st-tag" />
        <p class="pj-out" data-rise>{p.outcome}</p>
      </div>
      <div class="pj-st-r">
        {
          (p.role || p.client) && (
            <div class="pj-blk">
              <h3 class="t-label t-mute">INNOVA’s role</h3>
              {p.role && <p>{p.role}</p>}
              {p.client && <p class="pj-client">{p.client}</p>}
            </div>
          )
        }
        {
          p.lookingFor && (
            <div class="pj-blk pj-ask">
              <h3 class="t-label t-mute">Looking for</h3>
              <p>{p.lookingFor}</p>
              <Button openContact variant="flare" size="sm">Write to INNOVA</Button>
            </div>
          )
        }
        {
          !p.role && !p.client && !p.lookingFor && p.capability && (
            <div class="pj-blk">
              <h3 class="t-label t-mute">Part of</h3>
              <a class="lnk" href={p.capability.href}>
                {p.capability.label} <span class="ar" aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ═══ RELATED ═══ -->
  <section class="pj-rel shell" aria-labelledby="rel-h">
    <div class="inset">
      <SectionHead id="rel-h" title="Related work" size="h2" link={{ href: '/projects', label: 'All projects' }} />
    </div>
    <div class="rel-g">
      {related.map((r) => <ProjectTile project={r} size="half" />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  .pj-top {
    padding-top: clamp(20px, 2.4vw, 36px);
  }
  .pj-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(16px, 1.8vw, 24px);
    color: var(--ash);
  }
  .pj-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .pj-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  :global(.pj-hf .pj-tag) {
    margin-bottom: 16px;
  }
  .pj-h {
    font-size: clamp(40px, 4.6vw, 76px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }
  .pj-tl {
    margin-top: 10px;
    font-size: clamp(22px, 1.9vw, 30px);
    letter-spacing: -0.022em;
    line-height: 1.12;
    color: var(--ash);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pj-hf {
      animation: pj-gate 0.95s var(--e-gate) both;
    }
    .pj-hf :global(.mf-world img) {
      animation: pj-settle 1.8s var(--e-out) both;
    }
    .pj-h,
    .pj-tl,
    .pj-hf :global(.pj-tag) {
      animation: pj-up 0.9s var(--e-out) 0.28s both;
    }
    .pj-tl {
      animation-delay: 0.38s;
    }
  }
  @keyframes pj-gate {
    from {
      clip-path: inset(5% 3% 5% 3% round 6px);
    }
    to {
      clip-path: inset(0 0 0 0 round 6px);
    }
  }
  @keyframes pj-settle {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes pj-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── summary + record ── */
  .pj-in {
    padding-block: clamp(48px, 6vw, 104px) 0;
  }
  .pj-in-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 40px;
    align-items: start;
  }
  .pj-sum {
    grid-column: 1 / span 7;
    font-size: clamp(21px, 1.8vw, 28px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .pj-facts {
    grid-column: 9 / span 4;
    margin: 0;
    display: grid;
    gap: 18px;
    padding-top: 6px;
  }
  .pj-facts dt {
    font-size: 15px;
    color: var(--ash);
  }
  .pj-facts dd {
    margin: 4px 0 0;
    font-size: 19px;
    font-weight: 500;
  }
  .pj-facts dd :global(.tag) {
    font-size: 19px;
  }

  /* ── problem ── */
  .pj-pb {
    padding-block: calc(var(--sec) * 0.8) var(--sec);
  }
  .pj-k {
    margin-bottom: 24px;
  }
  .pj-pbt {
    font-size: clamp(28px, 3.1vw, 52px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    max-width: 26ch;
  }
  .light-ready .lw {
    color: rgb(238 234 226 / 0.44); /* ≥3:1 for large text even before it lights up */
    transition: color 0.4s var(--e-out);
  }
  .light-ready .lw.lit {
    color: var(--print);
  }

  /* ── what we built (bone) ── */
  .pj-sol {
    padding-block: var(--sec);
  }
  .pj-k--bone {
    color: var(--copy-ink);
  }
  .pj-solt {
    max-width: 30ch;
    font-size: clamp(28px, 3vw, 50px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.032em;
    text-wrap: pretty;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
    margin-top: clamp(28px, 3vw, 44px);
    max-width: 1100px;
  }
  .tech-h {
    font-size: 17px;
    font-weight: 600;
  }
  .tech ul {
    display: contents;
    list-style: none;
  }
  .tech li {
    padding: 6px 12px;
    border-radius: var(--r);
    background: var(--bone-2);
    font-size: 17px;
    line-height: 1.35;
    color: var(--ink);
  }
  .gal {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: clamp(48px, 5vw, 88px);
    margin-top: clamp(56px, 6vw, 104px);
  }
  .gal-i {
    grid-column: 1 / span 11;
    margin: 0;
  }
  .gal-i--r {
    grid-column: 2 / span 11;
  }
  .gal figcaption,
  .gal-ph figcaption {
    margin-top: 16px;
    max-width: 64ch;
    font-size: 17px;
    line-height: 1.45;
    color: var(--copy-ink);
  }
  /* Softer plate shadow on bone so it never reads as a tinted box behind the caption. */
  .gal :global(.scr-img),
  .gal-ph :global(.scr-img) {
    width: 100%;
    box-shadow:
      0 0 0 1px var(--rule-ink),
      0 28px 44px -34px rgb(20 19 16 / 0.45);
  }
  .gal-ph {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(48px, 5vw, 88px);
    padding-left: calc(100% / 12);
  }
  .gal-p {
    margin: 0;
    width: min(340px, 78vw);
  }
  .cyc {
    list-style: none;
    margin: clamp(48px, 5vw, 88px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .cyc li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: clamp(20px, 2vw, 30px);
    background: var(--print);
    border-radius: var(--r);
  }
  .cyc li:last-child {
    background: var(--ink);
    color: var(--print);
  }
  .cyc-n {
    font-size: 15px;
    font-weight: 600;
    color: var(--flare-ink);
  }
  .cyc li:last-child .cyc-n {
    color: var(--flare);
  }
  .cyc-k {
    font-size: clamp(28px, 2.6vw, 44px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .cyc-d {
    font-size: 17px;
    line-height: 1.45;
    color: var(--copy-ink);
  }
  .cyc li:last-child .cyc-d {
    color: var(--copy);
  }

  /* ── where it stands ── */
  .pj-st-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: start;
  }
  .pj-st-l {
    grid-column: 1 / span 10;
  }
  :global(.pj-st-tag) {
    font-size: 17px !important;
  }
  .pj-out {
    margin-top: 22px;
    font-size: clamp(28px, 2.9vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: pretty;
  }
  .pj-st-r {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px var(--col-gap);
  }
  .pj-blk {
    padding: clamp(22px, 2vw, 32px);
    border-radius: var(--r);
    background: var(--reel);
  }
  .pj-blk h3 {
    margin-bottom: 10px;
  }
  .pj-blk p {
    font-size: var(--fs-copy);
    line-height: 1.5;
    color: var(--copy);
  }
  .pj-client {
    margin-top: 10px;
  }
  .pj-ask :global(.btn) {
    margin-top: 18px;
  }

  /* ── related ── */
  .pj-rel {
    padding-bottom: 0;
  }
  .rel-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }

  @media (max-width: 900px) {
    .pj-sum,
    .pj-facts,
    .pj-st-l,
    .pj-st-r {
      grid-column: 1 / -1;
    }
    .pj-st-r {
      grid-template-columns: 1fr;
    }
    .pj-facts {
      gap: 18px;
    }
    .gal-i,
    .gal-i--r {
      grid-column: 1 / -1;
    }
    .gal-ph {
      padding-left: 0;
    }
    .cyc {
      grid-template-columns: 1fr;
    }
    .tech li {
      font-size: 16px;
    }
    .rel-g {
      grid-template-columns: 1fr;
    }
  }
</style>
