---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusTag from '../../components/StatusTag.astro';
import ProjectTile from '../../components/projects/ProjectTile.astro';
import { PRESETS } from '../../components/projects/presets';
import { visibleProjects, projectHref, type ProjectStatus } from '../../data/projects';
import { SITE } from '../../data/site';

const order: ProjectStatus[] = ['live', 'built', 'in-development', 'prototype', 'research', 'exploring'];
const projects = [...visibleProjects].sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status));
const entityId = (p: (typeof projects)[number]) =>
  `${SITE.url}${projectHref(p)}#${p.domain === 'dual-use' ? 'project' : 'app'}`;

const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const word = (n: number) => WORDS[n] ?? String(n);
const liveN = projects.filter((p) => p.status === 'live').length;

/* Projects with real screenshots get a «screen in its world» frame; the rest sit in one compact lab row. */
const shown = projects.filter((p) => !PRESETS[p.slug]?.words);
const lab = projects.filter((p) => PRESETS[p.slug]?.words);
const [lead, ...rest] = shown;

/* Filter chips: one per status that has projects. */
/* Status meanings live on the chips (title), not in a paragraph. */
const MEANING: Partial<Record<ProjectStatus, string>> = {
  live: 'Runs in production and is open to the public',
  'in-development': 'The core works; the product is being engineered toward release',
  prototype: 'A working version for testing and demonstrations',
  exploring: 'Early scouting, nothing delivered yet'
};
const chips = order.map((s) => ({ s, n: projects.filter((p) => p.status === s).length })).filter((c) => c.n > 0);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'INNOVA projects',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}${projectHref(p)}`,
    name: p.name,
    item: { '@id': entityId(p) }
  }))
};
---

<BaseLayout
  title="Projects: Live Products, Prototypes & R&D | INNOVA"
  description="INNOVA projects with their real status: live platforms, products in development, working prototypes and R&D across applied AI, software and AgriTech."
  path="/projects"
  jsonLd={[itemList]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' }
  ]}
>
  <section class="px shell" aria-labelledby="px-h">
    <div class="inset px-hd">
      <p class="t-label px-crumb"><a href="/">INNOVA</a><span aria-hidden="true">/</span><span>Projects</span></p>
      <h1 id="px-h" class="px-t">{word(projects.length)} projects. {word(liveN)} live.</h1>
      <div class="px-chips" role="group" aria-label="Filter projects by status" data-filter>
        <button type="button" class="px-chip on" aria-pressed="true" data-f="all">All <span class="tnum">{projects.length}</span></button>
        {
          chips.map((c) => (
            <button type="button" class="px-chip" aria-pressed="false" data-f={c.s} title={MEANING[c.s]}>
              <StatusTag status={c.s} /> <span class="tnum">{c.n}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="px-grid" data-grid>
      <ProjectTile project={lead} size="full" eager headingLevel="h2" id={lead.slug} data-s={lead.status} aspect="16 / 7.6" />
      {rest.map((p, i) => <ProjectTile project={p} size="half" eager={i < 2} headingLevel="h2" id={p.slug} data-s={p.status} />)}
    </div>

    {
      lab.length > 0 && (
        <div class="px-lab" aria-labelledby="lab-h">
          <h2 id="lab-h" class="t-h3 px-lab-k inset">In the lab</h2>
          <ul class="px-lab-g">
            {lab.map((p) => (
              <li data-s={p.status} id={p.slug}>
                <a href={projectHref(p)} class="px-li">
                  <StatusTag status={p.status} label={PRESETS[p.slug]?.statusLabel} />
                  <span class="px-ln">
                    {p.short}
                    <span class="ar" aria-hidden="true">→</span>
                  </span>
                  <span class="px-ld">{p.tagline}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  // Status chips filter the frames and the lab row. Without JS the chips stay hidden and everything shows.
  const box = document.querySelector<HTMLElement>('[data-filter]');
  if (box) {
    const items = [...document.querySelectorAll<HTMLElement>('.px [data-s]')];
    const chips = [...box.querySelectorAll<HTMLButtonElement>('[data-f]')];
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const f = c.dataset.f;
        chips.forEach((x) => {
          x.classList.toggle('on', x === c);
          x.setAttribute('aria-pressed', x === c ? 'true' : 'false');
        });
        items.forEach((it) => {
          const st = it.dataset.s;
          const match = f === 'all' || st === f;
          it.hidden = !match;
        });
        document.querySelectorAll<HTMLElement>('.px-lab').forEach((l) => (l.hidden = ![...l.querySelectorAll<HTMLElement>('[data-s]')].some((x) => !x.hidden)));
      })
    );
  }
</script>

<style>
  .px {
    padding-top: clamp(28px, 3.4vw, 56px);
  }
  .px-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 18px;
    align-items: end;
    margin-bottom: clamp(24px, 2.6vw, 40px);
  }
  .px-crumb {
    grid-column: 1 / -1;
    display: flex;
    gap: 10px;
    color: var(--ash);
  }
  .px-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .px-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .px-t {
    grid-column: 1 / -1;
    font-size: clamp(44px, 6.4vw, 108px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.92;

  }
  .px-chips {
    grid-column: 1 / -1;
    display: none;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  :global(.js) .px-chips {
    display: flex;
  }
  .px-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--rule-film);
    background: transparent;
    color: var(--print);
    font: 500 15px/1 var(--font);
    cursor: pointer;
    transition:
      background-color var(--t-micro) var(--e-out),
      border-color var(--t-micro) var(--e-out);
  }
  .px-chip .tnum {
    color: var(--ash);
  }
  .px-chip:hover {
    border-color: var(--ash);
  }
  .px-chip.on {
    background: var(--print);
    color: var(--ink);
    border-color: var(--print);
  }
  .px-chip.on .tnum,
  .px-chip.on :global(.tag) {
    color: var(--ink);
  }
  .px-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .px-grid > :global(.mf--full) {
    grid-column: 1 / -1;
  }
  .px-grid > :global([hidden]) {
    display: none !important;
  }

  /* lab row: three compact solid tiles (no ruled rows) */
  .px-lab {
    margin-top: clamp(48px, 5vw, 88px);
  }
  .px-lab-k {
    margin-bottom: clamp(18px, 2vw, 28px);
  }
  .px-lab-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
  }
  .px-lab-g > [hidden] {
    display: none;
  }
  .px-li {
    display: grid;
    align-content: start;
    gap: 10px;
    height: 100%;
    padding: clamp(22px, 2vw, 32px);
    border-radius: var(--r);
    background: var(--reel);
    text-decoration: none;
    color: var(--ash);
    transition: background-color var(--t-micro) var(--e-out);
  }
  .px-li:hover {
    background: var(--reel-2);
  }
  .px-ln {
    margin-top: 8px;
    font-size: clamp(26px, 2.2vw, 36px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--print);
  }
  .px-ln .ar {
    display: inline-block;
    margin-left: 6px;
    font-weight: 400;
    transition: transform 0.3s var(--e-out);
  }
  .px-li:hover .ar {
    transform: translateX(6px);
  }
  .px-ld {
    font-size: 18px;
    color: var(--ash);
  }
  @keyframes px-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .px-t,
    .px-chips {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
    :global(.js) .px-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--in) * -1 - var(--gut));
      padding-inline: calc(var(--in) + var(--gut));
      scrollbar-width: none;
    }
    .px-chip {
      flex: none;
    }
    .px-grid {
      grid-template-columns: 1fr;
    }
    .px-lab-g {
      grid-template-columns: 1fr;
    }
  }
</style>
