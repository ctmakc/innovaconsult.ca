---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import StatusTag from '../../components/StatusTag.astro';
import ProjectTile from '../../components/projects/ProjectTile.astro';
import { visibleProjects, STATUS_LABEL, projectHref, type ProjectStatus } from '../../data/projects';
import { SITE } from '../../data/site';

const order: ProjectStatus[] = ['live', 'built', 'in-development', 'prototype', 'research', 'exploring'];
const projects = [...visibleProjects].sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status));
const entityId = (p: (typeof projects)[number]) =>
  `${SITE.url}${projectHref(p)}#${p.domain === 'dual-use' ? 'project' : 'app'}`;

const LEGEND: Record<ProjectStatus, string> = {
  live: 'Running in production and open to the public.',
  built: 'Complete and working; release or rollout in progress.',
  'in-development': 'The core works; the product is being engineered toward release.',
  prototype: 'A working version used for testing and demonstrations.',
  research: 'Applied research: hypotheses, experiments and feasibility.',
  exploring: 'Early scouting and program research; nothing delivered yet.',
  'partner-opportunity': ''
};
const TONE: Record<ProjectStatus, string> = {
  live: 'live',
  built: 'build',
  'in-development': 'build',
  prototype: 'proto',
  research: 'proto',
  exploring: 'explore',
  'partner-opportunity': 'explore'
};
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const count = (n: number) => `${WORDS[n] ?? n} project${n === 1 ? '' : 's'}`;

/* One chapter per status that has projects; an odd chapter opens with one full-width frame. */
const chapters = order
  .map((s) => ({ s, items: projects.filter((p) => p.status === s) }))
  .filter((c) => c.items.length > 0);
/* A lone typographic frame stays short so the page keeps moving. */
const SHORT: Record<string, string> = { aicrmius: '16 / 6', 'dual-use': '16 / 5' };

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'INNOVA projects',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}${projectHref(p)}`,
    name: p.name,
    item: { '@id': entityId(p) }
  }))
};
---

<BaseLayout
  title="Projects: Live Products, Prototypes & R&D | INNOVA"
  description="INNOVA projects with their real status: live platforms, products in development, working prototypes and R&D across applied AI, software and AgriTech."
  path="/projects"
  jsonLd={[itemList]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' }
  ]}
>
  <PageHead
    crumb="Projects"
    title="Real work, with its real status."
    lede={`${WORDS[projects.length] ? WORDS[projects.length][0].toUpperCase() + WORDS[projects.length].slice(1) : projects.length} projects across applied AI, software and AgriTech. Every project carries exactly one status.`}
  >
    <nav slot="aside" class="px-idx" aria-label="Projects by status">
      {
        chapters.map((c) => (
          <a href={`#${c.s}`} class="px-ii">
            <StatusTag status={c.s} />
            <span class="px-ic tnum">{c.items.length}</span>
          </a>
        ))
      }
    </nav>
  </PageHead>

  {
    chapters.map((c, ci) => (
      <section class:list={['px-ch shell', { 'px-ch--first': ci === 0 }]} id={c.s} aria-labelledby={`${c.s}-h`}>
        <div class="inset px-hd">
          <h2 id={`${c.s}-h`} class:list={['px-t', ci === 0 ? 't-h2' : 't-h3']} data-rise>
            <span class="px-g" data-tone={TONE[c.s]} aria-hidden="true" />
            <span class="px-k">{STATUS_LABEL[c.s]}.</span> <span class="px-d">{LEGEND[c.s]}</span>
          </h2>
          <p class="px-n t-label t-mute">{count(c.items.length)}</p>
        </div>
        <div class="px-grid">
          {c.items.map((p, i) => {
            const full = c.items.length % 2 === 1 && i === 0;
            return <ProjectTile project={p} size={full ? 'full' : 'half'} aspect={full && c.items.length === 1 ? SHORT[p.slug] : undefined} id={p.slug} />;
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* ── head aside: the status index ── */
  .px-idx {
    display: grid;
    gap: 2px;
    max-width: 22rem;
  }
  .px-ii {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding: 6px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--rule-film);
  }
  .px-ii :global(.tag) {
    font-size: 17px;
  }
  .px-ic {
    font-size: 17px;
    font-weight: 500;
    color: var(--ash);
    transition: transform 0.3s var(--e-out), color 0.3s var(--e-out);
  }
  .px-ii:hover .px-ic {
    color: var(--print);
    transform: translateX(-4px);
  }

  /* ── chapters ── */
  .px-ch {
    padding-top: calc(var(--sec) * 0.72);
  }
  .px-ch--first {
    padding-top: 0;
  }
  .px-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 14px;
    align-items: end;
    margin-bottom: clamp(24px, 3vw, 44px);
  }
  .px-t {
    grid-column: 1 / span 10;
    max-width: 30ch;
  }
  .px-ch--first .px-t {
    max-width: 22ch;
  }
  .px-k {
    white-space: nowrap;
  }
  .px-d {
    color: var(--ash);
  }
  .px-n {
    grid-column: 11 / span 2;
    justify-self: end;
    padding-bottom: 0.4em;
    white-space: nowrap;
  }
  /* status by form, at heading scale */
  .px-g {
    display: inline-block;
    width: 0.36em;
    height: 0.36em;
    margin: 0 0.2em 0.12em 0;
    border-radius: 50%;
    vertical-align: middle;
  }
  .px-g[data-tone='live'] {
    background: var(--flare);
    box-shadow: 0 0 0 0.09em rgb(255 91 34 / 0.22);
  }
  .px-g[data-tone='build'] {
    background: var(--print);
  }
  .px-g[data-tone='proto'] {
    border: 0.06em solid var(--print);
  }
  .px-g[data-tone='explore'] {
    border: 0.06em dashed var(--print);
  }
  .px-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .px-grid > :global(.mf--full),
  .px-grid > :global(.tf--full) {
    grid-column: 1 / -1;
  }

  @media (max-width: 900px) {
    .px-t {
      grid-column: 1 / -1;
    }
    .px-n {
      grid-column: 1 / -1;
      justify-self: start;
      padding-bottom: 0;
      order: -1;
    }
    .px-grid {
      grid-template-columns: 1fr;
    }
    .px-idx {
      max-width: none;
    }
  }
</style>
