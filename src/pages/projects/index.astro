---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import StatusChip from '../../components/StatusChip.astro';
import StageTrack from '../../components/StageTrack.astro';
import PipelineBoard from '../../components/PipelineBoard.astro';
import { visibleProjects, STATUS_STAGE, STATUS_LABEL, DOMAINS, projectHref, type ProjectStatus } from '../../data/projects';
import { SITE } from '../../data/site';

const order: ProjectStatus[] = ['live', 'built', 'in-development', 'prototype', 'research', 'exploring'];
const projects = [...visibleProjects].sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status));
const domainLabel = (k: string) => DOMAINS.find((d) => d.key === k)?.label ?? k;
const entityId = (p: (typeof projects)[number]) =>
  `${SITE.url}${projectHref(p)}#${p.domain === 'dual-use' ? 'project' : 'app'}`;

const LEGEND: Record<ProjectStatus, string> = {
  live: 'Running in production and open to the public.',
  built: 'Complete and working; release or rollout in progress.',
  'in-development': 'The core works; the product is being engineered toward release.',
  prototype: 'A working version used for testing and demonstrations.',
  research: 'Applied research: hypotheses, experiments and feasibility.',
  exploring: 'Early scouting and program research; nothing delivered yet.',
  'partner-opportunity': ''
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'INNOVA projects',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}${projectHref(p)}`,
    name: p.name,
    item: { '@id': entityId(p) }
  }))
};
---

<BaseLayout
  title="Projects: Live Products, Prototypes & R&D | INNOVA"
  description="INNOVA projects with their real status: live platforms, products in development, working prototypes and R&D across applied AI, software and AgriTech."
  path="/projects"
  jsonLd={[itemList]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects' }
  ]}
>
  <PageHead
    crumb="Projects"
    title="Real work, with its real status."
    lede="Every project carries exactly one status. Live is open to the public today; Built is complete and rolling out; Prototype works and is being tested; R&D is testing feasibility; Exploring is early scouting with nothing delivered yet."
  />

  <section class="section">
    <div class="wrap pr-board">
      <PipelineBoard />
    </div>
  </section>

  <section class="section" aria-labelledby="pr-list-h">
    <div class="wrap">
      <h2 id="pr-list-h" class="sr-only">All projects</h2>
      <div class="rows">
        {
          projects.map((p) => {
            const shot = p.images?.find((im) => im.w > im.h);
            return (
              <a
                class:list={['row prow', { 'has-shot': !!shot }]}
                href={projectHref(p)}
                id={p.slug}
              >
                <div class="row-title">
                  <p class="mono prow-code">
                    {p.code} · {domainLabel(p.domain)}
                  </p>
                  <h2 id={`${p.slug}-t`} class="d-m">
                    {p.name}
                  </h2>
                  {p.tagline && <p class="prow-tag">{p.tagline}</p>}
                </div>
                <div>
                  {shot && (
                    <span class="prow-shot" aria-hidden="true">
                      <img src={shot.src800} width="800" height={Math.round((800 * shot.h) / shot.w)} alt="" loading="lazy" decoding="async" />
                    </span>
                  )}
                  <p id={`${p.slug}-d`} class="body">
                    {p.summary}
                  </p>
                  <p class="body prow-out">
                    <strong>Where it stands:</strong> {p.outcome}
                  </p>
                </div>
                <div class="prow-meta" id={`${p.slug}-s`}>
                  <StatusChip status={p.status} />
                  <StageTrack at={STATUS_STAGE[p.status]} status={p.status} />
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section pr-legend">
    <div class="wrap grid12 sec-head">
      <div class="sh-l">
        <h2 class="d-l">How we label status</h2>
      </div>
      <dl class="sh-r legend">
        {
          order.map((s) => (
            <div>
              <dt>
                <span class="status">
                  <span class="mark" data-s={s} aria-hidden="true" />
                  {STATUS_LABEL[s]}
                </span>
              </dt>
              <dd>{LEGEND[s]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .prow-code {
    color: var(--lichen);
    margin: 0 0 8px;
  }
  .prow h2 {
    margin: 0;
  }
  .prow-tag {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--lichen);
  }
  .prow-out {
    margin-top: 12px;
    font-size: 0.95rem;
  }
  .prow-meta {
    display: grid;
    gap: 12px;
  }

  /* Screenshot plate: pinned over columns 10–12, opens on hover or keyboard focus. */
  .prow-shot {
    position: absolute;
    z-index: 2;
    right: 0;
    top: clamp(22px, 2.4vw, 34px);
    width: min(320px, 25%);
    aspect-ratio: 16 / 10;
    background: var(--plate);
    border: 1px solid var(--rule-strong);
    overflow: hidden;
    pointer-events: none;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .prow-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  a.prow.has-shot:hover .prow-shot,
  a.prow.has-shot:focus-visible .prow-shot {
    clip-path: inset(0 0 0 0);
  }
  a.prow.has-shot:hover::after,
  a.prow.has-shot:focus-visible::after {
    opacity: 0;
  }
  @media (hover: none) {
    .prow-shot {
      display: none;
    }
  }

  .pr-legend {
    padding-bottom: 72px;
  }
  .legend {
    margin: 0;
    grid-column: 6 / span 7 !important;
  }
  .legend div {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .legend dd {
    margin: 0;
    color: var(--lichen);
  }
  @media (max-width: 860px) {
    /* Phone: the screenshot sits inline under the title as a 16:9 thumbnail. */
    .prow-shot,
    a.prow.has-shot:hover .prow-shot {
      display: block;
      position: static;
      width: 100%;
      aspect-ratio: 16 / 9;
      clip-path: none;
      transition: none;
      margin: 4px 0 16px;
      border-color: var(--rule);
    }
    .legend {
      grid-column: 1 / -1 !important;
    }
    .legend div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
