---
import BaseLayout from '../layouts/BaseLayout.astro';
import RiseHeading from '../components/RiseHeading.astro';
import PipelineBoard from '../components/PipelineBoard.astro';
import StageTrack from '../components/StageTrack.astro';
import StatusChip from '../components/StatusChip.astro';
import StageLine from '../components/StageLine.astro';
import { CAPABILITIES } from '../data/capabilities';
import { SECTORS, ENGAGEMENT_LABEL, type Engagement } from '../data/sectors';
import { PARTNERSHIP_MODELS } from '../data/partnerships';
import { visibleProjects, featuredProjects, STATUS_STAGE, STATUS_LABEL, type Project, type ProjectStatus } from '../data/projects';
import { STAGES } from '../data/stages';
import { SITE } from '../data/site';

const hrefOf = (p: Project) => p.internal ?? `/projects/${p.slug}`;
const bySlug = new Map(visibleProjects.map((p) => [p.slug, p]));

/* In brief: portfolio counts come from the data, so the copy never drifts. */
const PLURAL: Partial<Record<ProjectStatus, string>> = {
  prototype: 'prototypes',
  'partner-opportunity': 'partner opportunities'
};
const countPhrases = (Object.keys(STATUS_LABEL) as ProjectStatus[])
  .map((s) => ({ s, n: visibleProjects.filter((p) => p.status === s).length }))
  .filter(({ n }) => n > 0)
  .map(({ s, n }) => {
    const label = STATUS_LABEL[s];
    const word = /^[A-Z&]+$/.test(label) ? label : label.toLowerCase();
    if (s === 'research') return `${n} in ${word}`;
    return `${n} ${n > 1 && PLURAL[s] ? PLURAL[s] : word}`;
  });
const counts =
  countPhrases.length > 1 ? `${countPhrases.slice(0, -1).join(', ')} and ${countPhrases.at(-1)}` : countPhrases.join('');
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const word = (n: number) => WORDS[n] ?? String(n);
const totalWord = word(visibleProjects.length);
const boardWord = word(featuredProjects.length);

/* Hero trust line: years counted at build time from the founder's start year. */
const practiceYears = new Date().getFullYear() - Number(SITE.experienceSince);

/* Corporate record strip. Owner law (external-links-hidden): the registry link renders without href,
   base64 in data-x, opened by the script at the bottom (same mechanism as /about). */
const registryB64 = btoa(`https://ised-isde.canada.ca/cc/lgcy/fdrlCrpDtls.html?corpId=${SITE.corporationNumber.replace('-', '')}`);

/* Partners: the four parts of a funded project, worded exactly as on /innovation. */
const funded = [
  'A written technical question and the uncertainty behind it.',
  'A starting point and a target for the work.',
  'Two or three milestones, each ending in something a reviewer can run.',
  'Measured results, including the experiments that failed.'
];

/* What we do: the projects that prove each capability. */
const capRows = CAPABILITIES.map((c) => ({
  c,
  proof: (c.projects ?? []).map((slug) => bySlug.get(slug)).filter((p): p is Project => Boolean(p))
}));

/* How we work: one short line per station, plus the projects standing on it today. */
const stageNotes = [
  'We study how the organization works today.',
  'We test the options against real data first.',
  'A working version that real users can try.',
  'Security, permissions and audit built in.',
  'Rolled out inside the tools people already use.',
  'Time, cost, errors and adoption against the baseline.'
];
const stageLinks = STAGES.map((_, i) =>
  visibleProjects.filter((p) => STATUS_STAGE[p.status] === i).map((p) => ({ label: p.short, href: hrefOf(p) }))
);

/* Workflow OS */
const wosFlow = ['Company', 'Processes', 'Score', 'Select', 'Design', 'Implement', 'Measure'];
const wosFactors = [
  'Time consumed',
  'Volume',
  'Rework',
  'Waiting time',
  'Client and revenue impact',
  'Standardization',
  'Data readiness',
  'System readiness',
  'Rule clarity',
  'Exception predictability',
  'Repeatability',
  'Scalability',
  'Employee pain',
  'Management priority'
];

/* Domains, grouped by how far INNOVA is in each. Marks reuse the board's vocabulary. */
const engagementMark: Record<Engagement, string> = { building: 'prototype', researching: 'research', exploring: 'exploring' };
const domainGroups = (['building', 'researching', 'exploring'] as Engagement[])
  .map((e) => ({ e, label: ENGAGEMENT_LABEL[e], rows: SECTORS.filter((s) => s.engagement === e) }))
  .filter((g) => g.rows.length > 0);

/* Projects: real screenshots (captured 2026-10-01, see .proof-staging/MANIFEST.json). */
const shots: Record<string, { src: string; alt: string; cap: string; light?: boolean }> = {
  uafest: {
    src: '/proof/uafest-applications-1440-800.webp',
    alt: 'UAFest 2027 sign-up page on uafest.ca: one form with participation types for guests, volunteers, vendors, performers, sponsors, Unity Ride drivers, the Rushnyk and the organizing team.',
    cap: 'The 2027 sign-up list: one form files every participant type into the CRM.',
    light: true
  },
  foundwall: {
    src: '/proof/foundwall-home-1440-800.webp',
    alt: 'FoundWall homepage at 1440 px: Lost, Stolen, Found headline beside sample notices for a bike, a beagle, a robotic mower and a reunited bike.',
    cap: 'FoundWall public homepage, foundwall.com (sample notices).',
    light: true
  },
  'workflow-os': {
    src: '/proof/workflow-os-opportunity-map-1440-800.webp',
    alt: 'Workflow OS Opportunity Map: 15 processes plotted by business value and implementation feasibility, with Client Onboarding ranked first at 88 and its score broken into value, feasibility, strategic fit and risk.',
    cap: 'Opportunity Map for a fictional demo company.'
  },
  openfield: {
    src: '/proof/openfield-season-report-1440-800.webp',
    alt: 'OpenField season report preview: block-by-week pass grid and report figures such as hectares completed and passes on time, each tagged with its data source.',
    cap: 'Season report preview on a simulated 2027 season (demo data).',
    light: true
  }
};
const MOBILE_SHOT: ProjectStatus[] = ['live', 'built', 'prototype'];

/* Credibility */
const path = [
  {
    when: `From ${SITE.experienceSince}`,
    what: 'The founder’s business practice with small and mid-sized companies in more than 50 countries.'
  },
  { when: 'Then', what: 'Digital systems for client companies.' },
  { when: 'Then', what: 'Software products built and run in-house.' },
  { when: 'Now', what: 'Applied innovation in Canada, open to partners.', now: true }
];
---

<BaseLayout
  title="INNOVA · Applied AI & Software Company in Ottawa, Canada"
  description="INNOVA researches, prototypes, builds and deploys applied AI and custom software in Ottawa, with every project shown at its real stage, from R&D to live use."
  path="/"
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap grid12 hero-grid">
      <div class="hero-copy">
        <p class="kicker hero-eyebrow">Applied innovation · {SITE.city}, {SITE.country}</p>
        <RiseHeading text="Turning complex opportunities into working technology." />
        <p class="lede hero-lede">
          INNOVA researches, prototypes, builds and deploys applied AI and software<span class="lede-more">, and sets up joint projects with companies, researchers and public organizations</span>.
        </p>
        <p class="hero-trust">
          <span>{SITE.city}, {SITE.country} ·</span> <span>Federal corporation since {SITE.incorporated} ·</span>
          <span>Founder in business since {SITE.experienceSince} ({practiceYears} years)</span>
        </p>
        <div class="hero-ctas">
          <a href="/projects" class="btn btn-primary">Explore what we build <span class="arr" aria-hidden="true">→</span></a>
          <a href="/partnerships" class="btn btn-ghost hero-sec"
            ><span>Partner with INNOVA</span><span class="hero-sec-arr" aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="hero-board">
        <PipelineBoard only="featured" />
      </div>
    </div>
  </section>

  <!-- IN BRIEF -->
  <section class="brief" aria-labelledby="brief-h">
    <div class="wrap grid12">
      <h2 id="brief-h" class="meta brief-h">In brief</h2>
      <p class="brief-p">
        <strong>INNOVA ({SITE.legalName})</strong> is an applied-innovation and technology company in {SITE.city}, {SITE.region}, incorporated
        federally in {SITE.incorporated}. It researches, prototypes, builds and deploys applied AI and software. Its {totalWord} projects each
        show their real stage: {counts}. The board above shows {boardWord}; all {totalWord} are on the
        <a href="/projects" class="ulink brief-a">Projects page</a>.
      </p>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section" id="what-we-do">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l">
          <h2 class="d-xl">Four capabilities on one line.</h2>
        </div>
        <p class="body sh-r">
          Each capability covers a stretch of the path from first opportunity to measured impact. The track on each row shows which stretch.
        </p>
      </div>
      <div class="rows">
        {
          capRows.map(({ c, proof }) => (
            <a class="row caprow" href={c.href}>
              <h3 class="d-m row-title">{c.name}</h3>
              <p class="body">{c.line}</p>
              <div class="cap-trk">
                <StageTrack span={c.span} />
                {proof.length > 0 && (
                  <ul class="cap-proof" aria-label={`Projects that show ${c.name}`}>
                    {proof.map((p) => (
                      <li>
                        <span class="cap-code">{p.code}</span> {p.short}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW WE WORK: the one full-bleed band -->
  <section class="section band" id="how-we-work">
    <div class="wrap">
      <div class="grid12 sec-head band-head">
        <div class="band-l">
          <h2 class="d-xl">From opportunity to deployment.</h2>
        </div>
        <p class="body band-p">
          One accountable lead stays with each project from the first study to the measured result, so nothing is lost in a hand-off.
        </p>
      </div>
      <StageLine notes={stageNotes} links={stageLinks} />
    </div>
  </section>

  <!-- WORKFLOW OS -->
  <section class="section wos" id="workflow-os">
    <div class="wrap grid12">
      <div class="wos-l">
        <h2 class="d-xl">AI transformation starts with how work actually happens.</h2>
        <div class="wos-name">
          <span class="d-m">INNOVA AI Workflow OS</span>
          <StatusChip status="prototype" />
        </div>
        <p class="lede">From business processes to measurable AI automation.</p>
        <p class="body">
          Workflow OS maps a company’s operations, scores every process for automation value and recommends an architecture for each one, from
          plain software to supervised AI agents. The result is an implementation plan with a projected return that can be checked after go-live.
        </p>
        <a href="/workflow-os" class="btn btn-primary wos-cta">Explore Workflow OS <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="wos-r">
        <figure class="proof wos-shot">
          <img
            src="/proof/workflow-os-opportunity-map-1440-1600.webp"
            srcset="/proof/workflow-os-opportunity-map-1440-800.webp 800w, /proof/workflow-os-opportunity-map-1440-1600.webp 1600w"
            sizes="(min-width:1100px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            width="1600"
            height="1000"
            alt={shots['workflow-os'].alt}
          />
          <figcaption>Opportunity Map for Northstar Professional Services, a fictional demo company. Every score shows its parts.</figcaption>
        </figure>
        <ol class="wos-flow" aria-label="Workflow OS flow">
          {
            wosFlow.map((step, i) => (
              <li>
                <span class="mono wos-i">{String(i + 1).padStart(2, '0')}</span>
                <span class="wos-step">{step}</span>
              </li>
            ))
          }
        </ol>
        <div class="wos-why">
          <h3 class="meta wos-why-h">What each score weighs</h3>
          <ul class="wos-factors">
            {wosFactors.map((f) => <li>{f}</li>)}
          </ul>
          <p class="wos-minus">minus a risk penalty for privacy, regulation, consequence and change complexity</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DOMAINS -->
  <section class="section" id="domains">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l">
          <h2 class="d-xl">Where we build, research and explore.</h2>
        </div>
        <p class="body sh-r">Areas we build in, research or are starting to explore. The mark on each row says which.</p>
      </div>
      <div class="dom">
        {
          domainGroups.map((g) => (
            <div class="dom-g">
              <h3 class="status dom-gh">{g.label}</h3>
              <ul class="dom-list">
                {g.rows.map((s) => (
                  <li class="dom-row">
                    <p class="dom-h">
                      <span class="mark" data-s={engagementMark[g.e]} aria-hidden="true" />
                      {s.name}
                    </p>
                    <p class="dom-p">{s.line}</p>
                    {s.evidence && <p class="meta dom-ev">{s.evidence}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section" id="projects">
    <div class="wrap grid12 pj">
      <div class="pj-l">
        <h2 class="d-xl">Projects, each with its real status.</h2>
        <p class="body">
          Live products, systems in development and early research sit side by side. Every project carries one status, and the track shows its
          stage.
        </p>
        <a class="arrow-link pj-all" href="/projects"><span>All projects</span><span aria-hidden="true">→</span></a>
      </div>
      <div class="pj-r rows">
        {
          featuredProjects.map((p) => {
            const shot = shots[p.slug];
            return (
              <a class="row prow" href={hrefOf(p)}>
                <div class="row-title">
                  <p class="mono prow-code">{p.code}</p>
                  <h3 class="d-m" id={`pt-${p.slug}`}>
                    {p.name}
                  </h3>
                </div>
                <div class="prow-text">
                  <p class="body" id={`ps-${p.slug}`}>
                    {p.summary}
                  </p>
                  {shot && (
                    <figure class:list={['proof', 'prow-shot', { 'm-hide': !MOBILE_SHOT.includes(p.status), 'shot-light': shot.light }]}>
                      <img src={shot.src} alt={shot.alt} width="800" height="500" loading="lazy" decoding="async" />
                      <figcaption>{shot.cap}</figcaption>
                    </figure>
                  )}
                </div>
                <div class="prow-meta">
                  <StatusChip status={p.status} />
                  <StageTrack at={STATUS_STAGE[p.status]} status={p.status} caption={false} />
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- COLLABORATION -->
  <section class="section collab" id="collaboration">
    <div class="wrap grid12">
      <h2 class="d-xl co-h">Projects we take on with partners.</h2>
      <p class="co-st">
        Applied R&amp;D, pilots and commercialization, built together with industry, researchers and public organizations.
      </p>
      <div class="co-funded">
        <h3 class="meta co-fh" id="funded-h">What a funded project with INNOVA looks like</h3>
        <ol class="co-steps" aria-labelledby="funded-h">
          {
            funded.map((f, i) => (
              <li>
                <span class="mono co-n">{i + 1}</span>
                <span>{f}</span>
              </li>
            ))
          }
        </ol>
        <p class="co-ex">
          <a href="/projects/openfield" class="co-ex-a"
            ><strong>Example: OpenField.</strong> Prototype on demo data today; field validation planned for the 2027 season.<span
              class="co-ex-arr"
              aria-hidden="true">→</span
            ></a
          >
        </p>
      </div>
      <div class="co-side">
      <h3 class="meta co-fh">Partnership models</h3>
      <ul class="co-models" aria-label="Partnership models">
        {
          PARTNERSHIP_MODELS.slice(0, 4).map((m) => (
            <li>
              <a href="/partnerships#models">
                <span>{m.name}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="co-foot">
        <a href="/partnerships" class="btn btn-primary">See partnership models <span class="arr" aria-hidden="true">→</span></a>
      </div>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY -->
  <section class="section cred" id="background">
    <div class="wrap grid12">
      <h2 class="d-xl cr-h">New technology. Experienced operators.</h2>
      <p class="cr-rec">
        <span>Federal corporation {SITE.corporationNumber}</span><span class="cr-dot" aria-hidden="true">·</span><span
          ><abbr title="NATO Commercial and Government Entity code">NCAGE</abbr> {SITE.ncage}</span
        ><span class="cr-dot" aria-hidden="true">·</span><span>D-U-N-S {SITE.duns}</span><span class="cr-dot" aria-hidden="true">·</span><span
          class="xlink cr-verify"
          role="link"
          tabindex="0"
          data-x={registryB64}>Verify on Corporations Canada <span aria-hidden="true">↗</span></span
        >
      </p>
      <ol class="cr-path">
        {
          path.map((r) => (
            <li class:list={[{ now: r.now }]}>
              <span class="meta cr-when">{r.when}</span>
              <span class="cr-what">{r.what}</span>
            </li>
          ))
        }
      </ol>
      <div class="cr-side">
        <p class="cr-lead">INNOVA is led by its founder, Maksym Stepanenko.</p>
        <p class="body cr-team">
          For funded and client projects, engineering, security review and domain specialists are brought in as named
          subcontractors or partner firms, listed in the proposal before work starts.
        </p>
        <p class="body">
          His work with businesses across many jurisdictions and industries showed how companies run, where processes break and what it takes to
          get a new system adopted.
        </p>
        <a href="/about#founder" class="arrow-link"><span>About INNOVA</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // External links without href (owner law): decode on click or Enter, open in a new tab. Same mechanism as /about.
  document.querySelectorAll<HTMLElement>('.xlink[data-x]').forEach((el) => {
    const go = () => {
      const url = atob(el.dataset.x || '');
      if (/^https:\/\//.test(url)) window.open(url, '_blank', 'noopener');
    };
    el.addEventListener('click', go);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        go();
      }
    });
  });
</script>

<style>
  /* Small sentence-case mono label (not a stage label, chip or INV code). */
  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.35;
    color: var(--lichen);
    margin: 0;
  }
  .arrow-link {
    min-height: 44px;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding-block: clamp(36px, 4vw, 64px) clamp(64px, 6vw, 104px);
  }
  .hero-grid {
    align-items: start;
    row-gap: 0;
  }
  .hero-copy {
    grid-column: 1 / span 5;
    grid-row: 1;
    padding-top: clamp(8px, 2vw, 36px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero-eyebrow {
    margin-bottom: 20px;
    animation: hfade 700ms var(--ease-out) 60ms both;
  }
  /* Scoped hero size: 3-4 lines at 1440 with the real Hubot Sans metrics. */
  .hero-copy :global(.d-hero) {
    font-size: clamp(2.6rem, 1rem + 3.6vw, 4.25rem);
    max-width: 15ch;
  }
  .hero-board {
    grid-column: 6 / span 7;
    grid-row: 1;
    padding-top: clamp(8px, 2vw, 36px);
  }
  .hero-lede {
    margin-top: 24px;
    animation: hfade 800ms var(--ease-out) 520ms both;
  }
  .hero-ctas {
    order: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
    animation: hfade 800ms var(--ease-out) 640ms both;
  }
  .hero-sec-arr {
    display: none;
  }
  /* DOM order puts the trust line before the CTAs (phone order); on wider screens it sits under them. */
  .hero-trust {
    order: 5;
    align-self: stretch;
    margin: 26px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-text);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--lichen);
    animation: hfade 800ms var(--ease-out) 760ms both;
  }
  .hero-trust span {
    white-space: nowrap;
  }
  @keyframes hfade {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero * {
      animation: none !important;
    }
  }
  @media (max-width: 1100px) {
    .hero-copy,
    .hero-board {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .hero-board {
      margin-top: 44px;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 20px;
    }
    .hero-copy,
    .hero-board {
      padding-top: 0;
    }
    .hero-lede {
      margin-top: 18px;
    }
    .lede-more {
      display: none;
    }
    .hero-ctas {
      margin-top: 22px;
      gap: 4px;
    }
    .hero-ctas .btn-primary {
      width: 100%;
      justify-content: space-between;
    }
    .hero-sec {
      width: 100%;
      min-height: 44px;
      padding: 0;
      border: 0;
      gap: 10px;
    }
    .hero-sec-arr {
      display: inline;
      transition: transform var(--t-micro) var(--ease-out);
    }
    .hero-sec:hover .hero-sec-arr {
      transform: translateX(4px);
    }
    .hero-eyebrow {
      margin-bottom: 18px;
    }
    .hero-board {
      margin-top: 28px;
    }
  }
  @media (max-width: 640px) {
    .hero-trust {
      order: 3;
      margin-top: 18px;
      padding-top: 14px;
    }
  }

  /* ── In brief ─────────────────────────────────────────────────────── */
  .brief {
    padding-block: clamp(36px, 3vw, 52px);
    border-top: 1px solid var(--rule);
  }
  .brief-h {
    grid-column: 1 / span 2;
    padding-top: 6px;
  }
  .brief-p {
    grid-column: 3 / span 8;
    margin: 0;
    max-width: 64ch;
    font-size: clamp(1.02rem, 0.96rem + 0.25vw, 1.18rem);
    line-height: 1.6;
    color: var(--lichen);
  }
  .brief-a {
    color: var(--frost);
    background-size: 100% 1px;
  }
  .brief-a:hover {
    color: var(--signal);
  }
  .brief-p strong {
    color: var(--frost);
    font-weight: 600;
  }
  .brief + .section {
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 860px) {
    .brief-h,
    .brief-p {
      grid-column: 1 / -1;
    }
    .brief-h {
      padding: 0 0 10px;
    }
  }

  /* ── What we do ───────────────────────────────────────────────────── */
  /* Each capability row is one link to its page; the shared a.row rule gives the 6px title shift and the trailing arrow. */
  .caprow h3 {
    margin: 0;
  }
