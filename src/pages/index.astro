---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroReel from '../components/home/HeroReel.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusTag from '../components/StatusTag.astro';
import { visibleProjects, projectHref, type Project } from '../data/projects';
import { SITE } from '../data/site';
import { CROPS, asScreen } from '../data/crops';

const P = Object.fromEntries(visibleProjects.map((p) => [p.slug, p])) as Record<string, Project>;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const total = WORDS[visibleProjects.length] ?? String(visibleProjects.length);

/* In the lab: the work that is not in public use yet, named in one line (src/data/projects.ts). */
const LAB: Project[] = [P.openfield, P.aicrmius, P.finmozg, P['dual-use']];

/* Workflow OS on home: three readable close crops, one sentence each (src/components/wos/data.ts).
   The Overview screen is kept for the /workflow-os hero. */
const WOS = [
  { k: 'Score every process', t: 'Fourteen factors minus a risk penalty, with the reason behind every number.', c: CROPS.wosHomeMap },
  { k: 'Design the architecture', t: 'Six patterns and five levels of human control.', c: CROPS.wosHomeDesigner },
  { k: 'Measure the return', t: 'A projected return that can be checked after go-live.', c: CROPS.wosHomeImpact }
];
---

<BaseLayout
  title="INNOVA · Applied AI & Software Company in Ottawa, Canada"
  description="INNOVA researches, prototypes, builds and deploys applied AI and custom software in Ottawa, with every project shown at its real stage, from R&D to live use."
  path="/"
  cta={{
    title: `Founder-led since ${SITE.experienceSince}. Start a conversation.`,
    lede: `${SITE.legalName} is a federal corporation in Ottawa, led by its founder, Maksym Stepanenko, who has worked with companies in more than 50 countries. Every message is read by a person.`,
    link: { href: '/about', label: 'About INNOVA' }
  }}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/uafest-unity-ride-m.webp" media="(max-width: 700px)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset="/img/uafest-unity-ride-800.webp 800w, /img/uafest-unity-ride-1200.webp 1200w, /img/uafest-unity-ride.webp 1920w" imagesizes="100vw" media="(min-width: 701px)" fetchpriority="high" />
  </Fragment>

  <HeroReel />

  <!-- ═══ IN USE: the three live products, each screen in its world, each one readable crop ═══ -->
  <section class="work shell" id="work" aria-labelledby="work-h">
    <div class="inset work-hd">
      <h2 id="work-h" class="t-h2" data-rise>In use today</h2>
      <a class="lnk" href="/projects">All {total} projects <span class="ar" aria-hidden="true">→</span></a>
    </div>
    <div class="work-g">
      <ProjectCard
        project={P.uafest}
        size="full"
        eager
        headline="A festival ran on it."
        fact="199 participant cabinets and 13 shared mailboxes in one record, for a Ukrainian festival in Carleton Place, Ontario."
        world={{ src: '/img/uafest-dance.webp', src800: '/img/uafest-dance-800.webp', w: 1280, h: 818, pos: '22% 50%' }}
        screens={[asScreen(CROPS.uafestForm, { l: '49%', t: '10%', width: '46%', lm: '6%', tm: '7%', wm: '88%' })]}
        credit="UAFest festival, Carleton Place"
        aspect="16 / 8"
        aspectM="4 / 3.3"
      />
      <ProjectCard
        project={P.foundwall}
        material="evergreen"
        fact="Web platform live; iOS and Android apps in public beta. Every photo loses its location data before anyone sees it."
        screens={[asScreen(CROPS.foundwall, { l: '7%', t: '9%', width: '86%', lm: '6%', tm: '8%', wm: '88%' })]}
      />
      <ProjectCard
        project={P.babakokum}
        world={{ src: '/img/babakokum-porch.webp', w: 760, h: 720, pos: '50% 30%' }}
        fact="On the App Store since 24 September 2026, and playable on the web. Runs fully offline."
        screens={[asScreen(CROPS.babakokum, { l: '9%', t: '13%', width: '82%', lm: '6%', tm: '14%', wm: '88%' })]}
      />
    </div>

    <p class="lab inset">
      <span class="lab-k">In the lab:</span> <a href={projectHref(LAB[0])}>{LAB[0].short}</a>, <a href={projectHref(LAB[1])}>{LAB[1].short}</a>, <a href={projectHref(LAB[2])}>{LAB[2].short}</a> and <a href={projectHref(LAB[3])}>{LAB[3].short}</a>.
      <a class="lab-all" href="/projects">See all projects <span class="ar" aria-hidden="true">→</span></a>
    </p>
  </section>

  <!-- ═══ WORKFLOW OS: our own product, readable close crops on bone ═══ -->
  <section class="wos tone-bone" id="workflow-os" aria-labelledby="wos-h">
    <div class="shell">
      <div class="inset">
        <div class="wos-hd">
          <h2 id="wos-h" class="t-h2 wos-h" data-rise>AI transformation starts with how work actually happens.</h2>
          <div class="wos-r">
            <p class="wos-name">INNOVA AI Workflow OS <StatusTag status="prototype" /></p>
            <p class="wos-body">Maps how a company works, scores every process for automation value and recommends an architecture for each one, from plain software to supervised AI agents.</p>
            <Button href="/workflow-os" variant="ink" class="wos-cta">Explore Workflow OS</Button>
          </div>
        </div>
        <div class="wos-g" data-wos>
          <div class="wos-tabs" role="group" aria-label="Workflow OS screens">
            {
              WOS.map((s, i) => (
                <button type="button" class:list={['wos-tab', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-wtab={i}>
                  <span class="n tnum">{i + 1}</span>
                  <span class="wos-tt">
                    <b>{s.k}</b>
                    <span>{s.t}</span>
                  </span>
                </button>
              ))
            }
          </div>
          <figure class="wos-fig">
            <div class="wos-stack">
              {
                WOS.map((s, i) => (
                  <img
                    class:list={['scr-img scr-dark', { on: i === 0 }]}
                    data-wimg={i}
                    src={s.c.src}
                    srcset={s.c.srcset}
                    sizes="(max-width: 900px) 92vw, 66vw"
                    alt={s.c.alt}
                    width={s.c.w}
                    height={s.c.h}
                    loading="lazy"
                    decoding="async"
                  />
                ))
              }
            </div>
            <figcaption class="disc">Online since 1 October 2026 as an invite-only demo. Northstar Professional Services is a fictional 30-person firm; all data shown is illustrative.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Workflow OS: a step picks the screen. Instant swap, no fade, so a screen is never blank.
  const box = document.querySelector<HTMLElement>('[data-wos]');
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-wtab]')];
    const imgs = [...box.querySelectorAll<HTMLElement>('[data-wimg]')];
    const pick = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle('on', j === i);
        t.setAttribute('aria-pressed', j === i ? 'true' : 'false');
      });
      imgs.forEach((m, j) => m.classList.toggle('on', j === i));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('mouseenter', () => window.matchMedia('(hover: hover)').matches && pick(i));
    });
  }
</script>

<style>
  /* ── in use ── */
  .work {
    padding-top: var(--sec);
  }
  .work-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 2.6vw, 40px);
  }
  .work-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .work-g > :global(.mf--full) {
    grid-column: 1 / -1;
  }

  /* ── in the lab: one line ── */
  .lab {
    margin-top: clamp(36px, 4vw, 64px);
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
    color: var(--ash);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .lab-k {
    color: var(--ash);
  }
  .lab a {
    color: var(--print);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(238 234 226 / 0.35);
    text-underline-offset: 6px;
    transition: text-decoration-color var(--t-micro) var(--e-out);
  }
  .lab a:hover {
    text-decoration-color: var(--print);
  }
  .lab .lab-all {
    display: flex;
    width: fit-content;
    margin-top: 14px;
    gap: 8px;
    white-space: nowrap;
    text-decoration: none;
  }
  .lab-all .ar {
    transition: transform 0.3s var(--e-out);
  }
  .lab-all:hover .ar {
    transform: translateX(6px);
  }

  /* ── workflow os ── */
  .wos {
    margin-top: var(--sec);
    padding-block: calc(var(--sec) * 0.72);
  }
  .wos-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 28px;
    align-items: end;
  }
  .wos-h {
    grid-column: 1 / span 7;
    max-width: 16ch;
  }
  .wos-r {
    grid-column: 9 / span 4;
  }
  .wos-name {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 20px;
    font-weight: 600;
  }
  .wos-body {
    margin-top: 10px;
    color: var(--ink-soft);
    max-width: 44ch;
  }
  .wos-r :global(.wos-cta) {
    margin-top: 20px;
  }
  .wos-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin-top: clamp(36px, 4vw, 64px);
    align-items: start;
  }
  .wos-tabs {
    grid-column: 1 / span 3;
    display: grid;
  }
  .wos-tab {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 10px;
    text-align: left;
    padding: 18px 0;
    background: none;
    border: 0;
    border-top: 1px solid var(--rule-ink);
    color: var(--ink-soft);
    font: inherit;
    cursor: pointer;
    transition: color var(--t-micro) var(--e-out);
  }
  .wos-tab .n {
    font-size: 15px;
    font-weight: 600;
    padding-top: 4px;
  }
  .wos-tt b {
    display: block;
    font-size: clamp(20px, 1.6vw, 25px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .wos-tt span {
    display: block;
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.4;
  }
  .wos-tab.on {
    color: var(--ink);
    border-top: 2px solid var(--ink);
    padding-top: 17px;
  }
  .wos-tab.on .n {
    color: var(--flare-ink);
  }
  .wos-tab:hover {
    color: var(--ink);
  }
  .wos-fig {
    grid-column: 4 / -1;
    margin: 0;
    padding-left: clamp(0px, 1.6vw, 24px);
  }
  .wos-stack {
    position: relative;
    aspect-ratio: 1823 / 950;
  }
  .wos-stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    visibility: hidden;
  }
  .wos-stack img.on {
    visibility: visible;
  }
  .disc {
    margin-top: 14px;
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 80ch;
  }

  @media (max-width: 900px) {
    .work-g {
      grid-template-columns: 1fr;
    }
    .wos-h,
    .wos-r {
      grid-column: 1 / -1;
    }
    .wos-g {
      display: flex;
      flex-direction: column-reverse;
      gap: 20px;
    }
    .wos-fig {
      padding-left: 0;
      width: 100%;
    }
    .wos-stack {
      margin-inline: calc(var(--in) * -1 - var(--gut));
      aspect-ratio: 1.45;
    }
    .wos-stack img {
      border-radius: 0;
    }
    .wos-tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 12px;
      width: 100%;
    }
    .wos-tt span {
      display: none;
    }
    .wos-tab {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
      min-height: 44px;
    }
    .wos-tt b {
      font-size: 17px;
    }
  }
</style>
