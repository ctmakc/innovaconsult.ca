---
import BaseLayout from '../layouts/BaseLayout.astro';
import FitText from '../components/FitText.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusTag from '../components/StatusTag.astro';
import RecordIds from '../components/RecordIds.astro';
import { CAPABILITIES } from '../data/capabilities';
import { PARTNERSHIP_MODELS } from '../data/partnerships';
import { visibleProjects, projectHref, STATUS_STAGE, type Project } from '../data/projects';
import { STAGES } from '../data/stages';
import { SITE } from '../data/site';

const P = Object.fromEntries(visibleProjects.map((p) => [p.slug, p])) as Record<string, Project>;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const total = WORDS[visibleProjects.length] ?? String(visibleProjects.length);

/* Real screenshots, by project, used as proof thumbnails on the capability rows. */
const THUMB: Record<string, { src: string; w: number; h: number }> = {
  'workflow-os': { src: '/proof/workflow-os-overview-1440-800.webp', w: 800, h: 500 },
  uafest: { src: '/proof/uafest-applications-1440-800.webp', w: 800, h: 500 },
  foundwall: { src: '/proof/foundwall-home-1440-800.webp', w: 800, h: 500 },
  babakokum: { src: '/proof/babakokum-rules-tablet-800.webp', w: 800, h: 665 },
  openfield: { src: '/proof/openfield-season-report-1440-800.webp', w: 800, h: 500 }
};
const capRows = CAPABILITIES.map((c) => {
  const ps = (c.projects ?? []).map((s) => P[s]).filter(Boolean);
  const shots = ps.filter((p) => THUMB[p.slug]).slice(0, 3);
  return { c, shots, chips: ps.filter((p) => !shots.includes(p)) };
});

/* Live now: products in public use, straight from the data. */
const LIVE_LINE: Record<string, string> = {
  uafest: 'The 13 September 2026 festival ran on it',
  foundwall: 'Web live; iOS and Android in public beta',
  babakokum: 'On the App Store since 24 September 2026'
};
const live = visibleProjects.filter((p) => p.status === 'live');

/* The process told as one paragraph; the six stage words are the stage names in stages.ts. */
const PROCESS =
  'Every project starts from an *opportunity*: how the organization works today. *Research* tests the options against real data first. A *prototype* is a working version that real users can try. The *build* has security, permissions and audit built in. We *deploy* inside the tools people already use, then measure the *impact*: time, cost, errors and adoption against the baseline.';
const processWords = PROCESS.split(' ').map((tok) => {
  const m = tok.match(/^\*(.+?)\*(.*)$/);
  return m ? { t: m[1], tail: m[2], k: true } : { t: tok, tail: '', k: false };
});
const onLine = STAGES.map((s, i) => ({ label: s.label, projects: visibleProjects.filter((p) => STATUS_STAGE[p.status] === i) })).filter((r) => r.projects.length);

const funded = [
  'A written technical question and the uncertainty behind it.',
  'A starting point and a target for the work.',
  'Two or three milestones, each ending in something a reviewer can run.',
  'Measured results, including the experiments that failed.'
];
const models = PARTNERSHIP_MODELS.slice(0, 4);

const credits = [
  'Photos via Wikimedia Commons: Parliament Hill at dawn by joiseyshowaa, CC BY-SA 2.0 (colour graded)',
  'Rideau Canal at night by Dylandamic0, CC BY-SA 3.0'
];
---

<BaseLayout
  title="INNOVA · Applied AI & Software Company in Ottawa, Canada"
  description="INNOVA researches, prototypes, builds and deploys applied AI and custom software in Ottawa, with every project shown at its real stage, from R&D to live use."
  path="/"
  credits={credits}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/ottawa-dawn-m.webp" media="(max-width: 700px)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset="/img/ottawa-dawn-1440.webp 1440w, /img/ottawa-dawn-2400.webp 2400w" imagesizes="100vw" media="(min-width: 701px)" fetchpriority="high" />
  </Fragment>

  <!-- ═══ HERO: the statement over Ottawa at dawn ═══ -->
  <section class="hero shell" aria-labelledby="h1" data-hero>
    <div class="hero-f frame">
      <div class="hero-still" data-hero-still>
        <picture>
          <source media="(max-width: 700px)" srcset="/img/ottawa-dawn-m.webp" />
          <img
            src="/img/ottawa-dawn-1440.webp"
            srcset="/img/ottawa-dawn-1440.webp 1440w, /img/ottawa-dawn-2400.webp 2400w"
            sizes="100vw"
            alt="The Ottawa River at dawn, with Parliament Hill above the treeline"
            width="2400"
            height="1799"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <p class="hero-top t-label">
        <span>Ottawa, Canada</span>
        <span>Applied innovation &amp; technology · Founder in business since {SITE.experienceSince}</span>
      </p>
      <div class="hero-bot">
        <FitText
          as="h1"
          id="h1"
          class="hero-h"
          text="INNOVA: Applied AI & software, Ottawa"
          lines={['Applied AI', '& software']}
          mobileLines={['Applied', 'AI &', 'software']}
        />
        <div class="hero-row">
          <p class="hero-lede">INNOVA researches, prototypes, builds and deploys applied AI and software, with companies, researchers and public organizations.</p>
          <div class="hero-ctas">
            <Button href="#work" variant="ghost">See what we build</Button>
            <Button openContact variant="flare">Start a conversation</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LIVE NOW: proof in the first screen ═══ -->
  <section class="live shell" aria-label="Live now and corporate record">
    <div class="live-g inset">
      <p class="live-k t-label t-mute">Live now</p>
      {
        live.map((p) => (
          <a class="live-i" href={projectHref(p)}>
            <StatusTag status="live" label={p.short} class="live-n" />
            <span class="live-t">{LIVE_LINE[p.slug] ?? p.tagline}</span>
          </a>
        ))
      }
      <a class="live-i live-rec" href="#record">
        <span class="live-n tnum">Federal corporation <span style="white-space:nowrap">{SITE.corporationNumber}</span></span>
        <span class="live-t tnum">NCAGE {SITE.ncage} · since {SITE.incorporated}</span>
      </a>
    </div>
  </section>

  <!-- ═══ CAPABILITIES: four big rows, each proved by real screens ═══ -->
  <section class="caps shell pad-lg" aria-labelledby="caps-h">
    <div class="inset">
      <SectionHead id="caps-h" title="Four kinds of work" lede="Each one is shown in real projects, with the project's true status." size="h2" />
      <ol class="cap-list">
        {
          capRows.map(({ c, shots, chips }) => (
            <li class="cap">
              <div class="cap-l">
                <h3 class="cap-n" data-mask>
                  <a href={c.href}>{c.name.split(' ').slice(0, -1).join(' ')} <span class="nw">{c.name.split(' ').at(-1)}<span class="ar" aria-hidden="true">→</span></span></a>
                </h3>
                <p class="cap-p">{c.line}</p>
              </div>
              <div class="cap-r">
              <ul class="cap-shots" style={`--n:${shots.length}`} aria-label={`Projects that show ${c.name.toLowerCase()}`}>
                {shots.map((p) => (
                  <li>
                    <a class="cap-shot" href={projectHref(p)}>
                      <span class="cap-img frame">
                        <img src={THUMB[p.slug].src} alt="" width={THUMB[p.slug].w} height={THUMB[p.slug].h} loading="lazy" decoding="async" />
                      </span>
                      <span class="cap-sn">{p.short}</span>
                    </a>
                  </li>
                ))}
              </ul>
              {chips.length > 0 && (
                <p class="cap-also">
                  Also {chips.map((p, i) => <><a href={projectHref(p)}>{p.short}</a>{i < chips.length - 1 ? ' · ' : ''}</>)}
                </p>
              )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ WHAT WE BUILD: screens in their worlds ═══ -->
  <section class="work shell" id="work" aria-labelledby="work-h">
    <div class="inset">
      <SectionHead
        id="work-h"
        title="What we build"
        lede="Live products, systems in development and early research. Each one carries its real status."
        link={{ href: '/projects', label: `All ${total} projects` }}
      />
    </div>
    <div class="work-g">
      <ProjectCard
        project={P.uafest}
        size="full"
        headline="A festival ran on it."
        fact="Applications, participant cabinets, sponsor and finance registers for a Ukrainian festival in Carleton Place, Ontario. In production since August 2026."
        world={{ src: '/img/uafest-dance.webp', src800: '/img/uafest-dance-800.webp', w: 1280, h: 818, pos: '30% 50%' }}
        screens={[
          {
            src: '/proof/uafest-applications-1440-1600.webp',
            src800: '/proof/uafest-applications-1440-800.webp',
            w: 1600,
            h: 1000,
            alt: 'UAFest 2027 sign-up page on uafest.ca: one form with participation types for guests, volunteers, vendors, performers, sponsors and the organizing team.',
            r: '4.5%',
            t: '11%',
            width: '50%',
            lm: '7%',
            tm: '10%',
            wm: '86%'
          }
        ]}
        credit="UAFest festival, Carleton Place"
        aspectM="4 / 3.6"
      />
      <ProjectCard
        project={P.foundwall}
        material="evergreen"
        fact="Web platform live; iOS and Android apps in public beta. Every photo loses its location data before anyone sees it."
        screens={[
          {
            src: '/proof/foundwall-home-1440-1600.webp',
            src800: '/proof/foundwall-home-1440-800.webp',
            w: 1600,
            h: 1000,
            alt: 'FoundWall homepage: Lost, Stolen, Found headline beside sample notices for a bike, a beagle and a robotic mower.',
            l: '8%',
            t: '8%',
            width: '62%',
            lm: '6%',
            tm: '9%',
            wm: '76%'
          },
          {
            src: '/proof/foundwall-board-390-800.webp',
            src800: '/proof/foundwall-board-390-400.webp',
            w: 800,
            h: 1731,
            alt: 'FoundWall board on a phone: stacked notice cards for a stolen bike and a lost cat (sample notices).',
            kind: 'phone',
            r: '8%',
            t: '13%',
            width: '19%',
            rm: '6%',
            tm: '16%',
            wm: '27%',
            depth: 1.6
          }
        ]}
      />
      <ProjectCard
        project={P.babakokum}
        fact="On the App Store since 24 September 2026, and playable on the web. Runs fully offline."
        world={{ src: '/img/babakokum-porch.webp', w: 760, h: 720, pos: '50% 30%' }}
        screens={[
          {
            src: '/proof/babakokum-rules-tablet-1600.webp',
            src800: '/proof/babakokum-rules-tablet-800.webp',
            w: 1600,
            h: 1331,
            alt: 'BABA & KOKUM rules card: six scoring patterns for placing printed tiles on a scarf grid and the five ink colours.',
            kind: 'tablet',
            l: '24%',
            t: '6%',
            width: '52%',
            lm: '14%',
            tm: '7%',
            wm: '72%'
          }
        ]}
      />
      <ProjectCard
        project={P.openfield}
        statusLabel="Prototype · demo data"
        fact="Field validation is planned for the 2027 season, with Ontario dealers and growers running robots from more than one manufacturer."
        world={{ src: '/img/field-robot.webp', src800: '/img/field-robot-800.webp', w: 1376, h: 768, pos: '50% 60%' }}
        screens={[
          {
            src: '/proof/openfield-season-report-1440-1600.webp',
            src800: '/proof/openfield-season-report-1440-800.webp',
            w: 1600,
            h: 1000,
            alt: 'OpenField season report preview: block-by-week pass grid and report figures, each tagged with its data source (demo data).',
            l: '7%',
            t: '8%',
            width: '58%',
            lm: '6%',
            tm: '9%',
            wm: '74%'
          },
          {
            src: '/proof/openfield-entry-390-800.webp',
            src800: '/proof/openfield-entry-390-400.webp',
            w: 800,
            h: 1621,
            alt: 'OpenField technician entry screen on a phone (demo farm, simulated data).',
            kind: 'phone',
            r: '9%',
            t: '11%',
            width: '19%',
            rm: '6%',
            tm: '14%',
            wm: '27%',
            depth: 1.6
          }
        ]}
      />
      <div class="lab frame">
        <div class="lab-top">
          <p class="t-label t-mute">In the lab and in development</p>
          <a class="lab-main" href={projectHref(P.aicrmius)}>
            <span class="lab-cycle" aria-hidden="true">Propose. Validate. Approve. Apply. Undo.</span>
            <span class="lab-nm">
              <span class="two-tone t-h4">{P.aicrmius.short}<span class="d">{P.aicrmius.tagline}: agents propose, a person approves, every change can be undone.</span></span>
              <StatusTag status={P.aicrmius.status} />
            </span>
          </a>
        </div>
        <ul class="lab-list">
          <li>
            <a href={projectHref(P.finmozg)}>
              <span class="lab-n">{P.finmozg.short}</span>
              <StatusTag status={P.finmozg.status} />
              <span class="lab-t">Eight finance agents and a CFO copilot on a real double-entry ledger.</span>
            </a>
          </li>
          <li>
            <a href={projectHref(P['dual-use'])}>
              <span class="lab-n">{P['dual-use'].short}</span>
              <StatusTag status={P['dual-use'].status} />
              <span class="lab-t">Research and lab work only; no contracts.</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ WORKFLOW OS: our own product, on bone ═══ -->
  <section class="wos tone-bone" id="workflow-os" aria-labelledby="wos-h">
    <div class="shell">
      <div class="inset wos-g">
        <div class="wos-l">
          <p class="t-label t-mute">Our own product</p>
          <h2 id="wos-h" class="t-h2" data-rise>AI transformation starts with how work actually happens.</h2>
          <p class="wos-name">INNOVA AI Workflow OS <StatusTag status="prototype" /></p>
          <p class="wos-body">Maps how a company works, scores every process for automation value and recommends an architecture for each one, from plain software to supervised AI agents.</p>
        </div>
        <div class="wos-s">
          <ol class="steps">
            <li class="step on" data-step="0"><span class="n tnum">1</span><div><b>Map the company</b><span>Processes, people and systems, in one model.</span></div></li>
            <li class="step" data-step="1"><span class="n tnum">2</span><div><b>Score every process</b><span>Fourteen factors, minus a risk penalty. Every score shows its reasons.</span></div></li>
            <li class="step" data-step="2"><span class="n tnum">3</span><div><b>Design the architecture</b><span>Six patterns and five levels of human control.</span></div></li>
            <li class="step" data-step="3"><span class="n tnum">4</span><div><b>Measure the return</b><span>A projected return that can be checked after go-live.</span></div></li>
          </ol>
          <Button href="/workflow-os" variant="ink" class="wos-cta">Explore Workflow OS</Button>
        </div>
        <div class="wos-r">
          <div class="stack">
            <img class="scr-img on" src="/proof/workflow-os-overview-1440-1600.webp" alt="Workflow OS overview of a fictional demo company: mapped processes and their automation scores." width="1600" height="1000" loading="lazy" decoding="async" />
            <img class="scr-img" src="/proof/workflow-os-opportunity-map-1440-1600.webp" alt="Workflow OS Opportunity Map: 15 processes plotted by business value and feasibility, Client Onboarding ranked first at 88." width="1600" height="1000" loading="lazy" decoding="async" />
            <img class="scr-img" src="/proof/workflow-os-designer-1440-1600.webp" alt="Workflow OS designer: the recommended architecture for one process, with its human-control level." width="1600" height="1000" loading="lazy" decoding="async" />
            <img class="scr-img" src="/proof/workflow-os-impact-1440-1600.webp" alt="Workflow OS impact view: projected return over time for the selected automations." width="1600" height="1000" loading="lazy" decoding="async" />
          </div>
          <p class="disc">Online since 1 October 2026 as an invite-only demo. Northstar Professional Services is a fictional 30-person firm; all data shown is illustrative.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW A PROJECT RUNS: one paragraph that lights up ═══ -->
  <section class="run shell pad-lg" aria-labelledby="run-h">
    <div class="inset">
      <div class="run-g">
      <div class="run-main">
      <h2 id="run-h" class="t-label t-mute run-k">From opportunity to deployment</h2>
      <p class="run-p" data-light>
        {processWords.map((w) => (w.k ? <><b class="lw">{w.t}</b><span class="lw">{w.tail}</span>{' '}</> : <><span class="lw">{w.t}</span>{' '}</>))}
      </p>
      </div>
      <div class="run-b">
        <p class="run-lead">One accountable lead stays with each project from the first study to the measured result, so nothing is lost in a hand-off.</p>
        <div class="run-today">
          <p class="t-label t-mute">On the line today</p>
          <dl>
            {
              onLine.map((r) => (
                <div>
                  <dt>{r.label}</dt>
                  <dd>{r.projects.map((p, i) => <><a href={projectHref(p)}>{p.short}</a>{i < r.projects.length - 1 ? ', ' : ''}</>)}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- ═══ PARTNERSHIPS: Rideau Canal at night ═══ -->
  <section class="part shell" aria-labelledby="part-h">
    <div class="part-f frame" data-dolly-bg>
      <div class="part-world" aria-hidden="true">
        <img src="/img/rideau-night.webp" srcset="/img/rideau-night-1200.webp 1200w, /img/rideau-night.webp 2400w" sizes="100vw" alt="" width="2400" height="1600" loading="lazy" decoding="async" />
      </div>
      <div class="part-top">
        <h2 id="part-h" class="t-display" data-rise>Projects we take on with partners</h2>
        <p class="t-lede">Applied R&amp;D, pilots and commercialization, built together with industry, researchers and public organizations.</p>
      </div>
      <div class="part-b">
        <div class="funded">
          <h3 class="t-label t-mute">What a funded project with INNOVA looks like</h3>
          <ol>{funded.map((f) => <li>{f}</li>)}</ol>
          <p class="ex">
            Example: <a class="lnk" href="/projects/openfield">OpenField <span class="ar" aria-hidden="true">→</span></a> a prototype on demo data today; field validation is planned for the 2027 season.
          </p>
        </div>
        <div class="models">
          <h3 class="t-label t-mute">Partnership models</h3>
          <ul>
            {models.map((m) => (
              <li>
                <a href="/partnerships#models">
                  <span>{m.name}</span>
                  <span class="ar" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <Button href="/partnerships" variant="ghost">All {WORDS[PARTNERSHIP_MODELS.length] ?? PARTNERSHIP_MODELS.length} partnership models</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CORPORATE RECORD: on bone ═══ -->
  <section class="rec tone-bone" id="record" aria-labelledby="rec-h">
    <div class="shell">
      <div class="inset rec-g">
        <h2 id="rec-h" class="t-h2 rec-h" data-rise>New technology. Experienced operators.</h2>
        <div class="rec-l">
          <p class="rec-lead">{SITE.legalName} is a federal corporation in Ottawa, Ontario, incorporated in {SITE.incorporated} and led by its founder, Maksym Stepanenko.</p>
          <p class="rec-p">His work with businesses across many jurisdictions and industries showed how companies run, where processes break and what it takes to get a new system adopted.</p>
          <p class="rec-p">For funded and client projects, <strong>engineering, security review and domain specialists</strong> are brought in as named subcontractors or partner firms, listed in the proposal before work starts.</p>
          <a class="lnk rec-k" href="/about#founder">About INNOVA <span class="ar" aria-hidden="true">→</span></a>
        </div>
        <div class="rec-card frame">
          <RecordIds />
          <ol class="path">
            <li><span class="w">From {SITE.experienceSince}</span><span class="t">The founder’s business practice with small and mid-sized companies in more than 50 countries.</span></li>
            <li><span class="w">Then</span><span class="t">Digital systems for client companies.</span></li>
            <li><span class="w">Then</span><span class="t">Software products built and run in-house.</span></li>
            <li class="now"><span class="w">Now</span><span class="t">Applied innovation in Canada, open to partners.</span></li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Workflow OS: the step nearest the middle of the screen picks the screen in the stack.
  const steps = document.querySelectorAll<HTMLElement>('[data-step]');
  const shots = document.querySelectorAll<HTMLElement>('.stack img');
  const setStep = (i: number) => {
    steps.forEach((s, j) => s.classList.toggle('on', j === i));
    shots.forEach((s, j) => s.classList.toggle('on', j === i));
  };
  if ('IntersectionObserver' in window && steps.length) {
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.isIntersecting && setStep(Number((e.target as HTMLElement).dataset.step))),
      { rootMargin: '-48% 0px -42% 0px' }
    );
    steps.forEach((s) => io.observe(s));
  }
</script>

<style>
  /* ── hero ── */
  .hero-f {
    height: calc(100svh - var(--hdr) - 128px); /* the Live now line shows in the first screen */
    min-height: 560px;
    max-height: 1080px;
    background: var(--reel);
  }
  .hero-still {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-still picture,
  .hero-still img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-still img {
    object-fit: cover;
    object-position: 50% 34%;
    transform-origin: 50% 40%;
  }
  .hero-f::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(13 12 11 / 0.6) 0%, rgb(13 12 11 / 0) 16%, rgb(13 12 11 / 0) 30%, rgb(13 12 11 / 0.5) 48%, rgb(13 12 11 / 0.78) 68%, rgb(13 12 11 / 0.94) 100%);
  }
  .hero-top {
    position: absolute;
    top: clamp(18px, 2.4vw, 34px);
    left: clamp(18px, 2.6vw, 40px);
    right: clamp(18px, 2.6vw, 40px);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    text-shadow: 0 1px 14px rgb(13 12 11 / 0.7);
  }
  .hero-bot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: 0 clamp(14px, 1.6vw, 26px) clamp(6px, 0.8vw, 14px);
  }
  .hero-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: clamp(18px, 2vw, 28px) clamp(4px, 1vw, 14px) clamp(12px, 1.4vw, 20px);
  }
  .hero-lede {
    max-width: 36ch;
