---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
  { index: '01', title: 'Applied AI', text: 'AI systems designed around real workflows, decisions and measurable operational outcomes.', href: '/ai-transformation' },
  { index: '02', title: 'Software Products', text: 'Custom platforms, internal systems and digital products built from prototype to deployment.', href: '#projects' },
  { index: '03', title: 'Applied R&D', text: 'Technology discovery, experimentation and rapid validation of new technical opportunities.', href: '#innovation' },
  { index: '04', title: 'Innovation Partnerships', text: 'Collaborative development with businesses, researchers, technology providers and public organizations.', href: '#partnerships' }
];

const domains = [
  ['Building', 'AI & Agentic Systems', 'Workflow intelligence, assistants, agents and governed automation.'],
  ['Building', 'Enterprise Software', 'Operational systems, internal platforms and AI-enabled applications.'],
  ['Researching', 'AgriTech', 'Applied software, data and automation opportunities across agriculture.'],
  ['Exploring with partners', 'HealthTech & PharmaTech', 'Digital systems and applied AI around healthcare and life-science workflows.'],
  ['Exploring with partners', 'Smart Infrastructure', 'Data, automation and software for complex physical environments.'],
  ['Building', 'Data & Knowledge Systems', 'Structured knowledge, retrieval, decision support and operational data layers.'],
  ['Exploring with partners', 'Public Sector Technology', 'Digital services, knowledge systems and workflow modernization.'],
  ['Researching', 'Emerging Technology', 'New technical combinations with practical commercialization potential.']
];

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'INNOVA technology projects',
  itemListElement: [
    { '@type': 'SoftwareApplication', name: 'UAFest Digital Ecosystem', applicationCategory: 'BusinessApplication' },
    { '@type': 'SoftwareApplication', name: 'AICRMIUS', applicationCategory: 'BusinessApplication' },
    { '@type': 'SoftwareApplication', name: 'INNOVA AI Workflow OS', applicationCategory: 'BusinessApplication' }
  ]
};
---

<BaseLayout
  title="INNOVA — Applied Innovation & Technology | Ottawa, Canada"
  description="INNOVA is an Ottawa-based applied innovation company building AI systems, software products, prototypes and collaborative R&D projects."
  canonicalURL="https://innovaconsult.ca/"
>
  <Header />

  <main>
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Applied Innovation · Canada</p>
          <h1 class="display">Turning complex opportunities into <span class="gradient-text">working technology.</span></h1>
          <p class="kicker">INNOVA develops and deploys applied AI, software and emerging-technology solutions — from business transformation and digital products to R&D and industry collaboration.</p>
          <div class="hero-actions">
            <a class="button button-primary button-arrow" href="#projects">Explore what we build</a>
            <a class="button button-ghost" href="#partnerships">Partner with us</a>
          </div>
          <div class="trust-line" aria-label="Company facts">
            <span>Ottawa, Canada</span>
            <span>14+ years international experience</span>
            <span>Build · Prototype · Deploy</span>
          </div>
        </div>

        <div class="engine" aria-label="INNOVA innovation engine: opportunity to measurable impact">
          <span class="engine-label">Innovation Engine / 01</span>
          <span class="engine-status">Active system</span>
          <div class="engine-flow">
            <div class="engine-step"><strong>Opportunity</strong><span>identify value</span></div>
            <div class="engine-step"><strong>Research</strong><span>evaluate paths</span></div>
            <div class="engine-step active"><strong>Prototype</strong><span>validate quickly</span></div>
            <div class="engine-step"><strong>Build</strong><span>create system</span></div>
            <div class="engine-step"><strong>Deploy</strong><span>integrate</span></div>
            <div class="engine-step"><strong>Impact</strong><span>measure</span></div>
          </div>
          <div class="engine-domains"><span>AI</span><span>Software</span><span>AgriTech</span><span>HealthTech</span><span>Data</span><span>Public Sector</span></div>
        </div>
      </div>
    </section>

    <div class="stats-strip">
      <div class="shell stats-grid">
        <div class="stat stat-intro"><strong>Experienced operators building new technology.</strong></div>
        <div class="stat"><strong>14+ years</strong><span>International business and technology experience behind the current innovation focus.</span></div>
        <div class="stat"><strong>Ottawa</strong><span>Based inside one of Canada’s major technology and public-sector ecosystems.</span></div>
        <div class="stat"><strong>End-to-end</strong><span>Opportunity discovery through prototype, implementation and measurable operation.</span></div>
      </div>
    </div>

    <section id="capabilities" class="section">
      <div class="shell">
        <div class="section-head">
          <div><p class="eyebrow">Core capabilities</p><h2 class="h2">We do more than recommend. We build.</h2></div>
          <p class="kicker">Strategy only matters when it survives contact with implementation. Our work connects process understanding, technical architecture and product execution.</p>
        </div>
        <div class="card-grid">
          {capabilities.map((cap) => (
            <article class="cap-card">
              <span class="cap-index">{cap.index}</span>
              <h3>{cap.title}</h3>
              <p>{cap.text}</p>
              <a href={cap.href}>Explore capability ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="model">
      <div class="shell operating-grid">
        <div>
          <p class="eyebrow">Operating model</p>
          <h2 class="h2">From opportunity to deployment.</h2>
          <p class="kicker">INNOVA does not separate strategy from implementation. We move through one connected operating model and keep technical choices tied to the outcome.</p>
        </div>
        <div class="process" aria-label="INNOVA operating model">
          <div class="process-row"><span class="num">01</span><strong>Discover</strong><span>Problem + opportunity</span></div>
          <div class="process-row"><span class="num">02</span><strong>Design</strong><span>Architecture + path</span></div>
          <div class="process-row"><span class="num">03</span><strong>Prototype</strong><span>Feasibility + validation</span></div>
          <div class="process-row"><span class="num">04</span><strong>Build</strong><span>Product + integrations</span></div>
          <div class="process-row"><span class="num">05</span><strong>Deploy</strong><span>People + systems</span></div>
          <div class="process-row"><span class="num">06</span><strong>Measure</strong><span>Impact + iteration</span></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell product-panel">
        <span class="product-status">Prototype · In development</span>
        <p class="eyebrow" style="margin-top:28px;color:#08624f">Featured product</p>
        <h2 class="product-title">AI transformation starts with understanding how work actually happens.</h2>
        <p class="product-copy"><strong>INNOVA AI Workflow OS</strong> maps company operations, identifies high-value automation opportunities, recommends the right automation architecture and converts them into implementation roadmaps with measurable ROI.</p>
        <div class="flow-chips" aria-label="Workflow OS product flow"><span>Company</span><span>→</span><span>Processes</span><span>→</span><span>Score</span><span>→</span><span>Select</span><span>→</span><span>Design</span><span>→</span><span>Implement</span><span>→</span><span>Measure</span></div>
        <a class="button button-dark button-arrow" href="/workflow-os">Explore Workflow OS</a>
      </div>
    </section>

    <section id="innovation" class="section">
      <div class="shell">
        <div class="section-head">
          <div><p class="eyebrow">Innovation domains</p><h2 class="h2">Technology is horizontal. Impact happens inside industries.</h2></div>
          <p class="kicker">These are areas we build in, research and explore with partners. We state the level of activity explicitly instead of pretending to lead every vertical.</p>
        </div>
        <div class="domain-grid">
          {domains.map(([status, title, text]) => (
            <article class="domain"><small>{status}</small><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="section">
      <div class="shell">
        <div class="section-head">
          <div><p class="eyebrow">Selected work</p><h2 class="h2">Proof beats positioning.</h2></div>
          <p class="kicker">We distinguish what is live, what is being built and what remains experimental. No invented traction. No blurry status labels.</p>
        </div>

        <div class="project-grid">
          <article class="project-card large">
            <span class="status live">Built · Live</span>
            <div class="project-visual" aria-hidden="true">
              <div class="diagram-nodes">
                <div class="diagram-row"><div class="diagram-node accent">Event Platform</div><div class="diagram-node">Vendor Layer</div><div class="diagram-node">Community</div></div>
                <div class="diagram-row"><div class="diagram-node">Content</div><div class="diagram-node accent">UAFest Digital Ecosystem</div><div class="diagram-node">Operations</div></div>
                <div class="diagram-row"><div class="diagram-node">Networking</div><div class="diagram-node">Data</div><div class="diagram-node">Engagement</div></div>
              </div>
            </div>
            <h3>UAFest Digital Ecosystem</h3>
            <p>An interconnected digital environment supporting events, vendors, participants, community engagement and operational workflows.</p>
            <span class="project-meta">Digital products · Operations · Community systems</span>
          </article>

          <article class="project-card">
            <span class="status dev">In development</span>
            <div class="project-visual" aria-hidden="true"><div class="diagram-row"><div class="diagram-node">Human</div><div class="diagram-node accent">Shared Workflow</div><div class="diagram-node">AI Agent</div></div></div>
            <h3>AICRMIUS</h3>
            <p>AI-native CRM/ERP environment designed for humans and AI agents to operate inside shared business workflows.</p>
            <span class="project-meta">CRM/ERP · Agentic systems · Workflow infrastructure</span>
          </article>

          <article class="project-card">
            <span class="status prototype">Prototype · In development</span>
            <div class="project-visual" aria-hidden="true"><div class="diagram-row"><div class="diagram-node">Processes</div><div class="diagram-node accent">Opportunity Score</div><div class="diagram-node">ROI</div></div></div>
            <h3>INNOVA AI Workflow OS</h3>
            <p>Business-process discovery and AI automation planning environment that connects opportunity mapping to implementation and measurable impact.</p>
            <span class="project-meta">Applied AI · Process intelligence · Automation architecture</span>
          </article>
        </div>
      </div>
    </section>

    <section id="partnerships" class="section">
      <div class="shell partnership-panel">
        <div class="partnership-copy">
          <p class="eyebrow">Innovation partnerships</p>
          <h2 class="h2">Bring the expertise. Bring the technology. Bring the problem.</h2>
          <p>We work with technology companies, industry operators, researchers, institutions and public organizations on applied R&D, software development, pilot deployment and commercialization.</p>
          <a class="button button-primary button-arrow" href="#contact">Discuss a collaboration</a>
        </div>
        <div class="partnership-list">
          <div><span>01</span><strong>Co-development</strong></div>
          <div><span>02</span><strong>Applied R&D</strong></div>
          <div><span>03</span><strong>Technology integration</strong></div>
          <div><span>04</span><strong>Pilot deployment</strong></div>
          <div><span>05</span><strong>Commercialization</strong></div>
          <div><span>06</span><strong>Joint funding & innovation applications</strong></div>
        </div>
      </div>
    </section>

    <section id="about" class="section">
      <div class="shell about-grid">
        <div><p class="eyebrow">Company evolution</p><h2 class="h2">New technology. Experienced operators.</h2></div>
        <div class="about-copy">
          <p>INNOVA’s current focus is technology and applied innovation, but the organization was not created yesterday. Our team brings more than 14 years of international experience working across business operations, software, regulation and commercialization.</p>
          <div class="timeline" aria-label="INNOVA evolution"><div><strong>Business</strong><span>Operating context</span></div><div><strong>Digital</strong><span>Systems & channels</span></div><div><strong>Software</strong><span>Products & platforms</span></div><div><strong>AI</strong><span>Automation & agents</span></div><div><strong>Innovation</strong><span>R&D & collaboration</span></div></div>
        </div>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="shell contact-panel">
        <div class="contact-copy">
          <p class="eyebrow">Start a conversation</p>
          <h2 class="h2">Have a problem worth solving or technology worth building around?</h2>
          <p>Tell us what you are working on. We are interested in technology products, AI transformation, applied R&D, commercialization and collaborative projects.</p>
          <p><strong>Ottawa, Ontario</strong><br /><a href="mailto:canada@innovaconsult.ca">canada@innovaconsult.ca</a><br /><a href="tel:+16138677767">+1 (613) 867-7767</a></p>
        </div>
        <form class="contact-form" id="project-form">
          <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="organization">Organization</label><input id="organization" name="organization" autocomplete="organization" /></div>
          <div class="field full"><label for="email">Email</label><input id="email" type="email" name="email" autocomplete="email" required /></div>
          <div class="field full"><label for="type">I want to</label><select id="type" name="type"><option>Build a technology product</option><option>Automate business processes</option><option>Explore an AI initiative</option><option>Discuss an R&D project</option><option>Commercialize technology</option><option>Explore a partnership</option><option>Discuss a public-sector project</option><option>Other</option></select></div>
          <div class="field full"><label for="message">What are you working on?</label><textarea id="message" name="message" required></textarea></div>
          <div class="field full"><button class="button button-dark button-arrow" type="submit">Start a conversation</button></div>
        </form>
      </div>
    </section>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)}></script>
  <script is:inline>
    document.getElementById('project-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const data = new FormData(form);
      const subject = `INNOVA project inquiry — ${data.get('type') || 'Technology project'}`;
      const body = [
        `Name: ${data.get('name') || ''}`,
        `Organization: ${data.get('organization') || ''}`,
        `Email: ${data.get('email') || ''}`,
        `Project type: ${data.get('type') || ''}`,
        '',
        `${data.get('message') || ''}`
      ].join('\n');
      window.location.href = `mailto:canada@innovaconsult.ca?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
