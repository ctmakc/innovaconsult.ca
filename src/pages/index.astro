---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroReel from '../components/home/HeroReel.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusTag from '../components/StatusTag.astro';
import { visibleProjects, projectHref, type Project } from '../data/projects';
import { SITE } from '../data/site';

const P = Object.fromEntries(visibleProjects.map((p) => [p.slug, p])) as Record<string, Project>;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const total = WORDS[visibleProjects.length] ?? String(visibleProjects.length);

/* In the lab: the work that is not in public use yet. Lines restate src/data/projects.ts. */
const LAB: { p: Project; line: string; label?: string }[] = [
  { p: P.openfield, line: 'Ag-robot fleet logbook. Field validation is planned for the 2027 season.', label: 'Prototype · demo data' },
  { p: P.aicrmius, line: 'AI-native CRM: agents propose, a person approves, every change can be undone.' },
  { p: P.finmozg, line: 'Eight finance agents and a CFO copilot on a real double-entry ledger.' },
  { p: P['dual-use'], line: 'Defence-adjacent scouting. Research and lab work only; no contracts.' }
];

/* Workflow OS: four real screens, one sentence each (src/components/wos/data.ts). */
const WOS = [
  { k: 'Map the company', t: 'Processes, people and systems in one model.', src: 'overview', alt: 'Workflow OS overview of a fictional demo company: mapped processes and their automation scores.' },
  { k: 'Score every process', t: 'Fourteen factors minus a risk penalty, with the reason behind every number.', src: 'opportunity-map', alt: 'Workflow OS Opportunity Map: 15 processes plotted by business value and feasibility, Client Onboarding ranked first at 88.' },
  { k: 'Design the architecture', t: 'Six patterns and five levels of human control.', src: 'designer', alt: 'Workflow OS designer: the recommended architecture for one process, with its human-control level.' },
  { k: 'Measure the return', t: 'A projected return that can be checked after go-live.', src: 'impact', alt: 'Workflow OS impact view: projected return over time for the selected automations.' }
];
---

<BaseLayout
  title="INNOVA · Applied AI & Software Company in Ottawa, Canada"
  description="INNOVA researches, prototypes, builds and deploys applied AI and custom software in Ottawa, with every project shown at its real stage, from R&D to live use."
  path="/"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/uafest-unity-ride-m.webp" media="(max-width: 700px)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset="/img/uafest-unity-ride-800.webp 800w, /img/uafest-unity-ride-1200.webp 1200w, /img/uafest-unity-ride.webp 1920w" imagesizes="100vw" media="(min-width: 701px)" fetchpriority="high" />
  </Fragment>

  <HeroReel />

  <!-- ═══ IN USE: the three live products, each screen in its world ═══ -->
  <section class="work shell" id="work" aria-labelledby="work-h">
    <div class="inset">
      <SectionHead id="work-h" title="In use today" size="h2" lede="Three products run in public. Each one carries its real status." link={{ href: '/projects', label: `All ${total} projects` }} />
    </div>
    <div class="work-g">
      <ProjectCard
        project={P.uafest}
        size="full"
        eager
        headline="A festival ran on it."
        fact="Applications, participant cabinets, sponsor and finance registers for a Ukrainian festival in Carleton Place, Ontario. 199 participant cabinets and 13 shared mailboxes in one record."
        world={{ src: '/img/uafest-dance.webp', src800: '/img/uafest-dance-800.webp', w: 1280, h: 818, pos: '30% 50%' }}
        screens={[
          {
            src: '/proof/uafest-applications-1440-1600.webp',
            src800: '/proof/uafest-applications-1440-800.webp',
            w: 1600,
            h: 1000,
            alt: 'UAFest 2027 sign-up page on uafest.ca: one form with participation types for guests, volunteers, vendors, performers, sponsors and the organizing team.',
            l: '45.5%',
            t: '10%',
            width: '50%',
            lm: '7%',
            tm: '10%',
            wm: '86%'
          },
          {
            src: '/proof/uafest-certificate-check-1440-1600.webp',
            src800: '/proof/uafest-certificate-check-1440-800.webp',
            w: 1600,
            h: 473,
            alt: 'UAFest certificate register on uafest.ca: a code field and Check button for verifying a printed certificate.',
            l: '50%',
            t: '64%',
            width: '38%',
            depth: 1.6,
            desktopOnly: true
          }
        ]}
        credit="UAFest festival, Carleton Place"
        aspect="16 / 8"
        aspectM="4 / 3.4"
      />
      <ProjectCard
        project={P.foundwall}
        material="evergreen"
        eager
        aspect="5 / 4.2"
        fact="Web platform live; iOS and Android apps in public beta. Every photo loses its location data before anyone sees it."
        screens={[
          {
            src: '/proof/foundwall-home-1440-1600.webp',
            src800: '/proof/foundwall-home-1440-800.webp',
            w: 1600,
            h: 1000,
            alt: 'FoundWall homepage: Lost, Stolen, Found headline beside sample notices for a bike, a beagle and a robotic mower.',
            l: '8%',
            t: '8%',
            width: '62%',
            lm: '6%',
            tm: '9%',
            wm: '76%'
          },
          {
            src: '/proof/foundwall-board-390-800.webp',
            src800: '/proof/foundwall-board-390-400.webp',
            w: 800,
            h: 1731,
            alt: 'FoundWall board on a phone: stacked notice cards for a stolen bike and a lost cat (sample notices).',
            kind: 'phone',
            l: '73%',
            t: '12%',
            width: '19%',
            lm: '67%',
            tm: '16%',
            wm: '27%',
            depth: 1.6
          }
        ]}
      />
      <ProjectCard
        project={P.babakokum}
        world={{ src: '/img/babakokum-porch.webp', w: 760, h: 720, pos: '50% 30%' }}
        aspect="5 / 4.2"
        fact="On the App Store since 24 September 2026, and playable on the web. Runs fully offline."
        screens={[
          {
            src: '/proof/babakokum-rules-tablet-1600.webp',
            src800: '/proof/babakokum-rules-tablet-800.webp',
            w: 1600,
            h: 1331,
            alt: 'BABA & KOKUM rules card: six scoring patterns for placing printed tiles on a scarf grid and the five ink colours.',
            kind: 'tablet',
            l: '20%',
            t: '6%',
            width: '58%',
            lm: '14%',
            tm: '7%',
            wm: '72%'
          }
        ]}
      />
    </div>

    <div class="lab inset" aria-labelledby="lab-h">
      <h3 id="lab-h" class="lab-k t-label t-mute">In the lab</h3>
      <ul class="lab-g">
        {
          LAB.map(({ p, line, label }) => (
            <li>
              <a href={projectHref(p)} class="lab-i">
                <StatusTag status={p.status} label={label} />
                <span class="lab-n">
                  {p.short}
                  <span class="ar" aria-hidden="true">→</span>
                </span>
                <span class="lab-t">{line}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══ WORKFLOW OS: our own product, one big real screen on bone ═══ -->
  <section class="wos tone-bone" id="workflow-os" aria-labelledby="wos-h">
    <div class="shell">
      <div class="inset">
        <div class="wos-hd">
          <div class="wos-l">
            <p class="t-label t-mute">Our own product</p>
            <h2 id="wos-h" class="t-h2" data-rise>AI transformation starts with how work actually happens.</h2>
          </div>
          <div class="wos-r">
            <p class="wos-name">INNOVA AI Workflow OS <StatusTag status="prototype" /></p>
            <p class="wos-body">Maps how a company works, scores every process for automation value and recommends an architecture for each one, from plain software to supervised AI agents.</p>
            <Button href="/workflow-os" variant="ink" class="wos-cta">Explore Workflow OS</Button>
          </div>
        </div>
        <div class="wos-g" data-wos>
          <div class="wos-tabs" role="group" aria-label="Workflow OS screens">
            {
              WOS.map((s, i) => (
                <button type="button" class:list={['wos-tab', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-wtab={i}>
                  <span class="n tnum">{i + 1}</span>
                  <span class="wos-tt">
                    <b>{s.k}</b>
                    <span>{s.t}</span>
                  </span>
                </button>
              ))
            }
          </div>
          <figure class="wos-fig">
            <div class="wos-stack">
              {
                WOS.map((s, i) => (
                  <img
                    class:list={['scr-img', { on: i === 0 }]}
                    data-wimg={i}
                    src={`/proof/workflow-os-${s.src}-1440-1600.webp`}
                    srcset={`/proof/workflow-os-${s.src}-1440-800.webp 800w, /proof/workflow-os-${s.src}-1440-1600.webp 1600w`}
                    sizes="(max-width: 900px) 92vw, 64vw"
                    alt={s.alt}
                    width="1600"
                    height="1000"
                    decoding="async"
                  />
                ))
              }
            </div>
            <figcaption class="disc">Online since 1 October 2026 as an invite-only demo. Northstar Professional Services is a fictional 30-person firm; all data shown is illustrative.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHO BUILDS IT: founder and the company, in one statement ═══ -->
  <section class="who shell" aria-labelledby="who-h">
    <div class="inset who-g">
      <div class="who-l">
        <p class="t-label t-mute">Who builds it</p>
        <h2 id="who-h" class="who-h" data-rise>
          Led by its founder, Maksym Stepanenko. In business since {SITE.experienceSince}, with companies in more than 50&nbsp;countries.
        </h2>
      </div>
      <div class="who-r">
        <p>{SITE.legalName} is a federal corporation in Ottawa, Ontario, incorporated in {SITE.incorporated}.</p>
        <p class="t-mute">For funded and client projects, engineering, security review and domain specialists join as named subcontractors or partner firms, listed in the proposal before work starts.</p>
        <p class="who-k">
          <a class="lnk" href="/about">About INNOVA <span class="ar" aria-hidden="true">→</span></a>
          <a class="lnk" href="/partnerships">Partnerships <span class="ar" aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Workflow OS: a step picks the screen. Instant swap, no fade, so a screen is never blank.
  const box = document.querySelector<HTMLElement>('[data-wos]');
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-wtab]')];
    const imgs = [...box.querySelectorAll<HTMLElement>('[data-wimg]')];
    const pick = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle('on', j === i);
        t.setAttribute('aria-pressed', j === i ? 'true' : 'false');
      });
      imgs.forEach((m, j) => m.classList.toggle('on', j === i));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('mouseenter', () => window.matchMedia('(hover: hover)').matches && pick(i));
    });
  }
</script>

<style>
  /* ── in use ── */
  .work {
    padding-top: var(--sec);
  }
  .work-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .work-g > :global(.mf--full) {
    grid-column: 1 / -1;
  }

  /* ── in the lab ── */
  .lab {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 10fr);
    column-gap: var(--col-gap);
    row-gap: 18px;
    margin-top: clamp(40px, 4.4vw, 72px);
  }
  .lab-k {
    padding-top: 22px;
  }
  .lab-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px var(--col-gap);
  }
  .lab-i {
    display: grid;
    align-content: start;
    gap: 10px;
    height: 100%;
    padding-top: 20px;
    border-top: 1px solid var(--rule-film);
    text-decoration: none;
    color: var(--ash);
  }
  .lab-i :global(.tag) {
    color: var(--ash);
  }
  .lab-n {
    font-size: clamp(22px, 1.8vw, 28px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--print);
  }
  .lab-n .ar {
    display: inline-block;
    margin-left: 6px;
    font-weight: 400;
    transition: transform 0.3s var(--e-out);
  }
  .lab-i:hover .ar {
    transform: translateX(6px);
  }
  .lab-t {
    font-size: 16px;
    line-height: 1.45;
  }

  /* ── workflow os ── */
  .wos {
    margin-top: var(--sec);
    padding-block: calc(var(--sec) * 0.72);
  }
  .wos-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 28px;
    align-items: end;
  }
  .wos-l {
    grid-column: 1 / span 7;
  }
  .wos-l .t-h2 {
    margin-top: 18px;
    max-width: 16ch;
  }
  .wos-r {
    grid-column: 9 / span 4;
  }
  .wos-name {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 20px;
    font-weight: 600;
  }
  .wos-body {
    margin-top: 10px;
    color: var(--ink-soft);
    max-width: 44ch;
  }
  .wos-r :global(.wos-cta) {
    margin-top: 20px;
  }
  .wos-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin-top: clamp(36px, 4vw, 64px);
    align-items: start;
  }
  .wos-tabs {
    grid-column: 1 / span 3;
    display: grid;
  }
  .wos-tab {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 10px;
    text-align: left;
    padding: 18px 0;
    background: none;
    border: 0;
    border-top: 1px solid var(--rule-ink);
    color: var(--ink-soft);
    font: inherit;
    cursor: pointer;
    transition: color var(--t-micro) var(--e-out);
  }
  .wos-tab .n {
    font-size: 15px;
    font-weight: 600;
    padding-top: 4px;
  }
  .wos-tt b {
    display: block;
    font-size: clamp(20px, 1.6vw, 25px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .wos-tt span {
    display: block;
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.4;
  }
  .wos-tab.on {
    color: var(--ink);
    border-top: 2px solid var(--ink);
    padding-top: 17px;
  }
  .wos-tab.on .n {
    color: var(--flare-ink);
  }
  .wos-tab:hover {
    color: var(--ink);
  }
  .wos-fig {
    grid-column: 4 / -1;
    margin: 0;
    padding-left: clamp(0px, 1.6vw, 24px);
  }
  .wos-stack {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .wos-stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    visibility: hidden;
  }
  .wos-stack img.on {
    visibility: visible;
  }
  .disc {
    margin-top: 14px;
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 80ch;
  }

  /* ── who builds it ── */
  .who {
    padding-top: var(--sec);
  }
  .who-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 32px;
    align-items: end;
  }
  .who-l {
    grid-column: 1 / span 8;
  }
  .who-h {
    margin-top: 18px;
    font-size: clamp(32px, 3.6vw, 60px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.04;
    max-width: 22ch;
    text-wrap: balance;
  }
  .who-r {
    grid-column: 9 / span 4;
    display: grid;
    gap: 14px;
    font-size: 17px;
    line-height: 1.5;
    padding-bottom: 0.3em;
  }
  .who-k {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 6px;
  }

  @media (max-width: 1100px) {
    .lab-g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .work-g {
      grid-template-columns: 1fr;
    }
    .lab {
      grid-template-columns: 1fr;
    }
    .lab-k {
      padding-top: 0;
    }
    .wos-l,
    .wos-r,
    .who-l,
    .who-r {
      grid-column: 1 / -1;
    }
    .wos-g {
      display: flex;
      flex-direction: column-reverse;
      gap: 20px;
    }
    .wos-fig {
      padding-left: 0;
      width: 100%;
    }
    .wos-tabs {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
      width: 100%;
    }
    .wos-tt span {
      display: none;
    }
    .wos-tab {
      padding: 14px 0;
      min-height: 44px;
    }
  }
  @media (max-width: 520px) {
    .lab-g {
      grid-template-columns: 1fr;
    }
  }
</style>
