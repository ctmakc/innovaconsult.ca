---
import BaseLayout from '../layouts/BaseLayout.astro';
import RiseHeading from '../components/RiseHeading.astro';
import PipelineBoard from '../components/PipelineBoard.astro';
import StageTrack from '../components/StageTrack.astro';
import StatusChip from '../components/StatusChip.astro';
import StageLine from '../components/StageLine.astro';
import { CAPABILITIES } from '../data/capabilities';
import { SECTORS, ENGAGEMENT_LABEL } from '../data/sectors';
import { featuredProjects, STATUS_STAGE } from '../data/projects';
import { SITE } from '../data/site';

const engagementMark = { building: 'building', researching: 'research', exploring: 'exploring' } as const;
const wosFlow = ['Company', 'Processes', 'Score', 'Select', 'Design', 'Implement', 'Measure'];
const stageNotes = [
  'We look at how the organization works and where technology would change the result.',
  'We test the technical options against real data and constraints before anyone commits a budget.',
  'We build a working prototype that real users can try within weeks.',
  'We engineer the chosen solution with security, permissions and audit built in.',
  'We roll it out inside the systems and routines people already use.',
  'We measure time, cost, errors and adoption against the starting point.'
];
---

<BaseLayout
  title="INNOVA — Applied Innovation & Technology | Ottawa, Canada"
  description="INNOVA is an Ottawa applied-innovation company. We research, prototype, build and deploy applied AI and software with companies, researchers and public organizations."
  path="/"
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap grid12 hero-grid">
      <div class="hero-copy">
        <p class="kicker hero-kick">Applied innovation · Ottawa, Canada</p>
        <RiseHeading text="Turning complex opportunities into working technology." />
        <p class="lede hero-lede">
          INNOVA researches, prototypes, builds and deploys applied AI and software, and brings companies, researchers and public organizations onto the same project.
        </p>
        <div class="hero-ctas">
          <a href="/projects" class="btn btn-primary">Explore what we build <span class="arr" aria-hidden="true">→</span></a>
          <a href="/partnerships" class="btn btn-ghost">Work with INNOVA</a>
        </div>
        <p class="hero-trust mono">Ottawa, Canada · 14+ years of international business and technology experience</p>
      </div>
      <div class="hero-board">
        <PipelineBoard />
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section" id="what-we-do">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l">
          <h2 class="d-xl">Four capabilities on one line.</h2>
        </div>
        <p class="body sh-r">
          Each capability covers a stretch of the path from first opportunity to measured impact. The track on the right of every row shows which stretch.
        </p>
      </div>
      <div class="rows">
        {
          CAPABILITIES.map((c) => (
            <a class="row" href={c.href}>
              <h3 class="d-m row-title">{c.name}</h3>
              <p class="body">{c.line}</p>
              <StageTrack span={c.span} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OPERATING MODEL -->
  <section class="section" id="how-we-work">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l">
          <h2 class="d-xl">From opportunity to deployment.</h2>
        </div>
        <p class="body sh-r">
          Strategy and implementation stay in one team. The people who study the problem also build, ship and measure the solution, so nothing is lost in a hand-off.
        </p>
      </div>
      <StageLine notes={stageNotes} />
    </div>
  </section>

  <!-- WORKFLOW OS -->
  <section class="section wos" id="workflow-os">
    <div class="wrap grid12">
      <div class="wos-l">
        <h2 class="d-xl">AI transformation starts with how work actually happens.</h2>
        <div class="wos-name">
          <span class="d-m">INNOVA AI Workflow OS</span>
          <StatusChip status="prototype" />
        </div>
        <p class="lede">From business processes to measurable AI automation.</p>
        <p class="body">
          Workflow OS maps a company’s operations, scores every process for automation value, recommends the right architecture, from plain software to supervised AI agents, and turns the result into an implementation plan with a measurable return.
        </p>
        <a href="/workflow-os" class="btn btn-primary wos-cta">Explore Workflow OS <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="wos-r" aria-label="Workflow OS flow">
        <ol class="wos-flow" data-draw>
          {
            wosFlow.map((step, i) => (
              <li style={`--i:${i}`}>
                <span class="mono wos-i">{String(i + 1).padStart(2, '0')}</span>
                <span class="wos-step">{step}</span>
              </li>
            ))
          }
        </ol>
        <div class="wos-why">
          <p class="mono">Every score shows its reasons</p>
          <ul>
            {['Time spent', 'Volume', 'Repetition', 'Error rate', 'Delays', 'Cost', 'Risk', 'Data readiness', 'Integration effort', 'AI suitability', 'ROI potential'].map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DOMAINS -->
  <section class="section" id="domains">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l">
          <h2 class="d-xl">Technology is horizontal. Impact happens inside industries.</h2>
        </div>
        <p class="body sh-r">Areas we build in, research and explore with partners. The mark on each row says which.</p>
      </div>
      <div class="dom">
        {
          SECTORS.map((s) => (
            <div class="dom-row">
              <span class="status dom-st">
                <span class="mark" data-s={engagementMark[s.engagement]} aria-hidden="true" />
                {ENGAGEMENT_LABEL[s.engagement]}
              </span>
              <h3 class="d-m dom-h">{s.name}</h3>
              <p class="body dom-p">
                {s.line}
                {s.evidence && <span class="dom-ev mono">{s.evidence}</span>}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section" id="projects">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l">
          <h2 class="d-xl">Real work, with its real status.</h2>
        </div>
        <p class="body sh-r">
          Live products, systems in development and early research sit side by side. Every project carries one status, and the track shows its stage.
        </p>
      </div>
      <div class="rows">
        {
          featuredProjects.map((p) => (
            <a class="row prow" href={`/projects/${p.slug}`}>
              <div class="row-title">
                <p class="mono prow-code">{p.code}</p>
                <h3 class="d-m">{p.name}</h3>
              </div>
              <p class="body">{p.summary}</p>
              <div class="prow-meta">
                <StatusChip status={p.status} />
                <StageTrack at={STATUS_STAGE[p.status]} status={p.status} caption={false} />
              </div>
            </a>
          ))
        }
      </div>
      <p class="more">
        <a class="arrow-link" href="/projects"><span>All projects</span><span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- COLLABORATION -->
  <section class="section collab" id="collaboration">
    <div class="wrap grid12">
      <div class="co-l">
        <h2 class="d-xl">Innovation works better in collaboration.</h2>
      </div>
      <div class="co-r">
        <p class="lede">
          We work with technology companies, industry operators, researchers, institutions and public organizations on applied R&amp;D, software development, pilot deployment and commercialization.
        </p>
        <ul class="co-areas">
          {['Applied AI', 'Industrial software', 'Agriculture technology', 'Health technology', 'Data infrastructure', 'Public-sector digital systems', 'Commercializing emerging technology'].map((a) => <li>{a}</li>)}
        </ul>
        <div class="co-ctas">
          <a href="/partnerships" class="btn btn-primary">Discuss a collaboration <span class="arr" aria-hidden="true">→</span></a>
          <a href="/partnerships#models" class="arrow-link"><span>Partnership models</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY -->
  <section class="section cred" id="background">
    <div class="wrap grid12">
      <div class="cr-l">
        <h2 class="d-xl">New technology. Experienced operators.</h2>
        <p class="body cr-p">
          INNOVA’s focus today is applied technology, built on a longer history. Its founder has worked with businesses across many jurisdictions, industries and operating environments since {SITE.experienceSince}. That history teaches how companies run, where processes break and what it takes to get a new system adopted.
        </p>
        <a href="/about" class="arrow-link"><span>About INNOVA</span><span aria-hidden="true">→</span></a>
      </div>
      <ol class="cr-path" data-draw>
        <span class="cr-rail trk-span" aria-hidden="true"></span>
        <li><span class="mono">From {SITE.experienceSince}</span><strong>Business operations</strong> across jurisdictions and industries</li>
        <li><span class="mono">Then</span><strong>Digital systems</strong> for the companies we worked with</li>
        <li><span class="mono">Then</span><strong>Software products</strong> built and run in-house</li>
        <li><span class="mono">Then</span><strong>Applied AI</strong> inside real business workflows</li>
        <li><span class="mono">{SITE.incorporated} · Canada</span><strong>{SITE.legalName}</strong> incorporated federally, based in Ottawa</li>
        <li class="now"><span class="mono">Now</span><strong>Applied innovation</strong> with Canadian partners</li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(36px, 4vw, 64px) clamp(72px, 7vw, 120px);
  }
  .hero-grid {
    align-items: start;
    row-gap: 48px;
  }
  .hero-copy {
    grid-column: 1 / span 5;
    padding-top: clamp(8px, 2vw, 36px);
  }
  .hero-board {
    grid-column: 6 / span 7;
    padding-top: clamp(8px, 2vw, 36px);
  }
  .hero-kick {
    animation: hfade 700ms var(--ease-out) both;
  }
  .hero-lede {
    margin-top: 28px;
    animation: hfade 800ms var(--ease-out) 520ms both;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
    animation: hfade 800ms var(--ease-out) 640ms both;
  }
  .hero-trust {
    margin: 30px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--lichen);
    font-size: 0.7rem;
    max-width: 46ch;
    animation: hfade 800ms var(--ease-out) 760ms both;
  }
  @keyframes hfade {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero * {
      animation: none !important;
    }
  }
  @media (max-width: 1100px) {
    .hero-copy,
    .hero-board {
      grid-column: 1 / -1;
    }
    .hero-copy .d-hero {
      max-width: 14ch;
    }
  }

  /* Workflow OS */
  .wos-l {
    grid-column: 1 / span 6;
  }
  .wos-r {
    grid-column: 8 / span 5;
  }
  .wos-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin: 36px 0 14px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }
  .wos-l .lede {
    margin-bottom: 18px;
  }
  .wos-cta {
    margin-top: 30px;
  }
  .wos-flow {
    list-style: none;
    margin: 0;
    padding: 0 0 0 30px;
    position: relative;
  }
  .wos-flow::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: var(--signal);
    transform-origin: top;
    transition: transform 1100ms var(--ease-in-out);
  }
  :global(.js) .wos-flow:not(.is-in)::before {
    transform: scaleY(0);
  }
  .wos-flow li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
  }
  .wos-flow li::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 50%;
    width: 11px;
    height: 11px;
    margin-top: -5.5px;
    border-radius: 50%;
    background: var(--ground);
    border: 2px solid var(--signal);
  }
  .wos-flow li:last-child::before {
    background: var(--signal);
  }
  .wos-i {
    color: var(--lichen);
  }
  .wos-step {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 480;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    letter-spacing: -0.02em;
  }
  .wos-why {
    margin-top: 28px;
    padding: 20px 22px;
    background: var(--plate);
    border: 1px solid var(--rule);
  }
  .wos-why .mono {
    margin: 0 0 14px;
    color: var(--frost);
  }
  .wos-why ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .wos-why li {
    font-size: 0.86rem;
    color: var(--lichen);
    padding: 4px 10px;
    border: 1px solid var(--rule-strong);
  }
  @media (max-width: 980px) {
    .wos-l,
    .wos-r {
      grid-column: 1 / -1;
    }
    .wos-r {
      margin-top: 48px;
    }
  }

  /* Domains: two-column ruled list */
  .dom {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 4vw, 72px);
    border-bottom: 1px solid var(--rule);
  }
  .dom-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding: 26px 0 28px;
    border-top: 1px solid var(--rule);
  }
  .dom-st {
    color: var(--lichen);
  }
  .dom-h {
    margin: 2px 0 0;
  }
  .dom-ev {
    display: block;
    margin-top: 10px;
    color: var(--frost);
    font-size: 0.7rem;
  }
  @media (max-width: 860px) {
    .dom {
      grid-template-columns: 1fr;
    }
  }

  /* Projects */
  .prow-code {
    color: var(--lichen);
    margin: 0 0 8px;
  }
  .prow h3 {
    margin: 0;
  }
  .prow-meta {
    display: grid;
    gap: 12px;
  }
  .more {
    margin: 32px 0 0;
  }

  /* Collaboration */
  .co-l {
    grid-column: 1 / span 5;
  }
  .co-r {
    grid-column: 7 / span 6;
    padding-top: 8px;
  }
  .co-areas {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 8px;
  }
  .co-areas li {
    padding: 7px 14px;
    border: 1px solid var(--rule-strong);
    font-size: 0.95rem;
  }
  .co-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 36px;
  }
  @media (max-width: 980px) {
    .co-l,
    .co-r {
      grid-column: 1 / -1;
    }
    .co-r {
      margin-top: 24px;
    }
  }

  /* Credibility */
  .cr-l {
    grid-column: 1 / span 5;
  }
  .cr-p {
    margin: 28px 0 28px;
  }
  .cr-path {
    grid-column: 7 / span 6;
    list-style: none;
    margin: 0;
    padding: 0 0 0 34px;
    position: relative;
    align-self: center;
  }
  .cr-path::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--rule-strong);
  }
  .cr-rail {
    position: absolute;
    left: 5px;
    top: 10px;
    bottom: 10px;
    width: 3px;
    background: var(--signal);
    transform-origin: top;
    transition: transform var(--t-draw) var(--ease-in-out);
  }
  :global(.js) .cr-path:not(.is-in) .cr-rail {
    transform: scaleY(0) !important;
  }
  :global(.js) .cr-path.is-in .cr-rail {
    transform: none !important;
  }
  .cr-path li {
    position: relative;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--lichen);
  }
  .cr-path li::before {
    content: '';
    position: absolute;
    left: -33px;
    top: 50%;
    width: 11px;
    height: 11px;
    margin-top: -5.5px;
    border-radius: 50%;
    background: var(--ground);
    border: 2px solid var(--signal);
  }
  .cr-path li.now::before {
    background: var(--signal);
  }
  .cr-path .mono {
    display: block;
    color: var(--signal);
    font-size: 0.68rem;
    margin-bottom: 4px;
  }
  .cr-path strong {
    color: var(--frost);
    font-weight: 600;
    margin-right: 6px;
  }
  @media (max-width: 980px) {
    .cr-l,
    .cr-path {
      grid-column: 1 / -1;
    }
    .cr-path {
      margin-top: 40px;
    }
  }
</style>
