---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFilm from '../components/HeroFilm.astro';
import FundedProject from '../components/home/FundedProject.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusTag from '../components/StatusTag.astro';
import { visibleProjects, projectHref, type Project } from '../data/projects';
import { SITE } from '../data/site';
import { CROPS, asScreen } from '../data/crops';
import { HOME_MEDIA } from '../components/home/media';

const P = Object.fromEntries(visibleProjects.map((p) => [p.slug, p])) as Record<string, Project>;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const total = WORDS[visibleProjects.length] ?? String(visibleProjects.length);

/* In the lab: the work that is not in public use yet, named in one line (src/data/projects.ts). */
/* Descriptors restate each project's tagline in src/data/projects.ts. */
const LAB: { p: Project; d: string }[] = [
  { p: P.openfield, d: 'a logbook for ag-robot fleets' },
  { p: P.aicrmius, d: 'an AI-native CRM' },
  { p: P.finmozg, d: 'an AI finance back office' },
  { p: P['dual-use'], d: 'defence-adjacent scouting' }
];

/* Workflow OS on home: three readable 2x crops of the redesigned product UI (public/media/wos-*).
   The hero film already shows the process landscape and the score waterfall, so these are the
   other three moments: the opportunity map, the automation route with its human approval gates,
   and the before/after business case. Copy from src/components/wos/data.ts. */
const WOS = [
  { k: 'Score every process', t: 'Fourteen factors minus a risk penalty, with the reason behind every number.', c: HOME_MEDIA.wosMap, x: 0.14 },
  { k: 'Design the architecture', t: 'Six patterns and five levels of human control.', c: HOME_MEDIA.wosRoute, x: 0 },
  { k: 'Measure the return', t: 'A projected return that can be checked after go-live.', c: HOME_MEDIA.wosImpact, x: 0 }
];
---

<BaseLayout
  title="INNOVA · Applied AI & Software Company in Ottawa, Canada"
  description="INNOVA researches, prototypes, builds and deploys applied AI and custom software in Ottawa, with every project shown at its real stage, from R&D to live use."
  path="/"
  cta={{
    title: `Founder-led since ${SITE.experienceSince}. Start a conversation.`,
    lede: `${SITE.legalName} is a federal corporation in Ottawa, led by its founder, Maksym Stepanenko, who has worked with companies in more than 50 countries. Every message is read by a person.`,
    link: { href: '/about', label: 'About INNOVA' }
  }}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/media/hero-film-poster-m.webp" media="(max-width: 900px)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset="/media/hero-film-poster-1280.webp 1280w, /media/hero-film-poster-1920.webp 1920w" imagesizes="100vw" media="(min-width: 901px)" fetchpriority="high" />
  </Fragment>

  <HeroFilm />

  <!-- ═══ IN USE: the three live products, each screen in its world, each one readable crop ═══ -->
  <section class="work shell" id="work" aria-labelledby="work-h">
    <div class="inset work-hd">
      <h2 id="work-h" class="t-h2" data-rise>In use today</h2>
      <a class="lnk" href="/projects">All {total} projects <span class="ar" aria-hidden="true">→</span></a>
    </div>
    <div class="work-g">
      <ProjectCard
        project={P.uafest}
        size="full"
        eager
        headline="A festival ran on it."
        fact="199 participant cabinets and 13 shared mailboxes in one record, for a Ukrainian festival in Carleton Place, Ontario."
        world={{ src: '/img/uafest-dance.webp', src800: '/img/uafest-dance-800.webp', w: 1280, h: 818, pos: '22% 50%' }}
        screens={[asScreen(HOME_MEDIA.uafestCert, { l: '55%', t: '7%', width: '40%', lm: '7%', tm: '7%', wm: '86%' })]}
        credit="UAFest festival, Carleton Place"
        aspect="16 / 8"
        aspectM="4 / 3.3"
      />
      <ProjectCard
        project={P.foundwall}
        material="evergreen"
        fact="Web platform live; iOS and Android apps in public beta. Every photo loses its location data before anyone sees it."
        screens={[asScreen(CROPS.foundwall, { l: '7%', t: '9%', width: '86%', lm: '6%', tm: '8%', wm: '88%' })]}
      />
      <ProjectCard
        project={P.babakokum}
        world={{ src: '/img/babakokum-porch.webp', w: 760, h: 720, pos: '50% 30%' }}
        fact="On the App Store since 24 September 2026, and playable on the web. Runs fully offline."
        screens={[asScreen(CROPS.babakokum, { l: '9%', t: '13%', width: '82%', lm: '6%', tm: '14%', wm: '88%' })]}
      />
    </div>

    <p class="lab inset">
      Four more in the lab:
      {
        LAB.map(({ p, d }, i) => (
          <>
            <a href={projectHref(p)}>{p.short}</a>, {d}
            {i < LAB.length - 2 ? '; ' : i === LAB.length - 2 ? '; and ' : '.'}
          </>
        ))
      }
    </p>
  </section>

  <!-- ═══ R&D: what a funded project looks like (IRAP / Invest Ottawa readers) ═══ -->
  <FundedProject />

  <!-- ═══ WORKFLOW OS: our own product, readable 2x crops on bone ═══ -->
  <section class="wos tone-bone" id="workflow-os" aria-labelledby="wos-h">
    <div class="shell">
      <div class="inset">
        <h2 id="wos-h" class="t-h2 wos-h" data-rise>AI transformation starts with how work actually happens.</h2>
        <div class="wos-intro">
          <p class="wos-body"><span class="wos-name">INNOVA AI Workflow OS <StatusTag status="prototype" /></span> maps how a company works, scores every process for automation value and recommends an architecture for each one, from plain software to supervised AI agents.</p>
          <Button href="/workflow-os" variant="ink" class="wos-cta">Explore Workflow OS</Button>
        </div>
        <div class="wos-g" data-wos>
          <div class="wos-tabs" role="group" aria-label="Workflow OS screens">
            {
              WOS.map((s, i) => (
                <button type="button" class:list={['wos-tab', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-wtab={i}>
                  <b>{s.k}</b>
                  <span>{s.t}</span>
                </button>
              ))
            }
          </div>
          <figure class="wos-fig">
            <div class="wos-stack" data-wpan role="region" aria-label="Workflow OS screen">
              {
                WOS.map((s, i) => (
                  <img
                    class:list={['scr-img scr-dark', { on: i === 0 }]}
                    data-wimg={i}
                    data-x0={s.x}
                    src={s.c.src}
                    srcset={s.c.srcset}
                    sizes="(max-width: 900px) 250vw, 92vw"
                    alt={s.c.alt}
                    width={s.c.w}
                    height={s.c.h}
                    loading="lazy"
                    decoding="async"
                  />
                ))
              }
            </div>
            <figcaption class="disc"><span class="pan-hint">Swipe the screen sideways to see all of it. </span>Online since 1 October 2026 as an invite-only demo. Northstar Professional Services is a fictional 30-person firm; all data shown is illustrative.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Workflow OS: a step picks the screen. Instant swap, no fade, so a screen is never blank.
  const box = document.querySelector<HTMLElement>('[data-wos]');
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-wtab]')];
    const imgs = [...box.querySelectorAll<HTMLElement>('[data-wimg]')];
    const pan = box.querySelector<HTMLElement>('[data-wpan]');
    // the screen pans sideways on phones: make it reachable by keyboard only when it actually scrolls
    if (pan) {
      const kb = () => (pan.scrollWidth > pan.clientWidth + 4 ? pan.setAttribute('tabindex', '0') : pan.removeAttribute('tabindex'));
      new ResizeObserver(kb).observe(pan);
      pan.querySelectorAll('img').forEach((m) => m.addEventListener('load', kb, { once: true }));
      const first = imgs[0];
      const home = () => (pan.scrollLeft = (Number(first?.dataset.x0) || 0) * pan.scrollWidth);
      if (first instanceof HTMLImageElement && first.complete) home();
      else first?.addEventListener('load', home, { once: true });
    }
    const pick = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle('on', j === i);
        t.setAttribute('aria-pressed', j === i ? 'true' : 'false');
      });
      imgs.forEach((m, j) => m.classList.toggle('on', j === i));
      if (pan) pan.scrollLeft = (Number(imgs[i]?.dataset.x0) || 0) * pan.scrollWidth;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('mouseenter', () => window.matchMedia('(hover: hover)').matches && pick(i));
    });
  }
</script>

<style>
  /* ── in use ── */
  .work {
    padding-top: var(--sec);
  }
  .work-hd {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(24px, 2.6vw, 40px);
  }
  .work-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .work-g > :global(.mf--full) {
    grid-column: 1 / -1;
  }

  /* ── in the lab: one line ── */
  .lab {
    margin-top: clamp(40px, 4.4vw, 72px);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.022em;
    line-height: 1.35;
    color: var(--ash);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .lab a {
    color: var(--print);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: rgb(238 234 226 / 0.4);
    text-underline-offset: 6px;
    transition: text-decoration-color var(--t-micro) var(--e-out);
  }
  .lab a:hover {
    text-decoration-color: var(--print);
  }

  /* ── workflow os: stacked head, three captions as tabs, one full-width readable screen ── */
  .wos {
    margin-top: var(--sec);
    padding-block: calc(var(--sec) * 0.72);
  }
  .wos-h {
    max-width: 18ch;
  }
  .wos-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 20px 40px;
    margin-top: clamp(20px, 2vw, 28px);
  }
  .wos-body {
    max-width: 56ch;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .wos-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: 4px;
    font-weight: 600;
    color: var(--ink);
  }
  .wos-name :global(.tag) {
    font-weight: 500;
  }
  .wos-g {
    margin-top: clamp(36px, 4vw, 56px);
  }
  .wos-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--col-gap);
  }
  .wos-tab {
    display: grid;
    align-content: start;
    gap: 6px;
    text-align: left;
    padding: 18px 0 20px;
    background: none;
    border: 0;
    border-top: 2px solid var(--rule-ink);
    color: var(--ink-soft);
    font: inherit;
    cursor: pointer;
    transition:
      color var(--t-micro) var(--e-out),
      border-color var(--t-micro) var(--e-out);
  }
  .wos-tab b {
    font-size: clamp(20px, 1.6vw, 25px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .wos-tab span {
    font-size: 17px;
    line-height: 1.4;
    max-width: 36ch;
    text-wrap: pretty;
  }
  .wos-tab.on,
  .wos-tab:hover {
    color: var(--ink);
  }
  .wos-tab.on {
    border-top-color: var(--ink);
  }
  .wos-fig {
    margin: 8px 0 0;
  }
  .wos-stack {
    position: relative;
    aspect-ratio: 2288 / 1192;
  }
  .wos-stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    background: var(--ui-dark);
    visibility: hidden;
  }
  .wos-stack img.on {
    visibility: visible;
  }
  .pan-hint {
    display: none;
  }
  .disc {
    margin-top: 14px;
    font-size: 15px;
    color: var(--ink-soft);
    max-width: 80ch;
  }

  @media (max-width: 900px) {
    .work-g {
      grid-template-columns: 1fr;
    }
    .wos-tabs {
      column-gap: 12px;
    }
    .wos-tab {
      padding: 14px 0;
      min-height: 44px;
    }
    .wos-tab b {
      font-size: 17px;
    }
    .wos-tab span {
      display: none;
    }
    /* phones: the screen keeps a readable scale (UI text ~11px) and pans sideways
       instead of shrinking the whole 2288px master to the viewport (~8px text) */
    .wos-stack {
      margin-inline: calc(var(--in) * -1 - var(--gut));
      aspect-ratio: auto;
      height: min(126vw, 520px);
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--ink-soft) transparent;
      background: var(--ui-dark);
    }
    .wos-stack:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: 2px;
    }
    .wos-stack img {
      inset: 0 auto 0 0;
      width: auto;
      max-width: none;
      height: 100%;
      object-fit: fill;
      border-radius: 0;
      box-shadow: none;
    }
    .disc {
      font-size: 14px;
    }
    .pan-hint {
      display: inline;
      color: var(--ink);
    }
  }
</style>
