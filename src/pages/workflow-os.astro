---
const pageTitle = 'INNOVA AI Workflow OS — Demo';
const pageDescription = 'Process intelligence and AI automation planning platform by INNOVA.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="noindex,nofollow" />
  <title>{pageTitle}</title>
  <style>
    :root{--bg:#08100e;--panel:#0d1714;--panel2:#111d19;--line:#20312b;--text:#eef6f2;--muted:#8ea69c;--accent:#65f5bb;--accent2:#1fd38e;--warn:#f8c76b;--risk:#f27c75;--blue:#79a8ff;--shadow:0 20px 70px rgba(0,0,0,.28)}
    *{box-sizing:border-box} html{background:var(--bg);color-scheme:dark} body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:radial-gradient(circle at 75% -10%,rgba(39,171,125,.13),transparent 30%),var(--bg);color:var(--text);min-height:100vh}
    button,input,textarea{font:inherit} button{cursor:pointer}.app{display:grid;grid-template-columns:248px 1fr;min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;border-right:1px solid var(--line);background:rgba(7,14,12,.93);backdrop-filter:blur(14px);padding:20px 14px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;align-items:center;gap:11px;padding:4px 8px 19px}.mark{width:33px;height:33px;border-radius:9px;background:linear-gradient(135deg,var(--accent),#33c5a2);color:#06100d;font-weight:950;display:grid;place-items:center;letter-spacing:-1px}.brand strong{font-size:14px;letter-spacing:.04em}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:2px;letter-spacing:.08em;text-transform:uppercase}.company{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:11px;margin-bottom:18px}.company .eyebrow{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.14em}.company .name{font-size:12px;font-weight:750;margin-top:5px;display:flex;justify-content:space-between;gap:8px}.demo{font-size:9px;border:1px solid rgba(101,245,187,.3);color:var(--accent);border-radius:999px;padding:2px 6px}.nav{display:grid;gap:3px}.nav button{background:transparent;border:0;color:#9ab0a7;text-align:left;border-radius:9px;padding:10px 11px;font-size:12px;display:flex;align-items:center;gap:9px}.nav button:hover{background:#101b17;color:#dff3ea}.nav button.active{background:#14231e;color:var(--text);box-shadow:inset 2px 0 0 var(--accent)}.nav .icon{width:15px;text-align:center;opacity:.9}.sidefoot{margin-top:auto;padding:14px 8px 2px;color:#6f877d;font-size:10px;line-height:1.6}.dot{display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%;box-shadow:0 0 10px rgba(101,245,187,.65);margin-right:6px}
    .main{min-width:0}.topbar{height:64px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;background:rgba(8,16,14,.88);backdrop-filter:blur(14px);z-index:15}.crumb{font-size:11px;color:var(--muted)}.crumb strong{color:#dcebe5}.topmeta{display:flex;gap:12px;align-items:center;font-size:10px;color:var(--muted)}.chip{border:1px solid var(--line);border-radius:999px;padding:6px 9px;background:#0b1512}.content{padding:30px;max-width:1500px;margin:auto}.view{display:none}.view.active{display:block;animation:fade .22s ease}@keyframes fade{from{opacity:.25;transform:translateY(3px)}to{opacity:1;transform:none}}.pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}.pagehead h1{font-size:27px;letter-spacing:-.04em;margin:0 0 7px}.pagehead p{margin:0;color:var(--muted);font-size:12px;max-width:720px;line-height:1.55}.primary,.secondary,.ghost{border-radius:9px;padding:9px 13px;font-size:11px;font-weight:750}.primary{border:1px solid var(--accent);background:var(--accent);color:#07110d}.primary:hover{filter:brightness(1.05)}.secondary{border:1px solid #2b423a;background:#13211c;color:#dcebe5}.ghost{border:1px solid var(--line);background:transparent;color:#b8c8c1}.grid{display:grid;gap:14px}.stats{grid-template-columns:repeat(5,minmax(0,1fr));margin-bottom:16px}.card{background:linear-gradient(180deg,rgba(17,29,25,.95),rgba(12,22,18,.96));border:1px solid var(--line);border-radius:14px;box-shadow:0 10px 30px rgba(0,0,0,.08)}.stat{padding:16px}.stat .label{color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.09em}.stat .value{font-size:25px;font-weight:850;letter-spacing:-.04em;margin:9px 0 4px}.stat .sub{font-size:10px;color:#7f958d}.accent{color:var(--accent)}.warn{color:var(--warn)}.risk{color:var(--risk)}.blue{color:var(--blue)}
    .overview-grid{grid-template-columns:1.4fr .9fr}.section{padding:18px}.section h2{font-size:13px;margin:0 0 15px}.opp-row{display:grid;grid-template-columns:1fr 46px 88px;gap:10px;align-items:center;padding:11px 0;border-top:1px solid #1a2a24}.opp-row:first-of-type{border-top:0}.opp-name{font-size:11px;font-weight:700}.opp-sub{font-size:9px;color:var(--muted);margin-top:3px}.score{font-weight:850;font-size:14px;text-align:right}.band{font-size:8px;text-transform:uppercase;letter-spacing:.05em;text-align:center;border-radius:999px;padding:4px 6px;border:1px solid #2a4439}.band.p1{color:var(--accent);background:rgba(101,245,187,.07)}.band.high{color:#a8c9ff;background:rgba(121,168,255,.07)}.progress-list{display:grid;gap:10px}.progress-item{display:grid;grid-template-columns:110px 1fr 37px;gap:9px;align-items:center;font-size:9px;color:var(--muted)}.bar{height:5px;border-radius:999px;background:#182720;overflow:hidden}.bar span{display:block;height:100%;background:linear-gradient(90deg,#34cb91,var(--accent));border-radius:inherit}.alert{margin-top:14px;border:1px solid #3a3221;background:#1e1a10;border-radius:10px;padding:12px;font-size:10px;color:#d7c596;line-height:1.45}.small-title{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:7px}
    .discovery{grid-template-columns:1.05fr .95fr}.textarea{width:100%;min-height:200px;background:#09120f;border:1px solid #263a32;border-radius:12px;color:#dcebe5;padding:14px;resize:vertical;outline:none;line-height:1.5;font-size:12px}.textarea:focus,.field:focus{border-color:#447e68;box-shadow:0 0 0 3px rgba(101,245,187,.06)}.analysis-result{min-height:247px}.result-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.result-box{padding:11px;border:1px solid #20332b;border-radius:10px;background:#0b1512}.result-box strong{font-size:10px}.tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}.tag{font-size:8px;padding:4px 6px;border:1px solid #2a4238;border-radius:999px;color:#aac0b7}.known{color:#83b7ff}.estimated{color:#f2c476}.demo-label{font-size:8px;color:#70877d}.spinner{width:18px;height:18px;border:2px solid #2b443a;border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;margin:80px auto 10px}@keyframes spin{to{transform:rotate(360deg)}}
    .tablewrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:880px}.table th{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#748a81;text-align:left;padding:10px 10px;border-bottom:1px solid var(--line);font-weight:700}.table td{padding:11px 10px;border-bottom:1px solid #192821;font-size:10px;color:#b8cac2}.table tr:hover td{background:#0f1b17}.table .pname{font-weight:750;color:#edf6f2}.metric{font-variant-numeric:tabular-nums}.painbar{display:flex;gap:2px}.painbar i{width:12px;height:4px;border-radius:2px;background:#263a32}.painbar i.on{background:#e1a954}.linkbtn{background:0;border:0;color:var(--accent);font-size:9px;padding:0}.toolbar{display:flex;justify-content:space-between;gap:10px;margin-bottom:12px}.search{min-width:240px;background:#0a1411;border:1px solid var(--line);color:#d9e8e2;border-radius:8px;padding:8px 10px;font-size:10px;outline:none}
    .opportunity-layout{grid-template-columns:1.2fr .8fr}.matrix{height:460px;position:relative;padding:18px 22px 36px 42px}.plot{position:relative;height:100%;border-left:1px solid #3a4c45;border-bottom:1px solid #3a4c45;background:linear-gradient(90deg,transparent 49.8%,#1a2a24 50%,transparent 50.2%),linear-gradient(0deg,transparent 49.8%,#1a2a24 50%,transparent 50.2%)}.quad{position:absolute;font-size:8px;color:#52685f;text-transform:uppercase;letter-spacing:.09em}.q1{top:8px;right:10px;color:#6ea88f}.q2{top:8px;left:10px}.q3{bottom:8px;right:10px}.q4{bottom:8px;left:10px}.bubble{position:absolute;transform:translate(-50%,50%);border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.24);font-size:8px;font-weight:850;color:#08100e;background:#7ddfba;box-shadow:0 5px 25px rgba(0,0,0,.28);transition:.2s;cursor:pointer}.bubble:hover{z-index:5;transform:translate(-50%,50%) scale(1.14);box-shadow:0 0 0 5px rgba(101,245,187,.08)}.bubble.risk-med{background:#c8d882}.bubble.risk-high{background:#df9a82}.axis-x,.axis-y{position:absolute;color:#6e857b;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.axis-x{bottom:9px;left:46%;}.axis-y{left:10px;top:46%;transform:rotate(-90deg)}.selected-detail{padding:18px}.selected-detail h3{font-size:17px;margin:0 0 4px}.bigscore{font-size:43px;font-weight:900;letter-spacing:-.06em;color:var(--accent)}.scoreline{display:flex;align-items:flex-end;gap:12px;padding:6px 0 15px}.scoreline .meta{font-size:9px;color:var(--muted);padding-bottom:6px}.tri{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.mini{border:1px solid #22372f;border-radius:9px;padding:10px}.mini span{display:block;font-size:8px;color:var(--muted);margin-bottom:5px}.mini strong{font-size:13px}.why{margin-top:15px}.why h4{font-size:9px;text-transform:uppercase;color:#718980;letter-spacing:.08em;margin:12px 0 6px}.why p{font-size:10px;color:#b9cac3;margin:0;line-height:1.5}
    .designer-grid{grid-template-columns:1fr 1fr}.flow{padding:18px;min-height:380px}.flowhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.flowhead h2{margin:0;font-size:13px}.state{font-size:8px;border:1px solid #2b4038;border-radius:999px;padding:4px 7px;color:#8ea69c}.nodes{display:grid;gap:8px}.node{border:1px solid #23372f;background:#0b1512;border-radius:10px;padding:10px 11px;display:grid;grid-template-columns:25px 1fr auto;align-items:center;gap:9px;position:relative}.node:not(:last-child):after{content:'↓';position:absolute;left:18px;bottom:-13px;color:#4d6a5e;z-index:2}.node .ntype{width:25px;height:25px;border-radius:7px;display:grid;place-items:center;background:#182821;font-size:9px}.node strong{font-size:10px;display:block}.node small{font-size:8px;color:var(--muted)}.node .time{font-size:8px;color:#80978d}.node.ai{border-color:#315b4b}.node.human{border-color:#55492d}.node.system{border-color:#2a3e58}.architecture{margin-top:14px;grid-template-columns:1fr 1fr}.component{padding:13px}.component .ctype{font-size:8px;color:var(--accent);text-transform:uppercase;letter-spacing:.08em}.component h4{font-size:11px;margin:5px 0}.component p{font-size:9px;color:var(--muted);line-height:1.45;margin:0}.controls{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}.control{font-size:7px;padding:3px 5px;background:#14231d;border-radius:4px;color:#a9beb5}.rec{border:1px solid #2d604d;background:linear-gradient(135deg,#10231c,#0e1916);padding:15px 16px;border-radius:12px;margin-bottom:14px}.rec .rlabel{font-size:8px;color:var(--accent);text-transform:uppercase;letter-spacing:.1em}.rec h3{font-size:16px;margin:5px 0}.rec p{font-size:10px;color:#a7bbb3;margin:0;line-height:1.55}
    .kanban{display:grid;grid-template-columns:repeat(5,minmax(200px,1fr));gap:10px;overflow:auto;padding-bottom:5px}.stage{min-width:200px;background:#0b1512;border:1px solid var(--line);border-radius:12px;padding:10px}.stagehead{display:flex;justify-content:space-between;align-items:center;padding:3px 2px 10px}.stagehead strong{font-size:10px}.count{font-size:8px;color:var(--muted)}.task{background:#111e19;border:1px solid #20342b;border-radius:8px;padding:10px;margin-bottom:7px}.task .tasktop{display:flex;gap:6px;justify-content:space-between}.task strong{font-size:9px;line-height:1.35}.task p{font-size:8px;color:#768d83;margin:7px 0}.status-select{background:#0b1512;color:#9eb5ab;border:1px solid #263b32;border-radius:6px;padding:4px 5px;font-size:7px;width:100%}.riskdot{width:6px;height:6px;border-radius:50%;background:#6ec69d;flex:none;margin-top:3px}.riskdot.medium{background:#e3bd6a}.riskdot.high{background:#e67d76}
    .impact-grid{grid-template-columns:.85fr 1.15fr}.impact-kpis{grid-template-columns:repeat(2,1fr)}.impact-stat{padding:16px}.impact-stat .k{font-size:8px;color:#7e958b;text-transform:uppercase;letter-spacing:.08em}.impact-stat .v{font-size:23px;font-weight:850;margin:7px 0 2px}.impact-stat .s{font-size:8px;color:#6f877c}.assumptions{padding:18px}.assumption{display:grid;grid-template-columns:1fr 120px 68px;gap:8px;align-items:center;padding:9px 0;border-bottom:1px solid #1b2b25;font-size:9px}.field{width:100%;background:#09120f;border:1px solid #263a32;border-radius:7px;color:#e2eee9;padding:7px 8px;outline:none;text-align:right}.evidence{font-size:7px;text-align:center;border-radius:999px;padding:4px}.ev-demo{background:#172820;color:#83a899}.ev-calc{background:#162033;color:#91b8f4}.formula{font-size:9px;color:#86a096;line-height:1.6;padding:12px;background:#09120f;border:1px solid #1e3029;border-radius:9px;margin-top:12px}.footer-note{font-size:8px;color:#6f867c;margin-top:11px}.projected{display:inline-block;font-size:7px;text-transform:uppercase;letter-spacing:.08em;color:#e5c372;background:#2a2414;border-radius:4px;padding:3px 5px;margin-left:5px;vertical-align:middle}
    .drawer{position:fixed;inset:0;z-index:50;display:none}.drawer.open{display:block}.shade{position:absolute;inset:0;background:rgba(0,0,0,.58)}.drawerpanel{position:absolute;right:0;top:0;height:100%;width:min(540px,94vw);background:#0b1512;border-left:1px solid var(--line);box-shadow:-30px 0 80px rgba(0,0,0,.35);padding:24px;overflow:auto}.close{position:absolute;right:18px;top:17px;background:transparent;border:1px solid var(--line);color:#9fb2aa;border-radius:7px;width:30px;height:30px}.drawer h2{font-size:21px;margin:20px 0 4px}.drawer p{font-size:10px;color:var(--muted);line-height:1.5}.detailmetrics{grid-template-columns:repeat(3,1fr);margin:16px 0}.detailmetric{padding:11px;border:1px solid #20322b;border-radius:9px}.detailmetric span{display:block;font-size:7px;color:#738a80}.detailmetric strong{font-size:13px;display:block;margin-top:4px}.steps{counter-reset:step}.step{counter-increment:step;display:grid;grid-template-columns:24px 1fr;gap:8px;padding:8px 0;border-bottom:1px solid #182720;font-size:9px}.step:before{content:counter(step);width:21px;height:21px;border-radius:6px;background:#15251f;display:grid;place-items:center;color:#89a99b;font-size:8px}
    @media(max-width:1050px){.app{grid-template-columns:76px 1fr}.sidebar{padding:18px 10px}.brand strong,.brand small,.company,.nav button span:not(.icon),.sidefoot{display:none}.brand{justify-content:center;padding-left:0;padding-right:0}.nav button{justify-content:center}.stats{grid-template-columns:repeat(3,1fr)}.overview-grid,.opportunity-layout,.designer-grid,.impact-grid{grid-template-columns:1fr}}
    @media(max-width:680px){.app{display:block}.sidebar{position:fixed;bottom:0;top:auto;height:62px;width:100%;border-right:0;border-top:1px solid var(--line);padding:6px 7px;flex-direction:row;z-index:40}.brand,.company,.sidefoot{display:none}.nav{display:flex;width:100%;overflow-x:auto;gap:3px}.nav button{min-width:50px;flex:1;padding:8px 7px}.nav button .icon{font-size:13px}.topbar{padding:0 16px;height:55px}.topmeta .chip:nth-child(1){display:none}.content{padding:20px 14px 82px}.pagehead{align-items:flex-start;flex-direction:column}.stats{grid-template-columns:repeat(2,1fr)}.stat .value{font-size:21px}.result-grid,.impact-kpis,.architecture{grid-template-columns:1fr}.matrix{height:370px;padding-left:35px}.tri{grid-template-columns:1fr}.assumption{grid-template-columns:1fr 100px 58px}.search{min-width:0;width:100%}.toolbar{flex-direction:column}.topmeta{gap:5px}.chip{padding:5px 7px}.crumb{font-size:9px}}
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="mark">I</div><div><strong>INNOVA</strong><small>Workflow OS</small></div></div>
    <div class="company"><div class="eyebrow">Company</div><div class="name"><span>Northstar Professional Services</span><span class="demo">DEMO</span></div></div>
    <nav class="nav" id="nav">
      <button data-view="overview" class="active"><span class="icon">⌂</span><span>Overview</span></button>
      <button data-view="discovery"><span class="icon">◇</span><span>Discovery</span></button>
      <button data-view="processes"><span class="icon">≡</span><span>Processes</span></button>
      <button data-view="opportunities"><span class="icon">◎</span><span>Opportunities</span></button>
      <button data-view="designs"><span class="icon">⌘</span><span>Designs</span></button>
      <button data-view="implementation"><span class="icon">▦</span><span>Implementation</span></button>
      <button data-view="impact"><span class="icon">↗</span><span>Impact</span></button>
    </nav>
    <div class="sidefoot"><span class="dot"></span>Demo mode online<br/>Deterministic fallback enabled</div>
  </aside>
  <main class="main">
    <header class="topbar"><div class="crumb">INNOVA / <strong id="crumb">Overview</strong></div><div class="topmeta"><span class="chip">Evidence-aware</span><span class="chip"><span class="dot"></span>Demo mode</span></div></header>
    <div class="content">
      <section class="view active" id="overview">
        <div class="pagehead"><div><h1>AI Transformation Overview</h1><p>See where this company is in its transformation lifecycle and where measurable automation value is concentrated.</p></div><button class="primary goto" data-target="processes">View Process Map →</button></div>
        <div class="grid stats">
          <div class="card stat"><div class="label">Processes mapped</div><div class="value">15</div><div class="sub">Across 5 departments</div></div>
          <div class="card stat"><div class="label">High-value opportunities</div><div class="value accent">5</div><div class="sub">Priority score ≥ 65</div></div>
          <div class="card stat"><div class="label">Priority 1</div><div class="value accent">2</div><div class="sub">Ready for near-term design</div></div>
          <div class="card stat"><div class="label">In implementation</div><div class="value blue">1</div><div class="sub">Client Onboarding pilot</div></div>
          <div class="card stat"><div class="label">Projected annual value</div><div class="value">$71k</div><div class="sub">Illustrative demo data</div></div>
        </div>
        <div class="grid overview-grid"><div class="card section"><h2>Top automation opportunities</h2><div id="topOpps"></div></div><div class="card section"><h2>Transformation progress</h2><div class="progress-list"><div class="progress-item"><span>Discovery</span><div class="bar"><span style="width:100%"></span></div><b>100%</b></div><div class="progress-item"><span>Process Map</span><div class="bar"><span style="width:100%"></span></div><b>100%</b></div><div class="progress-item"><span>Opportunity Map</span><div class="bar"><span style="width:100%"></span></div><b>100%</b></div><div class="progress-item"><span>Design</span><div class="bar"><span style="width:60%"></span></div><b>60%</b></div><div class="progress-item"><span>Implementation</span><div class="bar"><span style="width:25%"></span></div><b>25%</b></div><div class="progress-item"><span>Measurement</span><div class="bar"><span style="width:0%"></span></div><b>0%</b></div></div><div class="alert"><div class="small-title">Data gap</div>Loaded labour cost and actual KYC rework rate are not yet confirmed. These assumptions reduce confidence in projected ROI.</div></div></div>
      </section>
      <section class="view" id="discovery"><div class="pagehead"><div><h1>Discovery</h1><p>Turn an unstructured business description into an editable operating model. AI suggestions remain evidence-labelled and reviewable.</p></div></div><div class="grid discovery"><div class="card section"><h2>Describe the company</h2><textarea class="textarea" id="companyText">We are a 30-person accounting and legal services company. Leads arrive from referrals, partners and the website. Our team uses Microsoft 365, a CRM, accounting software and SharePoint. Client onboarding and document collection are email-heavy, KYC requires compliance review, and management reporting is still assembled manually.</textarea><div style="display:flex;gap:8px;margin-top:12px"><button class="primary" id="analyzeCompany">Analyze Company</button><button class="ghost" id="resetDiscovery">Reset demo</button></div><div class="footer-note">Demo mode uses a deterministic fallback if a live model is unavailable.</div></div><div class="card section analysis-result" id="discoveryResult"><div class="small-title">Operating model</div><h2 style="margin-top:0">Ready to analyze</h2><p style="font-size:10px;color:var(--muted);line-height:1.6">The system will infer departments, current systems, likely processes, pain points and missing information. All suggestions can be edited before scoring.</p></div></div></section>
      <section class="view" id="processes"><div class="pagehead"><div><h1>Process Map</h1><p>15 mapped workflows with operational metrics, evidence state and automation context.</p></div><button class="primary" id="analyzeOpps">Analyze Automation Opportunities →</button></div><div class="card section"><div class="toolbar"><input class="search" id="processSearch" placeholder="Search processes or departments…"/><span class="chip">15 workflows · 5 departments</span></div><div class="tablewrap"><table class="table"><thead><tr><th>Process</th><th>Department</th><th>Volume/mo</th><th>Hours/mo</th><th>Pain</th><th>Systems</th><th>Opportunity</th><th></th></tr></thead><tbody id="processTable"></tbody></table></div></div></section>
      <section class="view" id="opportunities"><div class="pagehead"><div><h1>Opportunity Map</h1><p>Deterministic prioritization based on Business Value, Feasibility, Strategic Fit and Risk Penalty.</p></div></div><div class="grid opportunity-layout"><div class="card matrix"><div class="plot" id="plot"><span class="quad q1">Do first</span><span class="quad q2">Strategic projects</span><span class="quad q3">Quick wins</span><span class="quad q4">Avoid / later</span></div><span class="axis-x">Implementation feasibility →</span><span class="axis-y">Business value →</span></div><div class="card selected-detail" id="selectedOpportunity"></div></div><div class="card section" style="margin-top:14px"><h2>Ranked opportunities</h2><div class="tablewrap"><table class="table"><thead><tr><th>Process</th><th>Priority</th><th>Value</th><th>Feasibility</th><th>Risk</th><th>Est. hours saved</th><th></th></tr></thead><tbody id="opportunityTable"></tbody></table></div></div></section>
      <section class="view" id="designs"><div class="pagehead"><div><h1>Automation Designer</h1><p>Design the right combination of deterministic software, AI and human control — not “an agent for everything”.</p></div><button class="primary goto" data-target="implementation">Generate Implementation Plan →</button></div><div class="rec"><div class="rlabel">Recommended pattern</div><h3>Hybrid AI-assisted workflow</h3><p>Automate document requests, intake, completeness checks and record creation. Keep the regulated KYC approval human-controlled before downstream actions.</p></div><div class="grid designer-grid"><div class="card flow"><div class="flowhead"><h2>Current State</h2><span class="state">100 staff hours / month</span></div><div class="nodes" id="currentFlow"></div></div><div class="card flow"><div class="flowhead"><h2>Proposed State</h2><span class="state accent">40 staff hours / month projected</span></div><div class="nodes" id="futureFlow"></div></div></div><div class="grid architecture" id="architectureCards"></div></section>
      <section class="view" id="implementation"><div class="pagehead"><div><h1>Implementation Workspace</h1><p>Translate the proposed architecture into a concrete delivery plan with dependencies, owners, risks and acceptance criteria.</p></div><button class="primary goto" data-target="impact">View Business Case →</button></div><div class="kanban" id="kanban"></div></section>
      <section class="view" id="impact"><div class="pagehead"><div><h1>Impact & ROI</h1><p>Baseline vs target economics for Client Onboarding. All pre-deployment outputs are explicitly projected.</p></div></div><div class="grid impact-grid"><div class="grid impact-kpis"><div class="card impact-stat"><div class="k">Hours saved / month</div><div class="v accent" id="hoursSaved">60</div><div class="s">Projected reduction</div></div><div class="card impact-stat"><div class="k">Annual labour value</div><div class="v" id="annualValue">$43,200</div><div class="s">Projected</div></div><div class="card impact-stat"><div class="k">Year-one ROI</div><div class="v" id="roi">137%</div><div class="s">Projected</div></div><div class="card impact-stat"><div class="k">Payback period</div><div class="v" id="payback">4.4 mo</div><div class="s">Projected</div></div><div class="card impact-stat"><div class="k">Implementation</div><div class="v" id="implementationCostDisplay">$14,000</div><div class="s">Estimated</div></div><div class="card impact-stat"><div class="k">Operating cost</div><div class="v" id="operatingCostDisplay">$350/mo</div><div class="s">Estimated</div></div></div><div class="card assumptions"><h2 style="font-size:13px;margin:0 0 9px">Business case assumptions <span class="projected">Illustrative demo data</span></h2><div class="assumption"><span>Monthly transaction volume</span><input class="field roi-input" id="volume" type="number" value="100" min="1"/><span class="evidence ev-demo">DEMO</span></div><div class="assumption"><span>Baseline minutes / case</span><input class="field roi-input" id="baselineMins" type="number" value="60" min="0"/><span class="evidence ev-demo">DEMO</span></div><div class="assumption"><span>Future minutes / case</span><input class="field roi-input" id="futureMins" type="number" value="24" min="0"/><span class="evidence ev-demo">DEMO</span></div><div class="assumption"><span>Loaded hourly cost (USD)</span><input class="field roi-input" id="hourlyCost" type="number" value="60" min="0"/><span class="evidence ev-demo">EST.</span></div><div class="assumption"><span>Implementation cost (USD)</span><input class="field roi-input" id="implementationCost" type="number" value="14000" min="0"/><span class="evidence ev-demo">EST.</span></div><div class="assumption"><span>Monthly operating cost (USD)</span><input class="field roi-input" id="operatingCost" type="number" value="350" min="0"/><span class="evidence ev-demo">EST.</span></div><div class="formula">Monthly labour benefit = (Baseline minutes − Future minutes) × volume ÷ 60 × loaded hourly cost.<br/>Year 1 ROI = (Annual benefit − implementation − annual operating cost) ÷ (implementation + annual operating cost).</div><div class="footer-note">Projected values are not realized savings. Replace demo assumptions with confirmed evidence after discovery and pilot measurement.</div></div></div><div class="card section" style="margin-top:14px"><div class="small-title">Outcome</div><h2 style="font-size:18px;margin:0 0 7px">One process identified, designed and quantified. Now repeat across the business.</h2><p style="font-size:10px;color:var(--muted);margin:0">Operations → technology → implementation → economics.</p></div></section>
    </div>
  </main>
</div>
<div class="drawer" id="drawer"><div class="shade" id="drawerShade"></div><div class="drawerpanel"><button class="close" id="drawerClose">×</button><div id="drawerContent"></div></div></div>
<script>
const processes=[
{id:'client-onboarding',name:'Client Onboarding',dept:'Operations',volume:100,hours:100,pain:5,systems:5,value:94,feas:91,strat:89,risk:4,saved:60,confidence:'Medium',sensitivity:'Restricted',description:'From signed engagement through document intake, KYC, record creation and team assignment.',positives:'High recurring staff effort, predictable inputs and outputs, strong system readiness.',constraint:'KYC approval carries compliance consequences and remains human-controlled.',missing:'Loaded labour cost and actual monthly case volume need confirmation.'},
{id:'document-collection',name:'Document Collection',dept:'Operations',volume:180,hours:76,pain:5,systems:3,value:90,feas:88,strat:84,risk:4,saved:49,confidence:'High',sensitivity:'Confidential',description:'Request, receive, chase and validate client documents.',positives:'High volume, repetitive follow-ups and clear completeness rules.',constraint:'Some documents require contextual review.',missing:'Exact follow-up frequency by client segment.'},
{id:'meeting-notes',name:'Meeting Notes & Action Items',dept:'Operations',volume:120,hours:42,pain:3,systems:2,value:72,feas:96,strat:84,risk:4,saved:31,confidence:'High',sensitivity:'Internal',description:'Capture meeting notes, decisions and follow-up actions.',positives:'Very standardized and technically easy to assist with AI.',constraint:'Lower direct economic value than core operational workflows.',missing:'No material gaps.'},
{id:'management-reporting',name:'Management Reporting',dept:'Finance',volume:12,hours:64,pain:4,systems:6,value:88,feas:70,strat:83,risk:10,saved:38,confidence:'Medium',sensitivity:'Confidential',description:'Combine operational and financial data into management reports.',positives:'Material management time and strategic impact.',constraint:'Data quality and cross-system dependencies reduce feasibility.',missing:'Authoritative source-of-truth mapping.'},
{id:'contract-review-intake',name:'Contract Review Intake',dept:'Legal',volume:55,hours:48,pain:4,systems:3,value:76,feas:68,strat:75,risk:7,saved:24,confidence:'Medium',sensitivity:'Restricted',description:'Receive, classify and route contracts for legal review.',positives:'Structured intake and triage can be automated.',constraint:'Legal judgment and sensitive outputs require human review.',missing:'Contract mix and escalation criteria.'},
{id:'lead-qualification',name:'Lead Qualification',dept:'Sales',volume:160,hours:44,pain:3,systems:3,value:73,feas:86,strat:78,risk:4,saved:28,confidence:'Medium',sensitivity:'Internal',description:'Qualify inbound opportunities and route to the right specialist.'},
{id:'proposal-prep',name:'Proposal Preparation',dept:'Sales',volume:45,hours:50,pain:4,systems:4,value:78,feas:79,strat:80,risk:5,saved:27,confidence:'Medium',sensitivity:'Internal',description:'Prepare scoped client proposals from discovery information.'},
{id:'engagement-letter',name:'Engagement Letter Preparation',dept:'Legal',volume:60,hours:32,pain:3,systems:3,value:67,feas:84,strat:74,risk:7,saved:19,confidence:'High',sensitivity:'Confidential',description:'Generate standardized engagement documents for review and signature.'},
{id:'kyc-intake',name:'KYC / Compliance Intake',dept:'Compliance',volume:80,hours:72,pain:5,systems:4,value:86,feas:62,strat:82,risk:16,saved:29,confidence:'Medium',sensitivity:'Restricted',description:'Collect identity evidence, screen and prepare compliance review.'},
{id:'invoice-prep',name:'Invoice Preparation',dept:'Finance',volume:110,hours:36,pain:3,systems:2,value:64,feas:93,strat:72,risk:3,saved:25,confidence:'High',sensitivity:'Internal',description:'Prepare invoices from approved billing data.'},
{id:'ar-followup',name:'Accounts Receivable Follow-Up',dept:'Finance',volume:95,hours:30,pain:4,systems:3,value:66,feas:88,strat:76,risk:5,saved:20,confidence:'High',sensitivity:'Confidential',description:'Track overdue balances and send staged follow-ups.'},
{id:'expense-processing',name:'Expense Processing',dept:'Finance',volume:210,hours:35,pain:3,systems:2,value:59,feas:89,strat:68,risk:4,saved:23,confidence:'High',sensitivity:'Internal',description:'Capture, validate and code employee expenses.'},
{id:'client-status',name:'Client Status Reporting',dept:'Operations',volume:80,hours:45,pain:3,systems:5,value:70,feas:72,strat:75,risk:8,saved:22,confidence:'Low',sensitivity:'Confidential',description:'Assemble client-facing status updates from project systems.'},
{id:'knowledge-search',name:'Internal Knowledge Search',dept:'Operations',volume:300,hours:55,pain:4,systems:4,value:71,feas:76,strat:84,risk:7,saved:29,confidence:'Low',sensitivity:'Confidential',description:'Find prior work, templates and internal answers across repositories.'},
{id:'employee-onboarding',name:'Employee Onboarding',dept:'HR',volume:5,hours:18,pain:2,systems:4,value:43,feas:84,strat:62,risk:5,saved:9,confidence:'High',sensitivity:'Confidential',description:'Create accounts, collect forms and coordinate new-hire setup.'}
];
const score=p=>Math.max(0,Math.min(100,Math.round(p.value*.5+p.feas*.3+p.strat*.2-p.risk)));const band=s=>s>=80?'Priority 1':s>=65?'High Opportunity':s>=50?'Medium':'Low / Later';const sorted=[...processes].sort((a,b)=>score(b)-score(a));let selected=processes[0];const $=q=>document.querySelector(q);const $$=q=>[...document.querySelectorAll(q)];
function nav(view){$$('.view').forEach(v=>v.classList.toggle('active',v.id===view));$$('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===view));$('#crumb').textContent=({overview:'Overview',discovery:'Discovery',processes:'Process Map',opportunities:'Opportunity Map',designs:'Automation Designer',implementation:'Implementation',impact:'Impact & ROI'})[view];history.replaceState(null,'','#'+view);window.scrollTo({top:0,behavior:'smooth'})}$$('#nav button').forEach(b=>b.addEventListener('click',()=>nav(b.dataset.view)));$$('.goto').forEach(b=>b.addEventListener('click',()=>nav(b.dataset.target)));
function renderTop(){$('#topOpps').innerHTML=sorted.slice(0,5).map(p=>`<div class="opp-row"><div><div class="opp-name">${p.name}</div><div class="opp-sub">${p.dept} · ${p.hours} human hrs/mo</div></div><div class="score">${score(p)}</div><div class="band ${score(p)>=80?'p1':'high'}">${band(score(p))}</div></div>`).join('')}
function pain(n){return `<span class="painbar">${[1,2,3,4,5].map(i=>`<i class="${i<=n?'on':''}"></i>`).join('')}</span>`}
function renderProcesses(filter=''){const f=filter.toLowerCase();$('#processTable').innerHTML=processes.filter(p=>(p.name+' '+p.dept).toLowerCase().includes(f)).map(p=>`<tr><td><span class="pname">${p.name}</span><div class="demo-label">${p.description||''}</div></td><td>${p.dept}</td><td class="metric">${p.volume}</td><td class="metric">${p.hours}</td><td>${pain(p.pain)}</td><td>${p.systems}</td><td><b class="${score(p)>=80?'accent':score(p)>=65?'blue':''}">${score(p)}</b> · ${band(score(p))}</td><td><button class="linkbtn process-open" data-id="${p.id}">Inspect →</button></td></tr>`).join('');$$('.process-open').forEach(b=>b.onclick=()=>openProcess(b.dataset.id))}$('#processSearch').addEventListener('input',e=>renderProcesses(e.target.value));
function openProcess(id){const p=processes.find(x=>x.id===id);const steps=p.id==='client-onboarding'?['Collect client details','Request documents','Check completeness','Perform KYC','Create CRM record','Create document folder','Create accounting / project record','Send onboarding instructions','Assign internal staff','Follow up on missing documents']:['Receive trigger / input','Validate required information','Perform core processing','Update systems','Review exceptions','Produce output / follow-up'];$('#drawerContent').innerHTML=`<div class="small-title">Process · ${p.dept}</div><h2>${p.name}</h2><p>${p.description}</p><div class="grid detailmetrics"><div class="detailmetric"><span>Monthly volume</span><strong>${p.volume}</strong></div><div class="detailmetric"><span>Human hours</span><strong>${p.hours}</strong></div><div class="detailmetric"><span>Priority</span><strong class="accent">${score(p)}</strong></div></div><div class="small-title">Process steps</div><div class="steps">${steps.map(s=>`<div class="step">${s}</div>`).join('')}</div><div style="display:flex;gap:8px;margin-top:18px"><button class="primary" id="drawerDesign">Design Automation</button><button class="secondary" id="drawerOpp">View Opportunity</button></div>`;$('#drawer').classList.add('open');$('#drawerDesign').onclick=()=>{selected=p;$('#drawer').classList.remove('open');nav('designs')};$('#drawerOpp').onclick=()=>{selected=p;renderOpportunityDetail();$('#drawer').classList.remove('open');nav('opportunities')}}$('#drawerClose').onclick=$('#drawerShade').onclick=()=>$('#drawer').classList.remove('open');
function riskClass(p){return p.risk>=12?'risk-high':p.risk>=7?'risk-med':''}function renderMatrix(){const plot=$('#plot');plot.querySelectorAll('.bubble').forEach(x=>x.remove());processes.forEach(p=>{const b=document.createElement('button');const size=Math.max(26,Math.min(52,24+p.hours/3));b.className='bubble '+riskClass(p);b.style.left=p.feas+'%';b.style.bottom=p.value+'%';b.style.width=size+'px';b.style.height=size+'px';b.title=`${p.name}: ${score(p)}`;b.textContent=score(p);b.onclick=()=>{selected=p;renderOpportunityDetail()};plot.appendChild(b)})}
function renderOpportunityDetail(){const p=selected;$('#selectedOpportunity').innerHTML=`<div class="small-title">Selected opportunity</div><h3>${p.name}</h3><div class="scoreline"><div class="bigscore">${score(p)}</div><div class="meta">${band(score(p))}<br/>Confidence: ${p.confidence}</div></div><div class="tri"><div class="mini"><span>Business Value</span><strong>${p.value}</strong></div><div class="mini"><span>Feasibility</span><strong>${p.feas}</strong></div><div class="mini"><span>Risk penalty</span><strong>${p.risk}</strong></div></div><div class="why"><h4>Why this scored highly</h4><p>${p.positives||'Recurring workload and measurable operational value.'}</p><h4>What limits the score</h4><p>${p.constraint||'Dependencies and exception handling require validation.'}</p><h4>What would improve confidence</h4><p>${p.missing||'Confirm operating metrics with process owners.'}</p></div><button class="primary" id="designSelected" style="margin-top:16px">Design Automation →</button>`;$('#designSelected').onclick=()=>nav('designs')}
function renderOppTable(){$('#opportunityTable').innerHTML=sorted.map(p=>`<tr><td><span class="pname">${p.name}</span></td><td><b class="${score(p)>=80?'accent':score(p)>=65?'blue':''}">${score(p)}</b> · ${band(score(p))}</td><td>${p.value}</td><td>${p.feas}</td><td>−${p.risk}</td><td>${p.saved} h/mo</td><td><button class="linkbtn opp-select" data-id="${p.id}">Select →</button></td></tr>`).join('');$$('.opp-select').forEach(b=>b.onclick=()=>{selected=processes.find(p=>p.id===b.dataset.id);renderOpportunityDetail();window.scrollTo({top:0,behavior:'smooth'})})}
$('#analyzeOpps').onclick=()=>{const btn=$('#analyzeOpps');btn.textContent='Scoring 15 processes…';btn.disabled=true;setTimeout(()=>{btn.textContent='Analyze Automation Opportunities →';btn.disabled=false;selected=processes[0];renderOpportunityDetail();nav('opportunities')},620)};
const currentFlow=[['human','1','Collect client details','10 min'],['human','2','Request documents','12 min'],['human','3','Check completeness','15 min'],['human','4','KYC / compliance review','12 min'],['system','5','Create CRM + folders','7 min'],['human','6','Assign team + welcome','4 min']];const futureFlow=[['system','↯','Automation trigger','Instant'],['ai','AI','Document request + follow-up','Automated'],['ai','AI','Completeness check','Assisted'],['human','✓','Compliance approval','Human gate'],['system','↔','Create CRM / folders / records','Automated'],['system','→','Welcome + assign team','Automated']];function renderFlow(id,arr){$(id).innerHTML=arr.map(n=>`<div class="node ${n[0]}"><div class="ntype">${n[1]}</div><div><strong>${n[2]}</strong><small>${n[0]==='ai'?'AI component':n[0]==='human'?'Human-controlled':'Deterministic automation'}</small></div><div class="time">${n[3]}</div></div>`).join('')}
const components=[['AI','Document Intake Assistant','Classifies incoming files, checks completeness and drafts follow-up requests.','Read client uploads','No compliance approval'],['Automation','Record Provisioning','Creates CRM, folder and project records after approval.','Write approved systems','Idempotent retry'],['Human gate','Compliance Review','Authorized reviewer makes the regulated KYC decision.','Restricted KYC data','Approval required'],['Control','Audit & Fallback','Records evidence, confidence, approvals and failure handling.','Event metadata','Stop on uncertainty']];function renderArchitecture(){$('#architectureCards').innerHTML=components.map(c=>`<div class="card component"><div class="ctype">${c[0]}</div><h4>${c[1]}</h4><p>${c[2]}</p><div class="controls"><span class="control">${c[3]}</span><span class="control">${c[4]}</span></div></div>`).join('')}
const plan={Validate:[['Confirm baseline metrics','Operations Lead','medium'],['Confirm system access','IT Lead','low'],['Map compliance decision boundary','Compliance','high']],Prototype:[['Build intake trigger','Engineer','low'],['Configure document request flow','Engineer','medium'],['Implement completeness schema','AI Engineer','medium']],Pilot:[['Run 20 sample cases','Ops + Compliance','medium'],['Measure failure / exception rate','Analyst','medium'],['Validate human approval UX','Compliance','high']],Production:[['Harden credentials and permissions','IT / Security','high'],['Enable production integrations','Engineer','medium'],['Train operations users','Operations Lead','low']],Optimize:[['Compare actual vs baseline','Analyst','low'],['Tune exception routing','AI Engineer','medium'],['Expand to document collection','Product Owner','medium']]};function renderKanban(){$('#kanban').innerHTML=Object.entries(plan).map(([stage,tasks])=>`<div class="stage"><div class="stagehead"><strong>${stage}</strong><span class="count">${tasks.length} tasks</span></div>${tasks.map((t,i)=>`<div class="task"><div class="tasktop"><strong>${t[0]}</strong><span class="riskdot ${t[2]}"></span></div><p>Owner: ${t[1]}</p><select class="status-select task-status" data-key="${stage}-${i}"><option>Not Started</option><option>Ready</option><option>In Progress</option><option>Blocked</option><option>Review</option><option>Done</option></select></div>`).join('')}</div>`).join('');$$('.task-status').forEach(s=>{const saved=localStorage.getItem('workflow-'+s.dataset.key);if(saved)s.value=saved;s.onchange=()=>localStorage.setItem('workflow-'+s.dataset.key,s.value)})}
function analyzeDiscovery(){const box=$('#discoveryResult');const txt=$('#companyText').value.trim();if(!txt)return;box.innerHTML='<div class="spinner"></div><div style="text-align:center;font-size:9px;color:var(--muted)">Structuring operating model…</div>';setTimeout(()=>{box.innerHTML=`<div class="small-title">Operating model · deterministic fallback</div><h2 style="margin-top:0">30 people · 5 departments · 9 systems</h2><div class="result-grid"><div class="result-box"><strong>Departments</strong><div class="tags"><span class="tag">Sales</span><span class="tag">Operations</span><span class="tag">Finance</span><span class="tag">Legal</span><span class="tag">Compliance</span></div></div><div class="result-box"><strong>Systems</strong><div class="tags"><span class="tag">Microsoft 365</span><span class="tag">CRM</span><span class="tag">SharePoint</span><span class="tag">Accounting</span></div></div><div class="result-box"><strong>Likely processes</strong><div class="tags"><span class="tag">Client onboarding</span><span class="tag">Document collection</span><span class="tag">KYC intake</span><span class="tag">Management reporting</span></div></div><div class="result-box"><strong>Missing evidence</strong><div class="tags"><span class="tag estimated">Loaded labour cost</span><span class="tag estimated">Actual volumes</span><span class="tag estimated">Error / rework rate</span></div></div></div><div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px"><span class="demo-label"><span class="known">■ known</span> · <span class="estimated">■ estimated</span></span><button class="primary" id="addSuggested">Add Suggested Processes →</button></div>`;$('#addSuggested').onclick=()=>nav('processes')},650)}$('#analyzeCompany').onclick=analyzeDiscovery;$('#resetDiscovery').onclick=()=>{$('#companyText').value='We are a 30-person accounting and legal services company. Leads arrive from referrals, partners and the website. Our team uses Microsoft 365, a CRM, accounting software and SharePoint. Client onboarding and document collection are email-heavy, KYC requires compliance review, and management reporting is still assembled manually.';$('#discoveryResult').innerHTML='<div class="small-title">Operating model</div><h2 style="margin-top:0">Ready to analyze</h2><p style="font-size:10px;color:var(--muted);line-height:1.6">The system will infer departments, current systems, likely processes, pain points and missing information. All suggestions can be edited before scoring.</p>'};
function money(v){return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(v)}function calcROI(){const volume=+$('#volume').value||0,base=+$('#baselineMins').value||0,future=+$('#futureMins').value||0,cost=+$('#hourlyCost').value||0,impl=+$('#implementationCost').value||0,op=+$('#operatingCost').value||0;const hrs=Math.max(0,(base-future)*volume/60);const monthly=hrs*cost;const annual=monthly*12;const totalCost=impl+op*12;const roi=totalCost?((annual-totalCost)/totalCost*100):0;const monthlyNet=monthly-op;const payback=monthlyNet>0?impl/monthlyNet:0;$('#hoursSaved').textContent=hrs.toFixed(hrs%1?1:0);$('#annualValue').textContent=money(annual);$('#roi').textContent=Math.round(roi)+'%';$('#payback').textContent=payback?payback.toFixed(1)+' mo':'—';$('#implementationCostDisplay').textContent=money(impl);$('#operatingCostDisplay').textContent=money(op)+'/mo'}$$('.roi-input').forEach(i=>i.addEventListener('input',calcROI));renderTop();renderProcesses();renderMatrix();renderOpportunityDetail();renderOppTable();renderFlow('#currentFlow',currentFlow);renderFlow('#futureFlow',futureFlow);renderArchitecture();renderKanban();calcROI();const start=location.hash.slice(1);if(['overview','discovery','processes','opportunities','designs','implementation','impact'].includes(start))nav(start);
</script>
