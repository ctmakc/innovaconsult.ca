---
import BaseLayout from '../layouts/BaseLayout.astro';
import RiseHeading from '../components/RiseHeading.astro';
import { SITE } from '../data/site';

// Product facts are traceable to /data/projects/innova-workflow-os (README.md, docs/SCORING.md,
// src/domain/types.ts, src/domain/patterns.ts; vitest run 2026-10-01: 226 passed) and to the
// memory note innova-workflow-os.md (invite-only deployment, 1 October 2026).

const PAGE = `${SITE.url}/workflow-os`;

const shot = (name: string) => ({
  src: `/proof/workflow-os-${name}-1440-1600.webp`,
  srcset: `/proof/workflow-os-${name}-1440-800.webp 800w, /proof/workflow-os-${name}-1440-1600.webp 1600w`,
  width: 1600,
  height: 1000
});

// Alt and captions: .proof-staging/MANIFEST.json (captured 2026-10-01 from commit 94b14f3).
const SHOTS = {
  map: {
    ...shot('opportunity-map'),
    alt: 'Workflow OS Opportunity Map: 15 processes plotted by business value and implementation feasibility, with Client Onboarding ranked first at 88 and its score broken into value, feasibility, strategic fit and risk.',
    caption: 'Opportunity Map for the demo company Northstar Professional Services (illustrative demo data). Every score shows its parts.'
  },
  overview: {
    ...shot('overview'),
    alt: 'Workflow OS overview for the demo company Northstar Professional Services: 30 people, 5 departments, 9 systems, 15 mapped workflows and the top-ranked automation opportunities.',
    caption: 'Company overview with ranked opportunities (illustrative demo data).'
  },
  designer: {
    ...shot('designer'),
    alt: 'Workflow OS Automation Designer for Client Onboarding: effort per case from 100 to 40 minutes, current and proposed process flows with human, system and AI lanes.',
    caption: 'Automation Designer: current state against proposed state, with the human approval gate kept. Illustrative demo data.'
  },
  impact: {
    ...shot('impact'),
    alt: 'Workflow OS business case for Client Onboarding: projected staff hours, payback and Year-1 ROI with every figure labelled calculated, assumption, estimated or projected.',
    caption: 'Business case with each number tagged by origin (illustrative demo data).'
  }
};

const technology = [
  'React + TypeScript',
  'Deterministic scoring engine (14 factors + risk penalty)',
  'AI process discovery with rules-engine fallback',
  'Architecture recommender (6 patterns, 5 human-control levels)',
  'ROI model',
  '226 automated tests'
];

const qa = [
  {
    q: 'What exactly should be automated?',
    a: 'Module 2 scores every process on 14 factors in three groups (value, feasibility, strategic fit), subtracts a risk penalty, and shows the reason behind each number.',
    m: 2
  },
  {
    q: 'Which process comes first?',
    a: 'Processes are ranked by priority score, and the plan starts with the top two or three.',
    m: 2
  },
  {
    q: 'Where is AI actually useful?',
    a: 'Where drafting, classifying, summarizing or a bounded task with tools saves real time. Stable, rule-based work goes to deterministic software.',
    m: 3
  },
  {
    q: 'Does this need an agent, or ordinary automation?',
    a: 'Module 3 recommends one of six patterns, from traditional automation to supervised agents, with one of five levels of human control.',
    m: 3
  },
  {
    q: 'What will implementation cost?',
    a: 'Module 4 turns the design into tasks, owners, integrations and milestones, which is the basis of the estimate.',
    m: 4
  },
  {
    q: 'Did the automation produce measurable value?',
    a: 'Module 5 projects the return from stated assumptions, then records actual results against the baseline after go-live.',
    m: 5
  }
];

const flow = [
  { t: 'Company', m: 1 },
  { t: 'Processes', m: 1 },
  { t: 'Score', m: 2 },
  { t: 'Select', m: 2 },
  { t: 'Design', m: 3 },
  { t: 'Implement', m: 4 },
  { t: 'Measure', m: 5 }
];

type Group = { label: string; items: string[] };
type Module = {
  name: string;
  line: string;
  shot?: (typeof SHOTS)[keyof typeof SHOTS];
  lazy?: boolean;
  formula?: string;
  fields?: string[];
  groups?: Group[];
  phases?: string[];
};

const modules: Module[] = [
  {
    name: 'Process discovery',
    line: 'Capture departments, roles, systems and processes by hand, or paste a written company description and review the draft process model the AI proposes.',
    shot: SHOTS.overview,
    fields: ['Company', 'Departments', 'Roles', 'Systems', 'Processes', 'Process steps', 'Pain points', 'Volume and minutes per case']
  },
  {
    name: 'Automation opportunity map',
    line: 'Score every process on 14 factors in three groups (value, feasibility, strategic fit), subtract a risk penalty, and show the reason and evidence source behind each number.',
    shot: SHOTS.map,
    formula: 'Priority = Value × 0.50 + Feasibility × 0.30 + Fit × 0.20 − Risk penalty',
    groups: [
      { label: 'Value', items: ['Time consumed', 'Volume', 'Rework', 'Waiting time', 'Client and revenue impact'] },
      { label: 'Feasibility', items: ['Standardization', 'Data readiness', 'System readiness', 'Rule clarity', 'Exception predictability'] },
      { label: 'Fit', items: ['Repeatability', 'Scalability', 'Employee pain', 'Management priority'] },
      { label: 'Risk penalty', items: ['Privacy', 'Regulatory', 'Consequence', 'Change complexity'] }
    ]
  },
  {
    name: 'Automation designer',
    line: 'Recommend one of six patterns for the selected process, draw its current and proposed flow, and set a level of human control for every component.',
    shot: SHOTS.designer,
    groups: [
      {
        label: 'Six patterns',
        items: [
          'Traditional workflow automation',
          'AI assistant with human execution',
          'Bounded AI agent',
          'Multi-agent system',
          'Human-in-the-loop AI support',
          'Hybrid AI-assisted automation'
        ]
      },
      {
        label: 'Five levels of human control',
        items: ['Fully automated', 'Review after execution', 'Approval before external action', 'Approval before critical action', 'Human only']
      }
    ]
  },
  {
    name: 'Implementation workspace',
    line: 'Turn the design into a delivery plan in five phases, with an owner, dependencies, effort, a target date and acceptance criteria for every task.',
    phases: ['Validate', 'Prototype', 'Pilot', 'Production', 'Optimize'],
    fields: ['Tasks', 'Owners', 'Dependencies', 'Systems touched', 'Milestones', 'Effort in days', 'Target dates', 'Acceptance criteria']
  },
  {
    name: 'Impact & ROI',
    line: 'Project the return from stated assumptions, then record actual results against the baseline after go-live.',
    shot: SHOTS.impact,
    fields: [
      'Monthly case volume',
      'Baseline minutes per case',
      'Projected minutes per case',
      'Loaded hourly cost',
      'Implementation and operating cost',
      'Payback and Year-1 ROI',
      'Actual minutes after go-live',
      'Actual volume after go-live'
    ]
  }
];

const risk = ['Privacy', 'Security', 'Regulatory', 'Financial', 'Legal', 'Reputational', 'Operational', 'Model hallucination', 'Unauthorized tool use'];

const product = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${PAGE}#app`,
  name: 'INNOVA AI Workflow OS',
  url: PAGE,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  creativeWorkStatus: 'Prototype',
  description:
    'Business-process discovery and AI automation planning: maps operations, scores each process for automation value, recommends the architecture, projects ROI and compares it with measured results.',
  screenshot: `${SITE.url}${SHOTS.map.src}`,
  creator: { '@id': `${SITE.url}/#org` }
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${PAGE}#faq`,
  mainEntity: qa.map((x) => ({
    '@type': 'Question',
    name: x.q,
    acceptedAnswer: { '@type': 'Answer', text: x.a }
  }))
};
---

<BaseLayout
  title="AI Workflow OS: From Processes to Measured AI | INNOVA"
  description="INNOVA AI Workflow OS maps operations, scores each process for automation value, recommends software, agent or human-in-the-loop design and projects ROI."
  path="/workflow-os"
  jsonLd={[product, faq]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Workflow OS', path: '/workflow-os' }
  ]}
>
  <section class="wh">
    <div class="wrap wh-grid">
      <div class="wh-top">
        <p class="kicker wh-crumb"><a href="/" class="ulink">INNOVA</a><span aria-hidden="true">/</span>Workflow OS</p>
        <RiseHeading text="INNOVA AI Workflow OS" class="d-xl" delay={60} />
        <p class="lede wh-lede">From business processes to measurable AI automation.</p>
      </div>

      <figure class="proof wh-fig">
        <div class="proof-frame">
        <img
          src={SHOTS.map.src}
          srcset={SHOTS.map.srcset}
          sizes="(max-width: 980px) calc(100vw - 32px), (max-width: 1472px) 56vw, 800px"
          width={SHOTS.map.width}
          height={SHOTS.map.height}
          alt={SHOTS.map.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        </div>
        <figcaption>Prototype · illustrative demo data on Northstar Professional Services, a fictional 30-person firm. Every score shows its formula.</figcaption>
      </figure>

      <div class="wh-act">
        <p class="wh-status"><span class="mark" data-s="prototype" aria-hidden="true"></span>Working prototype. Invite-only demo online since 1 October 2026.</p>
        <p class="wh-fit">Built for firms of 20 to 200 people.</p>
        <a class="btn btn-primary" href="/contact?topic=workflow-os">Request a demo invite <span class="arr" aria-hidden="true">→</span></a>
        <p class="wh-sub">You receive a personal link to the working prototype, preloaded with a fictional sample company. The walkthrough takes about two minutes.</p>
      </div>
    </div>

    <div class="wrap">
      <dl class="rec">
        <div class="rec-id">
          <dt class="sr-only">Record</dt>
          <dd>INV-04 · Prototype</dd>
        </div>
        <div class="rec-tech">
          <dt class="sr-only">Technology</dt>
          <dd>{technology.join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="qa-h">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l"><h2 class="d-l" id="qa-h">Six questions every automation plan has to answer.</h2></div>
        <p class="body sh-r">Workflow OS answers each one from the company’s own process data, and each answer links to the module that produces it.</p>
      </div>
      <div class="qa">
        {
          qa.map((x) => (
            <div class="qa-row">
              <h3 class="qa-q">{x.q}</h3>
              <p class="qa-a">{x.a}</p>
              <a class="qa-m" href={`#module-${x.m}`}>
                <span>Module {x.m}</span>
                <span aria-hidden="true">↓</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="flow-h">
    <div class="wrap">
      <h2 class="sr-only" id="flow-h">Product flow</h2>
      <p class="wf-cap">One path through the product, seven stations. Each station opens the module that handles it.</p>
      <div class="wf" data-draw>
        <span class="wf-track" aria-hidden="true"></span>
        <span class="wf-rail trk-span" aria-hidden="true"></span>
        <ol class="wf-ol">
        {
          flow.map((f, i) => (
            <li style={`--i:${i}`}>
              <a href={`#module-${f.m}`} class="wf-a">
                <span class="wf-dot" aria-hidden="true" />
                <span class="wf-i">{String(i + 1).padStart(2, '0')}</span>
                <span class="wf-t">{f.t}</span>
                <span class="sr-only">, module {f.m}</span>
              </a>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="mods-h">
    <div class="wrap">
      <div class="grid12 sec-head">
        <div class="sh-l"><h2 class="d-l" id="mods-h">Five modules.</h2></div>
        <p class="body sh-r">Each module hands its output to the next. Risk controls run through all five.</p>
      </div>

      <div class="grid12 ms">
        <nav class="ms-nav" aria-label="Workflow OS modules">
          <ol>
            {
              modules.map((m, i) => (
                <li>
                  <a href={`#module-${i + 1}`} class:list={['d-m', 'ms-link', { 'is-active': i === 0 }]} data-mod={i + 1}>
                    {m.name}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="ms-body">
          {
            modules.map((m, i) => (
              <article class:list={['mod', { 'is-active': i === 0 }]} id={`module-${i + 1}`} data-mod={i + 1} aria-labelledby={`module-${i + 1}-h`}>
                <p class="mod-n">Module {i + 1} of 5</p>
                <h3 class="mod-h" id={`module-${i + 1}-h`}>
                  {m.name}
                </h3>

                {m.shot && (
                  <figure class="proof mod-fig">
                    <div class="proof-frame">
                    <img
                      src={m.shot.src}
                      srcset={m.shot.srcset}
                      sizes="(max-width: 980px) calc(100vw - 32px), (max-width: 1472px) 62vw, 900px"
                      width={m.shot.width}
                      height={m.shot.height}
                      alt={m.shot.alt}
                      loading="lazy"
                      decoding="async"
                    />
                    </div>
                    <figcaption>{m.shot.caption}</figcaption>
                  </figure>
                )}

                {m.phases && (
                  <ol class="ph5" aria-label="Five delivery phases">
                    {m.phases.map((p, k) => (
                      <li style={`--k:${k}`}>
                        <span class="ph5-dot" aria-hidden="true" />
                        <span class="ph5-t">{p}</span>
                      </li>
                    ))}
                  </ol>
                )}

                <p class="mod-l">{m.line}</p>

                {m.formula && <p class="formula">{m.formula}</p>}

                {m.groups && (
                  <div class="grp">
                    {m.groups.map((g) => (
                      <div class="grp-c">
                        <h4 class="grp-h">{g.label}</h4>
                        <ul class="ruled">
                          {g.items.map((x) => (
                            <li>{x}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}

                {m.fields && (
                  <ul class="ruled ruled-2" aria-label={`${m.name}: fields`}>
                    {m.fields.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <div class="riskrow">
        <p class="riskrow-l">Risk and governance · every module</p>
        <ul class="riskrow-r">
          {risk.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid12">
      <div class="b-l">
        <h2 class="d-l">Where Workflow OS ends.</h2>
      </div>
      <div class="b-r">
        <p class="lede">
          Workflow OS decides what to automate and how. The automations themselves run in the client’s existing platforms or in INNOVA products such as <a class="ulink b-link" href="/projects/aicrmius">AICRMIUS</a>.
        </p>
        <p class="body b-p">That boundary keeps the planning tool independent of any single vendor, including us.</p>
        <p class="body b-p2">The demo runs on fictional data and works without any external AI service.</p>
        <a class="arrow-link" href="/ai-transformation"><span>Our AI transformation method</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Sticky module list: the module crossing the middle of the viewport becomes active.
  const links = document.querySelectorAll<HTMLAnchorElement>('.ms-link');
  const mods = document.querySelectorAll<HTMLElement>('.mod');
  if (links.length && 'IntersectionObserver' in window) {
    const setActive = (n: string) => {
      links.forEach((l) => {
        const on = l.dataset.mod === n;
        l.classList.toggle('is-active', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
      mods.forEach((m) => m.classList.toggle('is-active', m.dataset.mod === n));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.mod || '1');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    mods.forEach((m) => io.observe(m));
  }
</script>

<style>
  /* ── Proof plate (mirrors the shared .proof contract; scoped so the page stands alone) ── */
  .proof {
    margin: 0;
    border: 0;
    background: none;
  }
  .proof-frame {
    background: var(--plate);
    border: 1px solid var(--rule-strong);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .proof img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .proof figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
    color: var(--lichen);
    max-width: 72ch;
  }

  /* ── Hero: 5 / 7 split ── */
  .wh {
    padding-block: clamp(40px, 4.5vw, 80px) 0;
  }
  .wh-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 32px;
  }
  .wh-top {
    grid-column: 1 / span 5;
    grid-row: 1;
  }
  .wh-act {
    grid-column: 1 / span 5;
    grid-row: 2;
    align-self: end;
    display: grid;
    justify-items: start;
    gap: 16px;
  }
  .wh-fig {
    grid-column: 6 / span 7;
    grid-row: 1 / span 2;
    align-self: start;
    margin-top: 6px;
  }
  .wh-crumb a {
    color: var(--frost);
  }
  .wh-crumb span {
    color: var(--rule-strong);
  }
  .wh-top :global(.d-xl) {
    font-size: clamp(2.4rem, 1.4rem + 2.6vw, 4.1rem);
    max-width: 11ch;
  }
  .wh-lede {
    margin-top: 24px;
    max-width: 28ch;
  }
  .wh-status {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    color: var(--frost);
    font-size: 1rem;
    line-height: 1.5;
  }
  .wh-status .mark {
    flex: none;
    translate: 0 1px;
  }
  .wh-fit {
    margin: 0 0 6px;
    color: var(--lichen);
    font-size: 1rem;
  }
  .wh-sub {
    margin: 0;
    color: var(--lichen);
    font-size: 0.94rem;
    line-height: 1.55;
    max-width: 46ch;
  }

  /* Record bar */
  .rec {
    margin: clamp(40px, 4vw, 64px) 0 0;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
  }
  .rec dd {
    margin: 0;
  }
  .rec-id {
    grid-column: 1 / span 3;
    color: var(--frost);
  }
  .rec-tech {
    grid-column: 4 / span 9;
    color: var(--lichen);
  }

  /* ── Q&A: ruled rows (question · answer · module link) ── */
  .qa {
    border-bottom: 1px solid var(--rule);
  }
  .qa-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) minmax(0, 2fr);
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 10px;
    padding-block: clamp(20px, 2.2vw, 30px);
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .qa-q {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 500;
    font-size: clamp(1.2rem, 1.02rem + 0.55vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .qa-a {
    margin: 0;
    color: var(--lichen);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 58ch;
  }
  .qa-m {
    justify-self: end;
    display: inline-flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--lichen);
    text-decoration: none;
    padding-block: 4px;
    transition: color var(--t-micro) var(--ease-out);
  }
  .qa-m:hover,
  .qa-m:focus-visible {
    color: var(--frost);
  }
  .qa-m span:last-child {
    transition: transform var(--t-micro) var(--ease-out);
  }
  .qa-m:hover span:last-child {
    transform: translateY(3px);
  }

  /* ── Product flow: shared line language ── */
  .wf-cap {
    margin: 0 0 clamp(28px, 3vw, 44px);
    color: var(--lichen);
    font-size: 1rem;
    max-width: 52ch;
  }
  .wf {
    --dot: 10px;
    position: relative;
  }
  .wf-ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
  .wf-track,
  .wf-rail {
    position: absolute;
    left: 0;
    right: calc(100% / 7 - var(--dot) / 2);
    top: calc(var(--dot) / 2 - 1px);
    height: 2px;
  }
  .wf-track {
    background: var(--rule-strong);
  }
  .wf-rail {
    background: var(--signal);
    transform-origin: left;
    transition: transform var(--t-draw) var(--ease-in-out);
  }
  .wf li {
    position: relative;
  }
  .wf-a {
    display: block;
    padding-top: 30px;
    padding-right: 12px;
    color: var(--frost);
    text-decoration: none;
  }
  .wf-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--ground);
    border: 2px solid var(--signal);
    transition:
      transform var(--t-micro) var(--ease-out),
      background-color var(--t-micro) var(--ease-out);
  }
  .wf li:last-child .wf-dot {
    background: var(--signal);
  }
  .wf-i {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--lichen);
    margin-bottom: 8px;
  }
  .wf-t {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 480;
    font-size: clamp(1.1rem, 0.6rem + 1.1vw, 1.9rem);
    letter-spacing: -0.02em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--t-micro) var(--ease-out);
    padding-bottom: 2px;
  }
  .wf-a:hover .wf-t,
  .wf-a:focus-visible .wf-t {
    background-size: 100% 1px;
  }
  .wf-a:hover .wf-dot {
    transform: scale(1.3);
  }
  @media (prefers-reduced-motion: no-preference) {
