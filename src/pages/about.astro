---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecordIds from '../components/RecordIds.astro';
import { visibleProjects, type Project } from '../data/projects';
import { SITE } from '../data/site';
import { CROPS, asScreen } from '../data/crops';

const P = Object.fromEntries(visibleProjects.map((p) => [p.slug, p])) as Record<string, Project>;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about#page`,
    url: `${SITE.url}/about`,
    name: 'About INNOVA CONSULT LTD.',
    inLanguage: 'en-CA',
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: { '@id': `${SITE.url}/#org` }
  }
];
---

<BaseLayout
  title="About INNOVA CONSULT LTD. · Ottawa Technology Company"
  description="INNOVA CONSULT LTD. is an Ottawa applied AI and software company, incorporated federally in 2023. Its founder has worked in business and technology since 2012."
  path="/about"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' }
  ]}
>
  <!-- ═══ HERO: the name, and the three facts in one statement (round 3: no stat banner) ═══ -->
  <section class="ah shell" aria-labelledby="ah-h" data-hero>
    <div class="inset ah-in">
      <p class="t-label ah-crumb"><a href="/">INNOVA</a><span aria-hidden="true">/</span><span>About</span></p>
      <div class="ah-g">
        <h1 id="ah-h" class="ah-t">Maksym Stepanenko</h1>
        <p class="ah-st">
          In business since {SITE.experienceSince}, with companies in more than 50&nbsp;countries. In {SITE.incorporated} he incorporated {SITE.legalName} in {SITE.city}, an applied AI and software company he leads as founder and director.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ ONE PHOTO BAND: the festival that runs on INNOVA software ═══ -->
  <section class="ab shell" aria-label="UAFest, Carleton Place">
    <figure class="ab-f frame" data-dolly-bg>
      <img
        src="/img/uafest-venue.webp"
        srcset="/img/uafest-venue-800.webp 800w, /img/uafest-venue.webp 1280w"
        sizes="100vw"
        alt="UAFest in Carleton Place: the audience on the lawn in front of the festival stage, under the trees by the river."
        width="1280"
        height="851"
        decoding="async"
      />
      <figcaption class="ab-cap">UAFest, Carleton Place: the festival of the Ukrainian Community of Lanark County, a non-profit co-founded by INNOVA’s founder. Its applications, participant cabinets and registers run on the platform INNOVA built.</figcaption>
    </figure>
  </section>

  <!-- ═══ THE FOUNDER (bone): one statement, two sentences, one link ═══ -->
  <section class="fd tone-bone" id="founder" aria-labelledby="founder-h">
    <div class="shell">
      <div class="inset fd-in">
        <h2 id="founder-h" class="sr-only">The founder</h2>
        <p class="fd-bio" data-rise>
          Since {SITE.experienceSince} Maksym has worked with small and mid-sized businesses in more than 50 countries on strategy, legal structure, tax and marketing.
        </p>
        <p class="fd-p">
          In recent years he has brought applied AI into those businesses and into INNOVA’s own products. He holds an MA in Economic Theory (honours).
        </p>
        <p class="fd-p">
          For funded and client projects, engineering, security review and domain specialists join as named subcontractors or partner firms, listed in the proposal before work starts.
        </p>
        <a class="lnk fd-k" href="/partnerships">How partnerships work <span class="ar" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ WHERE IT HAS LED ═══ -->
  <section class="led shell" aria-labelledby="led-h">
    <div class="inset led-head">
      <h2 id="led-h" class="t-h2" data-rise>Where this has led so far</h2>
      <a class="lnk" href="/projects">All projects <span class="ar" aria-hidden="true">→</span></a>
    </div>
    <div class="led-g">
      <ProjectCard
        project={P.uafest}
        fact="Applications, participant cabinets, sponsor and finance registers for a Ukrainian festival in Carleton Place, Ontario. In production since August 2026."
        world={{ src: '/img/uafest-dance.webp', src800: '/img/uafest-dance-800.webp', w: 1280, h: 818, pos: '22% 50%' }}
        screens={[asScreen(CROPS.uafestForm, { l: '30%', t: '9%', width: '64%', lm: '6%', tm: '8%', wm: '88%' })]}
        credit="UAFest festival, Carleton Place"
      />
      <ProjectCard
        project={P.babakokum}
        fact="On the App Store since 24 September 2026, and playable on the web. Runs fully offline."
        world={{ src: '/img/babakokum-porch.webp', w: 760, h: 720, pos: '50% 30%' }}
        screens={[asScreen(CROPS.babakokum, { l: '9%', t: '13%', width: '82%', lm: '6%', tm: '14%', wm: '88%' })]}
      />
    </div>
  </section>

  <!-- ═══ COMPANY RECORD: one line ═══ -->
  <section class="rc shell" id="record" aria-labelledby="rc-h">
    <div class="inset rc-g">
      <h2 id="rc-h" class="sr-only">Company record</h2>
      <RecordIds />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero: type on film, the photo follows directly ── */
  .ah {
    padding-top: clamp(28px, 3.4vw, 56px);
  }
  .ah-crumb {
    display: flex;
    gap: 10px;
    color: var(--ash);
  }
  .ah-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .ah-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ah-t {
    margin-top: clamp(18px, 2.4vw, 36px);
    font-size: clamp(54px, 10.6vw, 184px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.86;
    margin-left: -0.05em;
  }
  .ah-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: clamp(24px, 3vw, 48px);
    align-items: end;
  }
  .ah-g .ah-t {
    grid-column: 1 / span 8;
  }
  .ah-st {
    grid-column: 9 / span 4;
    padding-bottom: 0.5em;
    font-size: clamp(20px, 1.65vw, 27px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: pretty;
  }
  @media (max-width: 1100px) {
    .ah-g .ah-t,
    .ah-st {
      grid-column: 1 / -1;
    }
    .ah-st {
      max-width: 34ch;
      padding-bottom: 0;
    }
  }

  /* ── photo band ── */
  .ab {
    padding-top: clamp(36px, 4.4vw, 72px);
  }
  .ab-f {
    margin: 0;
    aspect-ratio: 16 / 7;
    background: var(--reel);
  }
  .ab-f img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .ab-f::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(13 12 11 / 0.85) 0%, rgb(13 12 11 / 0.3) 26%, rgb(13 12 11 / 0) 46%);
  }
  .ab-cap {
    position: absolute;
    z-index: 1;
    left: clamp(18px, 2.6vw, 44px);
    bottom: clamp(16px, 2vw, 32px);
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.45;
  }

  /* ── founder ── */
  .fd {
    margin-top: var(--sec);
    padding-block: calc(var(--sec) * 0.8);
  }
  .fd-in {
    max-width: 1080px;
  }
  .fd-bio {
    font-size: clamp(30px, 3.4vw, 56px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    max-width: 24ch;
    text-wrap: balance;
  }
  .fd-p {
    margin-top: 22px;
    max-width: 58ch;
    font-size: clamp(18px, 1.35vw, 21px);
    color: var(--ink-soft);
  }
  .fd-p:first-of-type {
    margin-top: clamp(28px, 3vw, 44px);
  }
  .fd-k {
    margin-top: 28px;
  }

  /* ── where it has led ── */
  .led {
    padding-top: var(--sec);
  }
  .led-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    margin-bottom: clamp(24px, 3vw, 44px);
  }
  .led-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }

  /* ── company record: one line ── */
  .rc {
    padding-top: clamp(40px, 4.4vw, 72px);
  }
  .rc-g :global(.rid) {
    font-size: 18px;
  }

  @media (max-width: 900px) {
    .ah-st {
      grid-column: 1 / -1;
    }
    .ab-f {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
    }
    .ab-f img {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 4 / 3;
    }
    .ab-f::after {
      display: none;
    }
    .ab-cap {
      position: relative;
      left: auto;
      bottom: auto;
      padding: 16px 18px 20px;
      font-size: 15px;
    }
    .led-g {
      grid-template-columns: 1fr;
    }
  }
</style>
