---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { SITE } from '../data/site';

const topics = [
  ['product', 'Build a technology product'],
  ['automation', 'Automate business processes'],
  ['ai', 'Explore an AI initiative'],
  ['workflow-os', 'See AI Workflow OS'],
  ['rd', 'Discuss an R&D project'],
  ['commercialize', 'Commercialize technology'],
  ['partnership', 'Explore a partnership'],
  ['public-sector', 'Discuss a public-sector project'],
  ['other', 'Other']
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${SITE.url}/contact#page`,
    url: `${SITE.url}/contact`,
    name: 'Contact INNOVA',
    inLanguage: 'en-CA',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#org` }
  }
];
---

<BaseLayout
  title="Contact INNOVA · Applied AI & Software, Ottawa"
  description="Tell INNOVA about a product to build, a process to automate, an R&D project or a partnership. Every message is read by a person and answered by email."
  path="/contact"
  footerCta={false}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' }
  ]}
>
  <PageHead
    crumb="Contact"
    title="Start a conversation."
    lede="Tell us what you are working on. Every message is read by a person, and we reply by email."
  />

  <section class="section">
    <div class="wrap grid12">
      <form class="cf" data-cf novalidate>
        <fieldset class="cf-topics">
          <legend class="mono">I want to</legend>
          <div class="cf-opts">
            {
              topics.map(([v, l], i) => (
                <label class="cf-opt">
                  <input type="radio" name="topic" value={v} checked={i === 0} />
                  <span>{l}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="cf-grid">
          <div class="cf-f">
            <label class="mono" for="cf-name">Name</label>
            <input id="cf-name" name="name" autocomplete="name" required maxlength="120" />
            <p class="cf-err" id="cf-name-err" hidden></p>
          </div>
          <div class="cf-f">
            <label class="mono" for="cf-org">Organization (optional)</label>
            <input id="cf-org" name="organization" autocomplete="organization" maxlength="160" />
          </div>
          <div class="cf-f cf-wide">
            <label class="mono" for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" inputmode="email" />
            <p class="cf-err" id="cf-email-err" hidden></p>
          </div>
          <div class="cf-f cf-wide">
            <label class="mono" for="cf-message">What are you working on?</label>
            <textarea id="cf-message" name="message" rows="6" required maxlength="4000"></textarea>
            <p class="cf-err" id="cf-message-err" hidden></p>
          </div>
          <label class="cf-hp" aria-hidden="true">
            Website <input name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="cf-foot">
          <button class="btn btn-primary" type="submit">Start a conversation <span class="arr" aria-hidden="true">→</span></button>
          <p class="cf-note">We use your details only to reply to this message. <a class="cf-note-a" href="/privacy">How we handle them</a></p>
        </div>
        <p class="cf-status" role="status" aria-live="polite" data-cf-status></p>
      </form>

      <aside class="ca" aria-label="Other ways to reach INNOVA">
        <div>
          <p class="mono ca-h">Email</p>
          <a class="ulink ca-v" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <div>
          <p class="mono ca-h">Location</p>
          <p class="ca-v">{SITE.city}, {SITE.region}, {SITE.country}</p>
        </div>
        <div class="ca-next">
          <p class="mono ca-h">What happens next</p>
          <p class="ca-v ca-note">You get a written reply: a short scope proposal, or a clear answer on why it is not a fit.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-cf]');
  const status = document.querySelector<HTMLElement>('[data-cf-status]');
  const started = Date.now();

  const topic = new URLSearchParams(location.search).get('topic');
  if (form && topic) {
    const r = form.querySelector<HTMLInputElement>(`input[name="topic"][value="${CSS.escape(topic)}"]`);
    if (r) r.checked = true;
  }

  type Field = 'name' | 'email' | 'message';
  const fields: Field[] = ['name', 'email', 'message'];

  const check = (k: Field, v: string): string => {
    const t = v.trim();
    if (k === 'name') return t.length < 2 ? 'Add your name.' : '';
    if (k === 'email') {
      if (!t) return 'Add an email address so we can reply.';
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(t) ? '' : 'Check the email address, for example name@company.ca.';
    }
    return t.length < 2 ? 'Add a few words about what you are working on.' : '';
  };

  const setError = (k: Field, msg: string) => {
    const input = form?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${k}"]`);
    const err = document.getElementById(`cf-${k}-err`);
    if (!input || !err) return;
    if (msg) {
      err.textContent = msg;
      err.hidden = false;
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', err.id);
    } else {
      err.textContent = '';
      err.hidden = true;
      input.removeAttribute('aria-invalid');
      input.removeAttribute('aria-describedby');
    }
  };

  fields.forEach((k) => {
    form?.querySelector(`[name="${k}"]`)?.addEventListener('input', () => setError(k, ''));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status) return;
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries()) as Record<string, string>;

    const bad = fields.filter((k) => {
      const msg = check(k, String(data[k] || ''));
      setError(k, msg);
      return Boolean(msg);
    });
    if (bad.length) {
      status.dataset.state = 'error';
      status.textContent = bad.length === 1 ? 'One field needs attention.' : `${bad.length} fields need attention.`;
      form.querySelector<HTMLElement>(`[name="${bad[0]}"]`)?.focus();
      return;
    }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;
    status.dataset.state = 'sending';
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...data, page: location.href, elapsed: Date.now() - started })
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.dataset.state = 'ok';
      status.textContent = 'Thank you. Your message is with us, and we will reply by email.';
    } catch {
      status.dataset.state = 'error';
      status.innerHTML = 'The message did not go through. Please email <a href="mailto:info@innovaconsult.ca">info@innovaconsult.ca</a>.';
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>

<style>
  .cf {
    --field-rule: var(--rule-field, rgb(150 210 205 / 0.5));
    --err: #f2a7a0;
    grid-column: 1 / span 8;
  }
  .ca {
    grid-column: 10 / span 3;
    display: grid;
    gap: 26px;
    align-content: start;
  }
  .ca-h {
    color: var(--lichen);
    margin: 0 0 6px;
  }
  .ca-v {
    margin: 0;
    text-decoration: none;
  }
  .ca-next {
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }
  .ca-note {
    color: var(--lichen);
    font-size: 0.95rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .cf-topics {
    border: 0;
    margin: 0 0 36px;
    padding: 0;
  }
  .cf-topics legend {
    color: var(--lichen);
    margin-bottom: 14px;
    padding: 0;
  }
  .cf-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cf-opt {
    position: relative;
    cursor: pointer;
  }
  .cf-opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .cf-opt span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--rule-strong);
    color: var(--lichen);
    transition:
      border-color var(--t-micro) var(--ease-out),
      color var(--t-micro) var(--ease-out),
      background-color var(--t-micro) var(--ease-out);
  }
  .cf-opt:hover span {
    border-color: var(--frost);
    color: var(--frost);
  }
  .cf-opt input:checked + span {
    background: var(--frost);
    border-color: var(--frost);
    color: var(--ground);
    font-weight: 600;
  }
  .cf-opt input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .cf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 24px;
  }
  .cf-wide {
    grid-column: 1 / -1;
  }
  .cf-f {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .cf-f label {
    color: var(--lichen);
  }
  .cf-f input,
  .cf-f textarea {
    width: 100%;
    font: inherit;
    color: var(--frost);
    background: var(--plate);
    border: 1px solid var(--field-rule);
    border-radius: 0;
    padding: 13px 14px;
    min-height: 50px;
    transition: border-color var(--t-micro) var(--ease-out);
  }
  .cf-f textarea {
    resize: vertical;
    min-height: 160px;
  }
  .cf-f input:hover,
  .cf-f textarea:hover {
    border-color: var(--lichen);
  }
  .cf-f input:focus,
  .cf-f textarea:focus {
    outline: none;
    border-color: var(--signal);
    box-shadow: 0 0 0 1px var(--signal);
  }
  .cf-f [aria-invalid='true'],
  .cf-f [aria-invalid='true']:hover {
    border-color: var(--err);
  }
  .cf-f [aria-invalid='true']:focus {
    border-color: var(--err);
    box-shadow: 0 0 0 1px var(--err);
  }
  .cf-err {
    margin: 0;
    color: var(--err);
    font-size: 0.92rem;
    line-height: 1.45;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .cf-err::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
  }
  .cf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 28px;
  }
  .cf-foot .btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .cf-note {
    margin: 0;
    color: var(--lichen);
    font-size: 0.9rem;
  }
  .cf-note-a {
    color: var(--frost);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 4px;
  }
  .cf-note-a:hover {
    text-decoration-color: currentColor;
  }
  .cf-status {
    margin: 18px 0 0;
    min-height: 1.6em;
  }
  .cf-status[data-state='ok'] {
    color: var(--live);
  }
  .cf-status[data-state='error'] {
    color: var(--err);
  }
  .cf-status a {
    color: inherit;
  }
  @media (max-width: 980px) {
    .cf,
    .ca {
      grid-column: 1 / -1;
    }
    .ca {
      margin-top: 48px;
    }
  }
  @media (max-width: 640px) {
    .cf-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .cf-opts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .cf-opt span {
      display: flex;
      width: 100%;
      height: 100%;
      min-height: 52px;
      padding: 8px 12px;
      font-size: 15px;
      line-height: 1.3;
    }
  }
</style>
