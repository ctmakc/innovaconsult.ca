---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../data/site';

const credits = ['Photo via Wikimedia Commons: Rideau Canal at night by Dylandamic0, CC BY-SA 3.0'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${SITE.url}/contact#page`,
    url: `${SITE.url}/contact`,
    name: 'Contact INNOVA',
    inLanguage: 'en-CA',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#org` }
  }
];
---

<BaseLayout
  title="Contact INNOVA · Applied AI & Software, Ottawa"
  description="Tell INNOVA about a product to build, a process to automate, an R&D project or a partnership. Every message is read by a person and answered by email."
  path="/contact"
  footerCta={false}
  jsonLd={jsonLd}
  credits={credits}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact' }
  ]}
>
  <section class="ct shell" aria-labelledby="ct-h">
    <div class="ct-g">
      <!-- The city at night, the statement over it; it stays in view while the form scrolls -->
      <div class="ct-l">
        <div class="ct-f frame">
          <div class="ct-world" aria-hidden="true">
            <img
              src="/img/rideau-night-1200.webp"
              srcset="/img/rideau-night-1200.webp 1200w, /img/rideau-night.webp 2400w"
              sizes="(max-width: 900px) 100vw, 46vw"
              alt=""
              width="1200"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <p class="t-label ct-crumb"><a href="/">INNOVA</a><span aria-hidden="true">/</span><span>Contact</span></p>
          <div class="ct-head">
            <h1 id="ct-h" class="t-display ct-t">Start a conversation.</h1>
            <p class="t-lede ct-lede">Tell us what you are working on. Every message is read by a person, and we reply by email.</p>
          </div>
          <span class="ct-credit">Rideau Canal, Ottawa</span>
        </div>
      </div>

      <div class="ct-r">
        <ContactForm idPrefix="cf" tone="film" submitLabel="Start a conversation" rows={6} />

        <aside class="ca" aria-label="Other ways to reach INNOVA">
          <div class="ca-mail">
            <p class="t-label t-mute">Email</p>
            <a class="ca-big" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </div>
          <div>
            <p class="t-label t-mute">Location</p>
            <p class="ca-v">{SITE.city}, {SITE.region}, {SITE.country}</p>
          </div>
          <div>
            <p class="t-label t-mute">What happens next</p>
            <p class="ca-v">You get a written reply: a short scope proposal, or a clear answer on why it is not a fit.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ct {
    padding-top: var(--gut);
    padding-bottom: var(--sec);
  }
  .ct-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: start;
  }
  .ct-l {
    grid-column: 1 / span 6;
    position: sticky;
    top: calc(var(--hdr) + var(--gut));
  }
  .ct-f {
    height: calc(100svh - var(--hdr) - 2 * var(--gut));
    min-height: 560px;
    max-height: 980px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(20px, 2.6vw, 40px);
    background: var(--reel);
    animation: ct-open 0.9s var(--e-out) both;
  }
  .ct-world {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .ct-world img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 55%;
    animation: ct-settle 1.2s var(--e-out) both;
  }
  .ct-f::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(13 12 11 / 0.55) 0%, rgb(13 12 11 / 0) 22%, rgb(13 12 11 / 0.1) 42%, rgb(13 12 11 / 0.7) 70%, rgb(13 12 11 / 0.92) 100%);
  }
  .ct-crumb {
    display: flex;
    gap: 10px;
    color: var(--ash);
    text-shadow: 0 1px 12px rgb(13 12 11 / 0.7);
  }
  .ct-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .ct-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ct-t {
    font-size: clamp(52px, 6.4vw, 112px);
    max-width: 8ch;
  }
  .ct-lede {
    margin-top: 24px;
    max-width: 30ch;
  }
  .ct-credit {
    position: absolute;
    right: 14px;
    top: 14px;
    font-size: 14px;
    color: rgb(238 234 226 / 0.78);
  }
  .ct-r {
    grid-column: 8 / span 5;
    padding-top: clamp(24px, 4vw, 72px);
  }
  /* the form's privacy link sits in ash text: underline it so it never relies on colour alone */
  .ct-r :global(.cform-note a) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ca {
    margin-top: clamp(56px, 6vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--rule-film);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px var(--col-gap);
  }
  .ca .t-label {
    margin-bottom: 8px;
  }
  .ca-mail {
    grid-column: 1 / -1;
  }
  .ca-big {
    font-size: clamp(26px, 2.4vw, 40px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 4px;
    transition: background-size 0.35s var(--e-out);
  }
  .ca-big:hover {
    background-size: 100% 1px;
  }
  .ca-v {
    font-size: 17px;
    line-height: 1.5;
    max-width: 34ch;
  }
  @keyframes ct-open {
    from {
      clip-path: inset(3% 3% 3% 3% round var(--r));
    }
    to {
      clip-path: inset(0 0 0 0 round var(--r));
    }
  }
  @keyframes ct-settle {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1.02);
    }
  }

  @media (max-width: 1100px) {
    .ct-l {
      grid-column: 1 / span 6;
    }
    .ct-r {
      grid-column: 7 / span 6;
    }
  }
  @media (max-width: 900px) {
    .ct-l,
    .ct-r {
      grid-column: 1 / -1;
    }
    .ct-l {
      position: static;
    }
    .ct-f {
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 4.4;
    }
    .ct-r {
      padding-top: 40px;
    }
    .ca {
      grid-template-columns: 1fr;
    }
  }
</style>
