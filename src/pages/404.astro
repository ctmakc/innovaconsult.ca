---
import BaseLayout from '../layouts/BaseLayout.astro';
import FitText from '../components/FitText.astro';
import MediaFrame from '../components/MediaFrame.astro';

const credits = [
  'Photos via Wikimedia Commons: Parliament Hill at dawn by joiseyshowaa, CC BY-SA 2.0 (colour graded)',
  'Rideau Canal at night by Dylandamic0, CC BY-SA 3.0'
];
---

<BaseLayout title="Page not found | INNOVA" description="This page does not exist on innovaconsult.ca." path="/404" noindex footerCta={false} credits={credits}>
  <section class="nf shell" aria-labelledby="nf-h">
    <div class="inset nf-g">
      <FitText as="p" class="nf-num" text="Error 404" lines={['404']} />
      <div class="nf-r">
        <h1 id="nf-h" class="t-h2 nf-h">Page not found.</h1>
        <p class="t-lede nf-p">The address may be old or mistyped. These will get you back on track.</p>
      </div>
    </div>

    <nav class="nf-go" aria-label="Where to go instead">
      <MediaFrame
        href="/"
        size="stage"
        aspect="4 / 3.4"
        aspectM="16 / 9"
        world={{ src: '/img/ottawa-dawn-1440.webp', w: 1440, h: 1079, pos: '50% 40%' }}
      >
        <p class="nf-n">Home <span class="ar" aria-hidden="true">→</span></p>
        <p class="nf-d">Applied AI and software, Ottawa</p>
      </MediaFrame>
      <MediaFrame
        href="/projects"
        size="stage"
        aspect="4 / 3.4"
        aspectM="16 / 9"
        world={{ src: '/img/uafest-dance.webp', src800: '/img/uafest-dance-800.webp', w: 1280, h: 818, pos: '30% 50%' }}
        screens={[
          {
            src: '/proof/uafest-applications-1440-1600.webp',
            src800: '/proof/uafest-applications-1440-800.webp',
            w: 1600,
            h: 1000,
            alt: 'UAFest 2027 sign-up page on uafest.ca: one form with participation types for guests, volunteers, vendors, performers, sponsors and the organizing team.',
            l: '13%',
            t: '7%',
            width: '62%',
            lm: '20%',
            tm: '9%',
            wm: '56%'
          }
        ]}
      >
        <p class="nf-n">Projects <span class="ar" aria-hidden="true">→</span></p>
        <p class="nf-d">Each one at its real stage</p>
      </MediaFrame>
      <MediaFrame
        href="/contact"
        size="stage"
        aspect="4 / 3.4"
        aspectM="16 / 9"
        world={{ src: '/img/rideau-night-1200.webp', w: 1200, h: 800, pos: '58% 55%' }}
      >
        <p class="nf-n">Contact <span class="ar" aria-hidden="true">→</span></p>
        <p class="nf-d">Tell us what you are looking for</p>
      </MediaFrame>
    </nav>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-top: clamp(40px, 6vw, 96px);
    padding-bottom: var(--sec);
  }
  .nf-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 32px;
    align-items: end;
  }
  :global(.nf-num) {
    grid-column: 1 / span 7;
    color: var(--print);
    animation: nf-rise 0.9s var(--e-out) both;
  }
  .nf-r {
    grid-column: 9 / span 4;
    padding-bottom: 0.4em;
    animation: nf-in 0.7s var(--e-out) 0.25s both;
  }
  .nf-p {
    margin-top: 20px;
  }
  .nf-go {
    margin-top: clamp(56px, 6vw, 104px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gut);
  }
  .nf-n {
    font-size: clamp(30px, 2.6vw, 44px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .nf-n .ar {
    display: inline-block;
    transition: transform 0.35s var(--e-out);
  }
  .nf-go :global(a.mf:hover) .nf-n .ar {
    transform: translateX(8px);
  }
  .nf-d {
    margin-top: 10px;
    font-size: 17px;
    color: var(--print);
  }
  @keyframes nf-rise {
    from {
      opacity: 0;
      transform: translateY(6%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes nf-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 900px) {
    :global(.nf-num),
    .nf-r {
      grid-column: 1 / -1;
    }
    .nf-go {
      grid-template-columns: 1fr;
    }
  }
</style>
