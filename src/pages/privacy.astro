---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { SITE } from '../data/site';

// Every line below describes what the code does: src/components/ContactForm.astro (form), functions/api/contact.js (delivery),
// src/layouts/BaseLayout.astro (no analytics, no third-party scripts), public/fonts (self-hosted fonts).
const items: { h: string; body: string[] }[] = [
  {
    h: 'What the contact form collects',
    body: [
      'Your name, your organization if you give one, your email address, the topic you choose and your message.',
      'With them the form sends the address of the page you sent it from. Our hosting network adds the country your connection comes from.',
      'The form also measures how long the page was open before you pressed send. That number is used only to filter automated spam and is left out of the message we receive.'
    ]
  },
  {
    h: 'Why',
    body: ['To read your message and reply to you. Your email address is set as the reply address, so our answer goes straight to you.']
  },
  {
    h: 'Where it goes',
    body: [
      'The form sends one email to INNOVA through Resend, an email delivery service based in the United States. The website itself keeps no database of messages.'
    ]
  },
  {
    h: 'Cookies and analytics',
    body: ['The site’s own code sets no cookies and loads no analytics or advertising scripts. Fonts are served from this website.']
  },
  {
    h: 'Your requests',
    body: [`To ask what we hold about you, or to have your messages deleted, write to ${SITE.email}.`]
  },
  {
    h: 'Who is responsible',
    body: [`${SITE.legalName}, federal corporation ${SITE.corporationNumber}, ${SITE.city}, ${SITE.region}, ${SITE.country}.`]
  }
];

// The rows of the one email the form produces, in the order functions/api/contact.js writes them.
const mail: [string, string][] = [
  ['Topic', 'The topic you choose'],
  ['Name', 'Your name'],
  ['Organization', 'If you give one'],
  ['Email', 'Your address, also the reply-to'],
  ['Message', 'What you wrote'],
  ['Page', 'The page you sent it from'],
  ['Country', 'Added by the hosting network'],
  ['Received', 'Date and time']
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/privacy#page`,
    url: `${SITE.url}/privacy`,
    name: 'Privacy',
    inLanguage: 'en-CA',
    isPartOf: { '@id': `${SITE.url}/#website` },
    publisher: { '@id': `${SITE.url}/#org` }
  }
];
---

<BaseLayout
  title="Privacy | INNOVA"
  description="What the innovaconsult.ca contact form collects, why INNOVA uses it, where it goes and how to ask for your messages to be deleted."
  path="/privacy"
  jsonLd={jsonLd}
  footerCta={false}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Privacy', path: '/privacy' }
  ]}
>
  <PageHead crumb="Privacy" title="Privacy." lede="What this website collects when you write to us, and what happens to it." />

  <section class="pv shell" aria-label="Privacy notice">
    <div class="inset pv-g">
      <div class="pv-l">
        {
          items.map((it, i) => (
            <section class="pv-it" aria-labelledby={`pv-${i}`}>
              <h2 id={`pv-${i}`} class="t-h4 pv-h">{it.h}</h2>
              <div class="pv-b">
                {it.body.map((b) =>
                  b.includes(SITE.email) ? (
                    <p>{b.split(SITE.email)[0]}<a class="pv-a" href={`mailto:${SITE.email}`}>{SITE.email}</a>{b.split(SITE.email)[1]}</p>
                  ) : (
                    <p>{b}</p>
                  )
                )}
              </div>
            </section>
          ))
        }
        <p class="t-label t-mute pv-date">Updated October 2026</p>
      </div>

      <!-- The email itself: the one place your details go -->
      <aside class="pv-r" aria-labelledby="mail-h">
        <div class="mail frame">
          <div class="mail-top">
            <p id="mail-h" class="t-label">The one email the form sends</p>
            <p class="mail-to">To INNOVA, through Resend</p>
          </div>
          <dl class="mail-dl">
            {
              mail.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mail-foot">The time the page was open is checked for spam on arrival and left out of this email.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .pv {
    padding-bottom: var(--sec);
  }
  .pv-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 56px;
    align-items: start;
  }
  .pv-l {
    grid-column: 1 / span 7;
    display: grid;
    gap: clamp(40px, 4.4vw, 64px);
  }
  .pv-it {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--col-gap);
    row-gap: 12px;
  }
  .pv-h {
    text-wrap: balance;
  }
  .pv-b p {
    color: var(--ash);
    max-width: 52ch;
  }
  .pv-b p + p {
    margin-top: 12px;
  }
  .pv-a {
    color: var(--print);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .pv-date {
    margin-top: 8px;
  }
  .pv-r {
    grid-column: 9 / span 4;
    position: sticky;
    top: calc(var(--hdr) + 32px);
  }
  .mail {
    background: var(--bone);
    color: var(--ink);
    box-shadow: var(--shadow-screen);
  }
  .mail-top {
    padding: 22px 24px 18px;
    background: var(--bone-2);
  }
  .mail-to {
    margin-top: 4px;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .mail-dl {
    margin: 0;
    padding: 10px 24px 4px;
  }
  .mail-dl > div {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
  }
  .mail-dl > div + div {
    border-top: 1px solid var(--rule-ink);
  }
  .mail-dl dt {
    font-size: 15px;
    font-weight: 600;
  }
  .mail-dl dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .mail-foot {
    margin: 6px 24px 0;
    padding: 16px 0 22px;
    border-top: 2px solid var(--ink);
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
  }

  @media (max-width: 1100px) {
    .pv-it {
      grid-template-columns: 1fr;
    }
    .pv-l {
      grid-column: 1 / span 7;
    }
    .pv-r {
      grid-column: 8 / span 5;
    }
  }
  @media (max-width: 900px) {
    .pv-l,
    .pv-r {
      grid-column: 1 / -1;
    }
    .pv-r {
      position: static;
      order: -1;
    }
  }
</style>
