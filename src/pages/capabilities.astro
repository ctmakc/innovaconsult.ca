---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapHead from '../components/cap/CapHead.astro';
import Button from '../components/Button.astro';
import Brief from '../components/cap/Brief.astro';
import CapPanels from '../components/cap/CapPanels.astro';
import Thumbs from '../components/cap/Thumbs.astro';
import { type CapKey } from '../components/cap/media';
import { CAPABILITIES } from '../data/capabilities';
import { STAGES } from '../data/stages';
import { PROJECTS, type Project } from '../data/projects';

const shownIn = (slugs: string[] = []) =>
  slugs.map((slug) => PROJECTS.find((p) => p.slug === slug && p.visible)).filter((p): p is Project => Boolean(p));
const spanLabel = (s: readonly [number, number]) => (s[0] === s[1] ? STAGES[s[0]].label : `${STAGES[s[0]].label} → ${STAGES[s[1]].label}`);

const caps = CAPABILITIES.map((c) => ({ ...c, k: c.key as CapKey, span: spanLabel(c.span), projects: shownIn(c.projects) }));
---

<BaseLayout
  title="Capabilities: Applied AI, Software & R&D | INNOVA Ottawa"
  description="Four INNOVA capabilities on one line: applied AI and automation, custom software, applied R&D and commercialization, and innovation partnerships in Canada."
  path="/capabilities"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' }
  ]}
>
  <CapHead
    crumb="Capabilities"
    title="Applied AI, software and R&D on one line."
    lede="Four capabilities on one line, each shown in real projects. One accountable lead stays with a project from discovery to measurement, with specialist partners where needed."
  >
    <CapPanels slot="media" items={caps.map((c) => ({ k: c.k, href: `#${c.key}`, name: c.name, line: c.line, span: c.span }))} />
  </CapHead>

  <Brief
    text="INNOVA is an Ottawa technology company. It works across four connected capabilities: applied AI and automation, custom software, applied R&D and commercialization, and innovation partnerships. Each section below shows the stretch of the stage line it covers and the projects where it is in use."
  />

  {
    caps.map((c, i) => (
      <section class:list={['chap', c.key === 'partnerships' ? 'tone-bone chap--bone' : 'tone-film']} id={c.key} aria-labelledby={`${c.key}-h`}>
        <div class="shell">
          <div class="inset">
            <div class="chap-top">
              <div class="chap-t">
                <p class="t-label t-mute chap-span">
                  <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
                  <span>{c.span}</span>
                </p>
                <h2 class="chap-n" id={`${c.key}-h`} data-rise>
                  {c.name}
                </h2>
              </div>
              <div class="chap-a">
                <p class="chap-line">{c.line}</p>
                <Button href={c.href} variant={c.key === 'partnerships' ? 'ink' : 'ghost'} class="chap-go">
                  {c.linkLabel}
                </Button>
              </div>
            </div>
            <div class="chap-g">
              <ul class="chap-scope" aria-label={`${c.name}: scope`}>
                {c.scope.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              {c.projects.length > 0 && (
                <Thumbs class="chap-th" projects={c.projects} label={c.key === 'partnerships' ? 'Partnership-ready projects' : 'Shown in'} />
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* chapters */
  .chap {
    padding-block: calc(var(--sec) * 0.62);
  }
  .chap + .chap.tone-film {
    padding-top: calc(var(--sec) * 0.4);
  }
  .chap--bone {
    margin-top: calc(var(--sec) * 0.4);
    padding-block: var(--sec);
  }
  .chap-top,
  .chap-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 28px;
  }
  .chap-top {
    align-items: end;
  }
  .chap-t {
    grid-column: 1 / span 8;
  }
  .chap-a {
    grid-column: 9 / span 4;
  }
  .chap-span {
    display: flex;
    gap: 18px;
    margin-bottom: clamp(14px, 1.4vw, 22px);
  }
  .chap-n {
    font-size: clamp(44px, 6.2vw, 104px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.94;
    max-width: 15ch;
    text-wrap: balance;
  }
  .chap-line {
    font-size: clamp(18px, 1.4vw, 22px);
    line-height: 1.42;
    max-width: 34ch;
  }
  .chap-a :global(.chap-go) {
    margin-top: 24px;
  }
  .chap-g {
    margin-top: clamp(40px, 4.4vw, 72px);
    align-items: start;
  }
  .chap-scope {
    grid-column: 1 / span 6;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    counter-reset: sc;
  }
  .chap-scope li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 10px 0;
    font-size: clamp(20px, 2.15vw, 34px);
    line-height: 1.12;
    letter-spacing: -0.028em;
    color: var(--print);
  }
  .chap-scope li::before {
    counter-increment: sc;
    content: counter(sc);
    flex: none;
    width: 1.4em;
    font-size: 15px;
    font-weight: 500;
    color: var(--ash);
    font-variant-numeric: tabular-nums;
  }
  .chap--bone .chap-scope li {
    color: var(--ink);
  }
  .chap--bone .chap-scope li::before {
    color: var(--ink-soft);
  }
  .chap :global(.chap-th) {
    grid-column: 7 / span 6;
    padding-top: 12px;
  }
  @media (max-width: 900px) {
    .chap-t,
    .chap-a,
    .chap-scope,
    .chap :global(.chap-th) {
      grid-column: 1 / -1;
    }
    .chap :global(.chap-th .th-g) {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }
</style>
