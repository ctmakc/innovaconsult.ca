---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapHead from '../components/cap/CapHead.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatusTag from '../components/StatusTag.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Brief from '../components/cap/Brief.astro';
import CapNext from '../components/cap/CapNext.astro';
import { SHOT, RIDEAU_CREDIT } from '../components/cap/media';
import { visibleProjects, projectHref, type Project } from '../data/projects';
import { STAGES, type Span } from '../data/stages';

// Brand spelling and Canadian spelling for text that comes from shared project data.
const fix = (s: string) => s.replace(/FinMozg/g, 'FINMOZG').replace(/specialis/g, 'specializ');

const tracks: { name: string; span: Span; line: string; items: string[] }[] = [
  {
    name: 'Technology scouting',
    span: [0, 1],
    line: 'Finding what already exists before building anything new.',
    items: ['Emerging technologies', 'Existing technologies worth recombining', 'Open-source components', 'Research outputs ready for use', 'Potential technical partners']
  },
  {
    name: 'Applied R&D',
    span: [1, 2],
    line: 'Turning a hypothesis into evidence, fast and on a small budget.',
    items: ['A written hypothesis', 'Prototype', 'Experiments with real data', 'Validation with users', 'Technical feasibility', 'Business feasibility']
  },
  {
    name: 'Commercialization',
    span: [2, 5],
    line: 'Taking what worked to the people who will pay for it.',
    items: ['MVP', 'Market validation', 'Product architecture', 'Pilots with industry partners', 'Canadian market', 'International markets']
  }
];
const spanLabel = (s: Span) => (s[0] === s[1] ? STAGES[s[0]].label : `${STAGES[s[0]].label} → ${STAGES[s[1]].label}`);

const bench = visibleProjects.filter((p) => ['prototype', 'research', 'exploring'].includes(p.status));
const P = Object.fromEntries(bench.map((p) => [p.slug, p])) as Record<string, Project>;
const textOnly = bench.filter((p) => !['workflow-os', 'openfield'].includes(p.slug));

const funded = [
  'A written technical question and the uncertainty behind it.',
  'A starting point and a target for the work.',
  'Two or three milestones, each ending in something a reviewer can run.',
  'Measured results, including the experiments that failed.'
];

const publicSector = ['Digital services', 'Workflow automation', 'Knowledge systems', 'AI-assisted operations', 'Data platforms', 'Public-facing digital tools', 'R&D pilots', 'Technology modernization', 'Dual-use technology'];
---

<BaseLayout
  title="Applied R&D & Technology Commercialization | INNOVA"
  description="Applied R&D in Ottawa: technology scouting, fast prototypes, experiments with real data, feasibility answers and a path to market for new software and AI."
  path="/innovation"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'Innovation & R&D', path: '/innovation' }
  ]}
  cta={{ photo: 'festival' }}
  credits={[RIDEAU_CREDIT]}
>
  <CapHead
    crumb="Innovation & R&D"
    title="Applied R&D where technology creates new economic value."
    lede="Applied R&D at INNOVA is small, fast and evidence-first: a clear question, a working prototype and an honest answer about what to do next."
  >
    <MediaFrame
      slot="media"
      size="full"
      scrim="left"
      href={P.openfield ? projectHref(P.openfield) : '/projects/openfield'}
      world={{ src: '/img/field-robot.webp', src800: '/img/field-robot-800.webp', w: 1376, h: 768, pos: '50% 62%' }}
      aspectM="4 / 3.7"
      screens={[
        { ...SHOT.openfieldToday, l: '41%', t: '8%', width: '44%', lm: '5%', tm: '7%', wm: '72%' },
        { ...SHOT.openfieldPhone, kind: 'phone', l: '81.5%', t: '20%', width: '14%', lm: '69%', tm: '22%', wm: '26%', depth: 1.6 }
      ]}
    >
      <p class="in-k t-label">On the bench now</p>
      <StatusTag status="prototype" label="Prototype · demo data" class="in-tag" />
      <p class="in-n two-tone">OpenField<span class="d">Ag-robot fleet logbook</span></p>
      <p class="in-f">Field validation is planned for the 2027 season, with Ontario dealers and growers running robots from more than one manufacturer.</p>
      <span class="in-go t-label">Open the project <span class="ar" aria-hidden="true">→</span></span>
    </MediaFrame>
  </CapHead>

  <Brief
    text="INNOVA runs small, evidence-first applied R&D from Ottawa: a written hypothesis, a working prototype, experiments with real data and a technical and business feasibility answer. Work that passes moves to an MVP, pilots with industry partners and the Canadian market. On the bench now: OpenField, a prototype logbook for agricultural robot fleets, heading to field validation in 2027."
  />

  <!-- Three tracks -->
  <section class="tracks shell" aria-label="Three tracks">
    <ol class="tr-g">
      {
        tracks.map((t, i) => (
          <li class="tr frame">
            <p class="t-label t-mute tr-span">
              <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
              <span>{spanLabel(t.span)}</span>
            </p>
            <h2 class="tr-n" data-rise>{t.name}</h2>
            <p class="tr-line">{t.line}</p>
            <ul class="tr-items">
              {t.items.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Funded project, on bone -->
  <section class="fd tone-bone" id="funded" aria-labelledby="fd-h">
    <div class="shell">
      <div class="inset">
        <SectionHead id="fd-h" title="What a funded project with INNOVA looks like" lede="Four parts, written before the work starts and reported against when it ends." size="h2">
          <Button href="/contact?topic=rd" variant="ink" class="fd-cta">Discuss a project</Button>
        </SectionHead>
        <ol class="fd-g">
          {
            funded.map((f, i) => (
              <li>
                <span class="fd-n tnum">{i + 1}</span>
                <span class="fd-t">{f}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- On the bench -->
  <section class="bench shell" id="bench" aria-labelledby="bench-h">
    <div class="inset">
      <SectionHead id="bench-h" title="On the bench now." lede="Current research, prototypes and early explorations, each with its real status." link={{ href: '/projects', label: 'All projects' }} />
    </div>
    <div class="bench-g">
      {
        P['workflow-os'] && (
          <ProjectCard
            project={P['workflow-os']}
            statusLabel="Prototype · demo data"
            material="navy"
            fact="Online since 1 October 2026 as an invite-only demo with a fictional 30-person services firm and 15 mapped workflows."
            screens={[{ ...SHOT.wosMap, l: '7%', t: '10%', width: '86%', lm: '5%', tm: '10%', wm: '90%' }]}
          />
        )
      }
      {
        P.openfield && (
          <ProjectCard
            project={P.openfield}
            statusLabel="Prototype · demo data"
            material="loam"
            fact="Lab prototype tested on demo and simulated data. Field validation is planned for the 2027 growing season."
            screens={[{ ...SHOT.openfieldReport, l: '28%', t: '7%', width: '64%', lm: '10%', tm: '9%', wm: '84%' }]}
          />
        )
      }
      <ul class="bench-t">
        {
          textOnly.map((p) => (
            <li>
              <a class="bt frame" href={projectHref(p)}>
                <StatusTag status={p.status} />
                <span class="bt-n two-tone">
                  {fix(p.short)}
                  <span class="d">{fix(p.tagline ?? '')}</span>
                </span>
                <span class="bt-s">{fix(p.summary)}</span>
                <span class="bt-go t-label">
                  Open <span class="ar" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Public sector: Rideau Canal at night -->
  <section class="ps shell" id="public-sector" aria-labelledby="ps-h">
    <div class="ps-f frame" data-dolly-bg>
      <div class="ps-world" aria-hidden="true">
        <img src="/img/rideau-night.webp" srcset="/img/rideau-night-1200.webp 1200w, /img/rideau-night.webp 2400w" sizes="100vw" alt="" width="2400" height="1600" loading="lazy" decoding="async" />
      </div>
      <div class="ps-top">
        <h2 id="ps-h" class="t-display ps-h" data-rise>Public sector &amp; strategic innovation.</h2>
      </div>
      <div class="ps-b">
        <div class="ps-l">
          <p class="ps-p">
            Technology for complex operational environments. INNOVA is building its place in Canada’s public-sector and innovation ecosystem through innovation program applications, responses to public requests for information and
            proposals for joint R&amp;D.
          </p>
          <a href="/contact?topic=public-sector" class="lnk ps-k">Write to us about public-sector work <span class="ar" aria-hidden="true">→</span></a>
        </div>
        <ul class="ps-list" aria-label="Areas of public-sector work">
          {publicSector.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <CapNext current="rd" />
</BaseLayout>

<style>
  /* head frame caption */
  .in-k {
    margin-bottom: 18px;
    color: var(--ash);
  }
  :global(.in-tag) {
    margin-bottom: 14px;
  }
  .in-n {
    font-size: clamp(36px, 3.6vw, 64px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }
  .in-n .d {
    font-size: clamp(18px, 1.4vw, 22px);
    letter-spacing: 0;
    line-height: 1.3;
    margin-top: 8px;
  }
  .in-f {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ash);
    max-width: 40ch;
  }
  .in-go {
    display: inline-flex;
    gap: 10px;
    margin-top: 18px;
  }
  .in-go .ar {
    color: var(--flare);
    transition: transform 0.35s var(--e-out);
  }
  :global(a.mf:hover) .in-go .ar {
    transform: translateX(6px);
  }

  /* three tracks */
  .tracks {
    padding-bottom: var(--sec);
  }
  .tr-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 0.9vw, 14px);
  }
  .tr {
    display: flex;
    flex-direction: column;
    background: var(--reel);
    padding: clamp(24px, 2.6vw, 44px);
  }
  .tr:nth-child(2) {
    background: var(--reel-2);
  }
  .tr-span {
    display: flex;
    gap: 16px;
  }
  .tr-n {
    margin-top: clamp(28px, 4vw, 72px);
    font-size: clamp(34px, 3.4vw, 58px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .tr-line {
    margin-top: 16px;
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.42;
    max-width: 30ch;
  }
  .tr-items {
    list-style: none;
    margin: auto 0 0;
    padding: clamp(40px, 4vw, 72px) 0 0;
    display: grid;
    gap: 10px;
  }
  .tr-items li {
    font-size: 17px;
    line-height: 1.35;
    color: var(--ash);
  }

  /* funded */
  .fd {
    padding-block: var(--sec);
  }
  .fd :global(.fd-cta) {
    margin-top: 24px;
  }
  .fd-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px var(--col-gap);
  }
  .fd-g li {
    display: grid;
    align-content: start;
    gap: 18px;
  }
  .fd-n {
    font-size: clamp(64px, 6.4vw, 112px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.82;
  }
  .fd-t {
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }

  /* bench */
  .bench {
    padding-top: var(--sec);
  }
  .bench-g {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .bench-t {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.2vw, 18px);
  }
  .bt {
    display: grid;
    gap: 16px;
    height: 100%;
    align-content: start;
    background: var(--reel);
    padding: clamp(24px, 2.6vw, 44px);
    text-decoration: none;
  }
  .bt-n {
    margin-top: 10px;
    font-size: clamp(30px, 2.8vw, 46px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .bt-n .d {
    font-size: 18px;
    letter-spacing: 0;
    margin-top: 8px;
  }
  .bt-s {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
    max-width: 52ch;
  }
  .bt-go {
    display: inline-flex;
    gap: 10px;
  }
  .bt-go .ar {
    transition: transform 0.35s var(--e-out);
  }
  .bt:hover {
    background: var(--reel-2);
  }
  .bt:hover .bt-go .ar {
    transform: translateX(6px);
  }

  /* public sector band */
  .ps {
    padding-top: var(--sec);
  }
  .ps-f {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(64px, 12vw, 220px);
    min-height: min(980px, 112vh);
    padding: clamp(40px, 6vw, 96px) clamp(16px, 2vw, 28px) clamp(16px, 2vw, 28px);
  }
  .ps-world {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .ps-world img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .ps-f::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(13 12 11 / 0.82) 0%, rgb(13 12 11 / 0.3) 36%, rgb(13 12 11 / 0.2) 60%, rgb(13 12 11 / 0.6) 100%);
  }
  .ps-top {
    padding-inline: clamp(4px, 2vw, 36px);
  }
  .ps-h {
    max-width: 13ch;
  }
  .ps-b {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 40px;
    padding: clamp(24px, 3vw, 48px) clamp(20px, 2.4vw, 40px);
    background: var(--film);
    border-radius: var(--r);
  }
  .ps-l {
    grid-column: 1 / span 5;
  }
  .ps-p {
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.45;
    max-width: 44ch;
  }
  .ps-k {
    margin-top: 24px;
  }
  .ps-list {
    grid-column: 7 / span 6;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
  }
  .ps-list li {
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .ps-list li:not(:last-child)::after {
    content: '/';
    margin: 0 0.45em;
    font-weight: 400;
    color: var(--ash);
  }

  @media (max-width: 1100px) {
    .fd-g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .tr-g,
    .bench-g,
    .bench-t {
      grid-template-columns: 1fr;
    }
    .tr {
      min-height: 0;
    }
    .ps-l,
    .ps-list {
      grid-column: 1 / -1;
    }
    .ps-f {
      min-height: 0;
    }
  }
  @media (max-width: 520px) {
    .fd-g {
      grid-template-columns: 1fr;
    }
    .ps-b {
      padding-inline: 18px;
    }
  }
</style>
