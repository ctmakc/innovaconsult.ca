---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusTag from '../components/StatusTag.astro';
import { WOS3 } from '../data/wos3';

// Round 5: about four desktop screens. The method is four merged steps (the module screens live on
// /workflow-os); the autonomy scale is one labelled axis; the timelines, what we need, what you keep
// and security keep every fact. One closing line (BaseLayout cta), no photo band.
const R = WOS3.route;
const RM = WOS3.m_route;

// Four steps: the seven method steps of round 4, merged without dropping a fact.
const steps: { t: string; d: string }[] = [
  { t: 'Map', d: 'We map departments, roles, systems, documents and the processes that connect them, with volumes and pain points. That map is the baseline.' },
  { t: 'Score and choose', d: 'Each process is scored for value, feasibility and strategic fit, minus a risk penalty, and every score shows the reasons behind it. We rank by value and feasibility and agree on the first two or three to act on.' },
  { t: 'Design and build', d: 'For each chosen process we pick the simplest approach that works, from deterministic software to supervised agents, and build, integrate and test it inside the tools your team already uses. Approvals, permissions, audit trails and data controls are designed in from the first sprint.' },
  { t: 'Measure', d: 'We compare cycle time, cost, error rate and adoption against the baseline taken during discovery.' }
];

const approaches: { t: string; d: string; ex?: { name: string; href: string } }[] = [
  { t: 'Deterministic software', d: 'Rules are clear and stable. Plain code is cheaper, faster and fully predictable.' },
  { t: 'Conventional automation', d: 'Data moves between known systems on known triggers.' },
  { t: 'AI assistant', d: 'People stay in charge; AI drafts, summarizes and looks things up.' },
  { t: 'AI agent', d: 'A bounded task with tools, permissions and a person who approves the result.', ex: { name: 'AICRMIUS', href: '/projects/aicrmius' } },
  { t: 'Multi-agent workflow', d: 'Several specialized agents hand work to each other under one supervisor.' },
  { t: 'Human-in-the-loop system', d: 'High-stakes steps always pass through a named person before they take effect.', ex: { name: 'AICRMIUS', href: '/projects/aicrmius' } }
];
const cycle = ['Propose', 'Validate', 'Approve', 'Apply', 'Undo'];

// key: the time or scope stated in the step's own description.
const engagement: { t: string; key: string; d: string }[] = [
  { t: 'Opportunity assessment', key: 'Fixed scope', d: 'You get a process inventory, a scored opportunity register, technology options for each process, a privacy and security constraint map and a sequenced roadmap.' },
  { t: 'Proof of concept on your historical data', key: '~3 weeks', d: 'About three weeks. It answers the feasibility question before any build budget is committed.' },
  { t: 'Single-process pilot', key: '12–15 weeks', d: 'From discovery to a supported production process. Measured results arrive 4 to 6 weeks after go-live.' },
  { t: 'Support', key: 'Monthly', d: 'Monitoring, fixes, model-version regression tests and small improvements.' }
];

const security = [
  [
    'Where your data lives',
    'By default we build inside your own cloud tenant, for example Microsoft 365 and Azure in Canada Central or Canada East, under your licences. Data, backups and logs stay in your environment, and INNOVA keeps no copy. If a service you need runs only outside Canada, we say so at design stage. Data leaves Canada only with your written approval.'
  ],
  ['Access', 'We work under accounts you issue, time-limited and least-privilege, and you revoke them when the engagement ends.'],
  ['Models', 'Your data is never used to train or fine-tune a model. Model versions are pinned, and a version change is retested before it goes live.'],
  ['Documents are data', 'Instructions hidden in a document are treated as text. Agent tools are allow-listed step by step.'],
  ['Human approval', 'Any action that changes a record or affects a person passes a named approver, and every step is logged.'],
  ['Privacy review', 'Where personal information is involved, a privacy impact assessment is planned into the pilot from the start.']
];
const [secLead, ...secRest] = security;
---

<BaseLayout
  title="AI Transformation & Automation in Ottawa | INNOVA"
  description="Process-first AI transformation: INNOVA maps how work happens, scores where automation pays, builds the simplest fit with governance and measures results."
  path="/ai-transformation"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'AI Transformation', path: '/ai-transformation' }
  ]}
  cta={{
    title: 'Send us the process that takes the most hours.',
    lede: 'We reply in writing with whether and how we would start.',
    link: { href: '/workflow-os', label: 'See AI Workflow OS' }
  }}
>
  <!-- ═══ HEAD: the statement, then the automation route with its human approval gate ═══ -->
  <section class="ah shell" aria-labelledby="ah-h" data-hero>
    <div class="inset">
      <p class="t-label ah-crumb"><a href="/">INNOVA</a><span aria-hidden="true">/</span><a href="/capabilities">Capabilities</a><span aria-hidden="true">/</span><span>AI Transformation</span></p>
      <div class="ah-g">
      <div class="ah-txt">
      <h1 id="ah-h" class="ah-t">AI transformation means redesigning how work happens.</h1>
      <p class="ah-l">Companies often add AI tools one at a time, with no map of the processes underneath. We start from that map, so every automation has an owner, a reason and a number to beat.</p>
      </div>
      <figure class="ah-m">
        <a class="ah-plate" href="/workflow-os" aria-label="INNOVA AI Workflow OS: open the product page">
          <picture>
            <source media="(max-width: 900px)" srcset={RM.srcset} sizes="100vw" width={RM.w} height={RM.h} />
            <img src={R.src} srcset={R.srcset} sizes="(max-width: 900px) 100vw, 56vw" alt={R.alt} width={R.w} height={R.h} decoding="async" fetchpriority="high" style={`background-image:url(${R.lqip})`} />
          </picture>
        </a>
        <figcaption class="ah-cap">
          <p class="ah-n two-tone">INNOVA AI Workflow OS<span class="d">The method runs on our own product. On screen: an automation route where the KYC decision stays with a person.</span></p>
          <p class="ah-f"><StatusTag status="prototype" label="Prototype · demo data, fictional firm" /></p>
          <a class="lnk ah-go" href="/workflow-os">Explore Workflow OS <span class="ar" aria-hidden="true">→</span></a>
        </figcaption>
      </figure>
      </div>
    </div>
  </section>

  <!-- ═══ METHOD: four steps, one baseline ═══ -->
  <section class="mt shell" id="method" aria-labelledby="mt-h">
    <div class="inset">
      <h2 id="mt-h" class="t-h2 mt-h" data-rise>Four steps, one baseline.</h2>
      <p class="t-copy mt-brief">
        INNOVA is an Ottawa company that plans and builds AI automation for organizations in Canada. Each process gets the simplest approach that fits, from plain software to a supervised AI agent, and results are reported against the baseline.
      </p>
      <ol class="mt-g">
        {
          steps.map((x) => (
            <li class="mt-s">
              <h3 class="mt-t">{x.t}</h3>
              <p class="mt-d">{x.d}</p>
            </li>
          ))
        }
      </ol>
      <a class="lnk mt-go" href="/workflow-os#module-1">Each step as a Workflow OS screen <span class="ar" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ═══ THE RIGHT TOOL (bone): one labelled axis, then the agent cycle ═══ -->
  <section class="ap tone-bone" aria-labelledby="ap-h">
    <div class="shell">
      <div class="inset">
        <h2 id="ap-h" class="t-h2 ap-h" data-rise>The right tool for each process.</h2>
        <p class="t-copy ap-lede">We use AI where it earns its place. When ordinary software does the job better, we build ordinary software, and say so.</p>
        <div class="ax">
          <p class="ax-ends" aria-hidden="true"><span>Fully predictable</span><span>Supervised autonomy</span></p>
          <ol class="ax-g" aria-label="Approaches, from fully predictable to supervised autonomy">
            {
              approaches.map((a) => (
                <li class="ax-i">
                  <h3 class="ax-t">{a.t}</h3>
                  <p class="ax-d">{a.d}</p>
                  {a.ex && (
                    <a class="lnk ax-ex" href={a.ex.href}>
                      {a.ex.name} <span class="ar" aria-hidden="true">→</span>
                    </a>
                  )}
                </li>
              ))
            }
          </ol>
        </div>

        <div class="ag" id="agents">
          <h3 class="ag-h">How we build AI agents</h3>
          <p class="ag-cy" aria-label="AICRMIUS agent cycle: propose, validate, approve, apply, undo">
            {cycle.map((c, i) => <span class:list={['ag-w', { last: i === cycle.length - 1 }]}>{c}{i < cycle.length - 1 && <i aria-hidden="true">→</i>}</span>)}
          </p>
          <p class="t-copy ag-p">
            Each INNOVA agent gets a bounded task, named tools and permissions, and a person who approves its output. In <a class="ag-a" href="/projects/aicrmius">AICRMIUS</a>, agents follow that cycle with every step in an audit trail. In <a class="ag-a" href="/projects/finmozg">FINMOZG</a>, deterministic accounting engines keep the ledger correct, and every posting lands in a hash-chained audit log.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ENGAGEMENT (film): four timelines, then what we need and what you keep ═══ -->
  <section class="en shell" id="engagement" aria-labelledby="en-h">
    <div class="inset">
      <div class="en-hd">
        <h2 id="en-h" class="t-h2" data-rise>How a Workflow OS project runs</h2>
        <p class="t-copy en-lede">Each step runs on <a class="ag-a" href="/workflow-os">INNOVA AI Workflow OS</a> and ends in a result you can review before the next one is agreed.</p>
      </div>
      <ol class="en-g">
        {
          engagement.map((e) => (
            <li class="en-i">
              <p class="en-key">{e.key}</p>
              <h3 class="en-t">{e.t}</h3>
              <p class="en-d">{e.d}</p>
            </li>
          ))
        }
      </ol>
      <p class="en-cav">Timelines are for one bounded process. Integration, the number of exceptions, privacy review depth and data readiness move them most.</p>
      <div class="en-b">
        <div class="en-need">
          <h3 class="en-bh">What we need from you</h3>
          <p class="t-copy">
            A process owner and two or three of the people who do the work, about 2 to 4 hours each during discovery; one 3-hour workshop; 4 to 8 hours of acceptance testing; real sample transactions, including the awkward ones; and a named person inside your company who owns the automation.
          </p>
        </div>
        <div class="en-keep">
          <h3 class="en-bh">What you keep</h3>
          <p class="en-keep-t">Licences stay in your name and your tenant. You own the output.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SECURITY (bone) ═══ -->
  <section class="sc tone-bone" id="security" aria-labelledby="sc-h">
    <div class="shell">
      <div class="inset sc-g">
        <div class="sc-l">
          <h2 id="sc-h" class="t-h2" data-rise>Security and your data</h2>
          <h3 class="sc-lt">{secLead[0]}</h3>
          <p class="sc-ld">{secLead[1]}</p>
        </div>
        <dl class="sc-r">
          {
            secRest.map(([t, d]) => (
              <div class="sc-i">
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <p class="inset sc-more">
        Other capabilities: <a href="/innovation">Innovation &amp; R&amp;D</a>, <a href="/software">Software &amp; Products</a>, <a href="/capabilities">all four on one page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── head ── */
  .ah {
    padding-top: clamp(28px, 3.4vw, 56px);
  }
  .ah-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--ash);
  }
  .ah-crumb a {
    color: var(--print);
    text-decoration: none;
  }
  .ah-crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ah-g {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(32px, 4vw, 72px);
    align-items: center;
    margin-top: clamp(28px, 3vw, 48px);
  }
  .ah-t {
    max-width: 13ch;
    font-size: clamp(42px, 4.4vw, 72px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.96;
    text-wrap: balance;
  }
  .ah-l {
    margin-top: clamp(20px, 2vw, 28px);
    max-width: 52ch;
    font-size: clamp(19px, 1.45vw, 22px);
    line-height: 1.45;
    color: var(--copy);
  }
  .ah-m {
    margin: 0;
  }
  .ah-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    margin-top: 18px;
  }
  .ah-cap .ah-n {
    flex: 1 1 100%;
  }
  .ah-plate {
    display: block;
    padding: clamp(14px, 1.8vw, 28px);
    border-radius: var(--r);
    background: var(--ui-dark);
    box-shadow: 0 0 0 1px var(--rule-film);
  }
  .ah-plate img {
    width: 100%;
    background-size: 100% 100%;
    transition: transform 0.55s var(--e-out);
  }
  .ah-plate:hover img {
    transform: translateY(-4px);
  }
  .ah-n {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .ah-n .d {
    margin-top: 4px;
    font-weight: 400;
    font-size: 17px;
    letter-spacing: 0;
    line-height: 1.45;
    color: var(--copy);
  }


  /* ── method ── */
  .mt {
    padding-top: var(--sec);
  }
  .mt-h {
    max-width: 16ch;
  }
  .mt-brief {
    margin-top: 22px;
    max-width: 64ch;
  }
  .mt-g {
    list-style: none;
    margin: clamp(36px, 4vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 3.4vw, 48px) clamp(32px, 5vw, 96px);
    max-width: 1180px;
  }
  .mt-t {
    font-size: clamp(24px, 2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .mt-d {
    margin-top: 10px;
    font-size: var(--fs-copy);
    line-height: 1.55;
    color: var(--copy);
    max-width: 52ch;
  }
  .mt-go {
    margin-top: clamp(32px, 3vw, 44px);
    font-size: 17px;
  }

  /* ── the right tool (bone): one axis ── */
  .ap {
    margin-top: var(--sec);
    padding-block: calc(var(--sec) * 0.72);
  }
  .ap-h {
    max-width: 16ch;
  }
  .ap-lede {
    margin-top: 20px;
    max-width: 56ch;
  }
  .ax {
    margin-top: clamp(40px, 4vw, 64px);
  }
  .ax-ends {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .ax-g {
    position: relative;
    list-style: none;
    margin: 12px 0 0;
    padding: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--col-gap);
    border-top: 2px solid var(--ink);
  }
  /* the line is the scale; each approach hangs from its tick */
  .ax-i {
    position: relative;
  }
  .ax-i::before {
    content: '';
    position: absolute;
    left: 0;
    top: -36px;
    width: 2px;
    height: 16px;
    background: var(--ink);
  }
  .ax-t {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }
  .ax-d {
    margin-top: 8px;
    font-size: 17px;
    line-height: 1.45;
    color: var(--copy-ink);
  }
  .ax-ex {
    margin-top: 10px;
    font-size: 16px;
    color: var(--ink);
  }
  .ag {
    margin-top: clamp(56px, 6vw, 96px);
  }
  .ag-h {
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
  }
  .ag-cy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 0;
    margin-top: 12px;
    font-size: clamp(34px, 4vw, 66px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--ink);
  }
  .ag-w i {
    font-style: normal;
    margin: 0 0.32em;
    color: var(--ink-soft);
    font-weight: 400;
  }
  .ag-w.last {
    color: var(--flare-ink);
  }
  .ag-p {
    margin-top: 22px;
    max-width: 64ch;
  }
  .ag-a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* ── engagement (film) ── */
  .en {
    padding-top: calc(var(--sec) * 0.6);
  }
  .en-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 18px;
    margin-bottom: clamp(40px, 4vw, 64px);
  }
  .en-hd .t-h2 {
    grid-column: 1 / span 8;
  }
  .en-lede {
    grid-column: 1 / span 7;
  }
  .en-lede .ag-a {
    color: var(--print);
  }
  .en-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px var(--col-gap);
  }
  .en-i {
    padding: clamp(22px, 2vw, 32px);
    border-radius: var(--r);
    background: var(--reel);
  }
  .en-key {
    font-size: clamp(30px, 2.8vw, 46px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
    white-space: nowrap;
  }
  .en-t {
    margin-top: 18px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
  }
  .en-d {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--copy);
  }
  .en-cav {
    margin-top: 20px;
    max-width: 72ch;
    font-size: 16px;
    color: var(--ash);
  }
  .en-b {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 32px;
    margin-top: clamp(32px, 3.4vw, 56px);
    align-items: end;
  }
  .en-need {
    grid-column: 1 / span 6;
  }
  .en-bh {
    margin-bottom: 12px;
    font-size: 17px;
    font-weight: 600;
    color: var(--print);
  }
  .en-keep {
    grid-column: 8 / span 5;
  }
  .en-keep-t {
    font-size: clamp(28px, 2.6vw, 44px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.06;
  }

  /* ── security (bone) ── */
  .sc {
    margin-top: calc(var(--sec) * 0.6);
    padding-block: calc(var(--sec) * 0.6) calc(var(--sec) * 0.32);
  }
  .sc-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 40px;
    align-items: start;
  }
  .sc-l {
    grid-column: 1 / span 5;
  }
  .sc-lt {
    margin-top: clamp(28px, 3vw, 48px);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    letter-spacing: -0.022em;
  }
  .sc-ld {
    margin-top: 12px;
    font-size: clamp(18px, 1.35vw, 21px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 46ch;
  }
  .sc-r {
    grid-column: 7 / span 6;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 44px) var(--col-gap);
    padding-top: 10px;
  }
  .sc-i dt {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
  }
  .sc-i dd {
    margin: 8px 0 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--copy-ink);
  }
  .sc-more {
    margin-top: clamp(40px, 4vw, 64px);
    font-size: 17px;
    color: var(--copy-ink);
  }
  .sc-more a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }


  @media (max-width: 1100px) {
    .en-g {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ax-g {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (max-width: 900px) {
    .ah-g {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
    .ah-plate {
      margin-inline: calc(var(--in) * -1 - var(--gut));
      padding: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .ah-plate img {
      width: 100%;
    }
    .mt-g {
      grid-template-columns: 1fr;
    }
    .ax-g {
      grid-template-columns: 1fr;
      row-gap: 26px;
      border-top: 0;
      border-left: 2px solid var(--ink);
      padding: 0 0 0 22px;
    }
    .ax-i::before {
      left: -22px;
      top: 9px;
      width: 14px;
      height: 2px;
    }
    .ax-ends {
      flex-direction: column;
      gap: 4px;
    }
    .en-g {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .en-hd .t-h2,
    .en-lede,
    .en-need,
    .en-keep,
    .sc-l,
    .sc-r {
      grid-column: 1 / -1;
    }
    .sc-r {
      grid-template-columns: 1fr;
    }
    .en-key {
      white-space: normal;
    }
  }
</style>
