---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapHead from '../components/cap/CapHead.astro';
import StatusTag from '../components/StatusTag.astro';
import { WOS2, type Shot } from '../components/projects/shots';
import { STAGES } from '../data/stages';

// Round 4: one page of ≤ 7 desktop screens with ONE closing CTA (the band from BaseLayout).
// Workflow OS screens are 2x crops of the redesigned product UI; each method step points at one.
const SCREENS: (Shot & { cap: string; pos: string })[] = [
  { ...WOS2.landscape, cap: 'Process landscape: every mapped workflow, sized by staff hours and coloured by priority.', pos: '0% 40%' },
  { ...WOS2.score, cap: 'Priority score: each factor of the 88 is visible, down to the risk penalty.', pos: '0% 50%' },
  { ...WOS2.route, cap: 'Automation route: twelve steps, with the KYC decision held at a human approval gate.', pos: '78% 80%' },
  { ...WOS2.beforeAfter, cap: 'Business case: staff hours before and after, on one scale, against the discovery baseline.', pos: '0% 0%' }
];

// Seven method steps, each mapped to the master stage line and to the Workflow OS module that carries it.
const steps: { t: string; d: string; stage: number; module: [number, string]; screen: number }[] = [
  { t: 'Process discovery', d: 'We map departments, roles, systems, documents and the processes that connect them, with volumes and pain points.', stage: 0, module: [1, 'Process discovery'], screen: 0 },
  { t: 'Opportunity mapping', d: 'Each process is scored for value, feasibility and strategic fit, minus a risk penalty. Every score shows the reasons behind it.', stage: 0, module: [2, 'Automation opportunity map'], screen: 1 },
  { t: 'Prioritization', d: 'We rank opportunities by value and feasibility and agree on the first two or three to act on.', stage: 0, module: [2, 'Automation opportunity map'], screen: 1 },
  { t: 'Solution architecture', d: 'For each chosen process we pick the simplest approach that works, from deterministic software to supervised agents.', stage: 1, module: [3, 'Automation designer'], screen: 2 },
  { t: 'Implementation', d: 'We build, integrate and test inside the tools your team already uses.', stage: 3, module: [4, 'Implementation workspace'], screen: 2 },
  { t: 'Governance', d: 'Approvals, permissions, audit trails and data controls are designed in from the first sprint.', stage: 4, module: [4, 'Implementation workspace'], screen: 2 },
  { t: 'Measurement', d: 'We compare cycle time, cost, error rate and adoption against the baseline taken during discovery.', stage: 5, module: [5, 'Impact & ROI'], screen: 3 }
];

const outcomes = ['shorter cycle time', 'fewer repetitive tasks', 'lower operating cost', 'faster response to clients', 'visibility into every process', 'better-informed decisions', 'fewer manual errors'];

const approaches: { t: string; d: string; ex?: { name: string; href: string } }[] = [
  { t: 'Deterministic software', d: 'Rules are clear and stable. Plain code is cheaper, faster and fully predictable.' },
  { t: 'Conventional automation', d: 'Data moves between known systems on known triggers.' },
  { t: 'AI assistant', d: 'People stay in charge; AI drafts, summarizes and looks things up.' },
  { t: 'AI agent', d: 'A bounded task with tools, permissions and a person who approves the result.', ex: { name: 'AICRMIUS', href: '/projects/aicrmius' } },
  { t: 'Multi-agent workflow', d: 'Several specialized agents hand work to each other under one supervisor.' },
  { t: 'Human-in-the-loop system', d: 'High-stakes steps always pass through a named person before they take effect.', ex: { name: 'AICRMIUS', href: '/projects/aicrmius' } }
];
const cycle = ['Propose', 'Validate', 'Approve', 'Apply', 'Undo'];

// key: the time or scope stated in the step's own description.
const engagement: { t: string; key: string; d: string }[] = [
  { t: 'Opportunity assessment', key: 'Fixed scope', d: 'You get a process inventory, a scored opportunity register, technology options for each process, a privacy and security constraint map and a sequenced roadmap.' },
  { t: 'Proof of concept on your historical data', key: '~3 weeks', d: 'About three weeks. It answers the feasibility question before any build budget is committed.' },
  { t: 'Single-process pilot', key: '12–15 weeks', d: 'From discovery to a supported production process. Measured results arrive 4 to 6 weeks after go-live.' },
  { t: 'Support', key: 'Monthly', d: 'Monitoring, fixes, model-version regression tests and small improvements.' }
];

const security = [
  [
    'Where your data lives',
    'By default we build inside your own cloud tenant, for example Microsoft 365 and Azure in Canada Central or Canada East, under your licences. Data, backups and logs stay in your environment, and INNOVA keeps no copy. If a service you need runs only outside Canada, we say so at design stage. Data leaves Canada only with your written approval.'
  ],
  ['Access', 'We work under accounts you issue, time-limited and least-privilege, and you revoke them when the engagement ends.'],
  ['Models', 'Your data is never used to train or fine-tune a model. Model versions are pinned, and a version change is retested before it goes live.'],
  ['Documents are data', 'Instructions hidden in a document are treated as text. Agent tools are allow-listed step by step.'],
  ['Human approval', 'Any action that changes a record or affects a person passes a named approver, and every step is logged.'],
  ['Privacy review', 'Where personal information is involved, a privacy impact assessment is planned into the pilot from the start.']
];
const [secLead, ...secRest] = security;
---

<BaseLayout
  title="AI Transformation & Automation in Ottawa | INNOVA"
  description="Process-first AI transformation: INNOVA maps how work happens, scores where automation pays, builds the simplest fit with governance and measures results."
  path="/ai-transformation"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'AI Transformation', path: '/ai-transformation' }
  ]}
  cta={{
    title: 'Send us the process that takes the most hours.',
    lede: 'We reply in writing with whether and how we would start.',
    link: { href: '/workflow-os', label: 'See AI Workflow OS' }
  }}
>
  <CapHead
    crumb="AI Transformation"
    title="AI transformation means redesigning how work happens."
    lede="Companies often add AI tools one at a time, with no map of the processes underneath. We start from that map, so every automation has an owner, a reason and a number to beat."
  >
    <figure slot="media" class="ai-m">
      <a class="ai-plate" href="/workflow-os" aria-label="INNOVA AI Workflow OS: open the product page">
        <picture>
          <source media="(max-width: 900px)" srcset="/proof/wos2/m-route@2x.webp" width="764" height="680" />
          <img class="scr-img scr-dark" src={WOS2.route.src} srcset={WOS2.route.srcset} sizes="72vw" alt={WOS2.route.alt} width={WOS2.route.w} height={WOS2.route.h} decoding="async" fetchpriority="high" />
        </picture>
      </a>
      <figcaption class="ai-cap">
        <p class="ai-n two-tone">INNOVA AI Workflow OS<span class="d">The method runs on our own product</span></p>
        <p class="ai-f"><StatusTag status="prototype" label="Prototype · illustrative demo data" /></p>
        <a class="lnk ai-go" href="/workflow-os">Explore Workflow OS <span class="ar" aria-hidden="true">→</span></a>
      </figcaption>
    </figure>
  </CapHead>

  <!-- ═══ METHOD (film): seven steps beside the Workflow OS screen that carries each one ═══ -->
  <section class="mt shell" id="method" aria-labelledby="mt-h">
    <div class="inset">
      <div class="mt-hd">
        <h2 id="mt-h" class="t-h2" data-rise>Seven steps, one baseline.</h2>
        <p class="t-copy mt-brief">
          INNOVA is an Ottawa company that plans and builds AI automation for organizations in Canada. Work starts with a map of real processes and a measured baseline. Each process then gets the simplest approach that fits, from plain software to a supervised AI agent, with approvals and audit trails built in, and results are reported against that baseline.
        </p>
      </div>
      <div class="mt-g">
        <ol class="mt-steps">
          {
            steps.map((s, i) => (
              <li class:list={['mt-s', { on: i === 0 }]} data-step={i} data-screen={s.screen}>
                <span class="mt-n tnum">{i + 1}</span>
                <div>
                  <h3 class="mt-t">{s.t}</h3>
                  <p class="mt-d">{s.d}</p>
                  <p class="mt-m">{`${STAGES[s.stage].label} · Module ${s.module[0]}, ${s.module[1]}`}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="mt-r">
          <div class="mt-stack">
            {SCREENS.map((sc, i) => <img class:list={['scr-img scr-dark', { on: i === 0 }]} src={sc.src} srcset={sc.srcset} sizes="(max-width: 900px) 200vw, 62vw" alt={sc.alt} width={sc.w} height={sc.h} loading="lazy" decoding="async" style={`--pos:${sc.pos}`} />)}
          </div>
          <div class="mt-caps" aria-hidden="true">
            {SCREENS.map((sc, i) => <p class:list={['mt-c', { on: i === 0 }]}>{sc.cap}</p>)}
          </div>
          <p class="mt-disc">Illustrative demo data: Northstar Professional Services is a fictional firm.</p>
        </div>
      </div>
      <p class="mt-out">
        <span class="mt-out-k">Agreed before the build, reported against the baseline:</span>{' '}
        {outcomes.map((o, i) => <><span class="mt-o">{o}{i < outcomes.length - 1 ? ',' : '.'}</span>{' '}</>)}
      </p>
    </div>
  </section>

  <!-- ═══ THE RIGHT TOOL (bone): an autonomy scale, then the agent cycle as one line ═══ -->
  <section class="ap tone-bone" aria-labelledby="ap-h">
    <div class="shell">
      <div class="inset">
        <h2 id="ap-h" class="t-h2 ap-h" data-rise>The right tool for each process.</h2>
        <p class="t-copy ap-lede">We use AI where it earns its place. When ordinary software does the job better, we build ordinary software, and say so.</p>
        <ol class="ap-g" aria-label="Approaches, from fully predictable to supervised autonomy">
          {
            approaches.map((a, i) => (
              <li class="ap-i" style={`--k:${i + 1}`}>
                <span class="ap-bar" aria-hidden="true" />
                <h3 class="ap-t">{a.t}</h3>
                <p class="ap-d">{a.d}</p>
                {a.ex && (
                  <a class="lnk ap-ex" href={a.ex.href}>
                    {a.ex.name} <span class="ar" aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            ))
          }
        </ol>
        <p class="ap-scale" aria-hidden="true"><span>Fully predictable</span><span>Supervised autonomy</span></p>

        <div class="ag" id="agents">
          <h3 class="ag-h">How we build AI agents</h3>
          <p class="ag-cy" aria-label="AICRMIUS agent cycle: propose, validate, approve, apply, undo">
            {cycle.map((c, i) => <span class:list={['ag-w', { last: i === cycle.length - 1 }]}>{c}{i < cycle.length - 1 && <i aria-hidden="true">→</i>}</span>)}
          </p>
          <p class="t-copy ag-p">
            Each INNOVA agent gets a bounded task, named tools and permissions, and a person who approves its output. In <a class="ag-a" href="/projects/aicrmius">AICRMIUS</a>, agents follow that cycle with every step in an audit trail. In <a class="ag-a" href="/projects/finmozg">FINMOZG</a>, deterministic accounting engines keep the ledger correct, and every posting lands in a hash-chained audit log.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ENGAGEMENT (film): four steps, keys first ═══ -->
  <section class="en shell" id="engagement" aria-labelledby="en-h">
    <div class="inset">
      <div class="en-hd">
        <h2 id="en-h" class="t-h2" data-rise>How a Workflow OS project runs</h2>
        <p class="t-copy en-lede">Each step runs on <a class="ag-a" href="/workflow-os">INNOVA AI Workflow OS</a> and ends in a result you can review before the next one is agreed.</p>
      </div>
      <ol class="en-g">
        {
          engagement.map((e) => (
            <li class="en-i">
              <p class="en-key">{e.key}</p>
              <h3 class="en-t">{e.t}</h3>
              <p class="en-d">{e.d}</p>
            </li>
          ))
        }
      </ol>
      <p class="en-cav">Timelines are for one bounded process. Integration, the number of exceptions, privacy review depth and data readiness move them most.</p>
      <div class="en-b">
        <div class="en-need">
          <h3 class="en-bh">What we need from you</h3>
          <p class="t-copy">
            A process owner and two or three of the people who do the work, about 2 to 4 hours each during discovery; one 3-hour workshop; 4 to 8 hours of acceptance testing; real sample transactions, including the awkward ones; and a named person inside your company who owns the automation.
          </p>
        </div>
        <div class="en-keep">
          <h3 class="en-bh">What you keep</h3>
          <p class="en-keep-t">Licences stay in your name and your tenant. You own the output.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SECURITY (bone) ═══ -->
  <section class="sc tone-bone" id="security" aria-labelledby="sc-h">
    <div class="shell">
      <div class="inset sc-g">
        <div class="sc-l">
          <h2 id="sc-h" class="t-h2" data-rise>Security and your data</h2>
          <h3 class="sc-lt">{secLead[0]}</h3>
          <p class="sc-ld">{secLead[1]}</p>
        </div>
        <dl class="sc-r">
          {
            secRest.map(([t, d]) => (
              <div class="sc-i">
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <p class="inset sc-more">
        Other capabilities: <a href="/innovation">Innovation &amp; R&amp;D</a>, <a href="/software">Software &amp; Products</a>, <a href="/capabilities">all four on one page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Method: the step nearest the middle of the screen picks the Workflow OS screen and its caption.
  const steps = document.querySelectorAll<HTMLElement>('.mt-s');
  const shots = document.querySelectorAll<HTMLElement>('.mt-stack img');
  const caps = document.querySelectorAll<HTMLElement>('.mt-c');
  const set = (i: number) => {
    const sc = Number(steps[i]?.dataset.screen ?? 0);
    steps.forEach((s, j) => s.classList.toggle('on', j === i));
    shots.forEach((s, j) => s.classList.toggle('on', j === sc));
    caps.forEach((s, j) => s.classList.toggle('on', j === sc));
  };
  if ('IntersectionObserver' in window && steps.length) {
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set(Number((e.target as HTMLElement).dataset.step))), { rootMargin: '-46% 0px -44% 0px' });
    steps.forEach((s) => io.observe(s));
  }
</script>

<style>
  /* ── head media: one readable screen on a navy plate, caption beside it ── */
  .ai-m {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 24px;
    align-items: end;
  }
  .ai-plate {
    grid-column: 1 / span 9;
    grid-row: 1;
    display: block;
    padding: clamp(14px, 2vw, 32px);
    border-radius: var(--r);
    background: radial-gradient(120% 100% at 30% 15%, color-mix(in srgb, var(--m-navy) 75%, var(--print) 10%) 0%, var(--m-navy) 55%, color-mix(in srgb, var(--m-navy) 60%, var(--film)) 100%);
  }
  .ai-plate picture {
    display: block;
  }
  .ai-plate img {
    width: 100%;
    transition: transform 0.55s var(--e-out);
  }
  .ai-plate:hover img {
    transform: translateY(-6px);
  }
  .ai-cap {
    grid-column: 10 / span 3;
    grid-row: 1;
    padding-bottom: 6px;
  }
  .ai-n {
    font-size: clamp(26px, 2vw, 34px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .ai-n .d {
    margin-top: 10px;
    font-size: var(--fs-copy);
    letter-spacing: 0;
    line-height: 1.35;
  }
  .ai-f {
    margin-top: 16px;
  }
  .ai-go {
    margin-top: 18px;
  }
  .ai-go .ar {
    color: var(--flare);
  }

  /* ── method (film) ── */
  .mt {
    padding-top: calc(var(--sec) * 0.6);
  }
  .mt-hd {
    max-width: 980px;
    margin-bottom: clamp(32px, 3.4vw, 52px);
  }
  .mt-brief {
    margin-top: 22px;
    max-width: 66ch;
  }
  .mt-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: start;
  }
  .mt-steps {
    grid-column: 1 / span 4;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mt-s {
    display: grid;
    grid-template-columns: 30px 1fr;
    column-gap: 10px;
    padding: 2vh 0;
    color: var(--ash);
    transition: color 0.45s var(--e-out);
  }
  .mt-s:first-child {
    padding-top: 0;
  }
  .mt-n {
    font-size: 15px;
    font-weight: 600;
    padding-top: 6px;
  }
  .mt-t {
    font-size: clamp(22px, 1.8vw, 28px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .mt-d {
    margin-top: 6px;
    font-size: 17px;
    line-height: 1.5;
  }
  .mt-m {
    margin-top: 6px;
    font-size: 15px;
    font-weight: 500;
  }
  .mt-s.on {
    color: var(--copy);
  }
  .mt-s.on .mt-t {
    color: var(--print);
  }
  .mt-s.on .mt-n {
    color: var(--flare);
  }
  .mt-r {
    grid-column: 5 / span 8;
    position: sticky;
    top: calc(var(--hdr) + 28px);
    padding-left: clamp(0px, 1.6vw, 24px);
  }
  .mt-stack {
    position: relative;
    aspect-ratio: 2296 / 900;
    border-radius: var(--r);
    background: var(--ui-dark);
    box-shadow: var(--shadow-screen);
    overflow: hidden;
  }
  .mt-stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 50%;
    box-shadow: none;
    border-radius: 0;
    visibility: hidden;
  }
  .mt-stack img.on {
    visibility: visible;
  }
  .mt-caps {
    display: grid;
    margin-top: 18px;
  }
  .mt-c {
    grid-area: 1 / 1;
    font-size: 17px;
    font-weight: 500;
    color: var(--print);
    visibility: hidden;
  }
  .mt-c.on {
    visibility: visible;
  }
  .mt-disc {
    margin-top: 6px;
    font-size: 15px;
    color: var(--ash);
  }
  .mt-out {
    margin-top: clamp(40px, 4.4vw, 72px);
    max-width: 1180px;
    font-size: clamp(22px, 2.05vw, 33px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: pretty;
  }
  .mt-out-k {
    color: var(--ash);
  }
  .mt-o {
    color: var(--print);
  }
  .mt-o:nth-child(odd) {
    color: var(--copy);
  }

  /* ── approaches (bone): an autonomy scale ── */
  .ap {
    margin-top: calc(var(--sec) * 0.6);
    padding-block: calc(var(--sec) * 0.6);
  }
  .ap-h {
    max-width: 16ch;
  }
  .ap-lede {
    margin-top: 20px;
    max-width: 52ch;
  }
  .ap-g {
    list-style: none;
    margin: clamp(32px, 3.4vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0 var(--col-gap);
    align-items: start;
  }
  .ap-i {
    display: grid;
    align-content: start;
  }
  .ap-bar {
    display: block;
    height: clamp(48px, 4.6vw, 72px);
    margin-bottom: 20px;
    border-radius: 2px;
    background: linear-gradient(to top, var(--ink) calc(var(--k) * 16.666%), var(--bone-2) 0);
  }
  .ap-t {
    font-size: clamp(20px, 1.55vw, 25px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
    min-height: 2.3em;
  }
  .ap-d {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--copy-ink);
  }
  .ap-ex {
    margin-top: 12px;
    justify-self: start;
  }
  .ap-scale {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--rule-ink);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .ag {
    margin-top: clamp(48px, 4.6vw, 72px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 18px;
  }
  .ag-h {
    grid-column: 1 / -1;
    font-size: 17px;
    font-weight: 600;
  }
  .ag-cy {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    font-size: clamp(34px, 4.1vw, 64px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .ag-w i {
    margin-left: 0.3em;
    font-style: normal;
    font-weight: 300;
    color: var(--ink-soft);
  }
  .ag-w.last {
    color: var(--flare-ink);
  }
  .ag-p {
    grid-column: 6 / span 7;
    margin-top: 10px;
  }
  .ag-a {
    color: inherit;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* ── engagement (film) ── */
  .en {
    padding-top: calc(var(--sec) * 0.6);
  }
  .en-hd {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 18px;
    margin-bottom: clamp(40px, 4vw, 64px);
  }
  .en-hd .t-h2 {
    grid-column: 1 / span 8;
  }
  .en-lede {
    grid-column: 1 / span 7;
  }
  .en-lede .ag-a {
    color: var(--print);
  }
  .en-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px var(--col-gap);
  }
  .en-i {
    padding: clamp(22px, 2vw, 32px);
    border-radius: var(--r);
    background: var(--reel);
  }
  .en-key {
    font-size: clamp(30px, 2.8vw, 46px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
    white-space: nowrap;
  }
  .en-t {
    margin-top: 18px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
  }
  .en-d {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--copy);
  }
  .en-cav {
    margin-top: 20px;
    max-width: 72ch;
    font-size: 16px;
    color: var(--ash);
  }
  .en-b {
