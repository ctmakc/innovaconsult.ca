---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapHead from '../components/cap/CapHead.astro';
import MediaFrame from '../components/MediaFrame.astro';
import StatusTag from '../components/StatusTag.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Brief from '../components/cap/Brief.astro';
import CapNext from '../components/cap/CapNext.astro';
import { SHOT } from '../components/cap/media';
import { STAGES } from '../data/stages';

// Workflow OS screens shown beside the method; each step points at the screen that carries it.
const SCREENS = [
  { ...SHOT.wosOverview, cap: 'Overview: the mapped company, its top opportunities and the current implementation.' },
  { ...SHOT.wosMap, cap: 'Opportunity map: every process scored for value and feasibility.' },
  { ...SHOT.wosDesigner, cap: 'Automation designer: current and proposed state, with the human approval gate.' },
  { ...SHOT.wosImpact, cap: 'Impact & ROI: projected hours, cost and payback against the baseline.' }
];

// Seven method steps, each mapped to the master stage line and to the Workflow OS module that carries it.
const steps: { t: string; d: string; stage: number; module: [number, string]; screen: number }[] = [
  {
    t: 'Process discovery',
    d: 'We map departments, roles, systems, documents and the processes that connect them, with volumes and pain points.',
    stage: 0,
    module: [1, 'Process discovery'],
    screen: 0
  },
  {
    t: 'Opportunity mapping',
    d: 'Each process is scored for value, feasibility and strategic fit, minus a risk penalty. Every score shows the reasons behind it.',
    stage: 0,
    module: [2, 'Automation opportunity map'],
    screen: 1
  },
  {
    t: 'Prioritization',
    d: 'We rank opportunities by value and feasibility and agree on the first two or three to act on.',
    stage: 0,
    module: [2, 'Automation opportunity map'],
    screen: 1
  },
  {
    t: 'Solution architecture',
    d: 'For each chosen process we pick the simplest approach that works, from deterministic software to supervised agents.',
    stage: 1,
    module: [3, 'Automation designer'],
    screen: 2
  },
  {
    t: 'Implementation',
    d: 'We build, integrate and test inside the tools your team already uses.',
    stage: 3,
    module: [4, 'Implementation workspace'],
    screen: 0
  },
  {
    t: 'Governance',
    d: 'Approvals, permissions, audit trails and data controls are designed in from the first sprint.',
    stage: 4,
    module: [4, 'Implementation workspace'],
    screen: 0
  },
  {
    t: 'Measurement',
    d: 'We compare cycle time, cost, error rate and adoption against the baseline taken during discovery.',
    stage: 5,
    module: [5, 'Impact & ROI'],
    screen: 3
  }
];

const approaches: { t: string; d: string; ex?: { name: string; href: string } }[] = [
  { t: 'Deterministic software', d: 'Rules are clear and stable. Plain code is cheaper, faster and fully predictable.' },
  { t: 'Conventional automation', d: 'Data moves between known systems on known triggers.' },
  { t: 'AI assistant', d: 'People stay in charge; AI drafts, summarizes and looks things up.' },
  {
    t: 'AI agent',
    d: 'A bounded task with tools, permissions and a person who approves the result.',
    ex: { name: 'AICRMIUS', href: '/projects/aicrmius' }
  },
  {
    t: 'Multi-agent workflow',
    d: 'Several specialized agents hand work to each other under one supervisor.'
  },
  {
    t: 'Human-in-the-loop system',
    d: 'High-stakes steps always pass through a named person before they take effect.',
    ex: { name: 'AICRMIUS', href: '/projects/aicrmius' }
  }
];

// key: the time or scope stated in the step's own description.
const engagement: { t: string; key: string; d: string }[] = [
  {
    t: 'Opportunity assessment',
    key: 'Fixed scope',
    d: 'Fixed scope. You get a process inventory, a scored opportunity register, technology options for each process, a privacy and security constraint map and a sequenced roadmap.'
  },
  {
    t: 'Proof of concept on your historical data',
    key: '~3 weeks',
    d: 'About three weeks. It answers the feasibility question before any build budget is committed.'
  },
  {
    t: 'Single-process pilot',
    key: '12–15 weeks',
    d: 'About 12 to 15 weeks from discovery to a supported production process. Measured results arrive 4 to 6 weeks after go-live.'
  },
  {
    t: 'Support',
    key: 'Monthly',
    d: 'Monthly monitoring, fixes, model-version regression tests and small improvements.'
  }
];

const security = [
  [
    'Where your data lives',
    'By default we build inside your own cloud tenant, for example Microsoft 365 and Azure in Canada Central or Canada East, under your licences. Data, backups and logs stay in your environment, and INNOVA keeps no copy. If a service you need runs only outside Canada, we say so at design stage. Data leaves Canada only with your written approval.'
  ],
  ['Access', 'We work under accounts you issue, time-limited and least-privilege, and you revoke them when the engagement ends.'],
  ['Models', 'Your data is never used to train or fine-tune a model. Model versions are pinned, and a version change is retested before it goes live.'],
  ['Documents are data', 'Instructions hidden in a document are treated as text. Agent tools are allow-listed step by step.'],
  ['Human approval', 'Any action that changes a record or affects a person passes a named approver, and every step is logged.'],
  ['Privacy review', 'Where personal information is involved, a privacy impact assessment is planned into the pilot from the start.']
];

const outcomes = ['Shorter cycle time', 'Fewer repetitive tasks', 'Lower operating cost', 'Faster response to clients', 'Visibility into every process', 'Better-informed decisions', 'Fewer manual errors'];
const cycle = ['Propose', 'Validate', 'Approve', 'Apply', 'Undo'];
---

<BaseLayout
  title="AI Transformation & Automation in Ottawa | INNOVA"
  description="Process-first AI transformation: INNOVA maps how work happens, scores where automation pays, builds the simplest fit with governance and measures results."
  path="/ai-transformation"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'AI Transformation', path: '/ai-transformation' }
  ]}
>
  <CapHead
    crumb="AI Transformation"
    title="AI transformation means redesigning how work happens."
    lede="Companies often add AI tools one at a time, with no map of the processes underneath. We start from that map, so every automation has an owner, a reason and a number to beat."
  >
    <MediaFrame
      slot="media"
      size="full"
      scrim="left"
      material="navy"
      href="/workflow-os"
      aspectM="4 / 3.6"
      screens={[
        { ...SHOT.wosOverview, l: '28%', t: '6%', width: '42%', lm: '5%', tm: '7%', wm: '78%' },
        { ...SHOT.wosMap, l: '54.5%', t: '30%', width: '42%', lm: '25%', tm: '38%', wm: '70%', depth: 1.35 }
      ]}
    >
      <p class="ai-k t-label">The method runs on our own product</p>
      <p class="ai-n two-tone">INNOVA AI Workflow OS<span class="d">Automation planning tool</span></p>
      <p class="ai-f"><StatusTag status="prototype" label="Prototype · illustrative demo data" /></p>
      <span class="ai-go t-label">Explore Workflow OS <span class="ar" aria-hidden="true">→</span></span>
    </MediaFrame>
  </CapHead>

  <Brief
    text="INNOVA is an Ottawa company that plans and builds AI automation for organizations in Canada. Work starts with a map of real processes and a measured baseline. Each process then gets the simplest approach that fits, from plain software to a supervised AI agent, with approvals and audit trails built in, and results are reported against that baseline."
  />

  <!-- Method: seven steps beside the Workflow OS screen that carries each one (bone) -->
  <section class="mt tone-bone" id="method" aria-labelledby="mt-h">
    <div class="shell">
      <div class="inset">
        <SectionHead id="mt-h" title="Seven steps, one baseline." lede="The baseline measured in step one is the number we report against in step seven." size="h2" />
        <div class="mt-g">
          <ol class="mt-steps">
            {
              steps.map((s, i) => (
                <li class:list={['mt-s', { on: i === 0 }]} data-step={i} data-screen={s.screen}>
                  <span class="mt-n tnum">{i + 1}</span>
                  <div>
                    <h3 class="mt-t">{s.t}</h3>
                    <p class="mt-d">{s.d}</p>
                    <p class="mt-m">{`${STAGES[s.stage].label} · Module ${s.module[0]}, ${s.module[1]}`}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="mt-r">
            <div class="mt-stack">
              {SCREENS.map((sc, i) => <img class:list={['scr-img', { on: i === 0 }]} src={sc.src} srcset={`${sc.src800} 800w, ${sc.src} 1600w`} sizes="(max-width: 900px) 100vw, 56vw" alt={sc.alt} width={sc.w} height={sc.h} loading="lazy" decoding="async" />)}
            </div>
            <div class="mt-caps" aria-hidden="true">
              {SCREENS.map((sc, i) => <p class:list={['mt-c', { on: i === 0 }]}>{sc.cap}</p>)}
            </div>
            <p class="mt-disc">Illustrative demo data: Northstar Professional Services is a fictional 30-person firm.</p>
          </div>
        </div>
        <p class="mt-note">
          Stage names follow the INNOVA stage line. Modules are those of <a class="lnk" href="/workflow-os">INNOVA AI Workflow OS</a>: 1 Process discovery, 2 Automation opportunity map, 3 Automation designer, 4 Implementation workspace, 5 Impact &amp; ROI.
        </p>
      </div>
    </div>
  </section>

  <!-- The right tool for each process -->
  <section class="ap shell" aria-labelledby="ap-h">
    <div class="inset">
      <SectionHead id="ap-h" title="The right tool for each process." lede="We use AI where it earns its place. When ordinary software does the job better, we build ordinary software, and say so." size="h2" />
      <p class="t-label t-mute ap-scale">Scale: from fully predictable to supervised autonomy</p>
      <ol class="ap-g">
        {
          approaches.map((a, i) => (
            <li class="ap-i">
              <span class="ap-m" aria-hidden="true" style={`--k:${i + 1}`}>
                {approaches.map((_, j) => <i class:list={{ f: j <= i }} />)}
              </span>
              <h3 class="t-h4">{a.t}</h3>
              <p class="ap-d">{a.d}</p>
              {a.ex && (
                <a class="lnk ap-ex" href={a.ex.href}>
                  {a.ex.name} <span class="ar" aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- How we build AI agents: the cycle as type -->
  <section class="ag shell" id="agents" aria-labelledby="ag-h">
    <div class="inset ag-g">
      <div class="ag-l">
        <h2 id="ag-h" class="t-h2" data-rise>How we build AI agents</h2>
        <p class="t-lede ag-lede">Each INNOVA agent gets a bounded task, named tools and permissions, and a person who approves its output.</p>
        <p class="ag-p t-mute">
          In <a class="ag-a" href="/projects/aicrmius">AICRMIUS</a>, agents follow one cycle: propose, validate, approve, apply, undo, with every step in an audit trail. In <a class="ag-a" href="/projects/finmozg">FINMOZG</a>, deterministic accounting engines
          keep the ledger correct, and every posting lands in a hash-chained audit log.
        </p>
      </div>
      <ol class="ag-cycle" aria-label="AICRMIUS agent cycle">
        {
          cycle.map((c, i) => (
            <li data-mask>
              <span>
                <span class="ag-i tnum">{i + 1}</span>
                {`${c}.`}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- How a Workflow OS project runs -->
  <section class="en tone-reel" id="engagement" aria-labelledby="en-h">
    <div class="shell">
      <div class="inset">
        <SectionHead id="en-h" title="How a Workflow OS project runs" size="h2">
          <p class="t-lede t-mute en-lede">
            Each step runs on <a class="ag-a" href="/workflow-os">INNOVA AI Workflow OS</a>, from the first process map to the measured result. Four steps; each one ends in a result you can review before the next one is agreed.
          </p>
        </SectionHead>
        <ol class="en-g">
          {
            engagement.map((e, i) => (
              <li class="en-i">
                <p class="t-label t-mute">Step {i + 1}</p>
                <p class="en-key">{e.key}</p>
                <h3 class="t-h4 en-t">{e.t}</h3>
                <p class="en-d">{e.d}</p>
              </li>
            ))
          }
        </ol>
        <p class="en-cav">Timelines are for one bounded process. Integration, the number of exceptions, privacy review depth and data readiness move them most.</p>
        <div class="en-b">
          <div class="en-need">
            <h3 class="t-h4">What we need from you</h3>
            <p>
              A process owner and two or three of the people who do the work, about 2 to 4 hours each during discovery; one 3-hour workshop; 4 to 8 hours of acceptance testing; real sample transactions, including the awkward ones; and a named
              person inside your company who owns the automation.
            </p>
          </div>
          <div class="en-keep frame">
            <h3 class="t-label">What you keep</h3>
            <p class="en-keep-t">Licences stay in your name and your tenant. You own the output.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Security (bone) -->
  <section class="sc tone-bone" id="security" aria-labelledby="sc-h">
    <div class="shell">
      <div class="inset">
        <SectionHead id="sc-h" title="Security and your data" lede="How data, access and models are handled by default." size="h2" />
        <dl class="sc-g">
          {
            security.map(([t, d], i) => (
              <div class:list={['sc-i', { 'sc-lead': i === 0 }]}>
                <dt class="t-h4">{t}</dt>
                <dd>{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- What we measure + the offer -->
  <section class="oc shell" aria-labelledby="oc-h">
    <div class="inset oc-g">
      <div class="oc-l">
        <h2 id="oc-h" class="t-h2" data-rise>What we measure.</h2>
        <p class="oc-p t-mute">Outcomes are agreed before the build starts and reported against the discovery baseline.</p>
        <Button href="/workflow-os" variant="ghost" class="oc-btn">See AI Workflow OS</Button>
      </div>
      <ul class="oc-list" aria-label="Outcomes we measure">{outcomes.map((o) => <li>{o}</li>)}</ul>
    </div>
    <div class="inset">
      <div class="offer frame">
        <p class="offer-h">Send us the process that takes the most hours.</p>
        <div class="offer-r">
          <p>We reply in writing with whether and how we would start.</p>
          <Button href="/contact?topic=automation" variant="flare">Send a process</Button>
        </div>
      </div>
    </div>
  </section>

  <CapNext current="ai" />
</BaseLayout>

<script>
  // Method: the step nearest the middle of the screen picks the Workflow OS screen and its caption.
  const steps = document.querySelectorAll<HTMLElement>('.mt-s');
  const shots = document.querySelectorAll<HTMLElement>('.mt-stack img');
  const caps = document.querySelectorAll<HTMLElement>('.mt-c');
  const set = (i: number) => {
    const sc = Number(steps[i]?.dataset.screen ?? 0);
    steps.forEach((s, j) => s.classList.toggle('on', j === i));
    shots.forEach((s, j) => s.classList.toggle('on', j === sc));
    caps.forEach((s, j) => s.classList.toggle('on', j === sc));
  };
  if ('IntersectionObserver' in window && steps.length) {
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && set(Number((e.target as HTMLElement).dataset.step))), { rootMargin: '-46% 0px -44% 0px' });
    steps.forEach((s) => io.observe(s));
  }
</script>

<style>
  /* head frame caption */
  .ai-k {
    margin-bottom: 16px;
    color: var(--ash);
  }
  .ai-n {
    font-size: clamp(34px, 3.4vw, 60px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 12ch;
  }
  .ai-n .d {
    font-size: clamp(18px, 1.4vw, 22px);
    letter-spacing: 0;
    line-height: 1.3;
    margin-top: 8px;
  }
  .ai-f {
    margin-top: 16px;
  }
  .ai-go {
    display: inline-flex;
    gap: 10px;
    margin-top: 16px;
  }
  .ai-go .ar {
    color: var(--flare);
    transition: transform 0.35s var(--e-out);
  }
  :global(a.mf:hover) .ai-go .ar {
    transform: translateX(6px);
  }

  /* method */
  .mt {
    padding-block: var(--sec);
  }
  .mt-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: start;
  }
  .mt-steps {
    grid-column: 1 / span 5;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mt-s {
    display: grid;
    grid-template-columns: 34px 1fr;
    column-gap: 12px;
    padding: 4.2vh 0;
    color: var(--ink-soft);
    transition: color 0.45s var(--e-out);
  }
  .mt-s:first-child {
    padding-top: 0;
  }
  .mt-n {
    font-size: 15px;
    font-weight: 600;
    padding-top: 8px;
  }
  .mt-t {
    font-size: clamp(24px, 2.1vw, 34px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .mt-d {
    margin-top: 8px;
    font-size: 17px;
    line-height: 1.5;
    max-width: 42ch;
  }
  .mt-m {
    margin-top: 10px;
    font-size: 15px;
    font-weight: 500;
  }
  .mt-s.on {
    color: var(--ink);
  }
  .mt-s.on .mt-n {
    color: var(--flare-ink);
  }
  .mt-r {
    grid-column: 6 / span 7;
    position: sticky;
    top: calc(var(--hdr) + 32px);
    padding-left: clamp(0px, 2vw, 32px);
  }
  .mt-stack,
  .mt-caps {
    position: relative;
  }
  .mt-stack {
    aspect-ratio: 16 / 10;
  }
  .mt-stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
    opacity: 0;
    transform: scale(0.975);
    transition:
      opacity 0.6s var(--e-out),
      transform 0.8s var(--e-out);
  }
  .mt-stack img.on {
    opacity: 1;
    transform: none;
  }
  .mt-caps {
    display: grid;
    margin-top: 20px;
  }
  .mt-c {
    grid-area: 1 / 1;
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.4s var(--e-out);
  }
  .mt-c.on {
    opacity: 1;
  }
  .mt-disc {
    margin-top: 8px;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .mt-note {
    margin-top: clamp(40px, 4vw, 64px);
    max-width: 78ch;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .mt-note .lnk {
    color: var(--ink);
    display: inline;
  }

  /* approaches */
  .ap {
    padding-top: var(--sec);
  }
  .ap-scale {
    margin-bottom: 22px;
  }
  .ap-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(44px, 4.4vw, 72px) var(--col-gap);
  }
  .ap-i {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .ap-m {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
    margin-bottom: 14px;
    max-width: 240px;
  }
  .ap-m i {
    height: 6px;
    border-radius: 1px;
    background: var(--rule-film);
  }
  .ap-m i.f {
    background: var(--print);
  }
  .ap-d {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
    max-width: 36ch;
  }
  .ap-ex {
    margin-top: 2px;
    justify-self: start;
  }

  /* agents */
  .ag {
    padding-block: var(--sec);
  }
  .ag-g {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: center;
  }
  .ag-l {
    grid-column: 1 / span 5;
  }
  .ag-lede {
    margin-top: 24px;
  }
  .ag-p {
    margin-top: 18px;
    max-width: 48ch;
  }
  .ag-a {
    color: var(--print);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .ag-cycle {
    grid-column: 7 / span 6;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ag-cycle li {
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .ag-cycle li > span {
    display: block;
    font-size: clamp(48px, 6.6vw, 112px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }
  .ag-cycle li:last-child > span {
    color: var(--ash);
  }
  .ag-i {
    display: inline-block;
    width: 1.6em;
    vertical-align: top;
    padding-top: 0.5em;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ash);
  }

  /* engagement */
  .en {
    padding-block: var(--sec);
  }
  .en-lede {
    font-size: clamp(18px, 1.35vw, 21px);
  }
  .en-lede .ag-a {
    color: var(--print);
  }
  .en-g {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px var(--col-gap);
  }
  .en-i {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .en-key {
    margin-top: 6px;
    font-size: clamp(32px, 3vw, 50px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.95;
    white-space: nowrap;
  }
  .en-t {
    margin-top: 10px;
  }
  .en-d {
    font-size: 17px;
    line-height: 1.5;
    color: var(--ash);
  }
  .en-cav {
    margin-top: clamp(32px, 3vw, 48px);
    max-width: 72ch;
    font-size: 16px;
    color: var(--ash);
  }
  .en-b {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 32px;
    margin-top: clamp(56px, 6vw, 96px);
    align-items: stretch;
  }
  .en-need {
    grid-column: 1 / span 6;
  }
  .en-need p {
    margin-top: 14px;
    max-width: 56ch;
    color: var(--ash);
  }
  .en-keep {
    grid-column: 8 / span 5;
    background: var(--print);
    color: var(--ink);
    padding: clamp(24px, 2.6vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .en-keep-t {
