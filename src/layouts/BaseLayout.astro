---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBlock from '../components/CtaBlock.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Path without trailing slash, e.g. "/about". */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  footerCta?: boolean;
  /** Trail from the home page to this page; emitted as BreadcrumbList JSON-LD. */
  breadcrumbs?: { name: string; path: string }[];
  /** Attribution lines for third-party (CC) photos on this page; printed in the footer. */
  credits?: string[];
  /** Closing band: optional headline, lede and photo (default: Rideau Canal at night). */
  cta?: { title?: string; lede?: string; photo?: 'ottawa' | 'festival'; link?: { href: string; label: string } };
}

const { title, description = SITE.defaultDescription, path, ogImage = '/og/innova-og.png', noindex = false, jsonLd = [], footerCta = true, breadcrumbs, credits = [], cta = {} } = Astro.props;
const cleanPath = path ?? (Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/');
const canonical = new URL(cleanPath === '/' ? '/' : cleanPath, SITE.url).href;
const ogUrl = new URL(ogImage, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: 'INNOVA',
  legalName: SITE.legalName,
  alternateName: ['INNOVA CONSULT LTD.', 'INNOVA Applied Innovation & Technology'],
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'Corporations Canada corporation number (CBCA)', value: SITE.corporationNumber },
    { '@type': 'PropertyValue', propertyID: 'NCAGE', value: SITE.ncage },
    { '@type': 'PropertyValue', propertyID: 'DUNS', value: SITE.duns }
  ],
  duns: SITE.duns,
  sameAs: [`https://ised-isde.canada.ca/cc/lgcy/fdrlCrpDtls.html?corpId=${SITE.corporationNumber.replace('-', '')}`],
  url: SITE.url,
  logo: `${SITE.url}/innova-mark-512.png`,
  email: SITE.email,
  description: SITE.defaultDescription,
  foundingDate: SITE.incorporated,
  foundingLocation: { '@type': 'Place', name: `${SITE.city}, ${SITE.region}, ${SITE.country}` },
  founder: { '@type': 'Person', name: 'Maksym Stepanenko', jobTitle: 'Founder and Director' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: 'ON',
    addressCountry: 'CA'
  },
  areaServed: { '@type': 'Country', name: SITE.country },
  contactPoint: { '@type': 'ContactPoint', contactType: 'general inquiries', email: SITE.email, areaServed: 'CA' },
  knowsAbout: ['Applied artificial intelligence', 'AI agents', 'Workflow automation', 'Custom software development', 'Applied research and development', 'Technology commercialization']
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: 'INNOVA — Applied Innovation & Technology',
  publisher: { '@id': `${SITE.url}/#org` },
  inLanguage: 'en-CA'
};
const breadcrumbLd =
  breadcrumbs && breadcrumbs.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.path, SITE.url).href
        }))
      }
    : null;
const ld = [org, website, ...(breadcrumbLd ? [breadcrumbLd] : []), ...jsonLd];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0c0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="INNOVA" />
    <meta property="og:locale" content="en_CA" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/host-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
      {footerCta && <CtaBlock {...cta} />}
    </main>
    <Footer credits={credits} />
    <ContactDialog />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
