---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Path without trailing slash, e.g. "/about". */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  footerCta?: boolean;
}

const { title, description = SITE.defaultDescription, path, ogImage = '/og/innova-og.png', noindex = false, jsonLd = [], footerCta = true } = Astro.props;
const cleanPath = path ?? (Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/');
const canonical = new URL(cleanPath === '/' ? '/' : cleanPath, SITE.url).href;
const ogUrl = new URL(ogImage, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: 'INNOVA',
  legalName: SITE.legalName,
  url: SITE.url,
  logo: `${SITE.url}/innova-mark-512.png`,
  email: SITE.email,
  description: SITE.defaultDescription,
  foundingDate: SITE.incorporated,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: 'ON',
    addressCountry: 'CA'
  },
  areaServed: 'CA',
  knowsAbout: ['Applied artificial intelligence', 'AI agents', 'Workflow automation', 'Custom software development', 'Applied research and development', 'Technology commercialization']
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: 'INNOVA — Applied Innovation & Technology',
  publisher: { '@id': `${SITE.url}/#org` },
  inLanguage: 'en-CA'
};
const ld = [org, website, ...jsonLd];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#08161a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="INNOVA" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="INNOVA — applied innovation and technology, Ottawa" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/hubot-sans-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer showCta={footerCta} />

    <script>
      // Rows reveal by drawing their stage track once (DESIGN.md: no fade-up wallpaper).
      const els = document.querySelectorAll<HTMLElement>('[data-draw]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
